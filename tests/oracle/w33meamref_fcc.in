# oracle: pair_style meam, one element with Cmin(1,1,1) = 0.70 (w33meamtrip_b1_lib.meam element A + w33meamref.meam, nn2 0): 3x3x3 fcc cells at re = 2.5 A with the second shell partly screened in the crystal, 0.05 A sinusoidal displacements, velocities from atom-style variables, fix nve, 40 steps of 0.001 ps
# oracle-inputs: w33meamtrip_b1_lib.meam w33meamref.meam
# oracle-compare: thermo=all atoms=all rel=1e-7 abs=1e-9
units           metal
atom_style      atomic
boundary        p p p
lattice         fcc 3.5355339059327378
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 63.546
variable        dx atom 0.05*sin(1.3*x+0.7*y)
variable        dy atom 0.05*sin(0.9*y+1.1*z)
variable        dz atom 0.05*sin(1.7*z+0.4*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 2.0*sin(0.8*x+0.3*z)
variable        vy atom 2.0*sin(1.2*y+0.5*x)
variable        vz atom 2.0*sin(0.6*z+0.9*y)
velocity        all set v_vx v_vy v_vz units box
pair_style      meam
pair_coeff      * * w33meamtrip_b1_lib.meam A w33meamref.meam A
thermo_style    custom step pe press pxx pyy pzz pxy
thermo_modify   format float %.15g
timestep        0.001
fix             1 all nve
thermo          10
run             40
