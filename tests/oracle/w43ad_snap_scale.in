# oracle: fix adapt pair snap:1 scale * * v_l1 and snap:2 scale * * v_l2 on hybrid/overlay snap snap (cut-down examples/snap/in.snap.scale.Ni_Zuo_JCPA2020: 3x3x3 fcc Ni, 10 steps)
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
# oracle-potentials: Ni_Zuo_JPCA2020.snapcoeff Ni_Zuo_JPCA2020.snapparam Ni_Zuo_JPCA2020.quadratic.snapcoeff Ni_Zuo_JPCA2020.quadratic.snapparam
units           metal
atom_style      atomic
lattice         fcc 3.52
region          b block 0 3 0 3 0 3
create_box      2 b
create_atoms    1 box
mass            * 58.7
set             group all type 1
group           odd id 1:108:2
set             group odd type 2
variable        dx atom 0.05*sin(1.3*x+0.7*y)
variable        dy atom 0.05*cos(0.9*y-1.1*z)
variable        dz atom 0.05*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
timestep        0.5e-3
thermo_style    custom step pe evdwl press pxx pyy pzz
thermo_modify   format float %.15g
thermo          1
thermo_modify   norm no
pair_style      hybrid/overlay snap snap
pair_coeff      * * snap 1 Ni_Zuo_JPCA2020.snapcoeff Ni_Zuo_JPCA2020.snapparam Ni Ni
pair_coeff      * * snap 2 Ni_Zuo_JPCA2020.quadratic.snapcoeff Ni_Zuo_JPCA2020.quadratic.snapparam Ni Ni
variable        l1 equal 0.2
variable        l2 equal 1.0-0.2
fix             scale1 all adapt 1 pair snap:1 scale * * v_l1
fix             scale2 all adapt 1 pair snap:2 scale * * v_l2
fix             2 all nve
run             10
