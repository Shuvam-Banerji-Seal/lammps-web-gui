# Wave 41: fix ttm/cascade with only the cetab table: C_e from the table (the positional C_e 3.0 is overwritten), kappa_e
# stays the positional 0.5, rho_e 2, gamma_p 20, gamma_s 0, no cutoff, offset 0.015 (electron-ion friction off for the first
# step), seed 77, the eight-atom sc crystal of w41ttm_cas_small with mixed speeds; two runs.
# oracle-inputs: w41ttm_cas.init w41ttm_ce.tab
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           metal
atom_style      atomic
lattice         sc 3.0
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box
mass            1 10.0
displace_atoms  all move 0.5 0.5 0.5 units box
variable        vx atom 3.0*sin(0.9*x+0.4*y)
variable        vy atom 0.5*cos(0.7*y-0.5*z)
variable        vz atom 0.4*sin(1.1*z+0.3*x)
velocity        all set v_vx v_vy v_vz units box
pair_style      lj/cut 3.0
pair_coeff      1 1 0.0 2.0
fix             1 all nve
fix             2 all ttm/cascade 77 3.0 2.0 0.5 20.0 0.0 2.0 2 2 2 infile w41ttm_cas.init cetab w41ttm_ce.tab offset 0.015
timestep        0.01
thermo_style    custom step temp pe f_2[1] f_2[2]
thermo_modify   format float %.15g
thermo          1
run             4
run             3
