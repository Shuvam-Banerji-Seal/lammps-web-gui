# oracle: parallel tempering of gREM lambdas (temper/grem) on 4 replicas: LJ fcc under fix grem on fix npt, a swap every 20 of 400 steps
# oracle-partitions: 4
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10 atomrel=1e-8
# native: b332f28 (/home/roy/.local/bin/lmp, mpirun -np 4 -partition 4x1); the swap table (21 rows, 19 rows with a change) is compared exactly
# Measured with native LAMMPS: thermo max 1.2e-12, atoms max 4.2e-11 relative (ORACLE_MEASURE=1, temper/grem with fix grem on fix npt (lambda 2.0 2.1 2.2 2.3))
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 1.0 87287 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
neighbor        0.3 bin
variable        lambda world 2.0 2.1 2.2 2.3
fix             fxnpt all npt temp 1.0 1.0 0.5 iso 0.0 0.0 5.0
fix             fxgREM all grem ${lambda} 0.01 -740.0 fxnpt
thermo_style    custom step temp f_fxgREM pe etotal press vol
thermo_modify   format float %.15g
thermo          50
timestep        0.005
temper/grem     400 20 ${lambda} fxgREM fxnpt 4928 2394
