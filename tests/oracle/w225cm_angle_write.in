# oracle: angle_write of two harmonic angle types (angle table file, N 37 values, keyword HARM)
# oracle-files: w225cm_angle1.table w225cm_angle2.table
# oracle-compare: thermo=all atoms=none
units           real
atom_style      full
region          box block -5 5 -5 5 -5 5
create_box      2 box bond/types 1 angle/types 2 extra/bond/per/atom 2 extra/angle/per/atom 2 extra/special/per/atom 3
create_atoms    1 single 0.0 0.0 0.0
mass            * 12.0
pair_style      zero 10.0
pair_coeff      * *
angle_style     harmonic
angle_coeff     1 50.0 109.5
angle_coeff     2 30.0 120.0
angle_write     1 37 w225cm_angle1.table HARM
angle_write     2 19 w225cm_angle2.table HARM
