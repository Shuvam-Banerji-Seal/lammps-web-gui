# oracle: ELECTRODE conp with fix_modify tf and algo cg (electrode-electrode vector carries the tf q term), symm on, 2 steps
# native: LAMMPS b332f28 (installed lmp, ELECTRODE package). Measured max relative error vs native: thermo 7.3e-15, per-atom 4.9e-13
# oracle-inputs: w68elec_au_elyt.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
boundary        p p f
kspace_style    ewald/electrode 1.0e-8
kspace_modify   slab 8.0
units           real
atom_style      full
pair_style      lj/cut/coul/long 12
read_data       w68elec_au_elyt.data
group           bot type 1
group           top type 2
variable        q atom q
compute         qbot bot reduce sum v_q
compute         qtop top reduce sum v_q
thermo_style    custom step pe c_qbot c_qtop
thermo_modify   format float %.15g
fix             conp bot electrode/conp -1.0 1.805132 couple top 1.0 symm on algo cg 1e-10
fix_modify      conp tf 1 1.0 18.1715745
fix_modify      conp tf 2 1.0 18.1715745
run             2
