# oracle: compute pe/atom and stress/atom (kspace terms) with kspace_style ewald/electrode, slab 8.0 (the per-atom term of the EW3DC dipole correction) and fix electrode/conp qtotal (the w68elec_conp_qtotal system), per-atom values dumped at step 0
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 9.2e-15, atoms 8.7e-15.
# oracle-inputs: w68elec_au_elyt.data
# oracle-files: w268el_ewald_peratom.dump
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=1e-12 filerel=1e-10
boundary        p p f
kspace_style    ewald/electrode 1.0e-8
kspace_modify   slab 8.0
units           real
atom_style      full
pair_style      lj/cut/coul/long 12
read_data       w68elec_au_elyt.data
group           bot type 1
group           top type 2
variable        q atom q
compute         qbot bot reduce sum v_q
compute         qtop top reduce sum v_q
thermo_style    custom step pe c_qbot c_qtop
thermo_modify   format float %.15g
fix             conp bot electrode/conp 0 2 couple top 1 qtotal 0.1
compute         pa all pe/atom kspace
compute         sa all stress/atom NULL kspace
dump            d all custom 1000 w268el_ewald_peratom.dump id c_pa c_sa[1] c_sa[2] c_sa[3]
dump_modify     d sort id format float %.15g
run             0
