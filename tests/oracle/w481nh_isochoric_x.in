# oracle: w481nh_isochoric_x — fix npt barostat on z, isochoric x keeps the volume (fix_nh.html isochoric, versionadded 30Mar2026)
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# Measured with native LAMMPS: max relative error 1.1e-13 on thermo, 9.2e-14 per atom.
units lj
atom_style atomic
lattice fcc 0.8442
region box block 0 4 0 4 0 4
create_box 1 box
create_atoms 1 box
mass 1 1.0
velocity all create 1.0 87287 loop geom
pair_style lj/cut 2.5
pair_coeff 1 1 1.0 1.0 2.5
fix 1 all npt temp 1.0 1.0 0.5 z 2.0 2.0 1.0 isochoric x
thermo_style custom step temp pe press pzz vol lx ly lz
thermo_modify format float %.15g
thermo 10
run 60
