# oracle: compute chunk/atom in a triclinic box (units reduced): bin/1d along y, bin/sphere and bin/cylinder with their centres taken from reduced to box coordinates, under fix npt (the box changes size; nchunk once by default); fix ave/chunk density/number on each
# oracle-files: tri1.txt tri2.txt tri3.txt
units           lj
atom_style      atomic
boundary        p p p
lattice         fcc 0.8442
region          box prism 0 4 0 4 0 4 0.6 0.4 -0.3
create_box      1 box
create_atoms    1 box
mass            1 1.0
variable        dx atom 0.04*sin(1.3*x+0.7*y)
variable        dy atom 0.04*cos(0.9*y-1.1*z)
variable        dz atom 0.04*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
velocity        all create 1.2 87287 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
timestep        0.002
fix             1 all npt temp 1.2 1.2 0.2 iso 2.0 2.0 1.0
compute         c1 all chunk/atom bin/1d y lower 0.125 units reduced
compute         c2 all chunk/atom bin/sphere 0.3 0.6 0.5 0.05 0.4 4 units reduced pbc yes
compute         c3 all chunk/atom bin/cylinder z lower 0.25 0.7 0.2 0.0 0.35 3 units reduced
compute         rs all reduce sum c_c1 c_c2 c_c3
fix             2 all ave/chunk 5 2 10 c1 density/number format " %.12g" file tri1.txt
fix             3 all ave/chunk 5 2 10 c2 density/number format " %.12g" file tri2.txt
fix             4 all ave/chunk 5 2 10 c3 density/number format " %.12g" file tri3.txt
thermo_style    custom step temp pe etotal vol c_c1 c_c2 c_c3 c_rs[1] c_rs[2] c_rs[3]
thermo_modify   norm no format float %.15g
thermo          10
run             50
