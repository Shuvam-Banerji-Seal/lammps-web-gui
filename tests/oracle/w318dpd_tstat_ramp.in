# oracle: w318dpd_tstat_ramp — w77dpd_noise_tstat_spce with a temperature ramp, pair_style dpd/tstat 300 600: sigma follows T = t_start + delta (t_stop - t_start), delta = (step - beginstep)/(endstep - beginstep), over two runs (the second with start and stop keywords)
# oracle-inputs: w77dpd_cg_spce.data
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=0
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 2.3e-14, atoms 3.1e-15.
units            real
boundary     p p p
atom_style   atomic
dimension    3
newton       on
comm_modify  vel yes
read_data    w77dpd_cg_spce.data
pair_style       dpd/tstat 300.0 600.0 10.0 385262
pair_coeff   1 1 10.0 10.0
timestep    1.0
run_style   verlet
velocity all create 300.0 68768932
thermo_style custom step time temp press pe ke
thermo_modify format float %.15g
thermo       5
fix 1 all    nve
run          20
run          20 start 10 stop 60
