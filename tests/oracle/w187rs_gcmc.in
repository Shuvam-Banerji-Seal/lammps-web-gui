# oracle: fix gcmc carried through write_restart/read_restart (fix_gcmc.cpp write_restart and restart: the random_equal and random_unequal states, next_reneighbor, the eight counters and ntimestep): an empty lj box, 20 steps of exchanges (X=10 per step), write_restart, clear, read_restart, gcmc re-defined, 20 more steps. Native: built from b332f28 (installed lmp).
# oracle-compare: thermo=all atoms=all rel=1e-12 abs=1e-14
# measured: the case passes at rel=1e-14 abs=0 (tightest tested), so the tolerance is 1e-12; the run takes about 1 s
units           lj
atom_style      atomic
pair_style      lj/cut 3.0
pair_modify     tail no
region          box block 0 5 0 5 0 5
create_box      1 box
pair_coeff      * * 1.0 1.0
mass            * 1.0
group           gcmcgroup type 1
fix             mygcmc gcmcgroup gcmc 1 10 0 1 29494 2.0 -1.25 0.5
thermo_style    custom step atoms pe f_mygcmc[1] f_mygcmc[2] f_mygcmc[3] f_mygcmc[4] f_mygcmc[5] f_mygcmc[6] f_mygcmc[7] f_mygcmc[8]
thermo_modify   format float %.15g
thermo          4
run             20
write_restart   w187rs_gcmc.restart
clear
read_restart    w187rs_gcmc.restart
pair_style      lj/cut 3.0
pair_modify     tail no
pair_coeff      * * 1.0 1.0
fix             mygcmc gcmcgroup gcmc 1 10 0 1 29494 2.0 -1.25 0.5
thermo_style    custom step atoms pe f_mygcmc[1] f_mygcmc[2] f_mygcmc[3] f_mygcmc[4] f_mygcmc[5] f_mygcmc[6] f_mygcmc[7] f_mygcmc[8]
thermo_modify   format float %.15g
thermo          4
run             20
