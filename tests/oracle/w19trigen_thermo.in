# oracle: thermo_modify triclinic/general yes on a general triclinic data file; cell vectors and pressure tensor in the general frame
# oracle-inputs: w19trigen_general.data
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
read_data       w19trigen_general.data
mass            * 1.0
pair_style      lj/cut 1.2
pair_coeff      * * 1.0 1.0
neighbor        0.0 bin
thermo_style    custom step pe avecx avecy avecz bvecx bvecy bvecz cvecx cvecy cvecz pxx pyy pzz pxy pxz pyz vol
thermo_modify   format float %.15g norm no
thermo_modify   triclinic/general yes
run             0
