# oracle: fix atom/swap semi-grand with pair_modify tail yes: native never reinits the pair in fix atom/swap, so the tail correction keeps the per-type counts of the run's start while the swaps change them
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
set             type 1 type/fraction 2 0.5 4242
mass            1 1.0
mass            2 2.5
pair_style      lj/cut 2.5
pair_modify     tail yes
pair_coeff      1 1 1.0 1.0
pair_coeff      1 2 0.8 1.05
pair_coeff      2 2 0.6 0.95
velocity        all create 1.0 87287 loop geom
fix             integ all nve
fix             sw all atom/swap 5 20 12345 1.0 types 1 2 semi-grand yes mu 0.0 0.3 ke yes
variable        is2 atom type==2
compute         n2 all reduce sum v_is2
thermo_style    custom step pe ke temp f_sw[1] f_sw[2] c_n2
thermo_modify   format float %.15g
thermo          1
run             40
