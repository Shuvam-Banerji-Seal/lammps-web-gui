# oracle: cut-down of the in.spce2 example (two atom types, asymmetric 1-1-2 table): 205 molecules, 20 steps of nvt, velocities set from atom-style variables
# oracle-inputs: w49mt_spce2.data w49mt_spce2.3b w49mt_1-1-1.table w49mt_1-1-2.table w49mt_table_CG_CG.txt
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           real
atom_style      atomic
boundary        f f f

# data file with two atom types
read_data       w49mt_spce2.data

pair_style      hybrid/overlay table linear 1200 threebody/table

#pair coefficients
pair_coeff      * * table w49mt_table_CG_CG.txt VOTCA
pair_coeff      * * threebody/table w49mt_spce2.3b type1 type2

fix             1 all nvt temp 300.0 300.0 200.0

variable        vx atom 0.005*sin(id)
variable        vy atom 0.005*cos(2*id)
variable        vz atom 0.005*sin(3*id)
velocity        all set v_vx v_vy v_vz
timestep        2.0

thermo          5
thermo_style    custom step temp pe etotal press
thermo_modify   format float %.15g
#dump            2 all custom 100 dump.spce2 id type x y z fx fy fz

run             20

