# oracle: kspace_style pppm/cg 1.0e-5 0.1 on a partially charged cubic lattice (+-0.4 on 2/6 of the atoms, 0.05 and 3e-6 charges below smallq), run 0
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-8
units           real
atom_style      charge
boundary        p p p
lattice         sc 3.2
region          box block 0 4 0 4 0 4 units lattice
create_box      2 box
create_atoms    1 box
mass            * 18.0
group           pos id 1:64:6
group           neg id 4:64:6
group           mid id 5:64:6
group           tiny id 2:64:6
set             group pos charge 0.4
set             group neg charge -0.4
set             group mid charge 0.05
set             group tiny charge 3.0e-6
variable        dx atom 0.15*sin(0.31*x+0.27*y)
variable        dy atom 0.15*cos(0.23*y-0.19*z)
variable        dz atom 0.15*sin(0.17*z+0.29*x)
displace_atoms  all move v_dx v_dy v_dz units box
pair_style      zero/coul 6.0
pair_coeff      * *
pair_modify     table 0
kspace_style    pppm/cg 1.0e-5 0.1
kspace_modify   gewald 0.4 mesh 16 16 16 order 5
thermo_style    custom step temp pe elong ecoul etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
run             0
