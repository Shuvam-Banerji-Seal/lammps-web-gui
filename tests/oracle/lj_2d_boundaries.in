# oracle: 2d, shrink-wrapped and fixed faces, groups by region, enforce2d
units           lj
dimension       2
boundary        s f p
atom_style      atomic
lattice         hex 0.8
region          box block 0 10 0 8 -0.5 0.5
create_box      2 box
create_atoms    1 box
region          top block INF INF 5 INF INF INF
group           top region top
set             group top type 2
mass            * 1.0
variable        vx atom 0.5*sin(1.3*x+0.9*y)
variable        vy atom 0.5*cos(0.7*x-1.2*y)
velocity        all set v_vx v_vy 0.0 units box
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0 2.5
pair_coeff      1 2 0.5 1.1 2.5
fix             1 all nve
fix             2 all enforce2d
thermo_style    custom step temp pe ke etotal press pxx pyy vol lx ly xlo xhi ylo yhi atoms
thermo_modify   format float %.15g lost ignore
thermo          10
run             80
