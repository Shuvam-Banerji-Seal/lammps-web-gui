# oracle: fix adapt bond harmonic k and r0, angle harmonic k and theta0 (in radians), dihedral opls k1 (native stores 0.5 K1) and improper harmonic chi0, each driven by a step-dependent equal-style variable every 2 steps
# oracle-inputs: mol_chains.data
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=1e-12
units           lj
atom_style      molecular
bond_style      harmonic
angle_style     harmonic
dihedral_style  opls
improper_style  harmonic
pair_style      lj/cut 2.5
read_data       mol_chains.data
pair_coeff      * * 0.5 0.9
pair_coeff      1 3 0.8 1.0
special_bonds   lj 0.0 0.5 0.8
bond_coeff      1 100.0 1.05
bond_coeff      2 80.0 1.1
angle_coeff     1 40.0 109.5
angle_coeff     2 25.0 120.0
dihedral_coeff  1 1.2 -0.4 0.3 0.1
improper_coeff  1 12.0 20.0
variable        kb equal 100.0-1.5*step
variable        rb equal 1.05+0.002*step
variable        ka equal 40.0+0.5*step
variable        ta equal (109.5+0.2*step)*PI/180.0
variable        k1 equal 0.6+0.01*step
variable        ci equal 0.35-0.002*step
fix             ad all adapt 2 bond harmonic k 1 v_kb bond harmonic r0 * v_rb angle harmonic k 2 v_ka angle harmonic theta0 1 v_ta dihedral opls k1 1 v_k1 improper harmonic chi0 1 v_ci
velocity        all create 1.0 4928459 mom no rot no
timestep        0.002
fix             1 all nve
thermo_style    custom step pe ebond eangle edihed eimp etotal
thermo_modify   format float %.15g norm no
thermo          5
run             30
