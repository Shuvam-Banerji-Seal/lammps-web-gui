# oracle: ReaxFF nh3 molecule, fixed charges from the data file, 20 NVE steps (real units, dt 0.1), thermo every 5 steps
# oracle-inputs: w55reax_nh3.data
# oracle-potentials: ffield.reax.rdx
# oracle-compare: thermo=all atoms=all rel=1e-12 abs=1e-12
units           real
atom_style      charge
boundary        p p p
read_data       w55reax_nh3.data
pair_style      reaxff NULL checkqeq no
pair_coeff      * * ffield.reax.rdx H C O N
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check no
timestep        0.1
fix             1 all nve
thermo_style    custom step pe ebond evdwl ecoul ke etotal press
thermo_modify   format float %.15g
thermo          5
run             20
