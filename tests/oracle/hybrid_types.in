# oracle: pair_style hybrid with two lj/cut instances, none, mixing within one sub-style, pair_modify tail on one sub-style
units           real
atom_style      atomic
lattice         fcc 5.4
region          box block 0 4 0 4 0 4
create_box      3 box
create_atoms    1 box
group           odd id 1:256:2
group           third id 1:256:3
set             group odd type 2
set             group third type 3
mass            1 39.948
mass            2 83.798
mass            3 20.18
pair_style      hybrid lj/cut 10.0 lj/cut 8.0
pair_coeff      1 1 lj/cut 1 0.238 3.405
pair_coeff      2 2 lj/cut 1 0.32 3.6 9.0
pair_coeff      3 3 lj/cut 2 0.07 2.8
pair_coeff      1 3 lj/cut 2 0.12 3.1
pair_coeff      2 3 none
pair_modify     mix arithmetic
pair_modify     pair lj/cut 1 tail yes
variable        dx atom 0.15*sin(0.31*x+0.27*y)
variable        dy atom 0.15*cos(0.23*y-0.19*z)
variable        dz atom 0.15*sin(0.17*z+0.29*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.004*sin(0.31*x+0.27*y)
variable        vy atom 0.004*cos(0.23*y-0.19*z)
variable        vz atom 0.004*sin(0.17*z+0.29*x)
velocity        all set v_vx v_vy v_vz units box
timestep        2.0
fix             1 all nve
thermo_style    custom step temp pe evdwl etail ke etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          10
run             50
