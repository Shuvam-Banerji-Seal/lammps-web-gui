# oracle: nve/spin lattice frozen on eight periodic spins with spin/exchange (50 steps, pe and compute spin)
# oracle-files: spin_frozen.dump
units           metal
atom_style      spin
boundary        p p p
atom_modify     map array
lattice         sc 2.5
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box
mass            1 55.845
set             atom 1 spin/atom 1.824 -0.698 0.302 0.258
set             atom 2 spin/atom 2.036 -0.269 -0.884 0.606
set             atom 3 spin/atom 1.537 -0.133 -0.86 0.273
set             atom 4 spin/atom 1.925 0.654 -0.752 0.379
set             atom 5 spin/atom 2.127 0.895 0.154 0.517
set             atom 6 spin/atom 2.476 -0.907 0.717 0.432
set             atom 7 spin/atom 1.644 -0.764 -0.383 0.853
set             atom 8 spin/atom 1.681 0.163 0.278 0.498
pair_style      spin/exchange 4.0
pair_coeff      * * exchange 4.0 0.02726 0.2171 1.841 offset yes
fix             1 all nve/spin lattice frozen
timestep        0.001
compute         s all spin
compute         p all property/atom spx spy spz sp fmx fmy fmz
thermo_style    custom step pe c_s[1] c_s[2] c_s[3] c_s[4] c_s[5] c_s[6]
thermo_modify   format float %.15g
thermo          10
run             50
write_dump      all custom spin_frozen.dump id c_p[1] c_p[2] c_p[3] c_p[4] c_p[5] c_p[6] c_p[7] modify format float %.15g
