# oracle: pair_style colloid — colloid-colloid, colloid-solvent and solvent-solvent (d = 0) interactions
units           lj
atom_style      atomic
lattice         sc 0.0029154518950437317
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
lattice         sc 0.0029154518950437317 origin 0.5 0.5 0.5
create_atoms    2 box
mass            1 9.0
mass            2 1.0
variable        dx atom 0.1*sin(1.3*x+0.7*y)
variable        dy atom 0.1*cos(0.9*y-1.1*z)
variable        dz atom 0.1*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.5*sin(0.9*x+0.4*z)
variable        vy atom 0.5*cos(0.6*y+0.8*x)
variable        vz atom 0.5*sin(0.7*z-0.3*y)
velocity        all set v_vx v_vy v_vz units box
velocity        all zero linear
pair_style      colloid 12.0
pair_coeff      1 1 144.0 1.0 5.0 5.0 12.0
pair_coeff      1 2 75.4 1.0 5.0 0.0 8.0
pair_coeff      2 2 39.5 1.0 0.0 0.0 2.5
timestep        0.002
fix             1 all nve
thermo_style    custom step temp pe etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          10
run             50
