# oracle: LJ fluid barostatted by fix press/langevin iso (Gronbech-Jensen and Farago Langevin barostat) with fix nve, temperature ramp 1.2 -> 0.9
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 3.8e-15, atoms 2.2e-13.
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 1.0 87287 loop all
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0 2.5
timestep        0.002
fix             1 all nve
fix             2 all press/langevin iso 0.5 1.5 0.5 temp 1.2 0.9 4321
thermo_style    custom step temp pe press lx ly lz vol
thermo_modify   format float %.15g
thermo          10
run             100
