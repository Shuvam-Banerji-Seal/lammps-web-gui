# oracle: cut-down in.edip-SiC example: pair_style edip/multi (SiC.edip) on the 128-atom SiC data file of the example, 100 steps of nve
# oracle-potentials: SiC.edip
# oracle-inputs: w48pb_data.SiC
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-8
units           metal
boundary        p p p
atom_style      atomic
read_data       w48pb_data.SiC
pair_style      edip/multi
pair_coeff      * * SiC.edip Si C
mass            1 28.085
mass            2 12.001
neighbor        1.0 bin
neigh_modify    delay 1
fix             1 all nve
thermo_style    custom step pe press etotal
thermo_modify   format float %.15g norm no
thermo          10
timestep        0.001
run             100
