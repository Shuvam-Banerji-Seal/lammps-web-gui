# oracle: fix msst state (omega along z, e0, v0, p0) survives write_restart/read_restart: 20 steps, write_restart, clear, read_restart, fix msst re-specified (same ID and style), 20 more steps. Native: built from b332f28 with PKG_SHOCK (installed binary has SHOCK too).
# oracle-compare: thermo=all atoms=all rel=1e-8
units           lj
atom_style      atomic
boundary        p p p
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 0.8 4928 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
timestep        0.002
fix             1 all nve
fix             msst all msst z 1.5 q 10.0 mu 0.5 tscale 0.1
thermo_style    custom step temp pe ke econserve vol lz pzz f_msst f_msst[1] f_msst[2] f_msst[3] f_msst[4]
thermo_modify   format float %.15g
thermo          5
run             20
write_restart   w176rs_msst.restart
clear
read_restart    w176rs_msst.restart
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
fix             1 all nve
fix             msst all msst z 1.5 q 10.0 mu 0.5 tscale 0.1
thermo_style    custom step temp pe ke econserve vol lz pzz f_msst f_msst[1] f_msst[2] f_msst[3] f_msst[4]
thermo_modify   format float %.15g
thermo          5
run             20
