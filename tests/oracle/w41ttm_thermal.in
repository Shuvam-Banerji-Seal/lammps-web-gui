# Wave 41: fix ttm/thermal (docs.lammps.org/fix_ttm.html, section "Additional details for fix ttm/thermal") on an eight-atom
# sc crystal: per-cell C_vol, kappa_e (one zero), gamma_p (one zero), eta (one zero), one empty cell (T_e = 0),
# source 0.05, seed 4242, two runs, the second with a timestep large enough for two diffusion sub-steps (kappa/C_vol = 20 in one cell).
# oracle-inputs: w41ttm_thermal.props w41ttm_thermal.init
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           metal
atom_style      atomic
lattice         sc 3.0
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box
mass            1 10.0
displace_atoms  all move 0.5 0.5 0.5 units box
variable        vx atom 3.0*sin(0.9*x+0.4*y)
variable        vy atom 2.5*cos(0.7*y-0.5*z)
variable        vz atom 2.0*sin(1.1*z+0.3*x)
velocity        all set v_vx v_vy v_vz units box
velocity        all zero linear
pair_style      lj/cut 3.0
pair_coeff      1 1 0.0 2.0
fix             1 all nve
fix             2 all ttm/thermal 4242 w41ttm_thermal.props 2 2 2 infile w41ttm_thermal.init source 0.05 outfile 2 w41ttm_thermal.out
timestep        0.01
thermo_style    custom step temp pe f_2[1] f_2[2]
thermo_modify   format float %.15g
thermo          1
run             4
timestep        0.1
run             3
