# oracle: pair dispersion/d3 zero damping, functional name in upper case (B3-LYP: the zero branch lowercases it)
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 7.8e-13, atoms 2.3e-15.
units           metal
atom_style      atomic
boundary        p p p
lattice         diamond 3.57
region          box block 0 2 0 2 0 2
create_box      2 box
create_atoms    1 box
set             type 1 type/fraction 2 0.25 4127
displace_atoms  all random 0.08 0.08 0.08 9731 units box
mass            1 12.011
mass            2 15.999
pair_style      dispersion/d3 zero B3-LYP 8.5 5.5
pair_coeff      * * c O

velocity        all create 600.0 87287 loop geom
fix             1 all nve
timestep        0.0005
thermo_style    custom step pe ke press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          10
run             60
