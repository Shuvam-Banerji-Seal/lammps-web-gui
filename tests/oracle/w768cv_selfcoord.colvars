# Colvars configuration of tests/oracle/w768cv_selfcoord.in
colvarsTrajFrequency 5
colvarsRestartFrequency 20

colvar {
  name sc
  selfCoordNum {
    group1 { atomNumbersRange 1-25 }
    cutoff 1.4
  }
}

colvar {
  name scp
  selfCoordNum {
    group1 { atomNumbersRange 120-150 }
    cutoff 1.3
    expNumer 8
    expDenom 16
    tolerance 0.002
    pairListFrequency 4
  }
}

colvar {
  name gc
  groupCoord {
    group1 { atomNumbers 200 201 202 }
    group2 { atomNumbersRange 210-214 }
    cutoff 2.5
  }
}

harmonic {
  colvars sc gc
  centers 62.0 0.8
  forceConstant 0.05
  outputEnergy on
}

harmonicWalls {
  colvars scp
  upperWalls 52.0
  forceConstant 0.1
}
