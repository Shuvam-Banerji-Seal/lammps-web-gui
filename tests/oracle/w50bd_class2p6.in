# oracle: angle_style class2/p6 on a 4-atom chain (bond harmonic, improper harmonic), run 0
# oracle-inputs: w50bd_mol.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-8
units           real
atom_style      molecular
read_data       w50bd_mol.data
bond_style      harmonic
bond_coeff      1 300 1.0
bond_coeff      2 300 1.2
angle_style     class2/p6
angle_coeff     1 110.0 40.0 -5.0 2.0 -0.5 0.1
angle_coeff     1 bb 0.0 1.0 1.0
angle_coeff     1 ba 0.0 0.0 1.0 1.0
angle_coeff     2 100.0 35.0 3.0 -1.0 0.4 -0.05
angle_coeff     2 bb 1.0 1.0 1.2
angle_coeff     2 ba 0.5 -0.3 1.0 1.2
improper_style  harmonic
improper_coeff  1 10.0 0.0
pair_style      zero 3.0
pair_coeff      * *
thermo_style    custom step pe eangle ebond eimp evdwl etotal press
thermo_modify   format float %.15g
run             0
