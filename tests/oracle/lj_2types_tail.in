# oracle: two types, arithmetic mixing, per-pair cutoff, shifted energies, real units, tail correction
units           real
atom_style      atomic
lattice         fcc 5.4
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
set             type 1 type/fraction 2 0.0 12345
group           odd id 1:256:2
set             group odd type 2
mass            1 39.948
mass            2 83.798
pair_style      lj/cut 10.0
pair_coeff      1 1 0.238 3.405
pair_coeff      2 2 0.32 3.6 9.0
pair_modify     mix arithmetic tail yes
variable        vx atom 0.004*sin(0.31*x+0.27*y)
variable        vy atom 0.004*cos(0.23*y-0.19*z)
variable        vz atom 0.004*sin(0.17*z+0.29*x)
velocity        all set v_vx v_vy v_vz units box
timestep        2.0
fix             1 all nve
thermo_style    custom step temp pe evdwl etail ke etotal press enthalpy density vol
thermo_modify   format float %.15g
thermo          5
run             50
