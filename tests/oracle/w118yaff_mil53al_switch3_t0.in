# oracle: YAFF MIL-53(Al) with lj/switch3/coulgauss/long, pair_modify table 0 (direct erfc polynomial), special_bonds lj 0.0 0.5 1.0 and coul 0.0 0.5 1.0 (weights on the Gaussian and switched terms), pppm 1e-7, NVE, 40 steps.
# measured 2026-10-13 (engine vs native, max relative error per value, no absolute floor): thermo 2.2e-10, per-atom 4.8e-9; the compare passes at rel 1e-8 abs 1e-10.
# oracle-inputs: w118yaff_mil53al.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           real
atom_style      full
boundary        p p p
dielectric      1
special_bonds   lj 0.0 0.5 1.0 coul 0.0 0.5 1.0
pair_style      lj/switch3/coulgauss/long 12.0000 4.0000
pair_modify     table 0
pair_modify     mix arithmetic
pair_modify     tail no
bond_style      harmonic
angle_style     hybrid cosine/periodic cross harmonic cosine/squared
dihedral_style  fourier
improper_style  distharm
read_data       w118yaff_mil53al.data
kspace_style    pppm 0.0000001
neighbor        2.0 bin
neigh_modify    every 2 delay 4 check yes
timestep        0.5
velocity        all create 0.0 5
fix             1 all nve
thermo_style    custom step etotal ke temp pe evdwl ecoul elong etail press
thermo_modify   format float %.15g norm no
thermo          10
run             40
