# oracle: change_box without remap leaves atoms outside a fixed boundary; thermo_modify lost ignore deletes them
# oracle-inputs: w40core_cb.data
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           lj
atom_style      atomic
boundary        f p p
read_data       w40core_cb.data
pair_style      lj/cut 2.5
pair_coeff      * * 0.1 1.0
thermo_style    custom step pe atoms
thermo_modify   format float %.15g lost ignore
change_box      all x final 0 5
run             0
