# oracle: compute mliap model quadratic with descriptor sna (2 types, twojmax 2), gradgradflag 0, selected array rows through thermo, pair zbl reference
# oracle-inputs: w16mliap_compute.mliap.descriptor
# oracle-compare: thermo=first
units           metal
atom_style      atomic
lattice         bcc 3.0
region          box block 0 1 0 1 0 1
create_box      2 box
create_atoms    1 box
group           odd id 1:2:2
set             group odd type 2
mass            * 50.0
variable        dx atom 0.05*sin(1.3*x+0.7*y)
variable        dy atom 0.05*cos(0.9*y-1.1*z)
variable        dz atom 0.05*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
pair_style      zbl 4 4.8
pair_coeff      * * 73 73
compute g all mliap model quadratic descriptor sna w16mliap_compute.mliap.descriptor gradgradflag 0
thermo_style    custom step step pe c_g[1][1] c_g[1][2] c_g[1][3] c_g[1][4] c_g[1][5] c_g[1][6] c_g[1][7] c_g[1][8] c_g[1][9] c_g[1][10] c_g[1][11] c_g[1][12] c_g[1][13] c_g[1][14] c_g[1][15] c_g[1][16] c_g[1][17] c_g[1][18] c_g[1][19] c_g[1][20] c_g[1][21] c_g[1][22] c_g[1][23] c_g[1][24] c_g[1][25] c_g[1][26] c_g[1][27] c_g[1][28] c_g[1][29] c_g[1][30] c_g[1][31] c_g[1][32] c_g[1][33] c_g[1][34] c_g[1][35] c_g[1][36] c_g[1][37] c_g[1][38] c_g[1][39] c_g[1][40] c_g[1][41] c_g[1][42] c_g[1][43] c_g[2][1] c_g[2][2] c_g[2][3] c_g[2][4] c_g[2][5] c_g[2][6] c_g[2][7] c_g[2][8] c_g[2][9] c_g[2][10] c_g[2][11] c_g[2][12] c_g[2][13] c_g[2][14] c_g[2][15] c_g[2][16] c_g[2][17] c_g[2][18] c_g[2][19] c_g[2][20] c_g[2][21] c_g[2][22] c_g[2][23] c_g[2][24] c_g[2][25] c_g[2][26] c_g[2][27] c_g[2][28] c_g[2][29] c_g[2][30] c_g[2][31] c_g[2][32] c_g[2][33] c_g[2][34] c_g[2][35] c_g[2][36] c_g[2][37] c_g[2][38] c_g[2][39] c_g[2][40] c_g[2][41] c_g[2][42] c_g[2][43] c_g[5][1] c_g[5][2] c_g[5][3] c_g[5][4] c_g[5][5] c_g[5][6] c_g[5][7] c_g[5][8] c_g[5][9] c_g[5][10] c_g[5][11] c_g[5][12] c_g[5][13] c_g[5][14] c_g[5][15] c_g[5][16] c_g[5][17] c_g[5][18] c_g[5][19] c_g[5][20] c_g[5][21] c_g[5][22] c_g[5][23] c_g[5][24] c_g[5][25] c_g[5][26] c_g[5][27] c_g[5][28] c_g[5][29] c_g[5][30] c_g[5][31] c_g[5][32] c_g[5][33] c_g[5][34] c_g[5][35] c_g[5][36] c_g[5][37] c_g[5][38] c_g[5][39] c_g[5][40] c_g[5][41] c_g[5][42] c_g[5][43] c_g[8][1] c_g[8][2] c_g[8][3] c_g[8][4] c_g[8][5] c_g[8][6] c_g[8][7] c_g[8][8] c_g[8][9] c_g[8][10] c_g[8][11] c_g[8][12] c_g[8][13] c_g[8][14] c_g[8][15] c_g[8][16] c_g[8][17] c_g[8][18] c_g[8][19] c_g[8][20] c_g[8][21] c_g[8][22] c_g[8][23] c_g[8][24] c_g[8][25] c_g[8][26] c_g[8][27] c_g[8][28] c_g[8][29] c_g[8][30] c_g[8][31] c_g[8][32] c_g[8][33] c_g[8][34] c_g[8][35] c_g[8][36] c_g[8][37] c_g[8][38] c_g[8][39] c_g[8][40] c_g[8][41] c_g[8][42] c_g[8][43] c_g[11][1] c_g[11][2] c_g[11][3] c_g[11][4] c_g[11][5] c_g[11][6] c_g[11][7] c_g[11][8] c_g[11][9] c_g[11][1