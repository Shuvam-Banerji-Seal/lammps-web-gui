# oracle: pair_style polymorphic with GaN_sw.poly (eta 0, Ga N), diamond lattice, displaced, velocity create, 100 steps of nve
# oracle-potentials: GaN_sw.poly
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 2.6e-13, atoms 6.0e-13.
units           metal
atom_style      atomic
lattice         diamond 4.5
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
group           odd id 1:216:2
set             group odd type 2
mass            1 69.72
mass            2 14.007
variable        dx atom 0.05*sin(1.3*x+0.7*y)
variable        dy atom 0.05*cos(0.9*y-0.4*z)
variable        dz atom 0.05*sin(1.1*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
velocity        all create 300.0 4928459
pair_style      polymorphic
pair_coeff      * * GaN_sw.poly Ga N
timestep        0.001
fix             1 all nve
thermo_style    custom step pe ke press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g norm no
thermo          20
run             100
