# oracle: pair_style harmonic/cut on a two-type fcc lattice, geometric k/rc mixing, NVE 50 steps
units           lj
atom_style      atomic
boundary        p p p
lattice         fcc 1.0
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
group           odd id 1:2:2
set             group odd type 2
mass            * 1.0
pair_style      harmonic/cut
pair_coeff      1 1 5.0 1.3
pair_coeff      2 2 2.0 1.2
variable        dx atom 0.05*sin(0.9*x+0.4*y)
variable        dy atom 0.05*cos(0.7*y-0.5*z)
variable        dz atom 0.05*sin(1.1*z+0.3*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 1.0*sin(0.5*x+0.2*z)
variable        vy atom 1.0*cos(0.4*y+0.6*x)
variable        vz atom 1.0*sin(0.3*z-0.5*y)
velocity        all set v_vx v_vy v_vz units box
velocity        all zero linear
timestep        0.004
fix             1 all nve
thermo_style    custom step temp pe press pxx
thermo_modify   format float %.15g
thermo          10
run             50
