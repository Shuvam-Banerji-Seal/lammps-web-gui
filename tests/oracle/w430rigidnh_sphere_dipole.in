# oracle: fix rigid/nvt with bodies of finite-size dipolar spheres (atom_style hybrid sphere dipole): the spheres add 0.4 m r^2 to the body inertia and their spin to its angular momentum, the dipole torques of pair lj/cut/dipole/cut act on the bodies, and the spheres' omega and dipoles follow the bodies
# oracle-compare: thermo=all atoms=all
units           lj
atom_style      hybrid sphere dipole
lattice         sc 0.5
region          box block 0 6 0 6 0 6
create_box      2 box
create_atoms    1 box
set             type 1 diameter 0.9
set             type 1 density 1.5
set             group all dipole/random 4721 0.8
region          b1 block 0 2.9 0 2.9 0 2.9
region          b2 block 3 5.9 0 2.9 0 2.9
region          b3 block 0 2.9 3 5.9 0 2.9
region          b4 block 3 5.9 3 5.9 3 5.9
group           g1 region b1
group           g2 region b2
group           g3 region b3
group           g4 region b4
group           rig union g1 g2 g3 g4
group           free subtract all rig
velocity        all create 1.2 8812 loop geom
set             group all omega 0.3 -0.2 0.1
pair_style      lj/cut/dipole/cut 2.5
pair_coeff      * * 1.0 1.0
neigh_modify    exclude group g1 g1 exclude group g2 g2 exclude group g3 g3 exclude group g4 g4
fix             1 rig rigid/nvt group 4 g1 g2 g3 g4 temp 1.0 1.0 1.0
fix             2 free nve/sphere update dipole
compute         om all property/atom omegax omegay omegaz mux muy muz
compute         rs rig reduce sum c_om[*]
thermo_style    custom step temp pe f_1 c_rs[1] c_rs[2] c_rs[3] c_rs[4] c_rs[5] c_rs[6]
thermo_modify   format float %.15g
thermo          10
run             60
