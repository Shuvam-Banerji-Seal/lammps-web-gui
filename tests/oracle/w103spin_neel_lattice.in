# oracle: hybrid/overlay spin/exchange + spin/neel (bcc iron 4x4x4 cells, 128 random spins, nve/spin lattice moving: mechanical neel force, 20 steps)
# measured with native LAMMPS (black box), engine vs native fixture: thermo max relative error 1.3e-10; atoms 4.9e-12; spin dump 4.6e-7 (the file compare is 1e-6); re-measured under Node 20: the same.
# oracle-files: w103spin_neel_lattice.dump
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           metal
atom_style      spin
boundary        p p p
atom_modify     map array
lattice         bcc 2.8665
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
mass            1 55.845
set             group all spin/atom/random 31 2.2
displace_atoms  all random 0.02 0.02 0.02 4928459 units box
velocity        all create 100 4928459 rot yes dist gaussian
pair_style      hybrid/overlay spin/exchange 4.0 spin/neel 4.0
pair_coeff      * * spin/exchange exchange 4.0 0.02726 0.2171 1.841
pair_coeff      * * spin/neel neel 4.0 0.02 0.3 1.841 0.05 0.2 1.2
neighbor        0.1 bin
neigh_modify    every 10 check yes delay 20
fix             1 all precession/spin zeeman 0.001 0.0 0.0 1.0
fix_modify      1 energy yes
fix             2 all nve/spin lattice moving
timestep        0.0001
compute         s all spin
compute         p all property/atom spx spy spz sp fmx fmy fmz
thermo_style    custom step pe c_s[1] c_s[2] c_s[3] c_s[4] c_s[5] c_s[6]
thermo_modify   format float %.15g
thermo          10
run             20
write_dump      all custom w103spin_neel_lattice.dump id c_p[1] c_p[2] c_p[3] c_p[4] c_p[5] c_p[6] c_p[7] modify format float %.15g sort id
