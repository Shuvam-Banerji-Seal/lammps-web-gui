# oracle: fix wall/region on a sphere (side in, lj93): global energy and wall force vector; group = atoms inside
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      atomic
boundary        p p p
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
mass            1 1.0
region          sph sphere 2.52 2.52 2.52 2.2 side in units box
group           inside region sph
set             group inside type 2
mass            2 1.3
variable        dx atom 0.04*sin(1.3*x+0.7*y)
variable        dy atom 0.04*cos(0.9*y-1.1*z)
variable        dz atom 0.04*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.3*sin(0.9*x+0.4*z)
variable        vy atom 0.3*cos(0.6*y+0.8*x)
variable        vz atom 0.3*sin(0.7*z-0.3*y)
velocity        all set v_vx v_vy v_vz units box
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
pair_coeff      2 2 0.8 1.05 2.5
pair_coeff      1 2 0.9 1.0 2.5
timestep        0.002
fix             1 all nve
fix             2 inside wall/region sph lj93 0.1 0.3 2.5
fix_modify      2 energy yes
thermo_style    custom step temp pe etotal press f_2 f_2[1] f_2[2] f_2[3]
thermo_modify   format float %.15g
thermo          5
run             20
