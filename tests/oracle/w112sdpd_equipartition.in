# oracle: pair sdpd/taitwater/isothermal (random thermal forces) cut down from examples/PACKAGES/dpd-smooth/equipartition-verification/in.lammps: a 6x6x6 simple-cubic block of water-like SPH particles (216 atoms, box -0.3..0.3) instead of 8000 atoms, 20 steps; thermo and per-atom state compared
# measured max error vs native (per atom, relative to max(1,|value|)): 1.1e-16 (atom 97 vz), the random thermal forces included; thermo agrees at 1e-8.
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
dimension       3
units           micro
atom_style      sph
variable        a equal 0.1
variable        L equal 0.3
variable        T equal 300.
variable        rho_0 equal 1.
variable        c_0 equal 10.
variable        mu equal 1.
variable        h equal $a*4.0
variable        mass equal $a*$a*$a*${rho_0}
variable        dt equal 5e-4
variable        skin equal 0.1*$h
region          box block -$L $L -$L $L -$L $L units box
create_box      1 box
lattice         sc $a
create_atoms    1 box
mass            * ${mass}
set             group all sph/rho ${rho_0}
pair_style      sdpd/taitwater/isothermal $T ${mu} 76787
pair_coeff      * * ${rho_0} ${c_0} ${h}
fix             1 all sph
neighbor        ${skin} bin
timestep        ${dt}
thermo_style    custom step time pe ke etotal
thermo_modify   format float %.15g
thermo          5
run             20
