# oracle: pair_style edip/multi (SiC.edip) on a displaced zincblende SiC 2x2x2 cell, 100 steps of nve from variable velocities
# oracle-potentials: SiC.edip
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-8
units           metal
atom_style      atomic
lattice         fcc 4.36
region          box block 0 2 0 2 0 2
create_box      2 box
create_atoms    1 box
lattice         fcc 4.36 origin 0.25 0.25 0.25
create_atoms    2 box
mass            1 28.085
mass            2 12.001
variable        dx atom 0.04*sin(1.3*x+0.7*y)
variable        dy atom 0.04*cos(0.9*y-0.4*z)
variable        dz atom 0.04*sin(1.1*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.01*sin(id)
variable        vy atom 0.01*cos(2*id)
variable        vz atom 0.01*sin(3*id)
velocity        all set v_vx v_vy v_vz
pair_style      edip/multi
pair_coeff      * * SiC.edip Si C
timestep        0.001
neigh_modify    every 1 delay 10 check yes
thermo_style    custom step pe press etotal
thermo_modify   format float %.15g norm no
thermo          10
fix             1 all nve
run             100
