# oracle: pair_style lj/long/coul/long long off 2.5 with pair_modify mix arithmetic and kspace pppm/disp (arithmetic dispersion mixing, 7 structure factors, fixed gewald/disp, mesh/disp, order/disp), NVE 10 steps, 108 displaced fcc atoms, 2 types
# Measured with native LAMMPS (b332f28 binary): thermo and per-atom forces agree to 1e-12 relative (abs 0); 1e-13 fails only on the pyz component at step 10 (2e-14 absolute).
# oracle-inputs: w161pd_fcc.data
# native: /home/roy/.local/bin/lmp (b332f28, KSPACE package with pppm/disp, unmodified)
units           lj
atom_style      charge
read_data       w161pd_fcc.data
pair_style      lj/long/coul/long long off 2.5
pair_modify     table 0 table/disp 0 mix arithmetic
pair_coeff      1 1 1.0 1.0
pair_coeff      2 2 0.5 1.1
kspace_style    pppm/disp 1.0e-4
kspace_modify   gewald/disp 0.5 mesh/disp 12 12 12 order/disp 5
timestep        0.005
fix             1 all nve
thermo_style    custom step temp pe evdwl elong ecoul press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          5
run             10
