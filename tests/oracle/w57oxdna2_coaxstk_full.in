# oracle: oxDNA2 full set on the oxDNA2 duplex2 example (hybrid/overlay oxdna2/excv oxdna2/stk oxdna2/hbond oxdna2/xstk oxdna2/coaxstk oxdna2/dh, seqav, dh with T 0.1, salt 0.2, qeff 0.815 and half_charged_ends yes); the example's coefficients; FENE oxdna2/fene; lj units, fix nve/asphere, 200 steps at timestep 1e-4
# oracle-inputs: w57oxdna2_duplex2.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-12
units           lj
dimension       3
newton          on
boundary        p p p
atom_style      hybrid bond ellipsoid oxdna
atom_modify     sort 0 1.0
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
read_data       w57oxdna2_duplex2.data
set             atom * mass 3.1575
change_box      all x scale 0.85 y scale 0.85 z scale 0.85 remap
bond_style      oxdna2/fene
bond_coeff      * 2.0 0.25 0.7564
special_bonds   lj 0 1 1
pair_style      hybrid/overlay oxdna2/excv oxdna2/stk oxdna2/hbond oxdna2/xstk oxdna2/coaxstk oxdna2/dh
pair_coeff      * * oxdna2/excv 2.0 0.7 0.675 2.0 0.515 0.5 2.0 0.33 0.32
pair_coeff      * * oxdna2/stk seqav 0.1 1.3523 2.6717 6.0 0.4 0.9 0.32 0.75 1.3 0 0.8 0.9 0 0.95 0.9 0 0.95 2.0 0.65 2.0 0.65
pair_coeff      * * oxdna2/hbond seqav 0.0 8.0 0.4 0.75 0.34 0.7 1.5 0 0.7 1.5 0 0.7 1.5 0 0.7 0.46 3.141592653589793 0.7 4.0 1.5707963267948966 0.45 4.0 1.5707963267948966 0.45
pair_coeff      1 4 oxdna2/hbond seqav 1.0678 8.0 0.4 0.75 0.34 0.7 1.5 0 0.7 1.5 0 0.7 1.5 0 0.7 0.46 3.141592653589793 0.7 4.0 1.5707963267948966 0.45 4.0 1.5707963267948966 0.45
pair_coeff      2 3 oxdna2/hbond seqav 1.0678 8.0 0.4 0.75 0.34 0.7 1.5 0 0.7 1.5 0 0.7 1.5 0 0.7 0.46 3.141592653589793 0.7 4.0 1.5707963267948966 0.45 4.0 1.5707963267948966 0.45
pair_coeff      * * oxdna2/xstk 47.5 0.575 0.675 0.495 0.655 2.25 0.791592653589793 0.58 1.7 1.0 0.68 1.7 1.0 0.68 1.5 0 0.65 1.7 0.875 0.68 1.7 0.875 0.68
pair_coeff      * * oxdna2/coaxstk 58.5 0.4 0.6 0.22 0.58 2.0 2.891592653589793 0.65 1.3 0 0.8 0.9 0 0.95 0.9 0 0.95 40.0 3.116592653589793
pair_coeff      * * oxdna2/dh 0.1 0.2 0.815 half_charged_ends yes
fix             1 all nve/asphere
timestep        1e-4
thermo_style    custom step temp pe ebond evdwl ke etotal
thermo_modify   format float %.15g
thermo          20
run             200
