# oracle: fix phonon on the 8x8x8 FCC copper cell of examples/PACKAGES/phonon/3-3D-FCC-Cu-EAM (b332f28, GPL-2.0): EAM, npt (iso,
# Native reference: LAMMPS b332f28 built from source with PKG_KSPACE MANYBODY MISC MOLECULE PHONON QEQ QTB REAXFF SHOCK, because the installed binary has no QTB (cmake -D PKG_<name>=on for each; then LMP=<build>/lmp run-oracle.mjs)
# pchain 8 drag 1), a triclinic cell; cut down: 3000 steps, measurements every 10 steps after 1000 wait steps, output every 100
# measurements. The restart files, the phana inputs and the binary file of the example are not part of this case.
# oracle-inputs: w99phq_cu_data.pos w99phq_cuu3.eam w99phq_cu.map
# oracle-files: w99phq_cu.log
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# measured (engine vs native, Node 24): thermo within 9.7e-11 relative, per-atom within 3.2e-11; the log's basis-vector lines within 1e-15 relative
boundary    p p p
units       metal
atom_style  atomic
read_data	w99phq_cu_data.pos
pair_style  	eam/opt
pair_coeff   	* * w99phq_cuu3.eam
neighbor       0.5 nsq
neigh_modify   every 1 delay 0 check yes
variable r equal 57085
variable t equal 300
variable d equal 1
velocity all create $t 28459 rot yes dist gaussian mom yes
reset_timestep 0
fix      1 all npt temp $t $t $d iso 1. 1. 1. pchain 8 drag 1.0
fix      2 all phonon 10 100 1000 w99phq_cu.map w99phq_cu nasr 20
timestep 2e-3
thermo_style  custom step temp pe ke press vol lx ly lz xy xz yz
thermo_modify format float %.15g
thermo  100
run 	 3000
