# oracle: fix propel/self dipole 4.0 (virial on by default) with brownian/sphere (projection, 2d); pressure includes the propel virial
# oracle-compare: thermo=all atoms=all
dimension       2
units           lj
atom_style      hybrid dipole sphere
boundary        p p p
lattice         sq 0.4
region          box block 0 6 0 6 -0.2 0.2
create_box      1 box
create_atoms    1 box
mass            * 1.0
set             type * dipole/random 1974 1.0
velocity        all create 1.0 1 loop geom
pair_style      none
fix             1 all brownian/sphere 1.0 1974 gamma_t 1.0 gamma_r 1.0
fix             2 all propel/self dipole 4.0
compute         press all pressure NULL virial
thermo_style    custom step ke pe c_press
thermo_modify   format float %.15g
timestep        0.00001
thermo          50
run             200
