# oracle: fix grem on top of fix npt iso (GPL port of REPLICA/fix_grem.cpp and PRESSURE/GREM), single replica, 500-atom lj liquid of examples/PACKAGES/grem/lj-single
# oracle-measured: thermo max rel 9.7e-11 (press, abs 4.7e-10), per-atom max rel 1.8e-9 (vz), forces max rel 2.2e-9 (fy). The pressure kinetic term uses the barostat-stored kinetic tensor (see compute_pressure_grem.ts)
# oracle-inputs: grem_lj.data
# oracle-compare: rel=1e-8 abs=1e-10
units           real
atom_style      full
pair_style      lj/cut 5.0
read_data       grem_lj.data
timestep        1.0
thermo_style    custom step temp pe etotal press vol
thermo_modify   format float %.15g
thermo          10
fix             fxnpt all npt temp 300.0 300.0 1000.0 iso 0.0 0.0 10000.0
fix             fxgREM all grem 400 -.01 -30000 fxnpt
thermo_modify   press fxgREM_press
run             1000
