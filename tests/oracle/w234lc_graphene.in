# oracle: pair_style lcbop - graphene sheet 8x8 rectangular cells (256 atoms), random displacement 0.05 A, 50 NVE steps
# oracle-potentials: C.lcbop
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 1.8e-12, atoms 1.0e-12.
units           metal
atom_style      atomic
boundary        p p p
lattice         custom 2.46 a1 1 0 0 a2 0 1.7320508 0 a3 0 0 6.1 &
                basis 0 0 0 basis 0.5 0.5 0 basis 0.5 0.1666667 0 basis 0 0.6666667 0
region          box block 0 8 0 8 0 1
create_box      1 box
create_atoms    1 box
displace_atoms  all random 0.05 0.05 0.05 4711 units box
mass            1 12.011
pair_style      lcbop
pair_coeff      * * C.lcbop C
thermo_style    custom step pe ke press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
timestep        0.0005
velocity        all create 300.0 761341 loop all
fix             1 all nve
thermo          10
run             50
