# oracle: bond, angle, dihedral and improper hybrid styles with two sub-styles each, input-script coefficients (wildcard ranges, override by a later line), an improper none type, compute bond/angle/dihedral/improper vectors, 50 nve steps
# oracle-inputs: w21bhyb_chains.data
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           lj
atom_style      molecular
read_data       w21bhyb_chains.data
pair_style      lj/cut 2.5
pair_coeff      * * 0.5 0.9
pair_coeff      1 3 0.8 1.0
bond_style      hybrid harmonic morse
bond_coeff      1 harmonic 120.0 1.05
bond_coeff      * morse 1.0 2.0 1.1
bond_coeff      1 harmonic 120.0 1.05
angle_style     hybrid harmonic cosine
angle_coeff     * harmonic 40.0 109.5
angle_coeff     2 cosine 25.0
dihedral_style  hybrid harmonic zero
dihedral_coeff  1 harmonic 1.5 -1 3
dihedral_coeff  2 zero
improper_style  hybrid harmonic
improper_coeff  1 harmonic 12.0 20.0
improper_coeff  2 none
special_bonds   lj 0.0 0.5 0.8
timestep        0.002
fix             1 all nve
compute         cb all bond
compute         ca all angle
compute         cd all dihedral
compute         ci all improper
thermo_style    custom step temp pe ebond eangle edihed eimp evdwl etotal press c_cb[1] c_cb[2] c_ca[1] c_ca[2] c_cd[1] c_cd[2] c_ci[1]
thermo_modify   format float %.15g norm no
thermo          10
run             50
