# oracle: improper_style inversion/harmonic (K 10, omega0 20 degrees) on a 4-atom chain, 50 NVE steps
# oracle-inputs: w50bd_mol.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-8
units           real
atom_style      molecular
read_data       w50bd_mol.data
bond_style      harmonic
bond_coeff      1 300 1.0
bond_coeff      2 300 1.2
angle_style     harmonic
angle_coeff     1 50.0 110.0
angle_coeff     2 40.0 100.0
improper_style  inversion/harmonic
improper_coeff  1 10.0 20.0
pair_style      zero 3.0
pair_coeff      * *
thermo_style    custom step pe ebond eangle eimp evdwl etotal press
thermo_modify   format float %.15g
timestep        0.5
velocity        all set 0.3 -0.2 0.1 units box
fix             1 all nve
thermo          10
run             50
