# oracle: fix adapt on eam/alloy scale (native extract() "scale": the pair term of a type pair and the embedding energy of a type, scale[t][t]), the 1-1 and 1-2 pairs ramped every 4 steps, then reset no keeps the last values for the next run
# oracle-potentials: CuNi.eam.alloy
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=1e-10
units           metal
atom_style      atomic
lattice         fcc 3.6
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
set             group all type/fraction 2 0.4 4321
pair_style      eam/alloy
pair_coeff      * * CuNi.eam.alloy Cu Ni
velocity        all create 800.0 87287 loop geom
variable        a equal 1.0-0.001*elapsed
variable        b equal 1.0+0.002*elapsed
fix             1 all nve
fix             2 all adapt 4 pair eam/alloy scale 1 1 v_a pair eam/alloy scale 1 2 v_b
timestep        0.002
thermo_style    custom step temp pe press pxy
thermo_modify   format float %.15g
thermo          10
run             40
run             20
