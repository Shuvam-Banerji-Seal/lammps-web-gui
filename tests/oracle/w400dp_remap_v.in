# oracle: fix deform/pressure x erate 0.05 with y pressure/mean 0.5 0.1 and remap v (atoms crossing a y boundary get the pressure-controlled boundary velocity), fix nve, compute temp/deform
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# Measured with native LAMMPS: engine vs native thermo 4.9e-13, atoms 7.0e-12.
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 4 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 1.44 87287 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
timestep        0.005
fix             1 all nve
fix             2 all deform/pressure 1 x erate 0.05 y pressure/mean 0.5 0.1 remap v
compute         tdef all temp/deform
thermo_style    custom step temp c_tdef press lx ly lz vol
thermo_modify   format float %.15g
thermo          20
run             300
