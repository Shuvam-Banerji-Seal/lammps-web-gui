# oracle: compute stress/mop (x center kin conf; z lower total; y 0.8 with a half group, pair kin) on a periodic lj fcc liquid, sampled every step from the setup evaluation (step 0) through 10 nve steps through fix ave/time mode vector
# oracle-compare: thermo=all atoms=none rel=1e-8 abs=1e-10 filerel=1e-8
# oracle-files: w149cp_mop_setup.out w149cp_mop_setup_z.out
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
mass            1 1.0
variable        dxa atom 0.05*sin(2.3*y+0.4*z)
variable        dya atom 0.04*cos(1.7*z)
variable        dza atom 0.03*sin(1.3*z+0.5)
displace_atoms  all move v_dxa v_dya v_dza units box
variable        vxa atom 0.7*sin(2.3*y+0.4*z)+0.3*cos(1.1*x)
variable        vya atom 0.6*cos(1.7*z-0.9*x)
variable        vza atom 0.5*sin(1.3*x+0.8*y)
velocity        all set v_vxa v_vya v_vza units box
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0
fix             1 all nve
group           half id 1:128
compute         m1 all stress/mop x center kin conf
compute         m2 all stress/mop z lower total
compute         m3 half stress/mop y 0.8 pair kin
fix             f all ave/time 1 1 1 c_m1 c_m3 mode vector file w149cp_mop_setup.out format " %.15g"
fix             g all ave/time 1 1 1 c_m2 mode vector file w149cp_mop_setup_z.out format " %.15g"
thermo_style    custom step
thermo          10
run             10
