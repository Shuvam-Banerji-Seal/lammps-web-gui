# oracle: compute com/chunk with wrap yes on molecules with unwrapped centres outside a triclinic periodic box (xy tilt 3), and wrap no for comparison, run 0
# oracle-inputs: w39cfs_wrap_tri.data
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           lj
atom_style      molecular
read_data       w39cfs_wrap_tri.data
pair_style      lj/cut 2.5
pair_coeff      1 1 0.1 1.0
compute         cc all chunk/atom molecule compress no
compute         c0 all com/chunk cc
compute         c1 all com/chunk cc wrap yes
thermo_style    custom step c_c0[1][1] c_c0[1][2] c_c0[1][3] c_c0[2][1] c_c0[2][2] c_c0[2][3] c_c0[3][1] c_c0[3][2] c_c0[3][3] c_c0[4][1] c_c0[4][2] c_c0[4][3] c_c1[1][1] c_c1[1][2] c_c1[1][3] c_c1[2][1] c_c1[2][2] c_c1[2][3] c_c1[3][1] c_c1[3][2] c_c1[3][3] c_c1[4][1] c_c1[4][2] c_c1[4][3]
thermo_modify   format float %.15g norm no
run             0
