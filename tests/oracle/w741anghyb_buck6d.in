# oracle: angle_style hybrid with a cosine/buck6d sub-style. Native's cosine/buck6d tallies the 1-3 buck6d vdW
#   through force->pair->ev_tally into the pair's evdwl (src/MOFFF/angle_cosine_buck6d.cpp at b332f28), outside the
#   hybrid's sum of its sub-styles' own energy (src/angle_hybrid.cpp); the engine's hybrid dropped it
#   (examples/PACKAGES/mofff/in.hkust1: E_vdwl 31.68 against native 125.73, forces and pressure equal).
# oracle-inputs: w13dihcharmm_chains.data
# oracle-compare: thermo=all rel=1e-9 abs=1e-10
units           real
atom_style      full
read_data       w13dihcharmm_chains.data
special_bonds   lj 0.0 0.0 1.0 coul 1.0 1.0 1.0
bond_style      harmonic
bond_coeff      1 300.0 1.5
angle_style     hybrid cosine/buck6d
angle_coeff     1 cosine/buck6d 1.97835 4 180.0
dihedral_style  zero
dihedral_coeff  * 
pair_style      buck6d/coul/gauss/dsf 0.9 9.0
pair_coeff      1 1 10304 3.0612245 457.17971 4.5218516 0.60800971
pair_coeff      1 2 6157.8178 3.4682081 129.19572 0.78772886 0.73006542
pair_coeff      1 3 10576.399 3.1746032 377.27092 2.7176691 0.61999948
pair_coeff      2 2 3680 4 32.805 0.10690769 0.9771554
pair_coeff      2 3 6320.6076 3.6144578 103.50278 0.44181916 0.75109952
pair_coeff      3 3 10856 3.2967033 308.7755 1.6022517 0.63272774
timestep        0.5
velocity        all create 300.0 4928459 units box
fix             1 all nve
thermo_style    custom step temp pe eangle evdwl ecoul press
thermo_modify   format float %.15g
thermo          10
run             50
