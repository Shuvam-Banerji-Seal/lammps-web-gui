# oracle: ReaxFF water molecule (H, O) with the CHO force field (ffield.reax.cho), fixed charges, 20 NVE steps (real units, dt 0.1), thermo every 5 steps
# oracle-inputs: w55reax_water.data
# oracle-potentials: ffield.reax.cho
# oracle-compare: thermo=all atoms=all rel=1e-12 abs=1e-12
units           real
atom_style      charge
boundary        p p p
read_data       w55reax_water.data
pair_style      reaxff NULL checkqeq no
pair_coeff      * * ffield.reax.cho H O
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check no
timestep        0.1
fix             1 all nve
thermo_style    custom step pe ebond evdwl ecoul ke etotal press
thermo_modify   format float %.15g
thermo          5
run             20
