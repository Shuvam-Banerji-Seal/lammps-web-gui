# oracle: pair_style mliap model linear descriptor so3 with the Ni-Mo example potential (Mo Ni), 2x2x2 fcc, displaced, 20 NVE steps
# oracle-potentials: Ni_Mo.mliap.descriptor Ni_Mo.mliap.model
# oracle-compare: thermo=all atoms=all rel=1e-8
units           metal
atom_style      atomic
boundary        p p p
lattice         fcc 3.52
region          box block 0 2 0 2 0 2
create_box      2 box
create_atoms    1 box
group           odd id 1:32:2
set             group odd type 2
mass            1 58.69
mass            2 95.95
variable        dx atom 0.05*sin(1.3*x+0.7*y)
variable        dy atom 0.05*cos(0.9*y-1.1*z)
variable        dz atom 0.05*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
velocity        all create 300.0 4928459
pair_style      mliap model linear Ni_Mo.mliap.model descriptor so3 Ni_Mo.mliap.descriptor
pair_coeff      * * Mo Ni
fix             1 all nve
thermo_style    custom step pe press
thermo_modify   format float %.15g
timestep        0.0005
thermo          5
run             20
