# oracle: fix ti/spring (function 1) on a 32-atom fcc crystal, switching and holds, lambda and dlambda in the vector
# oracle-compare: thermo=all atoms=all rel=1e-7 abs=1e-9
units           lj
atom_style      atomic
lattice         fcc 0.9
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box
mass            1 1.0
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
velocity        all create 0.5 4321 loop all
fix             1 all nve
fix             f2 all ti/spring 3.0 4 3 function 1
thermo_style    custom step f_f2 f_f2[1] f_f2[2] pe
thermo_modify   format float %.15g
thermo          1
run             30
