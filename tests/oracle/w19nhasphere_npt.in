# oracle: fix npt/asphere (iso) on the same 108 fcc ellipsoids with an lj/cut fluid, 200 steps; Nose-Hoover thermostat on translation and rotation and a barostat on the box; compute temp/asphere, erotate/asphere, pressure, quaternion and angular momentum checksums
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           lj
atom_style      ellipsoid
lattice         fcc 0.7
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
group           g0 id 1:108:6
group           g1 id 2:108:6
group           g2 id 3:108:6
group           g3 id 4:108:6
group           g4 id 5:108:6
group           g5 id 6:108:6
set             group g0 shape 1.0 1.4 1.8
set             group g1 shape 0.9 0.9 0.9
set             group g2 shape 1.2 0.8 1.1
set             group g3 shape 2.0 1.0 1.6
set             group g4 shape 0.7 1.3 1.0
set             group g5 shape 1.1 1.1 0.6
set             group g2 mass 2.5
set             group g0 quat 0.3 1.0 0.5 47
set             group g1 quat 1 2 3 40
set             group g2 quat 0 1 1 70
set             group g3 quat 1 0 0 25
set             group g4 quat 0.5 0.2 -1 110
set             group g5 quat 1 -1 0.5 85
variable        lx atom 0.5*sin(0.3*id)
variable        ly atom 0.5*cos(0.7*id)
variable        lz atom 0.4*sin(1.1*id)
set             group all angmom v_lx v_ly v_lz
velocity        all create 1.0 4928 dist gaussian
compute         p all property/atom quatw quati quatj quatk angmomx angmomy angmomz
compute         r all reduce sum c_p[1] c_p[2] c_p[3] c_p[4] c_p[5] c_p[6] c_p[7]
compute         tmp all temp/asphere
compute         erot all erotate/asphere
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0
timestep        0.002
fix             1 all npt/asphere temp 1.0 1.0 0.5 iso 1.5 0.5 2.0
thermo_style    custom step temp pe press vol f_1 c_tmp c_erot c_r[1] c_r[2] c_r[3] c_r[4] c_r[5] c_r[6] c_r[7]
thermo_modify   format float %.15g norm no
thermo          20
run             200
