# oracle: compute voronoi/atom radical (radius) tessellation in a fully non-periodic (f f f) box with two atom types
# oracle-files: w31voronp_radius.dump
units           lj
atom_style      atomic
boundary        f f f
lattice         sc 1.0 origin 0.5 0.5 0.5
region          box block 0 4 0 4 0 4 units box
create_box      2 box
create_atoms    1 box
mass            * 1.0
region          left block INF 2.0 INF INF INF INF units box
group           small region left
set             group small type 2
variable        rad atom (type==1)*0.25+(type==2)*0.1
pair_style      lj/cut 2.5
pair_coeff      * * 0.0 1.0
neighbor        0.3 nsq
compute         v all voronoi/atom radius v_rad
thermo_style    custom step pe
thermo_modify   format float %.15g
dump            d all custom 1 w31voronp_radius.dump id type x y z c_v[1] c_v[2]
dump_modify     d sort id format float %.17g
run             0
