# oracle: angle_style table spline 240: type 1 has FP and EQ on a 2 degree table, type 2 a 1 degree table without them
# oracle-inputs: w216tb_chains.data w216tb_angle.table
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 1.5e-13, atoms 2.9e-15.
units           lj
atom_style      molecular
read_data      w216tb_chains.data
pair_style      lj/cut 1.0
pair_coeff      * * 0.0 1.0
timestep       0.002
angle_style     table spline 240
angle_coeff     1 w216tb_angle.table ANG2
angle_coeff     2 w216tb_angle.table ANG1
fix             1 all nve
thermo          10
thermo_style    custom step pe ebond eangle edihed ke press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
run             100
