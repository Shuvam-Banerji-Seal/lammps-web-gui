# oracle: fix rigid single on four finite-size spheres with spin and position-dependent external forces (sphere inertia, spin in angmom, temp dof, erotate/sphere), 4 free spheres at rest
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           lj
atom_style      sphere
region          box block 0 20 0 20 0 20 units box
create_box      1 box
create_atoms    1 single 8 10 10
create_atoms    1 single 9 10 10
create_atoms    1 single 8.5 10.9 10
create_atoms    1 single 8.5 10.3 10.9
create_atoms    1 single 3 3 3
create_atoms    1 single 4 3 3
create_atoms    1 single 3 4 3
create_atoms    1 single 3 3 4
group           body id 1:4
group           free id 5:8
set             type 1 diameter 1.0 density 1.0
pair_style      zero 2.5
pair_coeff      * *
velocity        all set 0 0 0 units box
set             group body vx 0.1 vy 0.02 vz -0.03
set             atom 1 omega 0 0 0.3
set             atom 2 omega 0.1 0 0.3
set             atom 3 omega 0 -0.2 0.1
set             atom 4 omega 0.05 0.05 0.2
variable        fx atom 0.2*sin(1.3*x)+0.05*y
variable        fy atom 0.1*cos(0.9*y)
variable        fz atom -0.15*z+0.1*x
fix             1 body rigid single
fix             2 body addforce v_fx v_fy v_fz
compute         ers all erotate/sphere
compute         tsp all temp/sphere
timestep        0.002
thermo_style    custom step temp ke pe c_ers f_1 f_1[1][1] f_1[1][2] f_1[1][3] f_1[1][4] f_1[1][5] f_1[1][6] f_1[1][7] f_1[1][8] f_1[1][9] f_1[1][10] f_1[1][11] f_1[1][12]
thermo_modify   format float %.15g
thermo          5
run             100
