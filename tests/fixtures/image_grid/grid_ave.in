# image_grid fixture: native b332f28 (/home/roy/.local/bin/lmp), dump image PPM.
units lj
atom_style atomic
lattice fcc 0.8442
region box block 0 3 0 3 0 3
create_box 1 box
create_atoms 1 box
mass * 1.0
velocity all create 1.0 87287 loop geom
pair_style lj/cut 2.5
pair_coeff * * 1.0 1.0
fix 1 all nve
fix ag all ave/grid 1 1 1 2 2 2 density/number norm all
dump d all image 1 img.*.ppm type type size 128 128 view 70 20 box yes 0.02 grid f_ag:grid:data
dump_modify d pad 0 adiam * 0.3 gtrans 0.4
run 2
