# oracle: replicate after pair_style/pair_coeff keeps the pair coefficients (two types, a cross pair_coeff), then a 50-step nve run
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           lj
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
group           odd id 1:108:2
set             group odd type 2
mass            * 1.0
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0
pair_coeff      1 2 0.8 1.05
replicate       2 1 1
variable        vx atom 0.3*sin(id)
variable        vy atom 0.3*cos(2*id)
variable        vz atom 0.2*sin(3*id)
velocity        all set v_vx v_vy v_vz
fix             1 all nve
thermo_style    custom step pe ke press
thermo_modify   format float %.15g norm no
thermo          10
run             50
