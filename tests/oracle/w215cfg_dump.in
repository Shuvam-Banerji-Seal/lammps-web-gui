# oracle: dump cfg (scaled and unwrapped coordinates, auxiliary columns, element names, colname, formats) and write_dump cfg on a triclinic box
# oracle-files: s.0.cfg s.20.cfg u.0.cfg u.20.cfg w.cfg
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 7.5e-15, atoms 3.6e-13. The five files are byte-identical to native (tests/engineDumpCfg.test.ts).
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box prism 0 3 0 3 0 3 0.4 0.2 0.3
create_box      2 box
create_atoms    1 box
set             type 1 type/fraction 2 0.3 12345
mass            1 1.0
mass            2 2.5
set             atom 3*6 image 1 -2 1
set             atom 40 image -1 0 3
velocity        all create 3.0 87287 loop geom
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0 2.5
compute         pe all pe/atom
compute         s all stress/atom NULL
dump            1 all cfg 20 s.*.cfg mass type xs ys zs id vx c_pe c_s[2]
dump_modify     1 element Ar Kr colname c_pe epot format float %.10g
dump            2 all cfg 20 u.*.cfg mass type xsu ysu zsu c_s[1] type
dump_modify     2 format 3 %20.15g
fix             1 all nve
thermo_style    custom step pe ke
thermo_modify   format float %.15g
run             20
write_dump      all cfg w.cfg mass type xs ys zs element modify element Ar Kr
