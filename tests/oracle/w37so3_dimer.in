# oracle: so3 descriptor dimer of two elements (A at (5,5,5), B 2.1 A away), linear model, 20 NVE steps
# oracle-inputs: w37so3_dimer.mliap.descriptor w37so3_dimer.mliap.model
# oracle-compare: thermo=all atoms=all rel=1e-8
units           metal
atom_style      atomic
boundary        p p p
region          box block 0 20 0 20 0 20
create_box      2 box
create_atoms    1 single 5.0 5.0 5.0 units box
create_atoms    2 single 7.1 5.3 4.8 units box
mass            * 1.0
velocity        all create 300.0 4928459 mom no rot no
pair_style      mliap model linear w37so3_dimer.mliap.model descriptor so3 w37so3_dimer.mliap.descriptor
pair_coeff      * * A B
fix             1 all nve
thermo_style    custom step pe press
thermo_modify   format float %.15g
timestep        0.0005
thermo          5
run             20
