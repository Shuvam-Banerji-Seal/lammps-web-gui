# oracle: pair_style rebo - graphene patch (4x3 honeycomb cells) from a data file
# oracle-inputs: w52airebo_graphene.data
# oracle-potentials: CH.rebo
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           metal
atom_style      atomic
timestep        0.0005
read_data       w52airebo_graphene.data
pair_style      rebo
pair_coeff      * * CH.rebo C
mass            1 12.011
thermo_style    custom step temp pe etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          10
run             0
velocity        all create 300.0 4321 loop all
fix             1 all nve
run             30
