# oracle: compute efield/atom (pair and kspace keywords) with lj/cut/coul/debye/dielectric and no kspace style: the field of the debye pair per atom
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 3.9e-16, atoms 4.4e-16.
# oracle-inputs: w226cs_diel.data
# oracle-files: w243de_efield_debye.dump
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=1e-12 filerel=1e-10
units           real
atom_style      dielectric
read_data       w226cs_diel.data
pair_style      lj/cut/coul/debye/dielectric 0.2 8.0
pair_coeff      * * 0.02 2.0
bond_style      harmonic
bond_coeff      1 100.0 1.5
special_bonds   lj/coul 0.0 0.5 1.0
compute         ef all efield/atom pair
thermo_style    custom step pe ecoul evdwl
thermo_modify   format float %.15g
dump            d all custom 1 w243de_efield_debye.dump id c_ef[1] c_ef[2] c_ef[3]
dump_modify     d sort id format float %.15g
run             0
