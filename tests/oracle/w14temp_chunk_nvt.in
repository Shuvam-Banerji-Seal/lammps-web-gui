# oracle: fix nvt thermostatting through a compute temp/chunk with com yes (no per-chunk values, so no array output is evaluated); the array outputs are checked in w14temp_chunk
# oracle-compare: thermo=all rel=1e-8 abs=1e-10
units lj
atom_style atomic
lattice fcc 0.8442
region box block 0 4 0 3 0 3
create_box 2 box
create_atoms 1 box
mass * 1.0
mass 2 2.5
region half block INF 2 INF INF INF INF units lattice
set region half type 2
variable vx atom 1.2*sin(1.7*x+2.3*y+0.7*z)
variable vy atom 1.2*cos(2.1*x-1.1*y+0.3*z)
variable vz atom 1.2*sin(0.5*x+1.9*z+1.3*y)
velocity all set v_vx v_vy v_vz units box
pair_style lj/cut 2.5
pair_coeff * * 1.0 1.0 2.5
timestep 0.002
compute cx all chunk/atom bin/1d x lower 0.25
compute cy all chunk/atom type
compute tn all temp/chunk cx com yes
thermo_style custom step temp c_tn c_tn[1] c_tn[4]
thermo_modify format float %.15g
thermo 10
run 0
fix 1 all nvt temp 1.0 1.0 0.5
fix_modify 1 temp tn
run 40
