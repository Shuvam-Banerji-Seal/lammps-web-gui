# oracle: fix deposit mol — near rejection retries the position/rotation draws, id next counters, type offset
# oracle-inputs: w26depmol_dimer.mol
units           lj
atom_style      bond
boundary        p p f
region          box block 0 10 0 10 0 20
create_box      4 box bond/types 1 extra/bond/per/atom 1
molecule        dim w26depmol_dimer.mol
pair_style      lj/cut 2.5
pair_coeff      * * 0.0 1.0
mass            * 1.0
bond_style      harmonic
bond_coeff      1 20.0 0.5
create_atoms    1 single 1.0 1.0 17.0 units box
create_atoms    1 single 4.0 4.0 17.0 units box
create_atoms    1 single 7.0 7.0 17.0 units box
create_atoms    1 single 2.0 5.0 17.0 units box
create_atoms    1 single 5.0 2.0 17.0 units box
create_atoms    1 single 8.0 5.0 17.0 units box
create_atoms    1 single 5.0 8.0 17.0 units box
region          slab block 0 10 0 10 16 18
fix             1 all deposit 4 1 1 777 region slab mol dim near 1.2 attempt 50 id next vx 0.0 0.0 vy 0.0 0.0 vz -0.5 -0.5 units box
fix             2 all nve
thermo_style    custom step atoms temp pe ebond evdwl etotal press
thermo_modify   format float %.15g
thermo          1
run             4
