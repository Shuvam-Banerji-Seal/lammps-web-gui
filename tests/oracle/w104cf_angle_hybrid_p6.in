# oracle: angle_style hybrid with class2/p6 (plain, bb and ba lines for one type) and cosine (mofff hkust1 pattern)
# oracle-inputs: mol_chains.data
units           lj
atom_style      molecular
bond_style      harmonic
angle_style     hybrid class2/p6 cosine
dihedral_style  harmonic
improper_style  harmonic
pair_style      lj/cut 2.5
read_data       mol_chains.data
pair_coeff      * * 0.5 0.9
pair_coeff      1 3 0.8 1.0
bond_coeff      1 120.0 1.05
bond_coeff      2 90.0 1.1
angle_coeff     1 class2/p6 109.5 40.0 -10.0 5.0 -2.0 1.0
angle_coeff     1 class2/p6 bb 0.5 1.0 1.0
angle_coeff     1 class2/p6 ba 0.1 0.1 1.0 1.0
angle_coeff     2 cosine 25.0
dihedral_coeff  1 1.5 -1 3
improper_coeff  1 12.0 20.0
special_bonds   lj 0.0 0.5 0.8
variable        vx atom 0.1*sin(1.3*x+0.7*y)
variable        vy atom 0.1*cos(0.9*y-0.4*z)
variable        vz atom 0.1*sin(1.1*z+0.5*x)
velocity        all set v_vx v_vy v_vz
velocity        all zero linear
timestep        0.002
fix             1 all nve
thermo_style    custom step temp pe eangle press
thermo_modify   format float %.15g norm no
thermo          10
run             50
