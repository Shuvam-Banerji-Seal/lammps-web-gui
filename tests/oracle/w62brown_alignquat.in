# oracle: fix align/self quat 0.1 with propel/self quat 2.0 on brownian/asphere (2d spheres as ellipsoids)
# oracle-compare: thermo=all atoms=all
dimension       2
units           lj
atom_style      ellipsoid
boundary        p p p
lattice         sq 0.4
region          box block 0 6 0 6 -0.2 0.2
create_box      1 box
create_atoms    1 box
set             type * shape 0.62 0.62 0.62
set             type * quat/random 12345
pair_style      none
fix             1 all brownian/asphere 0.002 12345 rng uniform gamma_r_eigen inf inf 0.5 gamma_t_eigen 1.0 1.0 inf
fix             2 all propel/self quat 2.0
fix             3 all align/self quat 0.1
fix             4 all enforce2d
thermo_style    custom step ke pe
thermo_modify   format float %.15g
timestep        0.001
thermo          50
run             200
