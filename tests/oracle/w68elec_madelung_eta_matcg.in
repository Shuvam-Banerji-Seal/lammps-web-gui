# oracle: ELECTRODE madelung in.madelung-eta_mix style: eta 2 with fix electrode/conp algo mat_cg (elastance, CG), symm on, ewald/electrode ew3dc
# oracle-inputs: w68elec_au_elyt.data
# oracle-compare: thermo=all atoms=all rel=1e-6 abs=1e-9
boundary        p p f
kspace_style    ewald/electrode 1.0e-8
kspace_modify   slab 8.0
units           real
atom_style      full
pair_style      lj/cut/coul/long 12
read_data       w68elec_au_elyt.data
group           bot type 1
group           top type 2
variable        q atom q
compute         qbot bot reduce sum v_q
compute         qtop top reduce sum v_q
fix             conp bot electrode/conp 0 2 couple top 1 symm on algo mat_cg 1e-6
thermo_style    custom step pe c_qbot c_qtop f_conp
thermo_modify   format float %.15g
run             0
