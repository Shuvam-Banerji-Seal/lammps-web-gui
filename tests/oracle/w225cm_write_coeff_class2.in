# oracle: write_coeff of the class 2 angle, dihedral and improper styles (their extra sections and type tags)
# oracle-files: w225cm_coeff_class2.txt
# oracle-compare: thermo=all atoms=none
units           real
atom_style      full
region          box block -5 5 -5 5 -5 5
create_box      2 box bond/types 1 angle/types 1 dihedral/types 2 improper/types 1 extra/bond/per/atom 2 extra/angle/per/atom 1 extra/dihedral/per/atom 1 extra/improper/per/atom 1 extra/special/per/atom 3
create_atoms    1 single 0.0 0.0 0.0
create_atoms    2 single 1.0 0.0 0.0
mass            * 12.0
pair_style      lj/cut 8.0
pair_coeff      * * 0.1 3.4
bond_style      harmonic
bond_coeff      1 300.0 1.09
angle_style     class2
angle_coeff     1 75.0 25.0 0.3 0.002
angle_coeff     1 bb 10.5872 1.0119 1.5228
angle_coeff     1 ba 3.6551 24.895 1.0119 1.5228
dihedral_style  class2
dihedral_coeff  1 100 75 100 70 80 60
dihedral_coeff  1 mbt 3.5945 0.1704 -0.5490 1.5228
dihedral_coeff  1 ebt 0.3417 0.3264 -0.9036 0.1368 0.0 -0.8080 1.0119 1.1010
dihedral_coeff  1 at 0.0 -0.1850 -0.7963 -2.0220 0.0 -0.3991 110.2453 105.1270
dihedral_coeff  1 aat -13.5271 110.2453 105.1270
dihedral_coeff  1 bb13 0.0 1.0119 1.1010
dihedral_coeff  2 100 75 100 70 80 60
dihedral_coeff  2 mbt 3.5945 0.1704 -0.5490 1.5228
dihedral_coeff  2 ebt 0.3417 0.3264 -0.9036 0.1368 0.0 -0.8080 1.0119 1.1010
dihedral_coeff  2 at 0.0 -0.1850 -0.7963 -2.0220 0.0 -0.3991 110.2453 105.1270
dihedral_coeff  2 aat -13.5271 110.2453 105.1270
dihedral_coeff  2 bb13 0.0 1.0119 1.1010
improper_style  class2
improper_coeff  1 100.0 0
improper_coeff  1 aa 0.0 0.0 0.0 115.06 130.01 115.06
write_coeff     w225cm_coeff_class2.txt
