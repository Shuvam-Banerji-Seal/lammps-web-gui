# oracle: cut-down pedone.melt example: hybrid/overlay pedone with coul/long and pppm, CaO 2x2x2 fcc cell, velocity create (loop all), fix nvt, 100 steps
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           metal
atom_style      charge
lattice         fcc 4.8105
region          box block 0 2 0 2 0 2
create_box      2 box
create_atoms    1 box
lattice         fcc 4.8105 origin 0.5 0.5 0.5
create_atoms    2 box
mass            1 40.078
mass            2 15.999
set             type 1 charge 1.2
set             type 2 charge -1.2
timestep        0.002
neigh_modify    delay 5 every 1 check yes
pair_style      hybrid/overlay pedone 15.0 coul/long 15.0
kspace_style    pppm 1.0e-6
pair_modify     table 0
pair_coeff      * * coul/long
pair_coeff      1 2 pedone 0.030211 2.241334 2.923245 5.0
pair_coeff      2 2 pedone 0.042395 1.379316 3.618701 22.0
velocity        all create 6000.0 98347 loop all
fix             1 all nvt temp 3000.0 3000.0 0.1
thermo_style    custom step pe press etotal temp
thermo_modify   format float %.15g norm no
thermo          10
run             100
