# oracle: compute hma cv with pair lj/cut: native's default Pair::single_hessian gives a zero Hessian (only lj/smooth/linear has one), so cv has no phi term
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=1e-12
units           lj
atom_style      atomic
lattice         fcc 1.0
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 1.0
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0
velocity        all create 0.1 45678 dist gaussian
fix             settemp all nvt temp 1.0 1.0 0.5
compute         hma all hma settemp u cv
timestep        0.005
thermo_style    custom step pe temp c_hma[1] c_hma[2]
thermo_modify   format float %.15g
thermo          50
run             100
