# oracle: compute pe/atom (kspace term) with kspace_style pppm/dipole/spin (the w103spin_pppm_dipole_virial system: spin/dipole/long + spin/exchange, 432 bcc iron spins, gewald 0.25 mesh 8): the per-atom energy of fieldforce_peratom_spin, halved, less the spin self term, times mub2mu0; dumps at steps 0 and 5
# Measured max relative error, engine vs native (thermo rows): thermo 3.4e-15; the dumped kspace pe/atom within 1e-14 of native.
# oracle-files: w272sp_pppm_spin_peatom.dump
# oracle-compare: thermo=all atoms=none rel=1e-8 abs=1e-10 filerel=1e-9
units           metal
atom_style      spin
dimension       3
boundary        p p p
atom_modify     map array
lattice         bcc 2.8665
region          box block 0.0 6.0 0.0 6.0 0.0 6.0
create_box      1 box
create_atoms    1 box
mass            1 55.845
set             group all spin/random 11 2.2
pair_style      hybrid/overlay spin/exchange 3.5 spin/dipole/long 8.0
pair_coeff      * * spin/exchange exchange 3.4 0.02726 0.2171 1.841
pair_coeff      * * spin/dipole/long 8.0
neighbor        0.1 bin
neigh_modify    every 10 check yes delay 20
kspace_style    pppm/dipole/spin 1.0e-4
kspace_modify   gewald 0.25 mesh 8 8 8
fix             1 all precession/spin zeeman 0.001 0.0 0.0 1.0
fix_modify      1 energy yes
fix             2 all nve/spin lattice frozen
timestep        0.0001
thermo_style    custom step pe press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          5
compute         pk all pe/atom kspace
dump            d all custom 5 w272sp_pppm_spin_peatom.dump id c_pk
dump_modify     d sort id format float %.15g
run             5
