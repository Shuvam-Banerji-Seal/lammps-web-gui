# oracle: compute force/tally and group/group force vector on the cut-down SPC/E water of the TALLY example (lj/cut/coul/long + pppm, kspace no)
# oracle-inputs: w47ta_spce_cut.data
units           real
atom_style      full
read_data       w47ta_spce_cut.data
pair_style      lj/cut/coul/long 12.0 12.0
kspace_style    pppm 1.0e-4
pair_coeff      1 1 0.15535 3.166
pair_coeff      * 2 0.0000 0.0000
bond_style      harmonic
angle_style     harmonic
bond_coeff      1 1000.00 1.000
angle_coeff     1 100.0 109.47
special_bonds   lj/coul 0.0 0.0 1.0
neighbor        2.0 bin
group           one molecule 1 2
compute         fpa one group/group all pair yes kspace no boundary no
compute         c1 one force/tally all
compute         c2 all force/tally all
compute         one one reduce sum c_c1[1] c_c1[2] c_c1[3]
compute         red all reduce sum c_c2[1] c_c2[2] c_c2[3]
thermo_style    custom step c_fpa[1] c_fpa[2] c_fpa[3] c_c1 c_c2 c_one[1] c_one[2] c_one[3] c_red[1] c_red[2] c_red[3]
thermo_modify   format float %.15g
run             0
