# oracle: pair_style hybrid/scaled with a constant and a ramping equal-style factor on two lj/cut instances
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
group           odd id 1:256:2
set             group odd type 2
mass            * 1.0
variable        dx atom 0.05*sin(1.3*x+0.7*y)
variable        dy atom 0.05*cos(0.9*y-1.1*z)
variable        dz atom 0.05*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 1.2*sin(0.9*x+0.4*z)
variable        vy atom 1.2*cos(0.6*y+0.8*x)
variable        vz atom 1.2*sin(0.7*z-0.3*y)
velocity        all set v_vx v_vy v_vz units box
velocity        all zero linear
variable        one equal ramp(1.0,0.2)
pair_style      hybrid/scaled v_one lj/cut 2.5 0.4 lj/cut 2.0
pair_coeff      * * lj/cut 1 1.0 1.0
pair_coeff      1 2 lj/cut 2 0.7 1.1
pair_coeff      2 2 lj/cut 2 1.3 0.95
timestep        0.004
fix             1 all nve
thermo_style    custom step temp pe evdwl etotal press pxx pyy pzz pxy pxz pyz v_one
thermo_modify   format float %.15g
thermo          10
run             50
