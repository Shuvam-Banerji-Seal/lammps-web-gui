# oracle: fix npt on a triclinic box with a nonzero xy shear target (x, y, z 1.5 and xy 0.4): the tilt's deviatoric force and the strain energy of the tilted cell
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box prism 0 3 0 3 0 3 0.3 0 0
create_box      1 box
create_atoms    1 box
mass            1 1.0
variable        vx atom 1.4*sin(1.7*x+2.3*y+0.7*z)
variable        vy atom 1.4*cos(2.1*x-1.1*y+0.3*z)
variable        vz atom 1.4*sin(0.5*x+1.9*z+1.3*y)
velocity        all set v_vx v_vy v_vz units box
velocity        all zero linear
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
neighbor        0.3 bin
neigh_modify    every 1 delay 0 check yes
fix             1 all npt temp 1.2 1.2 0.5 x 1.5 1.5 1.0 y 1.5 1.5 1.0 z 1.5 1.5 1.0 xy 0.4 0.4 1.0
thermo_style    custom step temp press pxx pyy pzz lx ly lz xy pe etotal vol f_1 
thermo_modify   format float %.15g
thermo          5
run             100
