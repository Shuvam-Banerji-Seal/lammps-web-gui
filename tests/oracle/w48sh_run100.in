# oracle: SPC/E water box (4500 atoms): fix shake tol 1e-4 iter 20, nve for 100 steps of 1 fs: thermo rows and the final per-atom state
# oracle-inputs: w48sh_spce.data
# oracle-compare: thermo=all atoms=all rel=1e-7 abs=1e-9
# oracle-tolerance: the per-step solve of fix shake (each cluster iterates until its largest multiplier update times dt^2 ftm2v is within tol) keeps the 100-step trajectory within 1e-7 relative in thermo (the per-atom error grows with the step count, see the run20 case)
units		real
atom_style	full
read_data	w48sh_spce.data
pair_style	lj/cut/coul/long 12.0 12.0
kspace_style	pppm 1.0e-4
pair_coeff	1 1 0.15535 3.166
pair_coeff	* 2 0.0000 0.0000
bond_style	harmonic
angle_style	harmonic
dihedral_style	none
improper_style	none
bond_coeff	1 1000.00 1.000
angle_coeff	1 100.0 109.47
special_bonds   lj/coul 0.0 0.0 1.0
neighbor        2.0 bin
fix             1 all shake 0.0001 20 0 b 1 a 1
fix             2 all nve
thermo_style    custom step temp pe ecoul elong press
thermo_modify   format float %.15g
thermo          20
run             100
