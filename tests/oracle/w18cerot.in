# oracle: compute erotate/sphere/atom (per-atom rotational energy in energy units) through compute reduce, with a point particle and group subsets
units           real
atom_style      sphere
lattice         fcc 4.05
region          box block 0 2 0 2 0 2
create_box      2 box
create_atoms    1 box
group           odd id 1:32:2
set             group odd type 2
set             group odd diameter 3.4
set             type 1 diameter 2.6
set             group all density 1.2
group           point id 1
set             group point diameter 0.0
group           a2 id 2
group           a3 id 3
variable        wx atom 0.5*sin(0.3*id)
variable        wy atom 0.5*cos(0.7*id)
variable        wz atom 0.2*sin(1.1*id)
set             group all omega v_wx v_wy v_wz
variable        vx atom 0.002*sin(1.3*x+0.7*y)
variable        vy atom 0.002*cos(0.9*y-0.4*z)
variable        vz atom 0.002*sin(1.1*z+0.5*x)
velocity        all set v_vx v_vy v_vz
velocity        all zero linear
compute         era all erotate/sphere/atom
compute         eraodd odd erotate/sphere/atom
compute         era2 a2 erotate/sphere/atom
compute         era3 a3 erotate/sphere/atom
compute         er all erotate/sphere
compute         s all reduce sum c_era
compute         so all reduce sum c_eraodd
compute         s2 all reduce sum c_era2
compute         s3 all reduce sum c_era3
pair_style      lj/cut 10.0
pair_coeff      * * 0.238 3.405
timestep        0.1
fix             1 all nve
thermo_style    custom step atoms c_s c_so c_s2 c_s3 c_er temp
thermo_modify   format float %.15g norm no
thermo          5
run             10