# oracle: compute snad/atom with quadraticflag on a perturbed bcc cell, 2 types, dumped per atom (%.12g)
# oracle-files: w8snap_snad_quad.dump
# oracle-compare: thermo=first-last
units           lj
atom_style      atomic
lattice         bcc 0.9
region          box block 0 2 0 2 0 2
create_box      2 box
create_atoms    1 box
group           odd id 1:128:2
set             group odd type 2
mass            * 1.0
variable        dx atom 0.05*sin(1.3*x+0.7*y)
variable        dy atom 0.05*cos(0.9*y-1.1*z)
variable        dz atom 0.05*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
pair_style      zero 4.5
pair_coeff      * *
compute         d all snad/atom 1.1 0.85 2 1.6 2.0 0.9 1.2 rmin0 0.1 quadraticflag 1
thermo_style    custom step pe
thermo_modify   format float %.15g
dump            dd all custom 1 w8snap_snad_quad.dump id c_d[*]
dump_modify     dd sort id format float %.12g
run             0
