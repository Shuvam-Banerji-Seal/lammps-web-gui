# oracle: bond_style lepton no_offset, angle_style lepton (auto offset), dihedral_style lepton (phi in [0, 2 pi)), pair lepton special bonds
# oracle-inputs: mol_chains.data
units           lj
atom_style      molecular
bond_style      lepton no_offset
angle_style     lepton
dihedral_style  lepton
improper_style  harmonic
pair_style      lepton 2.5
read_data       mol_chains.data
pair_coeff      * * "4*eps*((sig/r)^12-(sig/r)^6); eps=0.5; sig=0.9" 2.2
pair_coeff      1 3 "0.8*(sig/r)^6; sig=1.0" 1.8
bond_coeff      1 1.05 "120.0*r^2 + 10*r^3"
bond_coeff      2 1.1 "k2*r^2 + 2.0*cos(3*r); k2=90.0"
angle_coeff     1 109.5 "40.0*theta^2 + 2*sin(theta)"
angle_coeff     2 120.0 "25.0*theta^2"
dihedral_coeff  1 "1.5*(1+cos(2*phi)) + 0.1*phi"
improper_coeff  1 12.0 20.0
special_bonds   lj 0.0 0.5 0.8
timestep        0.002
fix             1 all nve
thermo_style    custom step temp pe ebond eangle edihed eimp evdwl etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          10
run             50
