# oracle: fix bond/react without stabilization, tiny nylon (examples/PACKAGES/reaction/tiny_nylon.unstabilized) cut to 300 steps
# oracle-inputs: w94react_nylon.data w94react_nylon_stp1.map w94react_nylon_stp1_unreacted.mol w94react_nylon_stp1_reacted.mol w94react_nylon_stp2.map w94react_nylon_stp2_unreacted.mol w94react_nylon_stp2_reacted.mol
# oracle-compare: thermo=all atoms=all rel=1e-7 abs=1e-9
# Engine vs this fixture (Node 24 and Node 20 agree): thermo max rel 3.6e-8 (press, step 300), temp 1.1e-9;
# atoms max rel 8.1e-7 (fx, abs 3.6e-7), positions 3.9e-9 (xu, abs 9.0e-9). The 1e-8 default is not met by press at step 300
# (3.6e-8 relative, 3.5e-7 atm); a 1e-10 A shift of the start gives 3e-12, so the gap is not round-off.
units real
boundary p p p
atom_style full
kspace_style pppm 1.0e-4
pair_style lj/class2/coul/long 8.5
angle_style class2
bond_style class2
dihedral_style class2
improper_style class2
special_bonds lj/coul 0 0 1
pair_modify tail yes mix sixthpower
read_data w94react_nylon.data extra/bond/per/atom 5 extra/angle/per/atom 15 extra/dihedral/per/atom 15 extra/improper/per/atom 25 extra/special/per/atom 25
velocity all create 300.0 4928459 dist gaussian
molecule mol1 w94react_nylon_stp1_unreacted.mol
molecule mol2 w94react_nylon_stp1_reacted.mol
molecule mol3 w94react_nylon_stp2_unreacted.mol
molecule mol4 w94react_nylon_stp2_reacted.mol
thermo 50
fix myrxns all bond/react stabilization no react rxn1 all 1 0.0 2.9 mol1 mol2 w94react_nylon_stp1.map react rxn2 all 1 0.0 5.0 mol3 mol4 w94react_nylon_stp2.map rescale_charges yes
fix 1 all nve/limit .03
thermo_style custom step temp press density f_myrxns[1] f_myrxns[2]
thermo_modify colname auto format float %.15g
run 300
