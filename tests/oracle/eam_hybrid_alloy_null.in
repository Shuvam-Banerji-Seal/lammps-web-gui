# oracle: pair_style hybrid with eam/alloy mapping type 2 to NULL (CuNi.eam.alloy, Cu on type 1) and lj/cut for the 1-2 and 2-2 pairs; 100 steps of nve
# oracle-potentials: CuNi.eam.alloy
# oracle-compare: thermo=all atoms=all rel=1e-11 abs=1e-12
units           metal
atom_style      atomic
lattice         fcc 3.615
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
set             group all type/fraction 2 0.3 2468
mass            2 39.95
pair_style      hybrid eam/alloy lj/cut 4.0
pair_coeff      * * eam/alloy CuNi.eam.alloy Cu NULL
pair_coeff      2 2 lj/cut 0.0104 3.40
pair_coeff      1 2 lj/cut 0.05 2.80
velocity        all create 600.0 13579 loop geom
fix             1 all nve
timestep        0.002
thermo_style    custom step temp pe ke etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          20
run             100
