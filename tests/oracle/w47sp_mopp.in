# oracle: compute stress/mop/profile (origin lower, delta 1.0, kin conf total) on a periodic lj fcc liquid after 20 nve steps
# oracle-compare: thermo=all atoms=none rel=1e-8 abs=1e-10
# oracle-files: w47sp_mopp.time
# oracle-note: the values are sampled by fix ave/time with start 20 (the setup evaluation of stress/mop is an EngineError: native's setup row is not reproduced)
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
mass            1 1.0
variable        dxa atom 0.05*sin(2.3*y+0.4*z)
variable        dya atom 0.04*cos(1.7*z)
variable        dza atom 0.03*sin(1.3*z+0.5)
displace_atoms  all move v_dxa v_dya v_dza units box
variable        vxa atom 0.7*sin(2.3*y+0.4*z)+0.3*cos(1.1*x)
variable        vya atom 0.6*cos(1.7*z-0.9*x)
variable        vza atom 0.5*sin(1.3*x+0.8*y)
velocity        all set v_vxa v_vya v_vza units box
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0
fix             1 all nve
compute         mp all stress/mop/profile x lower 1.0 kin conf total
thermo_style    custom step
thermo_modify   format float %.15g
thermo          20
run             20
print "$(c_mp[1][1]) $(c_mp[1][2]) $(c_mp[1][3]) $(c_mp[1][4]) $(c_mp[1][5]) $(c_mp[1][6]) $(c_mp[1][7]) $(c_mp[1][8]) $(c_mp[1][9]) $(c_mp[1][10]) $(c_mp[2][1]) $(c_mp[2][2]) $(c_mp[2][3]) $(c_mp[2][4]) $(c_mp[2][5]) $(c_mp[2][6]) $(c_mp[2][7]) $(c_mp[2][8]) $(c_mp[2][9]) $(c_mp[2][10]) $(c_mp[3][1]) $(c_mp[3][2]) $(c_mp[3][3]) $(c_mp[3][4]) $(c_mp[3][5]) $(c_mp[3][6]) $(c_mp[3][7]) $(c_mp[3][8]) $(c_mp[3][9]) $(c_mp[3][10]) $(c_mp[4][1]) $(c_mp[4][2]) $(c_mp[4][3]) $(c_mp[4][4]) $(c_mp[4][5]) $(c_mp[4][6]) $(c_mp[4][7]) $(c_mp[4][8]) $(c_mp[4][9]) $(c_mp[4][10]) $(c_mp[5][1]) $(c_mp[5][2]) $(c_mp[5][3]) $(c_mp[5][4]) $(c_mp[5][5]) $(c_mp[5][6]) $(c_mp[5][7]) $(c_mp[5][8]) $(c_mp[5][9]) $(c_mp[5][10]) $(c_mp[6][1]) $(c_mp[6][2]) $(c_mp[6][3]) $(c_mp[6][4]) $(c_mp[6][5]) $(c_mp[6][6]) $(c_mp[6][7]) $(c_mp[6][8]) $(c_mp[6][9]) $(c_mp[6][10]) $(c_mp[7][1]) $(c_mp[7][2]) $(c_mp[7][3]) $(c_mp[7][4]) $(c_mp[7][5]) $(c_mp[7][6]) $(c_mp[7][7]) $(c_mp[7][8]) $(c_mp[7][9]) $(c_mp[7][10])" file w47sp_mopp.time screen no
