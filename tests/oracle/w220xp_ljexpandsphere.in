# oracle: pair lj/expand/sphere 2.5 on atom_style sphere (diameters 0.9 and 1.1): mixed sigma and cutoff, pair_modify shift yes, 216 atoms NVE 200 steps
# oracle-compare: thermo=all atoms=all rel=1e-12 abs=1e-13
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 2.4e-12, atoms 8.8e-12.
units        lj
boundary     p p p
atom_style   sphere
lattice      sc 0.2
region       box block 0 6 0 6 0 6
create_box   2 box
create_atoms 1 box
set          group all type/fraction 2 0.5 4321
set          type 1 diameter 0.9
set          type 2 diameter 1.1
set          group all density 1.0
velocity     all create 1.0 4242
timestep     0.002
fix          1 all nve
pair_style   lj/expand/sphere 2.5
pair_coeff   1 1 1.0 0.3
pair_coeff   2 2 0.8 0.25 2.2
pair_modify  shift yes
thermo_style custom step pe evdwl ecoul elong ke press pxx pyy pzz pxy pxz pyz
thermo_modify format float %.15g
thermo       20
run          200
