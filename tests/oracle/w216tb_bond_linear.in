# oracle: bond_style table linear 500 with two sections, both without FP or EQ (r0 is the file minimum)
# oracle-inputs: w216tb_chains.data w216tb_bond.table
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 1.1e-14, atoms 0.0e+0.
units           lj
atom_style      molecular
read_data      w216tb_chains.data
pair_style      lj/cut 1.0
pair_coeff      * * 0.0 1.0
timestep       0.002
bond_style      table linear 500
bond_coeff      1 w216tb_bond.table BLIN
bond_coeff      2 w216tb_bond.table BLIN
fix             1 all nve
thermo          10
thermo_style    custom step pe ebond eangle edihed ke press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
run             100
