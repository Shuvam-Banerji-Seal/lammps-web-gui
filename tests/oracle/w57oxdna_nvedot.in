# oracle: fix nve/dot (ellipsoid translation and no-squish orientation with the fixed inertia 0.2 m (b^2 + c^2)) on the duplex1 example compressed to 0.85 (change_box remap), with the oxDNA excluded volume and FENE bond; lj units, 200 steps at timestep 1e-4
# oracle-inputs: w57oxdna_duplex1.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-12
units           lj
dimension       3
newton          on
boundary        p p p
atom_style      hybrid bond ellipsoid oxdna
atom_modify     sort 0 1.0
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
read_data       w57oxdna_duplex1.data
set             atom * mass 3.1575
change_box      all x scale 0.85 y scale 0.85 z scale 0.85 remap
bond_style      oxdna/fene
bond_coeff      * 2.0 0.25 0.7525
special_bonds   lj 0 1 1
pair_style      oxdna/excv
pair_coeff      * * 2.0 0.7 0.675 2.0 0.515 0.5 2.0 0.33 0.32
fix             1 all nve/dot
timestep        1e-4
thermo_style    custom step temp pe ebond evdwl ke etotal
thermo_modify   format float %.15g
thermo          20
run             200
