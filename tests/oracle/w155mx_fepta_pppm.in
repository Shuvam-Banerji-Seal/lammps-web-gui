# oracle: compute fep/ta (test-area perturbation, xy, scale 1.0005) with lj/cut/coul/long and pppm, cut down from PACKAGES/fep/ta, NVE
# native: b332f28 (installed lmp). Measured max relative error 8.3e-10 (target 1e-8).
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           real
boundary        p p p
atom_style      charge
pair_style      lj/cut/coul/long 6.0
pair_modify     tail no
lattice         bcc 5.0
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box basis 1 1 basis 2 2
mass            1 12.011
mass            2 1.008
set             type 1 charge 0.1
set             type 2 charge -0.1
pair_coeff      1 1 0.1 3.0
pair_coeff      1 2 0.05 2.0
pair_coeff      2 2 0.02 1.0
kspace_style    pppm 1.0e-5
timestep        1.0
velocity        all create 300.0 12345
fix             INTEG all nve
variable        TK equal 300.0
compute         TA all fep/ta ${TK} xy 1.0005
thermo_style    custom step etotal pe press c_TA[1] c_TA[2] c_TA[3]
thermo_modify   format float %.15g
thermo          5
run             20
