# oracle: fix rhok on a four-atom group of eight (N of rho_k is the group count), energy yes, a (1,1,0) vector
# oracle-compare: thermo=all atoms=all
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 2.5e-15, atoms 4.3e-16.
units           lj
atom_style      atomic
atom_modify     map array
boundary        p p p
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 single 0.3 0.2 0.1 units box
create_atoms    1 single 1.4 0.1 0.6 units box
create_atoms    1 single 0.2 1.7 0.9 units box
create_atoms    1 single 1.1 1.2 1.4 units box
create_atoms    1 single 2.3 0.4 1.9 units box
create_atoms    1 single 2.9 1.5 0.2 units box
create_atoms    1 single 2.1 2.6 1.1 units box
create_atoms    1 single 0.7 2.9 2.4 units box
mass            1 1.0
pair_style      lj/cut 2.5
pair_coeff      1 1 0.3 1.0 2.5
velocity        all create 0.2 4928 loop all
timestep        0.002
group           gg id 1:4
fix             1 all nve
fix             B gg rhok 1 1 0 2.0 0.5
fix_modify      B energy yes
thermo_style    custom step pe f_B f_B[1] f_B[2] f_B[3]
thermo_modify   format float %.15g
thermo          4
run             16
