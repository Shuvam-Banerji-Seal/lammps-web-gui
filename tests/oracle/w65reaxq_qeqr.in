# oracle: ReaxFF water cut from examples/reaxff/water with fix qeq/rel/reaxff (no fix efield: chi_eff = chi, the qeqr example solve), tolerance 1e-6, 10 NVE steps
# oracle-inputs: w65reaxq_water.data w65reaxq_acks2_ff.water w65reaxq_qeq_ff.water w65reaxq_gauss_exp.txt
# Measured (engine vs native, max relative error over the 11 rows): pe 2.1e-10, ecoul 4.4e-10, ke 1.9e-8, press 2.9e-7
# oracle-compare: thermo=all atoms=all rel=1e-6 abs=1e-10
units           real
atom_style      charge
boundary        p p p
read_data       w65reaxq_water.data
pair_style      reaxff NULL safezone 3.0 mincap 150
pair_coeff      * * w65reaxq_qeq_ff.water O H
fix             1 all qeq/rel/reaxff 1 0.0 10.0 1.0e-6 reaxff w65reaxq_gauss_exp.txt
neighbor        0.5 bin
neigh_modify    every 1 delay 0 check yes
velocity        all create 300.0 4928459 rot yes dist gaussian
timestep        0.5
fix             2 all nve
thermo_style    custom step temp pe ebond evdwl ecoul ke etotal press
thermo_modify   format float %.15g
thermo          1
run             10
