# oracle: fix nonaffine/displacement d2min type (the pair cutoffs) with the reference fixed at step 20, every 10 steps: sqrt(D2min), the volumetric and deviatoric strains and the Green strain components per atom
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# oracle-files: w379nad_d2min_type.dump
units           lj
atom_style      atomic

lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 1.0

velocity        all create 1.0 87287 loop all
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0 2.5
timestep        0.002
fix             1 all nve
fix             2 all nonaffine/displacement 10 d2min type fixed 20

compute         m all reduce sum f_2[1] f_2[2] f_2[3] f_2[4] f_2[9]
thermo_style    custom step temp pe c_m[1] c_m[2] c_m[3] c_m[4] c_m[5]
thermo_modify   format float %.15g
thermo          10
dump            3 all custom 20 w379nad_d2min_type.dump id f_2[1] f_2[2] f_2[3] f_2[4] f_2[5] f_2[6] f_2[7] f_2[8] f_2[9]
dump_modify     3 sort id format float %.15g
run             100
