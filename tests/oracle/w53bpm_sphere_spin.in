# oracle: fix nve/bpm/sphere spins one sphere with a constant lab-frame angular velocity for 200 steps; the quaternion
# follows the Richardson step measured in fix_nve_bpm_sphere (the native quaternion agrees to 5e-16)
# oracle-inputs: w53bpm_spin.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units lj
atom_style bpm/sphere
read_data w53bpm_spin.data
pair_style zero 2.0
pair_coeff * *
neighbor 0.3 bin
compute q all property/atom quatw quati quatj quatk
compute qs all reduce sum c_q[1] c_q[2] c_q[3] c_q[4]
compute om all property/atom omegax omegay omegaz
compute oms all reduce sum c_om[1] c_om[2] c_om[3]
fix 1 all nve/bpm/sphere
timestep 0.01
thermo_style custom step ke c_qs[1] c_qs[2] c_qs[3] c_qs[4] c_oms[1] c_oms[2] c_oms[3]
thermo_modify format float %.15g norm no
thermo 50
run 200
