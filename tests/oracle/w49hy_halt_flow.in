# oracle: fix halt error continue (later runs execute, the check repeats), error soft (later runs skipped until timer timeout off; timer timeout unlimited also clears it), and a halt inside a minimize (fix_halt.html: minimization iterations are checked too); checks at absolute steps multiple of N; message no (the message line would split the thermo rows of the oracle parser)
# oracle-compare: thermo=all atoms=none rel=1e-10 abs=1e-12
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 1.0
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
displace_atoms  all move 0.05 0.02 0.01 units box
velocity        all set 0.3 0.1 -0.2
fix             1 all nve
timestep        0.005
variable        s equal step
thermo_style    custom step pe v_s
thermo_modify   format float %.15g
thermo          1
fix             h all halt 3 v_s > 5 error continue message no
run             6
run             4
run             5
unfix           h
fix             h all halt 3 v_s > 5 error soft message no
run             6
run             4
timer           timeout off
run             4
timer           timeout unlimited
unfix           h
fix             h all halt 1 v_s >= 22 error soft message no
minimize        1.0e-4 1.0e-4 100 100
run             2
