# oracle: pair dpd/fdt (atom_style dpd, velocity-Verlet) on the first 1000 atoms of examples/PACKAGES/dpd-react/dpd-vv (10125 atoms, 1000 steps), 100 steps
# oracle-inputs: w95dreact_dpd_1000.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=0
# Measured with native LAMMPS (black box): cut-down of the dpd-vv example (same box, cutoff, temperature and seed).

boundary        p p p

units           metal
atom_style      dpd
read_data       w95dreact_dpd_1000.data

comm_modify     mode single vel yes
mass            1 125.9

pair_style      dpd/fdt 300.0 8.6 245455
pair_coeff      1 1 0.075 0.022 8.60

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check no once no

timestep        0.001

fix             2 all nve

variable        totEnergy equal pe+ke

thermo          10
thermo_style    custom step temp press pe ke v_totEnergy
thermo_modify   format float %.15g

run             100
