# oracle: fix qbmsst with artificial viscosity mu 0.5, fix_modify energy yes (shock energy in pe), explicit p0 and v0 on a 4x4x4 LJ fcc crystal, 100 steps
# Native reference: LAMMPS b332f28 built from source with PKG_KSPACE MANYBODY MISC MOLECULE PHONON QEQ QTB REAXFF SHOCK, because the installed binary has no QTB (cmake -D PKG_<name>=on for each; then LMP=<build>/lmp run-oracle.mjs)
# oracle-compare: thermo=all atoms=all rel=1e-8
# measured (engine vs native, Node 24): thermo within 7.5e-15 relative, per-atom within 1.3e-12
units           lj
atom_style      atomic
boundary        p p p
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 0.8 4928 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
fix             1 all nve
fix             shock all qbmsst z 1.5 q 10.0 mu 0.5 p0 0.3 v0 300.0 e0 -6.0 tscale 0.1 damp 1.0 f_max 4.0 N_f 20 seed 35082 eta 1.0 beta 5 T_init 0.8
thermo_style    custom step temp press econserve vol lz pzz f_shock[1] f_shock[2] f_shock[3] f_shock[4] f_shock[5]
fix_modify      shock energy yes
thermo_modify   format float %.15g
timestep        0.002
thermo          10
run             100
