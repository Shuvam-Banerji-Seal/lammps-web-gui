# oracle: pair_style lj/charmmfsw/coul/charmmfsh 8 10 9 on bonded 4-atom chains (special_bonds charmm)
# oracle-inputs: w10charmmfsw_chains.data
units           real
atom_style      full
read_data       w10charmmfsw_chains.data
special_bonds   charmm
bond_style      harmonic
bond_coeff      1 300.0 1.5
angle_style     harmonic
angle_coeff     1 50.0 110.0
pair_style      lj/charmmfsw/coul/charmmfsh 8.0 10.0 9.0
pair_coeff      1 1 0.1 3.0 0.05 3.5
pair_coeff      2 2 0.15 3.2 0.1 3.1
timestep        1.0
velocity        all set 0.001 0.0 0.0 units box
fix             1 all nve
thermo_style    custom step temp pe evdwl ecoul ebond eangle etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          10
run             40
