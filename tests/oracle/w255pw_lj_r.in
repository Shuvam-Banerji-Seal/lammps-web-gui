# oracle: pair_write of lj/cut 1-1 in style r (N 50 values, inner 0.8, outer 3.0, keyword LJ11)
# oracle-files: w255pw_lj_r.table
# oracle-compare: thermo=all atoms=none filerel=1e-15
# Measured max relative error, engine vs native (thermo rows, final atoms): none (no run, no thermo or atoms); the written table agrees with native token by token within filerel 1e-15.
units           lj
atom_style      atomic
region          box block 0 10 0 10 0 10
create_box      2 box
mass            * 1.0
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
pair_coeff      2 2 0.5 1.2
pair_write      1 1 50 r 0.8 3.0 w255pw_lj_r.table LJ11
