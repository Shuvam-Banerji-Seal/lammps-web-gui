# oracle: pouring spheres onto a plane of triangles read from an STL file by fix surface/local input stl (in.tri.gran.surf.stl cut down: 30 spheres poured, 500 steps; 3d surf/granular, atom_style tri, fix surface/local input stl. Stopped at 500 steps: a sphere sliding on a triangle diverges from native after step 500 (the same divergence as w106gs_tri_surf, which stops at 520; see the report))
# oracle-inputs: w127gsg_surf.tri.stl
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# oracle-measured: max relative error (native fixture vs engine, scale max(1,|LAMMPS|)): thermo 3.6e-15, per-atom 5.1e-15 (measured with tests/fixtures/oracle, 2026-10-14)
units           lj
atom_style      tri
atom_modify     map array
boundary        f f f
dimension       3
comm_modify     vel yes cutoff 12.5
region          box block -7 7 -7 7 0 9 units box
create_box      2 box
fix             20 all surface/local input stl 2 1 w127gsg_surf.tri.stl
pair_style      hybrid granular surf/granular
pair_coeff      1 1 granular hooke 4000.0 100.0 &
                         tangential linear_history 1000.0 1.0 0.5 &
                         damping mass_velocity
pair_coeff      1 2 surf/granular hooke 4000.0 100.0 &
                         tangential linear_history 1000.0 1.0 0.5 &
                         damping mass_velocity
pair_coeff      2 2 none
group           sphere type 1
group           tri type 2
neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes
fix             2 sphere nve/sphere
fix             3 sphere gravity 1.0 vector 0 0 -1
region          slab block -2 2 -2 2 7 9 units box
fix             ins sphere pour 30 1 4767548 vol 0.4 10 &
                diam one 1.0 region slab ignore
region          zcylinder cylinder z 0 0 7.0 INF INF units box
fix             wall sphere wall/gran/region granular hooke 4000.0 100.0 &
                         tangential linear_history 1000.0 1.0 0.5 &
                         damping mass_velocity &
                         region zcylinder
timestep        0.005
compute         1 sphere temp
compute_modify  1 dynamic/dof yes
compute         2 sphere temp/sphere
compute_modify  2 dynamic/dof yes
thermo_style    custom step atoms temp c_1 c_2 press
thermo_modify   format float %.15g lost ignore
compute_modify  thermo_temp dynamic/dof yes
thermo          100
run             500
