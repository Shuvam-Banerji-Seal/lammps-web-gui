# oracle: lj/spica periodic run, 50 steps, three lj types on a 256-atom fcc, shift yes
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           real
atom_style      charge
lattice         fcc 5.4
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
group           odd id 1:256:2
set             group odd type 2
mass            1 39.948
mass            2 39.948
variable        dx atom 0.1*sin(0.31*x+0.27*y)
variable        dy atom 0.1*cos(0.23*y-0.19*z)
variable        dz atom 0.1*sin(0.17*z+0.29*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.004*sin(0.31*x+0.27*y)
variable        vy atom 0.004*cos(0.23*y-0.19*z)
variable        vz atom 0.004*sin(0.17*z+0.29*x)
velocity        all set v_vx v_vy v_vz units box
pair_style      lj/spica 8.0
pair_coeff      1 1 lj9_6 0.4 3.0 8.0
pair_coeff      1 2 lj12_4 0.3 3.1 8.0
pair_coeff      2 2 lj12_6 0.2 3.2 7.0
pair_modify     shift yes

timestep        2.0
fix             1 all nve
thermo_style    custom step temp pe evdwl ecoul elong etotal press
thermo_modify   format float %.15g
thermo          10
run             50
