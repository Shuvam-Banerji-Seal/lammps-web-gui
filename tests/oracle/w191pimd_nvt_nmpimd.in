# Measured with native LAMMPS: engine vs native (b332f28, installed /home/roy/.local/bin/lmp, PKG REPLICA) per partition: thermo max err 8.3e-13 (relative; absolute 1e-12 where the value is below 1e-12), per-atom max 8.0e-15 (4 beads, 50 steps, about 1.3 s engine incl. node start).
# oracle: w191pimd_nvt_nmpimd — fix pimd/nvt method nmpimd (normal-mode ring polymer, Nose-Hoover chains) on 4 beads
# oracle: (partitions) 3 atoms in metal units, 4 replicas (beads) with uloop-style per-bead seeds, 50 steps
# oracle-partitions: 4
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
variable ibead world 0 1 2 3
units metal
atom_style atomic
atom_modify map yes
boundary p p p
region box block -6 6 -6 6 -6 6
create_box 1 box
create_atoms 1 single -1.0 0.5 0.2
create_atoms 1 single 1.5 -0.7 0.9
create_atoms 1 single 0.3 2.0 -1.1
mass 1 12.0
pair_style lj/cut 5.0
pair_coeff * * 0.002 3.0
timestep 0.001
velocity all create 300.0 4321${ibead} mom yes rot no dist gaussian
fix 1 all pimd/nvt method nmpimd fmass 1.0 temp 300.0 nhc 4
thermo_style custom step temp f_1[1] f_1[2] f_1[3] pe
thermo_modify format float %.15g
thermo 10
run 50
