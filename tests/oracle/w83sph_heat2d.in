# oracle: w83sph_heat2d, cut-down of examples/PACKAGES/sph/heatconduction/sph_heat_conduction_2d.lmp (40 x 4 cells, 40 steps); z box -0.1..0.1 (the example's 0..0.1 is refused by native create_box in 2d). Measured max relative error vs native LAMMPS (black box): 1.2e-16 thermo, 0 per atom.
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
dimension       2
units           si
atom_style      sph
boundary        f p p

lattice         sq 0.01
region          box block 0 40 0 4 -0.1 0.1
create_box      1 box
create_atoms    1 box
mass            1 1.0e-5

region          left  block EDGE 19.9 EDGE EDGE EDGE EDGE
region          right block 20 EDGE EDGE EDGE EDGE EDGE
set             region left  sph/e 1.0
set             region right sph/e 2.0
set             group all sph/rho 0.1

pair_style      sph/heatconduction
pair_coeff      1 1 1.0e-4           2.0e-2

compute         ie_atom all sph/e/atom
compute         ie all reduce sum c_ie_atom

thermo          10
thermo_style    custom step temp c_ie
thermo_modify   format float %.15g
timestep        0.25e-1
neighbor        0.2e-2 bin
fix             integrate_fix all sph/stationary
run             40
