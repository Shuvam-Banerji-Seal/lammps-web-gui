# oracle: cut-down examples/bpm/impact (spring): fcc plate and projectile, bonds by create_bonds many, bonds break under impact
# oracle-compare: thermo=all atoms=all
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 1.0e-14, atoms 8.2e-15.
units           lj
dimension       3
boundary        f f f
atom_style      bond
special_bonds   lj 0.0 1.0 1.0 coul 0.0 1.0 1.0
newton          on off
comm_modify     vel yes cutoff 2.6
lattice         fcc 1.0
region          box block -12 8 -10 10 -10 10
create_box      1 box bond/types 2 extra/bond/per/atom 20
region          disk cylinder x 0.0 0.0 8.0 -0.5 0.5
create_atoms    1 region disk
group           plate region disk
region          ball sphere 4.0 0.0 0.0 3.0
create_atoms    1 region ball
group           projectile region ball
mass            1 1.0
neighbor        1.0 bin
pair_style      bpm/spring
pair_coeff      1 1 1.0 1.0 1.0
fix             1 all nve
create_bonds    many plate plate 1 0.0 1.5
create_bonds    many projectile projectile 2 0.0 1.5
neighbor        0.3 bin
special_bonds   lj 0.0 1.0 1.0 coul 1.0 1.0 1.0
bond_style      bpm/spring
bond_coeff      1 1.0 0.04 1.0
bond_coeff      2 1.0 0.20 1.0
velocity        projectile set -0.05 0.0 0.0
compute         nbond all nbond/atom
compute         tbond all reduce sum c_nbond
timestep        0.1
thermo_style    custom step ke pe c_tbond
thermo_modify   format float %.15g norm no
thermo          100
run             300
