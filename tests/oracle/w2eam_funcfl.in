# oracle: pair_style eam — two funcfl files, mixed A-B pair term
# oracle-inputs: w2eam_A.eam w2eam_B.eam
units           metal
atom_style      atomic
lattice         fcc 3.6
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
group           odd id 1:1000:2
set             group odd type 2
mass            * 60.0
variable        dx atom 0.06*sin(0.9*x+0.4*y)
variable        dy atom 0.06*cos(0.7*y-0.5*z)
variable        dz atom 0.06*sin(1.1*z+0.3*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 3.0*sin(0.5*x+0.2*z)
variable        vy atom 3.0*cos(0.4*y+0.6*x)
variable        vz atom 3.0*sin(0.3*z-0.5*y)
velocity        all set v_vx v_vy v_vz units box
velocity        all zero linear
pair_style      eam
pair_coeff      1 1 w2eam_A.eam
pair_coeff      2 2 w2eam_B.eam
timestep        0.001
fix             1 all nve
thermo_style    custom step temp pe etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          10
run             50
