# oracle: pair dpd cut down from examples/PACKAGES/dpd-basic/dpd/in.dpd, pair temperature 0 (no random force; the velocities are seeded natively)
# Measured with native LAMMPS (black box): engine vs native max relative error 3.1e-15 (thermo), 9.1e-14 (per-atom, scale max(1,|x|)). Noise off (pair temperature 0): the random term is 0; the velocities come from velocity create (seeded). Multi-pair system, no RNG dependence.
# oracle-compare: thermo=all atoms=all rel=1e-12 abs=0
variable T    equal 0.0
variable rc   equal 1.0
variable rcD  equal 1.2
units        lj
boundary     p p p
atom_style   atomic
dimension    3
newton       on
comm_modify  vel yes
variable     L equal 3.0
lattice      fcc 3.0
region       simBox block 0 ${L} 0 ${L} 0 ${L}
create_box   2 simBox
create_atoms 1 random 30 12456 simBox
create_atoms 2 random 30 13245 simBox
mass         1 1.0
mass         2 2.0
pair_style       dpd ${T} ${rc} 3854262
pair_coeff   1 1 25.0 4.5  1.2
pair_coeff   1 2 25.1 4.51 1.21
pair_coeff   2 2 25.2 4.52 1.22
timestep     0.01
run_style    verlet
velocity all create 1.0 68768932
thermo_style custom step time temp press pe ke
thermo_modify format float %.15g
thermo       10
fix 1 all    nve
run          50
