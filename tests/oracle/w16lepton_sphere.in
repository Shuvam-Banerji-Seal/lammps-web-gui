# oracle: pair_style lepton/sphere (radi, radj) with a contact-like term and a symmetric radius intermediate
units           lj
atom_style      sphere
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
set             group all diameter 1.0
set             group all density 1.0
set             type 2 diameter 1.3
variable        vx atom 0.5*sin(1.3*x+0.7*y)
variable        vy atom 0.5*cos(0.9*y-0.4*z)
variable        vz atom 0.5*sin(1.1*z+0.5*x)
velocity        all set v_vx v_vy v_vz
velocity        all zero linear
pair_style      lepton/sphere 2.0
pair_coeff      1 * "k*((r-r0)^2*step(r0-r)); k=20; r0=radi+radj" 2.0
pair_coeff      2 2 "4.0*eps*((sig/r)^12 - (sig/r)^6); eps=1.0; sig=2.0*sqrt(radi*radj)"
fix             1 all nve
thermo_style    custom step temp pe evdwl press
thermo_modify   format float %.15g
thermo          10
run             30
