# oracle: pair spin/dipole/long 8.0 with kspace_style pppm/dipole/spin 1.0e-4 (hybrid/overlay with spin/exchange 3.5), bcc iron 6x6x6 cells (432 random spins), nve/spin lattice frozen with zeeman precession, 20 steps
# measured with native LAMMPS (black box), engine vs native fixture: thermo max relative error 1.8e-13 (absolute 2.0e-9); spin dump (c_p columns, file compare) max relative 5.7e-10 (absolute 5.2e-8). G-ewald 0.0705, grid 2 2 2, order 5: the pppm field fm_long enters the sweep. Re-measured under Node 20: the same numbers.
# oracle-files: w103spin_pppm_dipole_frozen.dump
# oracle-compare: thermo=all atoms=none rel=1e-8 abs=1e-10
units           metal
atom_style      spin
dimension       3
boundary        p p p
atom_modify     map array
lattice         bcc 2.8665
region          box block 0.0 6.0 0.0 6.0 0.0 6.0
create_box      1 box
create_atoms    1 box
mass            1 55.845
set             group all spin/random 11 2.2
pair_style      hybrid/overlay spin/exchange 3.5 spin/dipole/long 8.0
pair_coeff      * * spin/exchange exchange 3.4 0.02726 0.2171 1.841
pair_coeff      * * spin/dipole/long 8.0
neighbor        0.1 bin
neigh_modify    every 10 check yes delay 20
kspace_style    pppm/dipole/spin 1.0e-4
fix             1 all precession/spin zeeman 0.001 0.0 0.0 1.0
fix_modify      1 energy yes
fix             2 all nve/spin lattice frozen
timestep        0.0001
compute         s all spin
compute         p all property/atom spx spy spz sp fmx fmy fmz
thermo_style    custom step pe c_s[1] c_s[2] c_s[3] c_s[4] c_s[5] c_s[6]
thermo_modify   format float %.15g
thermo          10
run             20
write_dump      all custom w103spin_pppm_dipole_frozen.dump id c_p[1] c_p[2] c_p[3] c_p[4] c_p[5] c_p[6] c_p[7] modify format float %.15g sort id
