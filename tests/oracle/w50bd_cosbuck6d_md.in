# oracle: angle_style cosine/buck6d with pair buck6d/coul/gauss/dsf, special_bonds lj 1-3 = 0, 50 NVE steps
# oracle-inputs: w50bd_mol_full.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-8
units           real
atom_style      full
read_data       w50bd_mol_full.data
bond_style      harmonic
bond_coeff      1 300 1.0
bond_coeff      2 300 1.2
angle_style     cosine/buck6d
angle_coeff     1 1.978350 4 120.0
angle_coeff     2 0.8 3 150.0
improper_style  harmonic
improper_coeff  1 10.0 0.0
pair_style      buck6d/coul/gauss/dsf 0.9 12.0
pair_coeff      1 1 1200.0 3.3 600.0 5.0 0.7
pair_coeff      1 2 800.0 2.7 250.0 3.8 0.45
pair_coeff      1 3 1030.0 3.061 457.179 4.521 0.608
pair_coeff      1 4 900.0 2.9 300.0 4.0 0.5
pair_coeff      2 2 1030.0 3.061 457.179 4.521 0.608
pair_coeff      2 3 900.0 2.9 300.0 4.0 0.5
pair_coeff      2 4 1200.0 3.3 600.0 5.0 0.7
pair_coeff      3 3 1200.0 3.3 600.0 5.0 0.7
pair_coeff      3 4 800.0 2.7 250.0 3.8 0.45
pair_coeff      4 4 1030.0 3.061 457.179 4.521 0.608
special_bonds   lj 1.0 0.0 0.0 coul 1.0 1.0 1.0
thermo_style    custom step pe eangle ebond eimp evdwl ecoul etotal press
thermo_modify   format float %.15g
timestep        0.5
velocity        all set 0.3 -0.2 0.1 units box
fix             1 all nve
thermo          10
run             50
