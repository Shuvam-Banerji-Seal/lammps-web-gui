# oracle: equal-style variable reference v_name in bond_style lepton (ramp evaluated every step), no_offset off
# oracle-inputs: mol_chains.data
units           lj
atom_style      molecular
variable        kk equal ramp(0.5,2.0)
bond_style      lepton
angle_style     harmonic
pair_style      zero 2.5
read_data       mol_chains.data
pair_coeff      * *
bond_coeff      1 1.05 "120.0*r^2 + 10*r^3"
bond_coeff      2 1.1 "v_kk*r^2 + 2.0*cos(3*r)"
angle_coeff     1 40.0 109.5
angle_coeff     2 25.0 120.0
dihedral_style  harmonic
dihedral_coeff  1 1.5 -1 3
improper_style  harmonic
improper_coeff  1 12.0 20.0
timestep        0.002
fix             1 all nve
thermo_style    custom step temp pe ebond eangle edihed eimp etotal press
thermo_modify   format float %.15g
thermo          10
run             50
