# oracle: fix neighbor/swap on a dynamic group (the atoms whose scaled |vx| has a fractional part above 0.5,
# re-evaluated every 2 steps): only the group's atoms are swapped, with Voronoi neighbors; binary lj/cut fcc with nve
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      atomic
atom_modify     map array sort 0 0.0
lattice         fcc 0.9
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
mass            * 1.0
variable        dx atom 0.08*sin(1.3*x+0.7*y)
variable        dy atom 0.08*cos(0.9*y)
displace_atoms  all move v_dx v_dy 0.0 units box
region          half block INF 2.5 INF INF INF INF units box
set             region half type 2
pair_style      lj/cut 1.4
pair_coeff      * * 1.0 1.0
neighbor        0.3 bin
timestep        0.005
velocity        all create 1.0 4928 loop geom
fix             1 all nve
variable        up atom (abs(vx)*1e2-floor(abs(vx)*1e2))>0.5
group           dyn dynamic all var up every 2
variable        ndyn equal count(dyn)
compute         v all voronoi/atom neighbors yes
fix             mc dyn neighbor/swap 2 5 12345 1.0 1.5 v types 2 1
thermo_style    custom step pe ke f_mc[1] f_mc[2] v_ndyn
thermo_modify   format float %.15g
thermo          4
run             12
