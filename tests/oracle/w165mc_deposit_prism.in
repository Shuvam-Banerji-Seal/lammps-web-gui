# oracle: fix deposit into a prism region (side in, tilted xy) with the rate keyword moving the insertion volume along z, 20 atoms every 3 steps
# Measured max relative error of the engine against native (thermo 4.9e-17, per-atom 5.6e-17). native: b332f28 (installed lmp, black box)
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      atomic
boundary        p p p
region          box block -5 5 -5 5 0 10
create_box      1 box
region          tilt prism -4 4 -4 4 6 9 1.0 0 0 side in
mass            * 1.0
pair_style      lj/cut 1.5
pair_coeff      * * 0.1 0.8 1.5
fix             1 all nve
fix             2 all deposit 20 1 3 9911 region tilt near 0.9 vz -0.1 -0.1 rate 0.2 attempt 10 units box
thermo_style    custom step pe ke atoms
thermo_modify   format float %.15g
thermo          10
run             60
