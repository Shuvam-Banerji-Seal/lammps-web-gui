# oracle: fix npt aniso and fix nph iso over two runs: the reference volume vol0 of the scalar's p_hydro (V - vol0) term is the one of the first run (native sets it once), and nph keeps the first run's barostat temperature t0
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 1.0
group           a id <= 54
group           b id > 54
variable        vx atom 1.4*sin(1.7*x+2.3*y+0.7*z)
variable        vy atom 1.4*cos(2.1*x-1.1*y+0.3*z)
variable        vz atom 1.4*sin(0.5*x+1.9*z+1.3*y)
velocity        all set v_vx v_vy v_vz units box
velocity        all zero linear
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
neighbor        0.3 bin
neigh_modify    every 1 delay 0 check yes
fix             1 all npt temp 1.2 1.2 0.5 aniso 1.5 1.5 1.0
thermo_style    custom step temp press lx ly lz pe etotal vol f_1 f_1[7] f_1[8] f_1[9] f_1[10] f_1[11] f_1[12]
thermo_modify   format float %.15g
thermo          5
run             30
run             30
unfix           1
fix             2 all nph iso 1.0 1.0 1.0
thermo_style    custom step temp press lx ly lz pe etotal vol f_2
thermo_modify   format float %.15g
run             20
velocity        all scale 2.0
run             20
