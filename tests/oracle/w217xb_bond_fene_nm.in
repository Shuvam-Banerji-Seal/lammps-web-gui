# oracle: bond_style fene/nm (K R0 epsilon sigma n m; two bond types, the 9-6 tail of type 2 and the 12-6 tail of type 1), 150 steps, nve
# native: b332f28 (installed /home/roy/.local/bin/lmp)
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 8.6e-14, atoms 1.4e-13.
# oracle-inputs: w217xb_mol.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      molecular
bond_style      fene/nm
angle_style     harmonic
dihedral_style  harmonic
improper_style  harmonic
pair_style      zero 2.5
read_data       w217xb_mol.data
pair_coeff      * *
bond_coeff      1 30.0 2.0 1.0 1.6 12 6
bond_coeff      2 20.0 2.2 0.8 1.7 9 6
angle_coeff     1 20.0 110.0
angle_coeff     2 15.0 105.0
dihedral_coeff  1 1.5 -1 3
dihedral_coeff  2 0.7 1 2
improper_coeff  1 12.0 20.0
special_bonds   lj 0.0 1.0 1.0
variable        vx atom 0.02*sin(1.3*x+0.7*y)
variable        vy atom 0.02*cos(0.9*y-0.4*z)
variable        vz atom 0.02*sin(1.1*z+0.5*x)
velocity        all set v_vx v_vy v_vz
velocity        all zero linear
timestep        0.0005
fix             1 all nve
thermo_style    custom step pe ebond eangle edihed eimp ke press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g norm no
thermo          25
run             150
