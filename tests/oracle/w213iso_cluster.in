# oracle: fix graphics/isosurface on a small LJ cluster that straddles the periodic x and y faces (56 atoms of two types, 12 sigma box), so ghost atoms take part in the grid: the number density of type-1 atoms (quality min, Nevery 5) and the mass density of all atoms (quality low, pad 3, Nevery 10), written as STL text files at setup and on the end-of-step stages of a 10-step NVE run (neighbor lists rebuilt every step)
# oracle-files: w213iso_a.0.stl w213iso_a.5.stl w213iso_a.10.stl w213iso_b.000.stl w213iso_b.010.stl
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 7 0 7 0 7
create_box      2 box
region          ball sphere 0.2 0.3 3.5 1.9
create_atoms    1 region ball
set             type 1 type/fraction 2 0.3 12345
mass            1 1.0
mass            2 2.0
velocity        all create 1.0 87287 loop geom
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0 2.5
neighbor        0.3 bin
neigh_modify    every 1 delay 0 check no
group           light type 1
fix             1 all nve
fix             iso light graphics/isosurface 5 0.5 1.0 quality min filename w213iso_a.*.stl
fix             iso2 all graphics/isosurface 10 1.2 0.8 quality low property mass filename w213iso_b.*.stl pad 3
thermo          5
thermo_style    custom step temp pe
thermo_modify   format float %.15g
run             10
