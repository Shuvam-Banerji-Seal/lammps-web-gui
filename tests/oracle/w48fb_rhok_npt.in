# oracle: fix rhok in a cut-down of examples/PACKAGES/rhok/in.pinning (npt with an anisotropic z barostat, bias K = 4)
# oracle-compare: thermo=all atoms=all rel=1e-7 abs=1e-9
units           lj
dimension       3
boundary        p p p
atom_style      atomic
pair_style      lj/cut 2.5
pair_modify     shift yes
lattice         fcc 0.9731
region          my_box block 0 2.0 0 2.0 0 5.0
create_box      1 my_box
region          particles block 0 2.0 0 2.0 0 5.0
create_atoms    1 region particles
pair_coeff      1 1 1.0 1.0 2.5
variable        dx atom 0.05*sin(2.1*x+0.7*y)
variable        dy atom 0.05*cos(1.3*y-0.9*z)
variable        dz atom 0.05*sin(1.7*z+0.4*x)
displace_atoms  all move v_dx v_dy v_dz units box
pair_modify     tail no
mass            1 1.0
velocity        all create 1.6 1 mom yes rot yes loop all
neighbor        0.6 bin
timestep        0.004
run_style       verlet
fix             ensemble all npt temp 0.8 0.8 4.0 z 2.185 2.185 8.0 pchain 32
fix             bias all rhok 1 0 0 4.0 1.0
thermo          4
thermo_style    custom step temp press density f_bias f_bias[1] f_bias[2] f_bias[3]
run             16
