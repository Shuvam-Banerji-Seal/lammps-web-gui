# oracle: fix adapt on lj/cut/coul/long epsilon and sigma (native extract() names, init_one re-derives lj1..lj4), every 5 steps with scale yes and reset yes, then a run that starts from the restored values; pppm on a charged two-type lattice
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=1e-10
units           lj
atom_style      charge
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
mass            * 1.0
set             group all type/fraction 2 0.5 4321
set             type 1 charge 0.5
set             type 2 charge -0.5
velocity        all create 1.2 87287 loop geom
pair_style      lj/cut/coul/long 2.5
pair_coeff      1 1 1.0 1.0
pair_coeff      2 2 0.8 1.05
pair_coeff      1 2 0.9 1.02
kspace_style    pppm 1.0e-5
variable        e equal 1.0+0.002*elapsed
variable        s equal 1.0-0.0005*elapsed
fix             1 all nve
fix             2 all adapt 5 pair lj/cut/coul/long epsilon 1 1 v_e pair lj/cut/coul/long sigma 2 2 v_s scale yes reset yes
thermo_style    custom step temp pe evdwl ecoul elong press
thermo_modify   format float %.15g
thermo          10
run             50
unfix           2
run             20
