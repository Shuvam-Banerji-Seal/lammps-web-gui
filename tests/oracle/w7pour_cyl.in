# oracle: fix pour cylinder region (z axis, side in), diam range, dens range, vel ranges, id next — 16 particles in a radius-3 cylinder, pair gran/hooke, fix nve/sphere, floor wall/gran
# oracle-compare: thermo=all atoms=all
units           lj
atom_style      sphere
atom_modify     map array
comm_modify     vel yes
boundary        p p f
region          box block -10 10 -10 10 -10 10
create_box      1 box
region          cyl cylinder z 0 0 3 0 3 side in units box
pair_style      gran/hooke 2000.0 700.0 50.0 30.0 0.5 1
pair_coeff      * *
timestep        0.002
fix             1 all nve/sphere
fix             2 all gravity 1.0 vector 0 0 -1
fix             4 all wall/gran hooke 2000.0 700.0 50.0 30.0 0.5 1 zplane -2.0 NULL
fix             3 all pour 16 1 4242 region cyl diam range 0.6 0.9 dens 0.8 1.6 vel -0.2 0.2 -0.2 0.2 0.0 vol 0.02 100 id next
compute         er all erotate/sphere
thermo_style    custom step atoms ke c_er
thermo_modify   format float %.15g
thermo          200
run             4000
