# oracle: compute ackland/atom (default algorithm) on a displaced hcp lj crystal (orthorhombic 4-atom cell, 3x3x3 cells, 108 atoms), 5 steps of nve; the structure of each atom is dumped at steps 0 and 5
# oracle: native: b332f28 (installed lmp; compute ackland/atom is in the EXTRA-COMPUTE package of that binary)
# oracle-files: w227xc_ackland_hcp.dump
# oracle-compare: thermo=all atoms=none filerel=1e-12
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 2.5e-15, atoms n/a (atoms=none; the per-atom structure is the dump file, worst token 0).
units           lj
atom_style      atomic
lattice         custom 1.0 a1 1 0 0 a2 0 1.732050808 0 a3 0 0 1.632993162 &
                basis 0.0 0.0 0.0 basis 0.5 0.5 0 basis 0 0.3333333 0.5 basis 0.5 0.8333333 0.5
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 1.0
variable        dx atom 0.1*sin(2.1*x+1.3*y+0.2*z)
variable        dy atom 0.1*cos(1.6*y-0.9*x+0.4*z)
variable        dz atom 0.1*sin(1.2*z+0.6*x-0.7*y)
displace_atoms  all move v_dx v_dy v_dz units box
velocity        all create 0.5 2468 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
compute         ack all ackland/atom
compute         ackS all reduce sum c_ack
dump            d1 all custom 5 w227xc_ackland_hcp.dump id c_ack
dump_modify     d1 sort id format float %.15g
fix             1 all nve
thermo_style    custom step pe ke c_ackS
thermo_modify   format float %.15g
thermo          5
run             5
