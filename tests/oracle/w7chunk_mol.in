# oracle: molecule chunks from a data file: com/chunk via fix ave/time vector mode, and fix ave/chunk vx per molecule
# oracle-inputs: mol_chains.data
# oracle-files: molcom.txt molvx.txt
units           lj
atom_style      molecular
bond_style      harmonic
angle_style     harmonic
dihedral_style  harmonic
improper_style  harmonic
pair_style      lj/cut 2.5
read_data       mol_chains.data
pair_coeff      * * 0.5 0.9
pair_coeff      1 3 0.8 1.0
bond_coeff      1 120.0 1.05
bond_coeff      2 90.0 1.1
angle_coeff     1 40.0 109.5
angle_coeff     2 25.0 120.0
dihedral_coeff  1 1.5 -1 3
improper_coeff  1 12.0 20.0
special_bonds   lj 0.0 0.5 0.8
timestep        0.002
fix             1 all nve
compute         cm all chunk/atom molecule
compute         mc all com/chunk cm
fix             2 all ave/time 5 1 5 c_mc[*] mode vector file molcom.txt
fix             3 all ave/chunk 5 1 5 cm vx norm all file molvx.txt
thermo_style    custom step temp pe etotal c_cm
thermo_modify   format float %.15g
thermo          10
run             30
