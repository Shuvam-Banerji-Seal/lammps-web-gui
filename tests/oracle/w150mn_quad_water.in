# oracle: min_style cg, default min_modify line quadratic, 4 TIP3P-like waters in real units (no SHAKE), 30 iterations, every thermo row (pe, fnorm)
# Measured with native LAMMPS (black box), all 20 rows: max relative error of the engine pe 2.8e-15, fnorm 5.7e-14.
# oracle-inputs: w150mn_water.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           real
atom_style      full
boundary        p p p
read_data       w150mn_water.data
bond_style      harmonic
bond_coeff      1 450.0 0.9572
angle_style     harmonic
angle_coeff     1 55.0 104.52
pair_style      lj/cut/coul/cut 8.0
pair_coeff      1 1 0.1521 3.1507
pair_coeff      2 2 0.0 1.0
pair_coeff      1 2 0.0 1.0
neighbor        2.0 bin
min_style       cg
thermo_style    custom step pe fnorm
thermo_modify   format float %.15g
thermo          1
minimize        0 0 30 1000
