# oracle: dump file formats at a deterministic state
# oracle-files: d.atom d.custom d.xyz d.data
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 2 0 2 0 2
create_box      2 box
create_atoms    1 box
set             atom 3 type 2
mass            * 1.0
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0 2.5
dump            1 all atom 10 d.atom
dump            2 all custom 10 d.custom id type x y z xu vx fx mass ix
dump            3 all xyz 10 d.xyz
thermo_style    custom step pe
thermo_modify   format float %.15g
run             0
write_data      d.data
