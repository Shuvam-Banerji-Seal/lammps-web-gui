# oracle: fix bond/swap with FENE bonds, harmonic angles (120 degrees) and a WCA pair style on 14 straight four-bead chains (56 atoms, periodic box 12, atom_style angle), special_bonds 0 1 1, every 2 steps with all atoms tried (fraction 1.0) and cutoff 2.0, 30 steps
# oracle-inputs: w224mc_bondswap_angles.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 4.3e-15, atoms 8.9e-14.
units           lj
atom_style      angle
read_data       w224mc_bondswap_angles.data extra/special/per/atom 8
special_bonds   lj 0.0 1.0 1.0
pair_style      lj/cut 1.12246
pair_coeff      1 1 1.0 1.0
bond_style      fene
angle_style     harmonic
angle_coeff     1 1.0 120.0
bond_coeff      1 0.3 2.5 1.0 1.0
timestep        0.001
velocity        all create 1.0 4928459 loop geom
fix             integ all nve
fix             bs all bond/swap 2 1.0 2.0 4321
thermo_style    custom step pe ke f_bs[1] f_bs[2]
thermo_modify   format float %.15g
thermo          1
run             30
