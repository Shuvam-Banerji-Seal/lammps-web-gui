# oracle: fix adapt on coul/long scale under pair hybrid/overlay (a decoupling ramp of the 1-2 Coulomb term, native prefactor qqrd2e * scale * qi qj / r), pppm, every 5 steps with reset yes, then a run from the restored values
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=1e-10
units           lj
atom_style      charge
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
mass            * 1.0
set             group all type/fraction 2 0.5 4321
set             type 1 charge 0.5
set             type 2 charge -0.5
velocity        all create 1.2 87287 loop geom
pair_style      hybrid/overlay lj/cut 2.5 coul/long 2.5
pair_coeff      * * lj/cut 1.0 1.0
pair_coeff      * * coul/long
kspace_style    pppm 1.0e-5
variable        s equal 1.0-0.01*elapsed
fix             1 all nve
fix             2 all adapt 5 pair coul/long scale 1 2 v_s reset yes
thermo_style    custom step temp pe evdwl ecoul elong press
thermo_modify   format float %.15g
thermo          10
run             50
unfix           2
run             20
