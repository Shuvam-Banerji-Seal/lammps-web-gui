# oracle: fix numdiff per-atom finite-difference force array equals the lj/cut analytic forces (dump and compute reduce sumsq)
units           lj
atom_style      atomic
atom_modify     map yes
boundary        p p p
region          box block 0 8 0 8 0 8
create_box      1 box
create_atoms    1 single 3.0 4.0 4.0
create_atoms    1 single 4.5 4.0 4.0
create_atoms    1 single 4.0 5.2 4.0
create_atoms    1 single 4.3 3.3 4.7
mass            1 1.0
pair_style      lj/cut 3.0
pair_coeff      1 1 1.0 1.0
pair_modify     tail yes
fix             fd all numdiff 1 1e-6
fix             nve all nve
compute         fsq all reduce sumsq f_fd[1] f_fd[2] f_fd[3]
dump            d all custom 1 w16numdiff_forces.dump id fx fy fz f_fd[1] f_fd[2] f_fd[3]
dump_modify     d format float %.17g
thermo          1
thermo_style    custom step c_fsq[1] c_fsq[2] c_fsq[3]
thermo_modify   format float %.15g
run             4
# oracle-files: w16numdiff_forces.dump
