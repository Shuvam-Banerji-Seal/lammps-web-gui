# oracle: fix qeq/point, four charged atoms in metal units, tolerance 1e-12 (f_q = iterations at tight tolerance), pair coul/cut, run 0
# measured max error vs native (relative): thermo 3.8e-16, atoms 4.4e-16, f_q equal. Main before this port: the same (no fixed charges, no images).
# oracle-inputs: w32qeq_point.params
# oracle-files: w123q_point_tight_q.dump
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10 atomrel=1e-8
units metal
atom_style charge
boundary f f f
region box block 0 30 0 30 0 30
create_box 2 box
create_atoms 1 single 5 15 15
create_atoms 2 single 7 15 15
create_atoms 1 single 9 15 15
create_atoms 2 single 11 15 15
mass 1 1.0
mass 2 1.0
set atom 1 charge 0.0
set atom 2 charge 0.0
set atom 3 charge 0.0
set atom 4 charge 0.0
pair_style coul/cut 20.0
pair_coeff * *
fix q all qeq/point 1 20 1.0e-12 200 w32qeq_point.params
thermo_style custom step pe ecoul f_q
thermo_modify format float %.15g
run 0
write_dump all custom w123q_point_tight_q.dump id q modify format float %.15g sort id
