# oracle: dump_modify thresh LAST compares with the values stored at the previous snapshot for every atom, chosen or not
# oracle-files: last.dump
units           lj
atom_style      atomic
region          box block 0 10 0 10 0 10
create_box      2 box
create_atoms    1 single 1.0 1.0 1.0
create_atoms    1 single 3.0 1.0 1.0
create_atoms    2 single 5.0 1.0 1.0
create_atoms    2 single 7.0 1.0 1.0
mass            * 1.0
pair_style      zero 2.5
pair_coeff      * *
# per-step values: atom 1 goes 0, 1, 0.5, 0.7, 0.2; atom 2 goes 0, 0.5, 1, 0.8, 0.9; atoms 3 and 4 scale with their id
variable        a1 atom (step==1)*1+(step==2)*0.5+(step==3)*0.7+(step==4)*0.2
variable        a2 atom (step==1)*0.5+(step==2)*1+(step==3)*0.8+(step==4)*0.9
variable        f atom (id==1)*v_a1+(id==2)*v_a2+(id>2)*id*v_a1
fix             1 all nve
dump            d all custom 1 last.dump id type v_f
dump_modify     d thresh v_f > LAST
thermo_style    custom step pe
thermo_modify   format float %.15g
run             4
# a LAST criterion followed by a plain one (native indexes its LAST slots by the LAST count, so a LAST criterion after a
# plain one reads an unset slot; that order is left out); the second run's values: atom 1 0.3, 0.1, 0.4, 0.4
variable        b atom (step==5)*0.3+(step==6)*0.1+(step==7)*0.4+(step==8)*0.4
variable        g atom v_b*id
undump          d
dump            e all custom 1 last.dump id type v_g
dump_modify     e append yes thresh v_g < LAST thresh type == 1
run             4
