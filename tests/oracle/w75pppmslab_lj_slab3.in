# oracle: PPPM slab box with automatic G-ewald and mesh (no gewald, no mesh): lj units, 6x6x5 sc cells (reduced density 1.6), kspace_modify slab 3.0, accuracy 1e-4, unit charges
units           lj
atom_style      charge
boundary        p p f
lattice         sc 1.6
region          box block 0 6 0 6 0 5 units lattice
create_box      2 box
create_atoms    1 box
group           odd id 2:180:2
set             group odd type 2
mass            * 1.0
set             type 1 charge 1.0
set             type 2 charge -1.0
variable        dz atom 0.02+0.02*sin(0.4*x+0.3*y)
displace_atoms  all move 0.0 0.0 v_dz units box
variable        vx atom 0.02*sin(0.6*x+0.2*z)
variable        vy atom 0.02*cos(0.5*y+0.3*x)
variable        vz atom 0.01*sin(0.4*z-0.5*y)
velocity        all set v_vx v_vy v_vz units box
pair_style      lj/cut/coul/long 2.5
pair_coeff      * * 0.1 0.5
pair_modify     table 0
kspace_style    pppm 1.0e-4
kspace_modify   slab 3.0
fix             1 all nve
thermo_style    custom step temp pe evdwl ecoul elong etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          10
run             20
