# oracle: compute efield/atom (default keywords: pair and kspace) with the lj/cut/coul/cut/dielectric pair style and no kspace, per-atom field dumped
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 5.7e-16, atoms 3.2e-16.
# oracle-inputs: w226cs_diel.data
# oracle-files: w243de_efield_cutcoul.dump
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=1e-12 filerel=1e-10
units           real
atom_style      dielectric
read_data       w226cs_diel.data
pair_style      lj/cut/coul/cut/dielectric 0.2 8.0
pair_coeff      * * 0.02 2.0
bond_style      harmonic
bond_coeff      1 100.0 1.5
special_bonds   lj/coul 0.0 0.5 1.0
compute         ef all efield/atom
thermo_style    custom step pe ecoul evdwl
thermo_modify   format float %.15g
dump            d all custom 1 w243de_efield_cutcoul.dump id c_ef[1] c_ef[2] c_ef[3]
dump_modify     d sort id format float %.15g
run             0
