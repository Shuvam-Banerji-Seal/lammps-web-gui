# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
# oracle: peri/pmb on a 6x6x6 cell block with sinusoidal initial velocities; bonds stretch, break (s00 small) and damage is summed in thermo
units           si
boundary        s s s
atom_style      peri
atom_modify     map array
neighbor        0.0010 bin
lattice         sc 0.0005
region          target block 0 6 0 6 0 6 units lattice
create_box      1 target
create_atoms    1 box
pair_style      peri/pmb
pair_coeff      * * 1.6863e22 0.0015001 0.0005 0.25
set             group all density 2200
set             group all volume 1.25e-10
variable        vx atom 60.0*sin(2000*y+0.3)
variable        vy atom 60.0*cos(2500*z)
variable        vz atom 60.0*sin(1800*x)
velocity        all set v_vx v_vy v_vz units box
fix             1 all nve
compute         1 all damage/atom
compute         2 all reduce sum c_1
timestep        1.0e-7
thermo_style    custom step pe ke etotal c_2
thermo_modify   format float %.15g norm no
thermo          10
run             100
