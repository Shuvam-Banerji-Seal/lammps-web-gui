# oracle: fix numdiff/virial in a periodic bulk liquid. As native LAMMPS does (src/EXTRA-FIX/fix_numdiff_virial.cpp
#   at b332f28), the owned and ghost atoms of the step's lists are strained together about the box centre of the fix
#   definition, with native's directions (yz moves y by z, xz and xy move x); the engine strained only the owned atoms
#   and rebuilt the ghosts from the unstrained box (examples/numdiff/in.numdiff: xx about 0 instead of 912). Compared
#   with the pressure compute's virial too. The finite differences carry rounding noise of about 1e-7 (delta 1e-6).
# oracle-compare: thermo=all rel=1e-7 abs=1e-5
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 2.0 87287 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
compute         vir all pressure NULL virial
fix             fd all numdiff/virial 10 1e-6
fix             nve all nve
thermo          10
thermo_style    custom step pe f_fd[1] f_fd[2] f_fd[3] f_fd[4] f_fd[5] f_fd[6] c_vir[1] c_vir[2] c_vir[3] c_vir[6] c_vir[5] c_vir[4]
thermo_modify   format float %.15g
run             30
