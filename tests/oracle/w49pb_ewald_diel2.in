# oracle: kspace_style ewald with the dielectric command (2.0) on the periodic charged system of w49pb_pppm_dielectric
# oracle-compare: thermo=all atoms=all abs=1e-9
units real
atom_style full
lattice sc 4.0
region box block 0 4 0 4 0 4
create_box 2 box
create_atoms 1 box
mass * 12.0
set type 1 charge 0.4
region half block 0 2 INF INF INF INF
set region half type 2
set type 2 charge -0.4
variable dx atom 0.3*sin(1.3*x+0.7*y)
variable dy atom 0.3*cos(0.9*y-0.4*z)
displace_atoms all move v_dx v_dy 0.0 units box
pair_style lj/cut/coul/long 6.0
pair_coeff * * 0.1 3.0
dielectric 2.0
kspace_style ewald 1.0e-5
thermo_style custom step pe evdwl ecoul elong press
thermo_modify format float %.15g norm no
run 0
