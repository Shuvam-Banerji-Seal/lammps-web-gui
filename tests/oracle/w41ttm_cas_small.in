# Wave 41: fix ttm/cascade (docs.lammps.org/fix_ttm.html, section "Additional details for fix ttm/cascade") on an eight-atom
# sc crystal, 2x2x2 electron grid, rho_e 2, C_e and kappa_e from tables (the positional values are overwritten),
# cutoff keyword, mixed speeds around v_0 = 2, gamma_p 20 and gamma_s 5, seed 77; two runs.
# oracle-inputs: w41ttm_cas.init w41ttm_ce.tab w41ttm_ke.tab
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           metal
atom_style      atomic
lattice         sc 3.0
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box
mass            1 10.0
displace_atoms  all move 0.5 0.5 0.5 units box
variable        vx atom 3.0*sin(0.9*x+0.4*y)
variable        vy atom 0.5*cos(0.7*y-0.5*z)
variable        vz atom 0.4*sin(1.1*z+0.3*x)
velocity        all set v_vx v_vy v_vz units box
pair_style      lj/cut 3.0
pair_coeff      1 1 0.0 2.0
fix             1 all nve
fix             2 all ttm/cascade 77 3.0 2.0 0.5 20.0 5.0 2.0 2 2 2 infile w41ttm_cas.init cetab w41ttm_ce.tab ketab w41ttm_ke.tab cutoff
timestep        0.01
thermo_style    custom step temp pe f_2[1] f_2[2]
thermo_modify   format float %.15g
thermo          1
run             4
run             3
