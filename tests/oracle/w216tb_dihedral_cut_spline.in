# oracle: dihedral_style table/cut spline 360 with a NOF table (type 1) and a RADIANS table (type 2)
# oracle-inputs: w216tb_chains.data w216tb_dihedral.table
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 3.6e-14, atoms 7.0e-15.
# timestep 0.0005 (not 0.002): the cut term amplifies rounding (Math.acos differs from glibc in the last bit for about 7% of arguments), so the shorter run stays at rounding level.
units           lj
atom_style      molecular
read_data      w216tb_chains.data
pair_style      lj/cut 1.0
pair_coeff      * * 0.0 1.0
timestep       0.0005
dihedral_style  table/cut spline 360
dihedral_coeff 1 aat 1.5 95.0 125.0 w216tb_dihedral.table DNOF
dihedral_coeff 2 aat 2.5 100.0 118.0 w216tb_dihedral.table DRAD
fix             1 all nve
thermo          10
thermo_style    custom step pe ebond eangle edihed ke press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
run             100
