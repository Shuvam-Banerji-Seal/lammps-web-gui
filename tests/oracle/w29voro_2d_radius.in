# oracle: compute voronoi/atom radical tessellation (radius v_rad) in a 2d periodic box with two atom types
# oracle-files: w29voro_2d_radius.dump
units           lj
dimension       2
boundary        p p p
atom_style      atomic
lattice         sq 1.0 origin 0.5 0.5 0.0
region          box block 0 3 0 3 -1.0 1.0 units box
region          atoms block 0 3 0 3 0.0 0.0 units box
create_box      2 box
create_atoms    1 region atoms
mass            * 1.0
region          left block INF 1.0 INF INF -0.5 0.5 units box
group           small region left
set             group small type 2
variable        rad atom (type==1)*0.3+(type==2)*0.15
pair_style      lj/cut 0.5
pair_coeff      * * 0.0 1.0
neighbor        0.3 nsq
comm_modify     cutoff 5.0
compute         v all voronoi/atom radius v_rad
thermo_style    custom step pe
thermo_modify   format float %.15g
dump            d all custom 1 w29voro_2d_radius.dump id type c_v[*]
dump_modify     d sort id format float %.17g
run             0
