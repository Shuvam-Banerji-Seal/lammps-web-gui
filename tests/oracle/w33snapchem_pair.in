# oracle: pair_style snap chemflag 1 (real InP_JCPA2020 SNAP files), two-element cluster, pe and forces at step 0
# oracle-inputs: w33snapchem_InP.snapcoeff w33snapchem_InP.snapparam
# oracle-compare: thermo=first-last
units           metal
atom_style      atomic
region          box block 0 8 0 8 0 8
create_box      2 box
create_atoms    1 single 1.00 1.00 1.00
create_atoms    2 single 2.55 1.10 1.05
create_atoms    1 single 1.05 2.75 1.00
create_atoms    2 single 2.50 2.60 1.15
create_atoms    1 single 1.00 1.05 3.20
create_atoms    2 single 2.70 1.20 3.40
mass            1 114.76
mass            2 30.98
pair_style      snap
pair_coeff      * * w33snapchem_InP.snapcoeff w33snapchem_InP.snapparam In P
thermo_style    custom step pe evdwl
thermo_modify   format float %.15g
run             0
