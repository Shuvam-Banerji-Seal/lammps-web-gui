# oracle: pair ldd with the tabulated pair table of examples/PACKAGES/bocs/4_sites_LD_SG/in.ldd_molecule (hybrid/overlay ldd table spline 3000), 240 atoms, NVE for 10 steps; thermo compared at 1e-8, forces not compared (the table spline term alone differs from native by about 1e-6 relative, a core style; w112ldd_molecule_ld carries the per-atom check of ldd)
# measured: thermo agrees at 1e-8. Per-atom forces are not compared here; the hybrid run differs from native by 5.9e-13 (atom 62 fy). The per-atom check of ldd is w112ldd_molecule_ld.
# oracle-inputs: w112ldd_molecule.data w112ldd_bonded.lammps w112ldd_ABCD.ldd w112ldd_nb_ACA_ACA.table w112ldd_LD_table.11.noself.dat w112ldd_LD_table.22.noself.dat w112ldd_LD_table.33.noself.dat w112ldd_LD_table.44.noself.dat w112ldd_SG_table.1.1.noself.dat w112ldd_SG_table.2.2.noself.dat w112ldd_SG_table.3.3.noself.dat w112ldd_SG_table.4.4.noself.dat
# oracle-compare: thermo=all atoms=none rel=1e-8 abs=1e-10
units           real
dimension       3
boundary        p p p
atom_style      full
read_data       w112ldd_molecule.data
pair_style      hybrid/overlay ldd table spline 3000
bond_style harmonic
angle_style harmonic
dihedral_style harmonic
improper_style none
include w112ldd_bonded.lammps
pair_coeff      * * table w112ldd_nb_ACA_ACA.table nb_ACA_ACA 15.0
pair_coeff      * * ldd w112ldd_ABCD.ldd A B C D
timestep        0.5
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes
thermo_style    custom step temp ke pe evdwl ebond eangle edihed etotal
thermo_modify   format float %.15g
thermo          5
fix             1  all      nve
run 10
