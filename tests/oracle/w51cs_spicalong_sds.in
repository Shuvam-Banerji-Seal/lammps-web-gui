# oracle: cut-down of examples/PACKAGES/cgspica/sds-monolayer (in.sds-regular; 120 molecules, pppm instead of pppm/cg, 50 steps)
# oracle-inputs: w51cs_sds_cut.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           real
dimension       3
atom_style      full
pair_style      lj/spica/coul/long 15.0
bond_style      harmonic
angle_style     spica
special_bonds   lj/coul 0.0 0.0 1.0
read_data       w51cs_sds_cut.data
pair_coeff  1     1      lj9_6  0.7000 4.3210
pair_coeff  1     2      lj9_6  0.3830 4.4135
pair_coeff  1     3      lj9_6  0.4050 4.4530
pair_coeff  1     4      lj12_4 1.1000 4.1000
pair_coeff  1     5      lj12_4 1.1000 4.1000
pair_coeff  2     2      lj9_6  0.4200 4.5060
pair_coeff  2     3      lj9_6  0.4440 4.5455
pair_coeff  2     4      lj12_4 0.3400 4.4385
pair_coeff  2     5      lj12_4 0.3400 4.4385
pair_coeff  3     3      lj9_6  0.4690 4.5850
pair_coeff  3     4      lj12_4 0.3600 4.4780
pair_coeff  3     5      lj12_4 0.3600 4.4780
pair_coeff  4     4      lj12_4 0.3500 4.3710
pair_coeff  4     5      lj12_4 0.8950 4.3710
pair_coeff  5     5      lj12_4 0.8950 4.3710
kspace_style    pppm 0.00001
# native auto-choice here is G 0.015838529 on mesh 2 1 3 (the engine's auto choice differs); both pinned
kspace_modify   order 3 gewald 0.015838529 mesh 2 1 3
neighbor        2.0 bin
neigh_modify    delay 4 every 2 check yes
timestep        10.0
fix             1 all nvt temp 310.0 310.0 100.0
thermo_style    custom step temp pe evdwl ecoul elong ebond eangle etotal press
thermo_modify   format float %.15g
thermo          10
run             50
