# oracle: velocity create/scale bias yes temp/cs on a core/shell system — create rescales with the plain temperature then removes the pair-COM bias
# oracle-inputs: w26velbias_cs.data
units           metal
atom_style      full
boundary        p p p
read_data       w26velbias_cs.data
comm_modify     vel yes
group           cores type 1
group           shells type 2
pair_style      zero 10.0
pair_coeff      * *
bond_style      harmonic
bond_coeff      1 100.0 0.1
compute         Tplain all temp
compute         CStemp all temp/cs cores shells
thermo_style    custom step temp c_Tplain c_CStemp
thermo_modify   format float %.15g
thermo          1
velocity        all create 1427.0 134 dist gaussian mom yes rot no bias yes temp CStemp
run             0
velocity        all scale 1427.0 temp CStemp
run             0
velocity        all scale 1427.0 bias yes temp CStemp
run             0
