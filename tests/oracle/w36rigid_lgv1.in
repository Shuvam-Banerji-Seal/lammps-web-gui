# oracle: fix rigid single with the langevin keyword (drag + random force/torque), 200 steps
# oracle-inputs: rigid_tetra.txt
# oracle-compare: abs=1e-8
units           lj
atom_style      molecular
region          box block 0 12 0 12 0 12 units box
create_box      2 box
mass            1 1.0
mass            2 1.5
molecule        t rigid_tetra.txt
create_atoms    0 single 6 6 6 mol t 1 rotate 0 0 0 1 units box
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
pair_coeff      2 2 0.8 1.05
pair_coeff      1 2 0.9 1.02
variable        vx atom 0.4*sin(0.7*x+0.3*z)
variable        vy atom 0.4*cos(0.5*y+0.6*x)
variable        vz atom 0.4*sin(0.6*z-0.2*y)
velocity        all set v_vx v_vy v_vz units box
timestep        0.002
fix             1 all rigid single langevin 0.8 0.8 0.5 373592
thermo_style    custom step temp pe ke etotal f_1[1][1] f_1[1][2] f_1[1][3] f_1[1][4] f_1[1][5] f_1[1][6] f_1[1][10] f_1[1][11] f_1[1][12]
thermo_modify   format float %.15g
thermo          20
run             200
