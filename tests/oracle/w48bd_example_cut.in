# oracle: examples/body/in.body (100 two-dimensional nparticle bodies, LJ between sub-particles, fix nve/body with enforce2d) cut to 200 steps with velocity create loop all (the engine's loop geom seeds differ from native); thermo temp, pe, press, etotal
# oracle-inputs: w48bd_example.data
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           lj
dimension       2
atom_style      body nparticle 2 6
read_data       w48bd_example.data
velocity        all create 1.44 87287 loop all
pair_style      body/nparticle 5.0
pair_coeff      * * 1.0 1.0
neighbor        0.5 bin
neigh_modify    every 1 delay 0 check yes
fix             1 all nve/body
fix             2 all enforce2d
thermo_style    custom step temp pe ke etotal press
thermo_modify   format float %.15g
thermo          50
run             200
