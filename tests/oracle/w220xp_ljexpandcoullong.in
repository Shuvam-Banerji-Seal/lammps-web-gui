# oracle: pair lj/expand/coul/long 2.5 3.0 with ewald 1e-5, delta shift 0.1 (mixed for I != J), charges +1/-1, pair_modify shift yes, 216 atoms NVE 200 steps
# oracle-compare: thermo=all atoms=all rel=1e-12 abs=1e-13
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 1.2e-13, atoms 2.6e-13.
units        lj
boundary     p p p
atom_style   charge
lattice      sc 0.5
region       box block 0 6 0 6 0 6
create_box   2 box
create_atoms 1 box
set          group all type/fraction 2 0.5 4321
set          type 1 charge 1.0
set          type 2 charge -1.0
mass         * 1.0
velocity     all create 1.0 4242
timestep     0.002
fix          1 all nve
pair_style   lj/expand/coul/long 2.5 3.0
pair_coeff   1 1 1.0 1.0 0.1
pair_coeff   2 2 0.8 1.1 0.05
pair_modify  shift yes
kspace_style ewald 1e-5
thermo_style custom step pe evdwl ecoul elong ke press pxx pyy pzz pxy pxz pyz
thermo_modify format float %.15g
thermo       20
run          200
