# oracle: fix wall/reflect/stochastic — diffusive on zlo (seed 4242) and maxwell (accom 0.6) on zhi (seed 777);
# the per-atom velocities after each collision come from the RANMAR stream (one warm-up draw per fix)
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      atomic
boundary        f f f
region          box block 0 10 0 10 0 10 units box
create_box      1 box
create_atoms    1 single 2.0 2.0 0.305 units box
create_atoms    1 single 5.0 5.0 0.255 units box
create_atoms    1 single 8.0 3.0 0.335 units box
create_atoms    1 single 3.0 7.0 9.695 units box
create_atoms    1 single 6.0 4.0 9.655 units box
create_atoms    1 single 8.5 8.0 9.765 units box
mass            1 1.0
group           lo id 1:3
group           hi id 4:6
velocity        lo set 0 0 -2.0 units box
velocity        hi set 0.3 -0.2 2.0 units box
pair_style      lj/cut 2.5
pair_coeff      1 1 0.0 1.0 2.5
timestep        0.005
fix             1 all nve
fix             2 lo wall/reflect/stochastic diffusive 4242 zlo 0.0 1.0 0 0 0 units box
fix             3 hi wall/reflect/stochastic maxwell 777 zhi 10.0 1.0 0 0 0 0.6 units box
thermo_style    custom step temp pe etotal
thermo_modify   format float %.15g
thermo          10
run             40
