# oracle: fix brownian/asphere, 2d, gaussian rng with a body-fixed dipole (1 0 0) on a 6x6 lattice of ellipsoids
# oracle-compare: thermo=all atoms=all
dimension       2
units           lj
atom_style      hybrid dipole ellipsoid
boundary        p p p
lattice         sq 0.4
region          box block 0 6 0 6 -0.2 0.2
create_box      1 box
create_atoms    1 box
mass            * 1.0
set             type * dipole/random 198098 1.0
set             type * shape 3.0 1.0 1.0
set             type * quat/random 198098
velocity        all create 1.0 1 loop geom
pair_style      none
fix             1 all brownian/asphere 1.0 198098 rng gaussian gamma_r_eigen inf inf 0.1 gamma_t_eigen 5.0 7.0 inf dipole 1.0 0.0 0.0
compute         msd all msd
thermo_style    custom step ke pe c_msd[1] c_msd[2] c_msd[3] c_msd[4]
thermo_modify   format float %.15g
timestep        0.00001
thermo          50
run             200
