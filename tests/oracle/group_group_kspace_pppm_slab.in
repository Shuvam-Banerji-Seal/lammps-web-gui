# oracle: compute group/group kspace yes with PPPM and kspace_modify slab 3.0 (the slab dipole terms between the groups): rocksalt ions in a p p f box
# oracle-compare: thermo=all atoms=none rel=1e-8 abs=1e-10
units           metal
boundary        p p f
atom_style      charge
lattice         fcc 5.64
region          box block 0 3 0 3 -0.25 2.75
create_box      2 box
create_atoms    1 box
lattice         fcc 5.64 origin 0.5 0.0 0.0
create_atoms    2 box
mass            1 22.99
mass            2 35.45
set             type 1 charge 1.0
set             type 2 charge -1.0
variable        dx atom 0.12*sin(0.53*x+0.21*y)
variable        dy atom 0.12*cos(0.37*y-0.19*z)
variable        dz atom 0.12*sin(0.29*z+0.41*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 2.0*sin(0.7*x+0.3*z)
variable        vy atom 2.0*cos(0.5*y+0.2*x)
variable        vz atom 2.0*sin(0.4*z-0.6*y)
velocity        all set v_vx v_vy v_vz units box
velocity        all zero linear
region          low block INF INF INF INF INF 1.5
group           lower region low
group           upper subtract all lower
group           na type 1
group           cl type 2
region          corner block 0 1.6 0 1.6 0 1.6
group           mixed region corner
pair_style      lj/cut/coul/long 7.0 7.5
pair_coeff      1 1 0.0100 2.35
pair_coeff      2 2 0.0050 4.40
pair_coeff      1 2 0.0070 3.00
pair_modify     table 0
kspace_style    pppm 1.0e-5
kspace_modify   gewald 0.35 mesh 18 18 48 slab 3.0
compute         gk lower group/group upper pair no kspace yes
compute         ga lower group/group upper kspace yes
compute         gn na group/group cl kspace yes
compute         gb na group/group cl pair no kspace yes boundary no
compute         gm mixed group/group na kspace yes
compute         gs na group/group na pair no kspace yes
timestep        0.001
fix             1 all nve
thermo_style    custom step pe elong c_gk c_gk[1] c_gk[2] c_gk[3] c_ga c_ga[3] c_gn c_gn[1] c_gb c_gb[2] c_gm c_gm[1] c_gm[3] c_gs
thermo_modify   format float %.15g
thermo          10
run             20
