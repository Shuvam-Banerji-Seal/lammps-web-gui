# oracle: group dynamic by an atom-style variable (kinetic energy above a threshold, a compute in the formula) with a thermostat on the group
units           lj
atom_style      atomic
boundary        p p p
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
mass            1 1.0
variable        vx atom 1.6*sin(0.9*x+0.4*z)
variable        vy atom 1.6*cos(0.6*y+0.8*x)
variable        vz atom 1.6*sin(0.7*z-0.3*y)
velocity        all set v_vx v_vy v_vz units box
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
timestep        0.004
compute         ke all ke/atom
variable        hot atom c_ke>1.4
region          half block INF 2.0 INF INF INF INF
group           left region half
group           hotleft dynamic left var hot every 3
variable        n equal count(hotleft)
fix             1 all nve
fix             2 hotleft temp/berendsen 0.9 0.9 0.05
fix             3 hotleft setforce NULL NULL 0.0
compute         th hotleft temp
thermo_style    custom step temp pe etotal press v_n c_th f_3[1] f_3[2] f_3[3]
thermo_modify   format float %.15g
thermo          3
run             90
