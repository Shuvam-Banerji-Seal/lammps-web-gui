# oracle: fix nph/sphere iso update dipole: the dipoles turn after the position update, between the barostat's two box remaps; pair lj/cut/dipole/cut torques and a zero-length dipole
# oracle-files: w355dipole_nph_sphere_rot.dump
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      hybrid sphere dipole
boundary        p p p
lattice         fcc 0.6
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 1.0
set             group all diameter 1.0
set             group all density 1.0
set             group all dipole/random 5512 0.6
set             atom 5 dipole 0 0 0
set             group all omega -0.2 0.4 0.1
pair_style      lj/cut/dipole/cut 2.5
pair_coeff      * * 1.0 1.0
neighbor        0.3 bin
neigh_modify    delay 0
velocity        all create 0.8 1209 mom yes rot yes dist gaussian
fix             1 all nph/sphere iso 0.5 0.5 1.0 update dipole
timestep        0.004
thermo_style    custom step temp pe ke press vol
thermo_modify   format float %.15g norm no
thermo          10
run             50
write_dump      all custom w355dipole_nph_sphere_rot.dump id mux muy muz omegax omegay omegaz modify format float %.15g sort id
