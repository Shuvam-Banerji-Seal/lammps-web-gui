# oracle: compute contact/atom (all atoms, and with group2 half) on finite-size spheres in contact, 0 steps of motion
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10 filerel=1e-8
# oracle-files: w228gs_contact_atom.dump
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 0.0e+0, atoms 3.5e-13.
units           lj
atom_style      sphere
comm_modify     vel yes
boundary        p p p
lattice         sc 0.8
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
group           half id 1:32
set             group half type 2
set             type 1 diameter 1.0
set             type 2 diameter 0.9
set             group all density 1.0
displace_atoms  all random 0.1 0.1 0.1 4321 units box
pair_style      gran/hooke/history 2000.0 NULL 50.0 NULL 0.5 0
pair_coeff      * *
compute         c all contact/atom
compute         c2 all contact/atom half
thermo_style    custom step pe
thermo_modify   format float %.15g
dump            1 all custom 1 w228gs_contact_atom.dump id x y z c_c c_c2
dump_modify     1 sort id format float %.15g
run             0
