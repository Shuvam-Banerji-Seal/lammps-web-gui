# oracle: pair_style granular hooke synchronized_verlet — the first contact steps of two spheres with spin, timestep 0.01 (amplified half-step effects)
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           lj
atom_style      sphere
atom_modify     map array
comm_modify     vel yes
newton          off
boundary        f f f
region          b block -10 10 -10 10 -10 10
create_box      1 b
create_atoms    1 single 0.0 0.0 0.0
create_atoms    1 single 0.9 0.05 0.0
set type 1 diameter 1.0 density 1.0
velocity        all set 0.0 0.0 0.0 units box
set atom 1 vx 0.3 vy 0.2 vz 0.05
set atom 2 vx -0.1 vy 0.1 vz -0.02
set atom 1 omega 0.4 -0.3 0.2
set atom 2 omega -0.2 0.5 0.1
pair_style granular
pair_coeff * * hooke 1000.0 0.5 tangential linear_history 300.0 0.0 0.4 damping coeff_restitution synchronized_verlet
timestep 0.01
fix 1 all nve/sphere
thermo_style custom step ke
thermo_modify format float %.15g
thermo 1
run 3
