# oracle: centroid/stress/atom with dihedral_style table spline (the GPL port of dihedral_table.cpp tallies through Dihedral::ev_tally, so the centroid virial about each quadruplet)
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 5.6e-15, atoms 3.3e-16; the per-atom pe, stress and centroid dump agrees within 1e-10.
# oracle-inputs: w216tb_chains.data w216tb_dihedral.table
# oracle-files: w247cs_dihtable.dump
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=1e-10 filerel=1e-10
units           lj
atom_style      molecular
read_data      w216tb_chains.data
pair_style      lj/cut 1.0
pair_coeff      * * 0.0 1.0
timestep       0.002
dihedral_style  table spline 720
dihedral_coeff 1 w216tb_dihedral.table DRAD
dihedral_coeff 2 w216tb_dihedral.table DNOF
fix             1 all nve
compute         pe all pe/atom
compute         st all stress/atom NULL
compute         cs all centroid/stress/atom NULL
compute         csd all centroid/stress/atom NULL dihedral
compute         sum all reduce sum c_cs[1] c_cs[2] c_cs[3] c_cs[4] c_cs[5] c_cs[6] c_cs[7] c_cs[8] c_cs[9] c_st[4] c_pe
thermo_style    custom step pe press c_sum[1] c_sum[2] c_sum[3] c_sum[4] c_sum[5] c_sum[6] c_sum[7] c_sum[8] c_sum[9] c_sum[10] c_sum[11]
thermo_modify   format float %.15g norm no
thermo          10
dump            d all custom 10 w247cs_dihtable.dump id c_pe c_st[1] c_st[4] c_cs[1] c_cs[2] c_cs[3] c_cs[4] c_cs[5] c_cs[6] c_cs[7] c_cs[8] c_cs[9] c_csd[1] c_csd[5] c_csd[9]
dump_modify     d sort id format float %.15g
run             20
