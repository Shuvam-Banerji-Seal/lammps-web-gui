# oracle: fix move rotate on ellipsoids and point particles of atom_style ellipsoid in units box (quaternion r q0, angular momentum from the previous orientation), a 27-atom cluster rotating through the lower periodic boundaries while a separate cluster runs fix nve under lj/cut; quaternion and angular momentum checksums
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           lj
atom_style      ellipsoid
lattice         sc 1.0
region          box block 0 10 0 10 0 10
create_box      1 box
region          cl block 0.5 3.5 0.5 3.5 0.5 3.5
region          far block 5.5 8.5 5.5 8.5 5.5 8.5
create_atoms    1 region cl
create_atoms    1 region far
group           mover region cl
group           rest region far
set             group mover shape 1.0 1.5 2.0
set             group mover quat 1 2 3 40
set             atom 3*5 shape 0 0 0
set             group all density 0.9
set             atom 4 angmom 0.1 0.2 0.3
variable        vx atom 0.1*sin(id)
variable        vy atom 0.1*cos(2*id)
variable        vz atom 0.05*sin(3*id)
velocity        rest set v_vx v_vy v_vz
pair_style      lj/cut 2.5
pair_coeff      * * 0.5 1.0
fix             1 mover move rotate 2.0 2.0 2.0 0.2 0.3 1.0 4.0 units box
fix             2 rest nve
compute         p all property/atom quatw quati quatj quatk angmomx angmomy angmomz
variable        a1 atom c_p[1]*(1+0.1*id)
variable        a2 atom c_p[2]*(1+0.2*id)
variable        a3 atom c_p[3]*(1+0.3*id)
variable        a4 atom c_p[4]*(1+0.4*id)
variable        a5 atom c_p[5]*(1+0.1*id)
variable        a6 atom c_p[6]*(1+0.2*id)
variable        a7 atom c_p[7]*(1+0.3*id)
compute         r all reduce sum v_a1 v_a2 v_a3 v_a4 v_a5 v_a6 v_a7
timestep        0.005
thermo_style    custom step pe ke c_r[1] c_r[2] c_r[3] c_r[4] c_r[5] c_r[6] c_r[7]
thermo_modify   format float %.15g norm no
thermo          20
run             200
