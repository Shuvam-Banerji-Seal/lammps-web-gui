# oracle: pair_style meam, an isolated A-A dimer at the rock-salt second-neighbour distance 3.677 A (w33meamtrip_b1_lib.meam + w33meamtrip_b1.meam), run 0
# oracle-inputs: w33meamtrip_b1_lib.meam w33meamtrip_b1.meam
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-9
units           metal
atom_style      atomic
boundary        p p p
region          box block 0 20 0 20 0 20
create_box      2 box
create_atoms    1 single 8.0 8.0 8.0
create_atoms    1 single 11.677 8.0 8.0
mass            1 63.546
mass            2 58.69
pair_style      meam
pair_coeff      * * w33meamtrip_b1_lib.meam A B w33meamtrip_b1.meam A B
thermo_style    custom step pe pxx pyy pzz
thermo_modify   format float %.15g
run             0
