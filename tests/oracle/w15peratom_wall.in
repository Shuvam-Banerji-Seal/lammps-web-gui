# oracle: compute pe/atom fix and stress/atom fix with fix wall/lj93 and wall/harmonic (fix_modify energy yes, virial yes)
units           lj
atom_style      atomic
boundary        f p p
lattice         fcc 0.8442
region          box block 0 6 0 4 0 4
create_box      1 box
region          inner block 0.3 5.7 INF INF INF INF
create_atoms    1 region inner
mass            1 1.0
variable        vx atom 0.5*sin(1.3*x+0.7*y)
variable        vy atom 0.5*cos(0.9*y-0.4*z)
variable        vz atom 0.5*sin(1.1*z+0.5*x)
velocity        all set v_vx v_vy v_vz
velocity        all zero linear
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
fix             w1 all wall/lj93 xlo EDGE 1.0 1.0 2.5
fix_modify      w1 energy yes virial yes
fix             w2 all wall/harmonic xhi EDGE 10.0 1.0 1.5
fix_modify      w2 energy yes virial yes
fix             1 all nve
compute         ef all pe/atom fix
compute         ep all pe/atom pair
compute         sf all stress/atom NULL fix
compute         ref all reduce sum c_ef
compute         rep all reduce sum c_ep
compute         rsf all reduce sum c_sf[1] c_sf[2]
thermo_style    custom step pe f_w1 f_w2 c_ref c_rep c_rsf[1] c_rsf[2] press pxx
thermo_modify   format float %.15g
thermo          10
run             40
