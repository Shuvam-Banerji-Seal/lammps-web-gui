# oracle: compute com/chunk with the wrap keyword (default, wrap yes, wrap off, wrap 1) on molecules with unwrapped centres outside an orthogonal periodic box with lo not zero, run 0
# oracle-inputs: w39cfs_wrap.data
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           lj
atom_style      molecular
read_data       w39cfs_wrap.data
pair_style      lj/cut 2.5
pair_coeff      1 1 0.1 1.0
compute         cc all chunk/atom molecule compress no
compute         c0 all com/chunk cc
compute         c1 all com/chunk cc wrap yes
compute         c2 all com/chunk cc wrap off
compute         c3 all com/chunk cc wrap 1
thermo_style    custom step c_c0[1][1] c_c0[1][2] c_c0[1][3] c_c0[2][1] c_c0[2][2] c_c0[2][3] c_c0[3][1] c_c0[3][2] c_c0[3][3] c_c0[4][1] c_c0[4][2] c_c0[4][3] c_c0[5][1] c_c0[5][2] c_c0[5][3] c_c1[1][1] c_c1[1][2] c_c1[1][3] c_c1[2][1] c_c1[2][2] c_c1[2][3] c_c1[3][1] c_c1[3][2] c_c1[3][3] c_c1[4][1] c_c1[4][2] c_c1[4][3] c_c1[5][1] c_c1[5][2] c_c1[5][3] c_c2[1][1] c_c2[1][2] c_c2[1][3] c_c2[2][1] c_c2[2][2] c_c2[2][3] c_c2[3][1] c_c2[3][2] c_c2[3][3] c_c2[4][1] c_c2[4][2] c_c2[4][3] c_c2[5][1] c_c2[5][2] c_c2[5][3] c_c3[1][1] c_c3[1][2] c_c3[1][3] c_c3[2][1] c_c3[2][2] c_c3[2][3] c_c3[3][1] c_c3[3][2] c_c3[3][3] c_c3[4][1] c_c3[4][2] c_c3[4][3] c_c3[5][1] c_c3[5][2] c_c3[5][3]
thermo_modify   format float %.15g norm no
run             0
