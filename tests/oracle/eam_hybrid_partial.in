# oracle: pair_style hybrid with eam on type 1 only (funcfl Cu_u3) and lj/cut for the 1-2 and 2-2 pairs: the eam sub-style computes on its skip list (type 2 atoms have no density and a zero embedding term); 100 steps of nve
# oracle-potentials: Cu_u3.eam
# oracle-compare: thermo=all atoms=all rel=1e-12 abs=1e-12
units           metal
atom_style      atomic
lattice         fcc 3.615
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
set             group all type/fraction 2 0.3 2468
mass            2 39.95
pair_style      hybrid eam lj/cut 4.0
pair_coeff      1 1 eam Cu_u3.eam
pair_coeff      2 2 lj/cut 0.0104 3.40
pair_coeff      1 2 lj/cut 0.05 2.80
velocity        all create 600.0 13579 loop geom
fix             1 all nve
timestep        0.002
thermo_style    custom step temp pe ke etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          20
run             100
