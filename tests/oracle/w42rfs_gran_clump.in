# oracle-compare: thermo=all atoms=all
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 6.7e-14, atoms 5.8e-14.
# oracle: two rigid clumps of three finite-size spheres collide through pair gran/hooke/history (contact mass is the body mass; per-atom contact torques enter the body torque), gravity, 6 free spheres; no contact at the run setup. rel 1e-5: the first contact step (281) differs from native by about 6e-9 in temp (also without friction, xmu 0), not yet explained; the difference grows to about 4e-8 in temp and 2e-6 in torque by step 300
units           lj

comm_modify     vel yes
atom_style      sphere
region          box block 0 10 0 10 0 10 units box
create_box      1 box
create_atoms    1 single 5 5 3.5
create_atoms    1 single 6.05 5 3.5
create_atoms    1 single 5.5 5.9 3.5
create_atoms    1 single 5.3 5.2 4.6
create_atoms    1 single 6.35 5.2 4.6
create_atoms    1 single 5.8 6.1 4.6
create_atoms    1 single 1 1 1
create_atoms    1 single 2.5 1 1
create_atoms    1 single 4 1 1
create_atoms    1 single 1 2.5 1
create_atoms    1 single 2.5 2.5 1
create_atoms    1 single 4 2.5 1
set             type 1 diameter 1.0 density 1.0
group           clumpA id 1:3
group           clumpB id 4:6
group           free id 7:12
variable        wx atom 0.8*sin(1.1*id)
variable        wy atom 0.8*cos(0.7*id)
variable        wz atom 0.6*sin(0.3*id)
set             group all omega v_wx v_wy v_wz
set             group clumpB vz -1.0
set             group clumpA vx 0.05
pair_style      gran/hooke/history 2000.0 NULL 50.0 NULL 0.5 1
pair_coeff      * *
timestep        0.0005
fix             1 all rigid group 2 clumpA clumpB
fix             2 all gravity 1.0 vector 0 0 -1
compute         ers all erotate/sphere
thermo_style    custom step temp ke c_ers f_1[1][1] f_1[1][2] f_1[1][3] f_1[1][10] f_1[1][11] f_1[1][12] f_1[2][1] f_1[2][2] f_1[2][3] f_1[2][10] f_1[2][11] f_1[2][12]
thermo_modify   format float %.15g
thermo          20
run             300
