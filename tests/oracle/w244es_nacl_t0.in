# oracle: kspace_style esp (ad, serial, orthogonal) with pair coul/esp (pair_modify table 0): rock-salt-like fcc
# crystal of 256 atoms (+1/-1 on two basis sites each), run 0 then 50 nve steps; native fixture from b332f28.
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=1e-10 filerel=1e-10
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 6.7e-12, atoms 5.5e-14.
units           real
atom_style      charge
boundary        p p p
lattice         fcc 5.64
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box basis 1 1 basis 2 1 basis 3 2 basis 4 2
mass            * 22.99
set             type 1 charge 1.0
set             type 2 charge -1.0
displace_atoms  all random 0.1 0.1 0.1 4411 units box
velocity        all create 300 8812 loop geom
pair_style      coul/esp 8.0
pair_coeff      * *
pair_modify     table 0
kspace_style    esp 1e-4
fix             1 all nve
timestep        1.0
thermo_style    custom step pe ecoul elong press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g norm no
thermo          10
run             0
run             50
