# oracle: pair nm/cut/coul/long 2.5 3.0 with ewald 1e-5 (table 12, default) on a bonded chain (special_bonds lj/coul 0.0 0.5 0.8), 216 atoms NVE 200 steps
# oracle-inputs: w220xp_chain.data
# oracle-compare: thermo=all atoms=all rel=1e-12 abs=1e-13
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 1.9e-13, atoms 1.8e-13.
units        lj
boundary     p p p
atom_style   full
read_data    w220xp_chain.data
mass         * 1.0
velocity     all create 1.0 4242
bond_style   harmonic
bond_coeff   1 50.0 1.2
special_bonds lj/coul 0.0 0.5 0.8
timestep     0.002
fix          1 all nve
pair_style   nm/cut/coul/long 2.5 3.0
pair_coeff   1 1 1.0 1.1 8 4
pair_coeff   1 2 0.7 1.2 8 6 2.4
pair_coeff   2 2 0.8 1.0 9 6
kspace_style ewald 1e-5
thermo_style custom step pe evdwl ecoul elong ke press pxx pyy pzz pxy pxz pyz
thermo_modify format float %.15g
thermo       20
run          200
