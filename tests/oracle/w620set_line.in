# oracle: set length, theta (degrees and v_ values), theta/random and length 0 on atom_style line (src/set.cpp process_length,
#   process_theta, process_theta_random and src/atom_vec_line.cpp set_length at b332f28): end points, radius and mass
# oracle-compare: thermo=all atoms=all rel=1e-12 abs=1e-14
units           lj
atom_style      line
dimension       2
lattice         sq 0.5
region          box block 0 6 0 5 -0.5 0.5
create_box      2 box
create_atoms    1 box
set             group all type/fraction 2 0.4 9871
group           one type 1
group           two type 2
variable        len atom 0.5+0.1*(id%4)
variable        th atom 0.05*id
set             type 1 length v_len
set             type 2 length 1.3
set             type 1 theta 30.0
set             type 2 theta/random 4321
set             group all theta v_th
set             group all theta/random 8191
set             type 1 theta 45.0
variable        k atom (id%5)==0
group           five variable k
set             group five length 0.0
set             group five length 0.0
compute         p all property/atom end1x end1y end2x end2y radius mass
compute         s all reduce sum c_p[1] c_p[2] c_p[3] c_p[4] c_p[5] c_p[6]
pair_style      lj/cut 1.0
pair_coeff      * * 0.0 1.0
thermo_style    custom step c_s[1] c_s[2] c_s[3] c_s[4] c_s[5] c_s[6]
thermo_modify   format float %.15g
run             0
