# image_select fixture: native b332f28 (/home/roy/.local/bin/lmp), dump image PPM, run 0.
units lj
atom_style bond
bond_style harmonic
region box block 0 6 0 6 0 6
create_box 2 box bond/types 1 extra/bond/per/atom 2
bond_coeff 1 100.0 1.0
create_atoms 1 single 0.5 1.0 1.0
create_atoms 1 single 2.0 2.0 1.5
create_atoms 2 single 3.5 1.0 2.5
create_atoms 1 single 5.0 2.5 3.0
create_atoms 1 single 5.0 4.5 4.5
mass * 1.0
pair_style lj/cut 2.5
pair_coeff * * 1.0 1.0
create_bonds single/bond 1 1 2
create_bonds single/bond 1 2 3
create_bonds single/bond 1 3 4
create_bonds single/bond 1 4 5
dump d all image 1 img.*.ppm type type size 96 96 view 60 30 zoom 2.5 box no 0.02 bond atom 0.25
dump_modify d pad 0 adiam * 0.4 thresh type == 1
run 0
