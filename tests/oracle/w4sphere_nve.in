# oracle: atom_style sphere with per-atom masses — fix nve/sphere, compute temp/sphere (dof all and rotate) and erotate/sphere under lj/cut
units           lj
atom_style      sphere
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
group           odd id 1:108:2
set             group odd type 2
set             group odd diameter 1.2
set             type 1 density 1.3
variable        dx atom 0.04*sin(1.3*x+0.7*y)
variable        dy atom 0.04*cos(0.9*y-1.1*z)
variable        dz atom 0.04*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        wx atom 0.5*sin(0.3*id)
variable        wy atom 0.5*cos(0.7*id)
variable        wz atom 0.2*sin(1.1*id)
set             group all omega v_wx v_wy v_wz
velocity        all create 1.2 87287
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0
timestep        0.002
fix             1 all nve/sphere
compute         ts all temp/sphere
compute         tr all temp/sphere dof rotate
compute         er all erotate/sphere
thermo_style    custom step temp pe etotal press c_ts c_tr c_er c_ts[1] c_ts[4] pxx pxy
thermo_modify   format float %.15g
thermo          10
run             50
