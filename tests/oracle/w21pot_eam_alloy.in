# oracle: pair_style eam/alloy with the LAMMPS potential file AlCu.eam.alloy and eam/fs with CuZr_mm.eam.fs (third_party/lammps/potentials), fcc lattice with mixed types (odd ids type 2), displaced, 50 steps of nve each
# oracle-potentials: AlCu.eam.alloy CuZr_mm.eam.fs
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           metal
atom_style      atomic
lattice         fcc 3.9
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
group           odd id 1:256:2
set             group odd type 2
mass            1 26.98
mass            2 63.546
variable        dx atom 0.05*sin(1.3*x+0.7*y)
variable        dy atom 0.05*cos(0.9*y-0.4*z)
variable        dz atom 0.05*sin(1.1*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
pair_style      eam/alloy
pair_coeff      * * AlCu.eam.alloy Al Cu
timestep        0.002
fix             1 all nve
thermo_style    custom step pe ke press pxx pyz
thermo_modify   format float %.15g norm no
thermo          10
run             50
pair_style      eam/fs
pair_coeff      * * CuZr_mm.eam.fs Cu Zr
mass            2 91.224
run             50
