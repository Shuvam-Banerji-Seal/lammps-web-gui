# oracle: pair_style gran/hooke/history 2000.0 NULL 50.0 NULL 0.1 1 — 100 polydisperse spheres with spin under gravity, fix nve/sphere (sliding contacts, contacts at setup)
units           lj
atom_style sphere
atom_modify map array
comm_modify vel yes
lattice sc 0.9
region b block 0 5 0 5 0 4
create_box 2 b
create_atoms 1 box
group odd id 1:100:2
set group odd type 2
set type 1 diameter 1.0 density 1.0
set type 2 diameter 1.15 density 1.4
variable dx atom 0.05*sin(1.3*x+0.7*y)
variable dy atom 0.05*cos(0.9*y-1.1*z)
variable dz atom 0.05*sin(1.7*z+0.5*x)
displace_atoms all move v_dx v_dy v_dz units box
variable vx atom 0.6*sin(0.9*x+0.4*z)
variable vy atom 0.6*cos(0.6*y+0.8*x)
variable vz atom 0.6*sin(0.7*z-0.3*y)
velocity all set v_vx v_vy v_vz units box
variable wx atom 1.5*sin(0.3*id)
variable wy atom 1.5*cos(0.7*id)
variable wz atom 1.0*sin(1.1*id)
set group all omega v_wx v_wy v_wz
pair_style gran/hooke/history 2000.0 NULL 50.0 NULL 0.1 1
pair_coeff * *
timestep 0.0005
fix 1 all nve/sphere
fix 2 all gravity 1.0 vector 0 0 -1
compute er all erotate/sphere
thermo_style custom step ke c_er press pxx pyy pzz pxy pxz pyz
thermo_modify format float %.15g
thermo 50
run 400
