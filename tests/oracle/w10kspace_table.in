# oracle: lj/cut/coul/long with the default pair_modify table 12 (tabulated erfc/r, force and 1/r above r^2 = 2) against the same system with table 0
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-6
units           real
atom_style      charge
lattice         sc 3.4
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
group           odd id 1:64:2
set             group odd type 2
set             type 1 charge 0.6
set             type 2 charge -0.6
mass            * 20.0
variable        vx atom 0.004*sin(0.9*x+0.4*z)
variable        vy atom 0.004*cos(0.6*y+0.8*x)
variable        vz atom 0.004*sin(0.7*z-0.3*y)
velocity        all set v_vx v_vy v_vz units box
pair_style      lj/cut/coul/long 6.0 6.5
pair_coeff      * * 0.1 3.0
kspace_style    ewald 1e-6
kspace_modify   gewald 0.28 kmax/ewald 7 7 7
timestep        1.0
fix             1 all nve
thermo_style    custom step pe ecoul elong press
thermo_modify   format float %.15g
thermo          10
run             50
pair_modify     table 0
run             20
