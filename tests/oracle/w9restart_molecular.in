# oracle: bonded restart — atom_style full, lj/cut/coul/cut, harmonic bonds and angles, special_bonds, pair_modify restored from the restart file
# oracle-inputs: w9restart_mol.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      full
bond_style      harmonic
angle_style     harmonic
pair_style      lj/cut/coul/cut 2.5 3.0
read_data       w9restart_mol.data
pair_coeff      * * 0.5 0.9
pair_coeff      1 3 0.8 1.0
pair_modify     shift yes mix arithmetic
bond_coeff      1 120.0 1.05
bond_coeff      2 90.0 1.1
angle_coeff     1 40.0 109.5
angle_coeff     2 25.0 120.0
special_bonds   lj/coul 0.0 0.5 0.8333
timestep        0.002
fix             1 all nve
thermo_style    custom step temp pe ebond eangle evdwl ecoul press
thermo_modify   format float %.15g
thermo          10
run             40
write_restart   w9restart_mol.restart
clear
read_restart    w9restart_mol.restart
fix             1 all nve
thermo_style    custom step temp pe ebond eangle evdwl ecoul press
thermo_modify   format float %.15g
thermo          10
run             40
