# oracle: pair_style meam, two-element B1 alloy with erose_form = 2 and per-pair attrac/repuls (w29meama_erose2_lib.meam + w29meama_erose2.meam, zbl 0), 2x2x2 cells of 8 atoms (64 atoms, A on fcc sites, B on octahedral sites), lattice constant 5.2 A = 2 re(1,2), 0.04 A sinusoidal displacement, velocities from atom-style variables, fix nve, 40 steps of 0.001 ps
# oracle: docs.lammps.org/pair_meam.html (plans/lammps-docs/pair_meam.rst), quoted: "if erose_form = 2: erose = -Ec\*(1 +astar + a3\*(astar\*\*3))\*exp(-astar)", "a3 = repuls, astar < 0", "a3 = attrac, astar >= 0"
# oracle-inputs: w29meama_erose2_lib.meam w29meama_erose2.meam
# oracle-compare: thermo=all atoms=all rel=1e-6 abs=1e-9
units           metal
atom_style      atomic
variable        a equal 5.2
lattice         custom ${a} a1 1 0 0 a2 0 1 0 a3 0 0 1 &
                basis 0 0 0 basis 0.5 0.5 0 basis 0.5 0 0.5 basis 0 0.5 0.5 &
                basis 0.5 0 0 basis 0 0.5 0 basis 0 0 0.5 basis 0.5 0.5 0.5
region          box block 0 2 0 2 0 2
create_box      2 box
create_atoms    1 box basis 1 1 basis 2 1 basis 3 1 basis 4 1 basis 5 2 basis 6 2 basis 7 2 basis 8 2
mass            1 63.546
mass            2 58.69
variable        dx atom 0.04*sin(2.3*x+1.1*y+0.4*z)
variable        dy atom 0.04*cos(1.9*y-0.7*x+0.3*z)
variable        dz atom 0.04*sin(1.3*z+0.8*x-0.5*y)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.4*cos(1.7*y-0.6*z)
variable        vy atom 0.4*sin(1.2*z+0.9*x)
variable        vz atom 0.3*cos(2.1*x-0.8*y+0.2)
velocity        all set v_vx v_vy v_vz units box
pair_style      meam
pair_coeff      * * w29meama_erose2_lib.meam A B w29meama_erose2.meam A B
timestep        0.001
fix             1 all nve
thermo          10
thermo_style    custom step pe ke press pxx pyy pzz
thermo_modify   format float %.15g
run             40
