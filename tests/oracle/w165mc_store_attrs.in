# oracle: fix store/state with the attributes of fix_store_state.rst (id mol type mass x..zu, xs..zsu, ix.., v.., f.., q), N = 3, dumped every 3 steps
# Measured max relative error of the engine against native (thermo 1.0e-15, per-atom 7.4e-15, dumped store values 5.6e-14). native: b332f28 (installed lmp, black box)
# oracle-files: d.store
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      full
lattice         fcc 0.8442
region          box block 0 2 0 2 0 2
create_box      2 box
create_atoms    1 box
set             type 2 mol 7
set             type 2 charge -0.4
set             type 1 charge 0.4
mass            * 1.0
velocity        all create 1.5 4928459 loop geom
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0 2.5
fix             1 all nve
fix             s all store/state 3 id mol type mass x y z xs ys zs xu yu zu xsu ysu zsu ix iy iz vx vy vz fx fy fz q
dump            d all custom 3 d.store id f_s[1] f_s[2] f_s[3] f_s[4] f_s[5] f_s[6] f_s[7] f_s[8] f_s[9] f_s[10] f_s[11] f_s[12] f_s[13] f_s[14] f_s[15] f_s[16] f_s[17] f_s[18] f_s[19] f_s[20] f_s[21] f_s[22] f_s[23] f_s[24] f_s[25] f_s[26]
dump_modify     d format float %.15g
thermo_style    custom step pe ke
thermo_modify   format float %.15g
thermo          3
run             7
