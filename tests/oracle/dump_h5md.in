# oracle: dump h5md (native: the b332f28 build with the H5MD package, /store/shuvam/software/lammps-build-h5md): position, image and species every 5 steps with an author, a second group of the same file (file_from, create_group yes) with velocity and force every 10, then write_dump adding velocity to the first group
# oracle-files: a.h5
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
mass            * 1.0
set             group all type/fraction 2 0.4 4321
displace_atoms  all random 0.05 0.05 0.05 9123
velocity        all create 1.0 87287 loop geom
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0
fix             1 all nve
region          lowerhalf block 0 4 0 4 0 2
group           lower region lowerhalf
thermo_style    custom step temp pe etotal press
thermo_modify   format float %.15g
dump            1 all h5md 5 a.h5 position image species author "Jane Q"
dump            2 lower h5md 10 a.h5 file_from 1 create_group yes velocity force
run             20
write_dump      all h5md a.h5 file_from 1 velocity
