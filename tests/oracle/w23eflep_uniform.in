# oracle: fix efield/lepton on charged point dipoles in a uniform field (no step needed) with a region: torque and energy only
# oracle-files: w23eflep_uniform_mu.dump
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-9
units           lj
atom_style      hybrid sphere dipole
lattice         sc 1.0
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            * 1.0
set             type * diameter 0.8 density 1.0
variable        mx atom 0.6*sin(1.0*x+0.5*y)
variable        my atom 0.6*cos(0.8*y-0.3*z)
variable        mz atom 0.6*sin(0.7*z+0.6*x)
set             group all dipole v_mx v_my v_mz
set             type 1 charge 0.4
variable        vx atom 0.3*sin(0.6*x+0.4*z)
variable        vy atom 0.3*cos(0.5*y+0.2*x)
variable        vz atom 0.3*sin(0.4*z-0.5*y)
velocity        all set v_vx v_vy v_vz units box
velocity        all zero linear
set             group all omega 0.1 0.15 -0.2
pair_style      zero 5.0
pair_coeff      * *
region          top block INF INF INF INF 1.5 INF units lattice
fix             1 all nve/sphere update dipole
fix             ef all efield/lepton "-(0.4*x + 0.2*y - 0.3*z)" region top
fix_modify      ef energy yes virial yes
compute         tq all property/atom tqx tqy tqz mux muy muz
compute         chk all reduce sum c_tq[1] c_tq[2] c_tq[3] c_tq[4] c_tq[5] c_tq[6]
thermo_style    custom step pe f_ef ke c_chk[1] c_chk[2] c_chk[3] c_chk[4] c_chk[5] c_chk[6] press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          10
run             50
write_dump      all custom w23eflep_uniform_mu.dump id fx fy fz tqx tqy tqz mux muy muz modify format float %.17g sort id
