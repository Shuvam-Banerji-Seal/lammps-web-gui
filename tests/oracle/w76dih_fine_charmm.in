# oracle: dihedral_style charmm (unaffected control) on a phi scan (one dihedral per molecule, w76dih_fine_full.data), forces and energy
# oracle-inputs: w76dih_fine_full.data
# oracle-compare: thermo=first atoms=all rel=1e-9 abs=1e-10
units           real
atom_style      full
bond_style      zero
angle_style     zero
dihedral_style  charmm
improper_style  zero
pair_style      lj/charmm/coul/charmm 7.0 8.0
read_data       w76dih_fine_full.data
pair_coeff      * * 0.0 1.0
dihedral_coeff  1 1.3 3 45 0.0
thermo_style    custom step pe edihed press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
run             0
