# oracle: native atom order (spatial sort at every run setup and every 10 steps, bins misaligned with the lattice) decides which atom gets which fix langevin draw over three runs
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
group           odd id 1:108:2
set             group odd type 2
mass            1 1.0
mass            2 1.5
velocity        all create 1.2 4928 loop all
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0
neighbor        1.0 bin
neigh_modify    every 2 delay 0 check no
atom_modify     sort 10 0.0
timestep        0.004
fix             1 all nve
fix             2 all langevin 1.0 1.0 0.5 4242
thermo_style    custom step temp pe etotal press
thermo_modify   format float %.15g
thermo          5
run             30
run             30
atom_modify     sort 7 1.3
run             30
