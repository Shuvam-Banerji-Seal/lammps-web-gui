# oracle: fix halt inside a minimize (fix_halt.html: minimization iterations are checked): the minimize stops at the iteration whose step meets the condition, then a soft halt skips the next run until timer timeout off; message no
# oracle-compare: thermo=all atoms=none rel=1e-10 abs=1e-12
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 1.0
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
displace_atoms  all move 0.05 0.02 0.01 units box
velocity        all set 0.3 0.1 -0.2
fix             1 all nve
timestep        0.005
variable        s equal step
thermo_style    custom step pe v_s
thermo_modify   format float %.15g
thermo          1
run             19
fix             h all halt 1 v_s >= 21 error soft message no
minimize        1.0e-12 1.0e-12 100 100
run             2
timer           timeout off
run             2
