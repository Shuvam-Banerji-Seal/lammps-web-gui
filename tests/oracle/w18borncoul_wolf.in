# oracle: pair_style born/coul/wolf — charged two-type lattice, Born-Mayer-Huggins A,C,D term plus Wolf Coulomb
units           lj
atom_style      charge
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
group           odd id 1:108:2
set             group odd type 2
mass            1 1.0
mass            2 1.5
set             type 1 charge 0.5
set             type 2 charge -0.5
variable        dx atom 0.04*sin(1.3*x+0.7*y)
variable        dy atom 0.04*cos(0.9*y-1.1*z)
variable        dz atom 0.04*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.8*sin(0.9*x+0.4*z)
variable        vy atom 0.8*cos(0.6*y+0.8*x)
variable        vz atom 0.8*sin(0.7*z-0.3*y)
velocity        all set v_vx v_vy v_vz units box
velocity        all zero linear
pair_style      born/coul/wolf 0.6 2.5 3.0
pair_coeff      1 1 6.08 0.317 2.340 24.18 11.51
pair_coeff      2 2 4.50 0.300 2.200 18.00 8.00
pair_coeff      1 2 5.20 0.310 2.280 21.00 9.60 2.4
timestep        0.002
fix             1 all nve
thermo_style    custom step temp pe evdwl ecoul etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          10
run             50
