# oracle: w83sph_shock2d, cut-down of examples/PACKAGES/sph/shock_tube/shock2d.lmp (60 x 8 particles, 40 steps). Measured max relative error vs native LAMMPS (black box): 3.4e-15 thermo, 3.4e-16 per atom.
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
atom_style         sph
dimension          2
boundary           s p p

region             box block -30 30 -4 4 -0.1 0.1 units box
create_box         2 box
lattice            sq 1.0
create_atoms       1 box

region             left block EDGE 0.0 EDGE EDGE EDGE EDGE units box
region             right block 1 EDGE EDGE EDGE EDGE EDGE units box
set                region right type 2

mass               1 1
mass               2 0.25
set                type 1 sph/e 2.5
set                type 2 sph/e 0.625
set                type 1 sph/rho 1.0
set                type 2 sph/rho 0.25

pair_style         hybrid/overlay sph/rhosum 1 sph/idealgas
pair_coeff         * * sph/rhosum 4.0
pair_coeff         * * sph/idealgas 0.75 4.0

compute            rhoatom all sph/rho/atom
compute            ieatom all sph/e/atom
compute            esph all reduce sum c_ieatom
compute            ke all ke
variable           etot equal c_ke+c_esph

neighbor           0.5 bin
neigh_modify       every 5 delay 0 check yes
thermo             10
thermo_style       custom step c_ke c_esph v_etot
thermo_modify      norm no format float %.15g

fix                integration_fix all sph
fix                1 all setforce NULL 0.0 0.0
timestep           0.05
run                40
