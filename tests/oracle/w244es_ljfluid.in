# oracle: pair lj/cut/coul/esp with kspace esp (default lookup table): randomly displaced charged LJ fluid (fcc +1/-1, 256 atoms, real units), run 0 then 50 nve steps
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=1e-10 filerel=1e-10
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 5.6e-13, atoms 5.0e-14.
units           real
atom_style      charge
boundary        p p p
lattice         fcc 3.9
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box basis 1 1 basis 2 1 basis 3 2 basis 4 2
mass            * 20.0
set             type 1 charge 0.5
set             type 2 charge -0.5
displace_atoms  all random 0.25 0.25 0.25 9187 units box
velocity        all create 300 8812 loop geom
pair_style      lj/cut/coul/esp 6.0 8.0
pair_coeff      * * 0.1 2.6
kspace_style    esp 1e-4
fix             1 all nve
timestep        1.0
thermo_style    custom step pe evdwl ecoul elong press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g norm no
thermo          10
run             0
run             50
