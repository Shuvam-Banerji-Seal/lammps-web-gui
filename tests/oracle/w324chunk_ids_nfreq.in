# oracle: compute chunk/atom ids nfreq: fix ave/chunk locks the chunk/atom on the first sample of each Nfreq window and the chunk IDs of that step persist to the window's end (ave one, Nrepeat 5), or for good (ave running); compared with ids every, in a hot liquid where atoms cross the thin bins; per-atom IDs summed in thermo every 2 steps
# oracle-files: nf.txt ev.txt run.txt
units           lj
atom_style      atomic
boundary        p p p
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 3.0 87287 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
timestep        0.005
fix             1 all nve
compute         cn all chunk/atom bin/1d x lower 0.1 units reduced ids nfreq
compute         ce all chunk/atom bin/1d x lower 0.1 units reduced
compute         cr all chunk/atom bin/1d y lower 0.1 units reduced ids nfreq
compute         rs all reduce sum c_cn c_ce c_cr
fix             2 all ave/chunk 2 5 20 cn vx density/number format " %.12g" file nf.txt
fix             3 all ave/chunk 2 5 20 ce vx density/number format " %.12g" file ev.txt
fix             4 all ave/chunk 10 1 10 cr vy ave running format " %.12g" file run.txt
thermo_style    custom step temp pe c_rs[1] c_rs[2] c_rs[3]
thermo_modify   norm no format float %.15g
thermo          2
run             60
