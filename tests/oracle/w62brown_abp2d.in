# oracle: spherical active Brownian particles in 2d (cut down from examples/PACKAGES/brownian/spherical_ABP/in.2d.abp): lj/cut, brownian/sphere, propel/self dipole, enforce2d
# oracle-compare: thermo=all atoms=all
dimension       2
units           lj
atom_style      hybrid dipole sphere
boundary        p p p
lattice         sq 0.4
region          box block 0 8 0 8 -0.2 0.2
create_box      1 box
create_atoms    1 box
mass            * 1.0
set             type * dipole/random 1974019 1.0
velocity        all create 1.0 1 loop geom
neighbor        1.0 bin
neigh_modify    every 1 delay 1 check yes
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0 1.1224
pair_modify     shift yes
fix             1 all brownian/sphere 1.0 1974019 gamma_t 1.0 gamma_r 1.0
fix             2 all propel/self dipole 4.0
fix             3 all enforce2d
compute         press all pressure NULL virial
thermo_style    custom step pe ke c_press
thermo_modify   format float %.15g
timestep        0.00001
thermo          50
run             200
