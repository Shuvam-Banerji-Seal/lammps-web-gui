# oracle: metal units (63.55 amu, 300 K, Angstrom/ps) with fix wall/flow along z, three walls at mid-cell lattice planes (lattice fcc 3.61, units lattice), 100 steps
# oracle-compare: thermo=all atoms=all rel=1e-7 abs=1e-9
units           metal
atom_style      atomic
lattice         fcc 3.61
region          box block 0.3 5.3 0.3 5.3 0.3 5.3 units lattice
create_box      1 box
create_atoms    1 box
mass            1 63.55
velocity        all create 300.0 4711
pair_style      lj/cut 6.0
pair_coeff      1 1 0.2 2.6
neighbor        1.0 bin
neigh_modify    delay 0 every 1 check yes
fix             1 all nve
fix             2 all wall/flow z 0.5 300.0 777 3 2.5 3.5 4.5 units lattice
thermo_style    custom step temp ke pe
thermo_modify   format float %.15g
timestep        0.001
thermo          20
run             100
