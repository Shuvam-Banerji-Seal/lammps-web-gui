# oracle: pair_style hybrid/overlay rebo kolmogorov/crespi/full 16.0 1 - AB-stacked bilayer graphene (1360 atoms, the example's data file), 10 NVE steps; compute pair c_1[1], c_1[2]
# measured (engine vs native, black box; rel over |value| >= 1e-6; per-atom scale max(1,|value|)): thermo max abs 5.6e-11, max rel 6.7e-13; per-atom max scaled 2.0e-12
# oracle-inputs: w102il_bi_gr.data
# oracle-potentials: CH.rebo CH_taper.KC
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           metal
boundary        p p p
atom_style      full
read_data       w102il_bi_gr.data
mass            1 12.0107
mass            2 12.0107
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
pair_style      hybrid/overlay rebo kolmogorov/crespi/full 16.0 1
pair_coeff      * * rebo CH.rebo C C
pair_coeff      * * kolmogorov/crespi/full CH_taper.KC C C
compute         0 all pair rebo
compute         1 all pair kolmogorov/crespi/full
timestep        0.001
thermo_style    custom step pe etotal press c_0 c_1[1] c_1[2]
thermo_modify   format float %.15g
thermo          5
run             0
velocity        all create 300.0 12345
fix             1 all nve
run             10
