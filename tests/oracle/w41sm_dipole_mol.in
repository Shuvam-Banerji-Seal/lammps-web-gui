# oracle: create_atoms mol with a template Dipoles section (point dipoles turn with the molecule's rotation; the dipole pair energy of two rotated 3-atom molecules and their forces); thermo pe over 20 steps of nve
# oracle-inputs: w41sm_dipole_mol.txt
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           lj
atom_style      hybrid sphere dipole
region          box block 0 10 0 10 0 10 units box
create_box      1 box
molecule        mymol w41sm_dipole_mol.txt
create_atoms    0 single 2 2 2 mol mymol 1 rotate 20 1 0 0 units box
create_atoms    0 single 6 6 6 mol mymol 2 rotate 75 0 1 1 units box
create_atoms    0 single 6 2 5 mol mymol 3 rotate 130 1 0 2 units box
set             type 1 diameter 1.0 density 1.0
pair_style      lj/cut/dipole/cut 4.0
pair_coeff      1 1 1.0 1.0
timestep        0.001
fix             1 all nve
thermo_style    custom step pe ke press
thermo_modify   format float %.15g
thermo          5
run             20
