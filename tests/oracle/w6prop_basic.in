# oracle: fix property/atom before the box — per-atom mass/charge/mol on atom_style atomic, custom i_/d_/d2_ properties via set, variables, compute property/atom, dump and write_data
# oracle-files: p.dump p.data
units           lj
atom_style      atomic
atom_modify     map array sort 0 0.0
fix             pa all property/atom mol q rmass i_flag d_val d2_vec 3 ghost yes
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
group           odd id 1:108:2
set             group odd type 2
mass            * 1.0
variable        mm atom 1.0+0.25*(id%3)
set             group all mass v_mm
variable        qq atom 0.4*((id%2)*2-1)
set             group all charge v_qq
variable        mol atom floor((id-1)/4)+1
set             group all mol v_mol
variable        fl atom id%5
set             group all i_flag v_fl
variable        dv atom 0.1*sin(id)
set             group all d_val v_dv
variable        c1 atom 0.01*id
set             group all d2_vec[1] v_c1
set             group all d2_vec[3] 2.5
variable        dx atom 0.04*sin(1.3*x+0.7*y)
variable        dy atom 0.04*cos(0.9*y-1.1*z)
variable        dz atom 0.04*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.8*sin(0.9*x+0.4*z)
variable        vy atom 0.8*cos(0.6*y+0.8*x)
variable        vz atom 0.8*sin(0.7*z-0.3*y)
velocity        all set v_vx v_vy v_vz units box
pair_style      lj/cut/coul/cut 2.5
pair_coeff      * * 1.0 1.0
compute         pp all property/atom i_flag d_val d2_vec[1] d2_vec[3] mol q mass
compute         sumd all reduce sum c_pp[2] c_pp[3]
variable        w atom d_val*i_flag+mol
compute         sumw all reduce sum v_w
variable        e1 equal i_flag[7]+d_val[9]+mol[11]+q[12]
timestep        0.002
fix             1 all nve
thermo_style    custom step temp pe ecoul etotal press c_sumd[1] c_sumd[2] c_sumw v_e1
thermo_modify   format float %.15g
thermo          10
dump            d all custom 30 p.dump id mol q mass i_flag d_val d2_vec[*]
dump_modify     d sort id format float %.12g
run             30
write_data      p.data
