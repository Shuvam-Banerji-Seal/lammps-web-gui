# oracle: fix deposit mol — molecule position, orientation and velocity random stream, type offset and molecule IDs
# oracle-inputs: w26depmol_dimer.mol
units           lj
atom_style      bond
boundary        p p f
region          box block 0 10 0 10 0 20
create_box      3 box bond/types 1 extra/bond/per/atom 1
molecule        dim w26depmol_dimer.mol
pair_style      lj/cut 2.5
pair_coeff      * * 0.0 1.0
mass            * 1.0
bond_style      harmonic
bond_coeff      1 20.0 0.5
region          slab block 0 10 0 10 16 18
fix             1 all deposit 6 0 1 12345 region slab mol dim vx -0.5 0.5 vy -0.5 0.5 vz -1.0 -0.5 units box
fix             2 all nve
thermo_style    custom step atoms temp pe ebond evdwl etotal press
thermo_modify   format float %.15g
thermo          1
run             5
