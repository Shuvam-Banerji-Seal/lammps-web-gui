# oracle: fix srd with big triangle particles held in fix rigid bodies, then the second phase of examples/ASPHERE/tri/in.tri.srd (cut-down): change_box all triclinic, fix srd tstat yes, fix deform xy erate 0.05 remap v (3d, the same four triangles as w254srd_tri_rigid; the first phase is 20 steps on an orthogonal box with fix deform scale 0.8, the second 40 steps; the small particles' forces are zeroed by fix setforce, since native leaves them uninitialised)
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 1.0e-13, atoms 2.2e-12.
# oracle-inputs: w254srd_tri_rigid.data
# oracle-compare: thermo=all atoms=all
units		lj
atom_style	tri
atom_modify	first big
dimension	3

read_data	w254srd_tri_rigid.data

lattice		sc 0.4
region		box block INF INF INF INF INF INF
lattice		sc 20.0
create_atoms	2 region box

group		big type 1
group		small type 2
set		group small mass 0.01
set		group big angmom 0.2 -0.1 0.3

pair_style	lj/cut 1.5
pair_coeff	1 1 0.0 1.0
pair_coeff	2 2 0.0 1.0 0.0
pair_coeff	1 2 0.0 1.0

delete_atoms	overlap 1.5 small big

reset_timestep	0

velocity	small create 1.44 87287 loop geom
velocity	big set 0.1 -0.05 0.08

neighbor	0.3 multi
neigh_modify	delay 0 every 1 check yes
neigh_modify	exclude molecule/intra big include big

comm_modify	mode multi group big vel yes
neigh_modify	include big

pair_style	tri/lj 3.5
pair_coeff	1 1 0.1 1.0
pair_coeff	2 2 0.0 1.0 0.0
pair_coeff	1 2 0.0 1.0 0.0

timestep	0.002

fix		1 big rigid molecule
fix		2 small srd 20 big 1.0 1.0 49894 search 0.2 cubic warn 0.0001 shift yes 49829 overlap yes collision noslip
fix		3 small setforce 0.0 0.0 0.0
fix		4 all deform 1 x scale 0.8 y scale 0.8 z scale 0.8

compute		tsmall small temp
compute		1 big erotate/asphere
compute		2 all ke
compute		3 all pe
variable	pebig equal pe*atoms/count(big)
variable	ebig equal etotal*atoms/count(big)

thermo_style	custom step c_tsmall f_2[1] f_2[2] f_2[3] f_2[4] f_2[5] f_2[6] f_2[7] f_2[8] f_2[9] f_2[10] f_2[11] f_2[12] c_1 etotal v_pebig v_ebig press
thermo_modify	temp tsmall
thermo_modify	format float %.15g
thermo		1

run		20

unfix		4
change_box	all triclinic
unfix		2
fix		2 small srd 20 big 1.0 1.0 49894 search 0.2 cubic warn 0.0001 shift yes 49829 overlap yes collision noslip tstat yes
fix		4 all deform 1 xy erate 0.05 units box remap v

run		40
