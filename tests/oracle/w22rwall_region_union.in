# oracle: fix wall/region on a union region (two disjoint block containers), lj93; global energy and wall force vector
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           lj
atom_style      atomic
boundary        f f f
region          box block -6 6 -6 6 -2 10 units box
create_box      1 box
region          A block -5 -0.1 -3 3 0 6 side in units box
region          B block 0.1 5 -3 3 0 6 side in units box
region          U union 2 A B
lattice         sc 1.0 origin 0.45 0.5 0.5
create_atoms    1 region U
mass            1 1.0
pair_style      lj/cut 2.5
pair_coeff      1 1 0.0 1.0 2.5
timestep        0.002
fix             1 all nve
fix             2 all wall/region U lj93 0.1 0.3 2.5
fix_modify      2 energy yes
thermo_style    custom step temp pe etotal f_2 f_2[1] f_2[2] f_2[3]
thermo_modify   format float %.15g
thermo          5
run             20
