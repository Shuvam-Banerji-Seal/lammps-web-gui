# oracle: compute temp/chunk (bin and type chunks; temp, kecom, internal values; com yes; bias temp/partial; adof and cdof) on a fixed state, then NVE with the per-chunk arrays evaluated by thermo (the thermostat case is w14temp_chunk_nvt)
# oracle-compare: thermo=all rel=1e-8 abs=1e-10
units lj
atom_style atomic
lattice fcc 0.8442
region box block 0 4 0 3 0 3
create_box 2 box
create_atoms 1 box
mass * 1.0
mass 2 2.5
region half block INF 2 INF INF INF INF units lattice
set region half type 2
variable vx atom 1.2*sin(1.7*x+2.3*y+0.7*z)
variable vy atom 1.2*cos(2.1*x-1.1*y+0.3*z)
variable vz atom 1.2*sin(0.5*x+1.9*z+1.3*y)
velocity all set v_vx v_vy v_vz units box
pair_style lj/cut 2.5
pair_coeff * * 1.0 1.0 2.5
timestep 0.002
compute cx all chunk/atom bin/1d x lower 0.25
compute cy all chunk/atom type
compute tc all temp/chunk cx temp kecom internal
compute tk all temp/chunk cy temp kecom adof 2.0 cdof 1.0
compute tcom all temp/chunk cx temp kecom com yes cdof 0.5
compute tp all temp/partial 1 0 1
compute tn all temp/chunk cx com yes
compute tb all temp/chunk cy temp internal bias tp adof 2.0
variable a11 equal c_tc[1][1]
variable a25 equal c_tc[5][2]
variable a33 equal c_tc[3][3]
variable k12 equal c_tk[1][2]
variable k21 equal c_tk[2][1]
variable m14 equal c_tcom[4][1]
variable b12 equal c_tb[1][2]
thermo_style custom step temp c_tc c_tc[1] c_tc[2] c_tk c_tk[3] c_tcom c_tcom[6] c_tb c_tb[4] v_a11 v_a25 v_a33 v_k12 v_k21 v_m14 v_b12 c_cx c_tn
thermo_modify format float %.15g
thermo 10
run 0
fix 1 all nve
run 20
