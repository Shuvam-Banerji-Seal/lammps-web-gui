# oracle: pair coul/slater/cut 0.7 2.5 with charges +-0.5; pair 1 2 with its own cutoff
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 4.0e-14, atoms 4.4e-16. The energy columns (pe, evdwl, ecoul, ke) agree to 1e-14; the thermo maximum is in the pressure components, whose virial is summed in a different order (fdotr).
# oracle-compare: thermo=all atoms=all rel=1e-11 abs=1e-13
units        lj
atom_style   charge
lattice      fcc 0.8442
region       box block 0 5 0 5 0 5
create_box   2 box
create_atoms 1 box
set          group all type/fraction 2 0.5 4321
mass         * 1.0
set          type 1 charge 0.5
set          type 2 charge -0.5
velocity     all create 1.0 4242
timestep     0.001
fix          1 all nve
pair_style   coul/slater/cut 0.7 2.5
pair_coeff   * *
pair_coeff   1 2 2.2
thermo_style custom step pe evdwl ecoul ke press pxx pyy pzz pxy pxz pyz
thermo_modify format float %.15g
thermo       20
run          200
