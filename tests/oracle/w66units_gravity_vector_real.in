# oracle: fix gravity vector style with fix_modify energy yes: 60 steps (real)
# oracle-compare: thermo=all atoms=all
units           real
atom_style      atomic
boundary        p p p
lattice         fcc 3.6
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
group           odd id 1:108:2
group           even subtract all odd
set             group odd type 2
mass            1 12
mass            2 20
velocity        all create 300 4928459 loop all
pair_style      lj/cut 8

pair_coeff      1 1 0.2 3.4
pair_coeff      2 2 0.15 3.6
timestep        1
fix             1 all nve
fix             2 all gravity 0.5 vector 0.2 0.0 -1.0
fix_modify      2 energy yes
thermo_style    custom step temp pe etotal press
thermo_modify   format float %.15g
thermo          10
run             60
