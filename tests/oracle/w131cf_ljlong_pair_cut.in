# oracle: pair_style lj/long/coul/long long off with a per-pair LJ cutoff (pair_coeff cutoff1) and ewald/disp
# oracle-compare: thermo=all atoms=all
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
set             region box type/fraction 2 0.5 4321
mass            * 1.0
velocity        all create 1.0 87287 loop geom
pair_style      lj/long/coul/long long off 2.5
pair_modify     table 0 table/disp 0
pair_coeff      * * 1.0 1.0 2.5
pair_coeff      * 2 1.0 1.0 1.8
kspace_style    ewald/disp 1.0e-4
kspace_modify   gewald/disp 0.3
neighbor        0.3 bin
neigh_modify    every 1 delay 0 check no
timestep        0.005
fix             1 all nve
# press is left out: its virial is a cancellation of large terms (engine 3.9e-8 relative at step 20, above the 1e-8 default); forces are compared per atom
thermo_style    custom step pe evdwl elong
thermo_modify   format float %.15g
thermo          5
run             20
