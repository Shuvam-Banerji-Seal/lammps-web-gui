# Wave 41: fix ttm/cascade offset keyword (docs.lammps.org/fix_ttm.html: "The *offset* keyword specifies an offset time
# (thermalization time) value during which electron-ion interactions are disabled for all particles.") on the eight-atom
# crystal of w41ttm_cas_small, uniform properties (no tables), offset 0.025 (steps 1 and 2 have no electron-ion friction,
# step 3 on), gamma_s 5 still acting on the fast atoms. Four runs of one step each.
# oracle-inputs: w41ttm_cas.init
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           metal
atom_style      atomic
lattice         sc 3.0
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box
mass            1 10.0
displace_atoms  all move 0.5 0.5 0.5 units box
variable        vx atom 3.0*sin(0.9*x+0.4*y)
variable        vy atom 0.5*cos(0.7*y-0.5*z)
variable        vz atom 0.4*sin(1.1*z+0.3*x)
velocity        all set v_vx v_vy v_vz units box
pair_style      lj/cut 3.0
pair_coeff      1 1 0.0 2.0
fix             1 all nve
fix             2 all ttm/cascade 77 1.0 1.0 0.5 20.0 5.0 2.0 2 2 2 infile w41ttm_cas.init offset 0.025
timestep        0.01
thermo_style    custom step temp pe f_2[1] f_2[2]
thermo_modify   format float %.15g
thermo          1
run             1
run             1
run             1
run             1
