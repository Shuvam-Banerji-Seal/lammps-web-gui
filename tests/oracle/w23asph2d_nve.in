# oracle: 2d gayberne ellipsoids (sphere, prolate and biaxial shapes, z-only orientations, with x and y angmom set so fix enforce2d must zero them) with fix nve/asphere and fix enforce2d, 200 steps; compute temp/asphere (2d dof), erotate/asphere, angmom and quaternion checksums
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           lj
dimension       2
atom_style      ellipsoid
lattice         sq 0.08
region          box block 0 6 0 6 -0.5 0.5
create_box      3 box
create_atoms    1 box
group           g0 id 1:36:3
group           g1 id 2:36:3
group           g2 id 3:36:3
set             group g1 type 2
set             group g2 type 3
set             group g0 shape 1.0 1.0 1.0
set             group g1 shape 2.5 1.0 1.0
set             group g2 shape 1.5 0.8 1.1
set             group g1 mass 1.5
set             group g0 quat 0 0 1 20
set             group g1 quat 0 0 1 75
set             group g2 quat 0 0 1 130
variable        lx atom 0.3*sin(0.3*id)
variable        ly atom 0.3*cos(0.9*id)
variable        lz atom 0.4*sin(0.7*id)
set             group all angmom v_lx v_ly v_lz
velocity        all create 1.0 4928 dist gaussian
compute         p all property/atom quatw quati quatj quatk angmomx angmomy angmomz
compute         r all reduce sum c_p[1] c_p[2] c_p[3] c_p[4] c_p[5] c_p[6] c_p[7]
compute         tmp all temp/asphere
compute         erot all erotate/asphere
pair_style      gayberne 1.0 3.0 1.0 4.0
pair_coeff      1 1 3.0 1.0 1 1 1 1 1 1 2.5
pair_coeff      1 2 3.0 1.0 1 1 1 0 0 0
pair_coeff      1 3 3.0 1.0 1 1 1 0 0 0
pair_coeff      2 2 1.0 1.0 1 1 0.2 0 0 0
pair_coeff      2 3 1.0 1.0 1 1 0.2 0 0 0
pair_coeff      3 3 1.0 1.0 1 1 0.2 0 0 0
timestep        0.002
fix             1 all nve/asphere
fix             2 all enforce2d
thermo_style    custom step temp pe c_tmp c_erot c_r[1] c_r[2] c_r[3] c_r[4] c_r[5] c_r[6] c_r[7]
thermo_modify   format float %.15g norm no
thermo          20
run             200
