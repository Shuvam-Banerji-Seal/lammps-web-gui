# oracle: fix shardlow with pair dpd/fdt and fix nph iso (isobaric, atom_style atomic, SSA) on the examples/PACKAGES/dpd-react/dpdp-shardlow fluid (1000 atoms), 100 steps
# oracle-inputs: w95dreact_shardlow_dpd_1000.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=0
# Measured with native LAMMPS (black box): the dpdp-shardlow example (same data, cutoff, temperature and seed).
# Measured against the engine: max relative error 8e-15 (thermo), 5e-12 (atoms; forces up to 5e-11).

boundary        p p p

units           metal
atom_style      atomic
read_data       w95dreact_shardlow_dpd_1000.data

comm_modify     mode single vel yes
mass            1 100.0

pair_style      dpd/fdt 300.0 10.0 234324
pair_coeff      1 1 0.075 0.022 10.0

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check no once no

timestep        0.001

thermo          10
thermo_style    custom step temp press vol pe ke etotal enthalpy cella cellb cellc
thermo_modify   format float %.15g

fix             1 all shardlow
fix             0 all nph iso 0.0 0.0 1000.0

run             100
