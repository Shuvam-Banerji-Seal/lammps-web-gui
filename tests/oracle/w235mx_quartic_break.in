# oracle: bond_style quartic (breakable bonds, docs.lammps.org/bond_quartic.html): a chain of 6 beads, 0.97 apart, with
# the end beads pulled apart until the bonds past Rc = 1.3 break (bond type 0, the subtracted lj/cut pair then acts);
# special_bonds 1,1,1 as the style requires; the energies (pe, ebond, evdwl) show the breaks. Native: installed lmp (b332f28).
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 4.0e-13, atoms 3.7e-12.
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      bond
boundary        f f f
region          box block -20 20 -20 20 -20 20
create_box      1 box bond/types 1 extra/bond/per/atom 2
create_atoms    1 single 0.0 0.0 0.0
create_atoms    1 single 0.97 0.0 0.0
create_atoms    1 single 1.94 0.0 0.0
create_atoms    1 single 2.91 0.0 0.0
create_atoms    1 single 3.88 0.0 0.0
create_atoms    1 single 4.85 0.0 0.0
mass            1 1.0
create_bonds    single/bond 1 1 2
create_bonds    single/bond 1 2 3
create_bonds    single/bond 1 3 4
create_bonds    single/bond 1 4 5
create_bonds    single/bond 1 5 6
group           left id 1
group           right id 6
velocity        all set 0.0 0.0 0.0 units box
velocity        left set -5.0 0.0 0.0 units box
velocity        right set 5.0 0.0 0.0 units box
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
special_bonds   lj 1.0 1.0 1.0 coul 1.0 1.0 1.0
bond_style      quartic
bond_coeff      1 1200 -0.55 0.25 1.3 34.6878
fix             1 all nve
timestep        0.002
thermo_style    custom step pe ke ebond evdwl bonds
thermo_modify   format float %.15g
thermo          100
run             1000
