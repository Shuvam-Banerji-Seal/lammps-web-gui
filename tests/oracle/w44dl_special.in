# oracle: lj/cut/dipole/long special_bonds lj/coul factors on a bonded chain of point dipoles (1-2, 1-3, 1-4 pairs), kspace ewald/dipole with fixed gewald 0.4 and kmax/ewald 5 5 5
# oracle-files: w44dl_special_mu.dump
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           lj
atom_style      hybrid bond sphere dipole
region          box block -6 6 -6 6 -6 6
create_box      1 box bond/types 1 extra/bond/per/atom 2 extra/special/per/atom 6
create_atoms    1 single 0.0 0.0 0.0
create_atoms    1 single 1.1 0.2 0.0
create_atoms    1 single 2.0 0.9 0.3
create_atoms    1 single 2.6 1.9 0.1
create_atoms    1 single 3.7 2.2 -0.4
set             group all diameter 1.0
set             group all density 1.0
set             atom 1 dipole 0.5 0.2 0.1
set             atom 2 dipole -0.3 0.4 0.2
set             atom 3 dipole 0.1 -0.5 0.3
set             atom 4 dipole 0.2 0.2 -0.6
set             atom 5 dipole -0.4 0.1 0.1
bond_style      harmonic
bond_coeff      1 50.0 1.1
create_bonds    single/bond 1 1 2
create_bonds    single/bond 1 2 3
create_bonds    single/bond 1 3 4
create_bonds    single/bond 1 4 5
special_bonds   lj 0.0 0.3 0.6 coul 0.2 0.5 0.8
pair_style      lj/cut/dipole/long 4.0
pair_coeff      * * 0.8 1.0
kspace_style    ewald/dipole 1.0e-4
kspace_modify   gewald 0.4 kmax/ewald 5 5 5
thermo_style    custom step pe evdwl ecoul elong press
thermo_modify   format float %.15g norm no
run             0
write_dump      all custom w44dl_special_mu.dump id tqx tqy tqz modify format float %.15g sort id
