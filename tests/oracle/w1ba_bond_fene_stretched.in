# oracle: bond_style fene beyond the guard: 1-(r/R0)^2 < 0.1 is replaced by 0.1 (with a warning)
# oracle-inputs: w1ba_bond_fene_stretched.data
units           lj
atom_style      bond
boundary        f f f
read_data       w1ba_bond_fene_stretched.data
pair_style      lj/cut 1.0
pair_coeff      * * 0.0 1.0
bond_style      fene
bond_coeff      1 30.0 1.5 1.0 1.0
bond_coeff      2 25.0 1.2 1.0 1.0
timestep        0.0005
fix             1 all nve
thermo_style    custom step temp pe ebond etotal
thermo_modify   format float %.15g norm no
thermo          5
run             20
