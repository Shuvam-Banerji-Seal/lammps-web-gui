# oracle: fix qtb after replicate (LJ fcc 2x2x2 copies, stored x-outermost as native after replicate), 4 steps: pins the replicate storage order
# Native reference: LAMMPS b332f28 built from source with PKG_KSPACE MANYBODY MISC MOLECULE PHONON QEQ QTB REAXFF SHOCK, because the installed binary has no QTB (cmake -D PKG_<name>=on for each; then LMP=<build>/lmp run-oracle.mjs)
# oracle-compare: thermo=all atoms=all rel=1e-8
# measured (engine vs native, Node 24): thermo within 2.3e-15 relative, per-atom within 3.6e-15
units           lj
atom_style      atomic
boundary        p p p
lattice         fcc 0.8442
region          box block 0 1 0 1 0 1
create_box      1 box
create_atoms    1 box
replicate       2 2 2
mass            1 1.0
velocity        all create 0.6 4928 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
fix             1 all nve
fix             2 all qtb temp 0.8 damp 0.5 seed 35082 f_max 2.0 N_f 50
thermo_style    custom step temp pe ke etotal press
thermo_modify   format float %.15g
timestep        0.005
thermo          1
run             4
