# oracle: cna/atom and centro/atom on an hcp crystal built from a custom lattice (orthohexagonal cell, 4 basis atoms), with a vacancy and displaced atoms
# oracle-files: w11struct_hcp.dump
# oracle-compare: thermo=all atoms=none
# thermo is step-only: the per-atom structure values are what this case checks
units           metal
atom_style      atomic
lattice         custom 2.5 a1 1 0 0 a2 0 1.7320508075688772 0 a3 0 0 1.6329931618554521 basis 0 0 0 basis 0.5 0.5 0 basis 0 0.3333333333333333 0.5 basis 0.5 0.8333333333333334 0.5
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
mass            1 26.98
group           vac id 1
delete_atoms    group vac compress no
group           few id 9 40 77 101
displace_atoms  few move 0.3 -0.2 0.25 units box
pair_style      lj/cut 4.0
pair_coeff      * * 0.01 2.2
compute         ch all centro/atom 12
compute         cna all cna/atom 3.0
dump            d all custom 1 w11struct_hcp.dump id c_ch c_cna
dump_modify     d sort id format float %.12g
thermo_style    custom step
run             0
