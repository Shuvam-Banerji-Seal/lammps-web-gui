# oracle: compute chunk/atom bin/sphere in lattice, box and reduced units, with discard mixed/yes/no, pbc yes and compress yes; fix ave/chunk density/number, density/mass, vx and temp on the spherical shells (norm sample and norm all), and compute property/chunk coord1
# oracle-files: sph.txt sphall.txt sphz.txt
units           lj
atom_style      atomic
boundary        p p p
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
group           odd id 1:256:2
set             group odd type 2
mass            1 1.0
mass            2 1.5
variable        dx atom 0.04*sin(1.3*x+0.7*y)
variable        dy atom 0.04*cos(0.9*y-1.1*z)
variable        dz atom 0.04*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.8*sin(0.9*x+0.4*z)
variable        vy atom 0.8*cos(0.6*y+0.8*x)
variable        vz atom 0.8*sin(0.7*z-0.3*y)
velocity        all set v_vx v_vy v_vz units box
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
pair_coeff      2 2 0.8 1.05
timestep        0.002
fix             1 all nve
compute         cs all chunk/atom bin/sphere 2 2 2 0.0 1.9 5 units lattice
compute         cy odd chunk/atom bin/sphere 0.5 0.5 0.5 0.1 0.45 4 units reduced discard yes
compute         cp all chunk/atom bin/sphere 0 0 0 0.3 3.0 6 units box pbc yes
compute         cn all chunk/atom bin/sphere 2.5 1 3 0.5 1.2 3 discard no
compute         cz all chunk/atom bin/sphere 2 2 2 0.5 1.8 6 discard yes compress yes
compute         rs all reduce sum c_cs c_cy c_cp c_cn c_cz
compute         pc all property/chunk cs coord1 count
compute         pz all property/chunk cz id coord1
fix             2 all ave/chunk 5 2 10 cs density/number density/mass vx temp norm sample format " %.12g" file sph.txt
fix             3 all ave/chunk 5 2 10 cp density/number vy norm all ave running format " %.12g" file sphall.txt
fix             4 all ave/chunk 5 1 25 cz density/number density/mass format " %.12g" file sphz.txt
thermo_style    custom step temp pe etotal c_cs c_cz c_rs[1] c_rs[2] c_rs[3] c_rs[4] c_rs[5] c_pc[2][1] c_pc[5][2] c_pz[2][1] c_pz[2][2]
thermo_modify   norm no format float %.15g
thermo          10
run             50
