# oracle: sw/angle/table linear style with N of the sw entry (9) different from the 5-point file: preliminary spline grid, 5-atom cluster
# oracle-inputs: w49mt_ang9.sw w49mt_ang5.txt
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units real
atom_style atomic
boundary f f f
lattice none 1.0
region b block -60 60 -60 60 -60 60
create_box 1 b
create_atoms 1 single 0.0 0.0 0.0 units box
create_atoms 1 single 0.083041 3.370426 0.354526 units box
create_atoms 1 single 1.983316 -2.186054 -1.651699 units box
create_atoms 1 single -1.027619 -3.125092 -0.004439 units box
create_atoms 1 single 4.922494 -2.246674 -2.507672 units box
mass 1 18.0
pair_style sw/angle/table
pair_coeff * * w49mt_ang9.sw type
thermo_style custom step pe
thermo_modify format float %.15g
run 0
