# oracle: run_style respa 2 levels — coul/long pair on level 1, ewald kspace on level 2 (charged, periodic)
# oracle-compare: thermo=all atoms=all rel=1e-8
units           lj
atom_style      charge
lattice         sc 0.5
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
set             type 1 charge 0.5
set             type 2 charge -0.5
group           odd id 1:64:2
set             group odd type 2
mass            * 1.0
variable        dx atom 0.05*sin(0.9*x+0.4*y)
variable        dy atom 0.05*cos(0.7*z-0.3*x)
variable        dz atom 0.05*sin(0.5*y+0.2*z)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.3*sin(0.6*x+0.2*z)
variable        vy atom 0.3*cos(0.5*y+0.3*x)
variable        vz atom 0.3*sin(0.4*z-0.5*y)
velocity        all set v_vx v_vy v_vz units box
pair_style      lj/cut/coul/long 2.2
pair_coeff      * * 1.0 1.0
pair_modify     table 0
kspace_style    ewald 1.0e-4
kspace_modify   gewald 1.1 kmax/ewald 6 6 6
timestep        0.002
run_style       respa 2 3 pair 1 kspace 2
fix             1 all nve
thermo_style    custom step temp pe evdwl ecoul elong etotal press
thermo_modify   format float %.15g
thermo          10
run             60
