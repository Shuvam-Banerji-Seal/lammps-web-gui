# oracle: pair lubricate/poly flaglog 1 flagfld 1 with two diameters (0.6 and 0.4, 1:1 types, newton off) on 125 spheres, 20 nve/sphere steps
# native: installed lmp (b332f28)
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 3.8e-15, atoms 1.1e-14.
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      sphere
newton          off
boundary        p p p
lattice         sc 0.3
region          box block 0 5 0 5 0 5
create_box      2 box
create_atoms    1 box
set             type 1 diameter 0.6
set             type 2 diameter 0.4
set             type 2 mass 0.3
velocity        all create 1.0 4928 loop geom
neighbor        1.0 bin
neigh_modify    delay 0 every 1 check yes
comm_modify     vel yes
timestep        0.0002
fix             1 all nve/sphere
pair_style      lubricate/poly 1.5 1 1 0.61 2.5
pair_coeff      * *
thermo_style    custom step temp press vol
thermo_modify   format float %.15g
thermo          5
run             20
