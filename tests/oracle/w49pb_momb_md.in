# oracle: pair_style momb 12.0 0.75 20.0 with three type pairs on a periodic 12-atom cell (metal units), mixed-type dimers in the cell, 50 steps of nve, pair_modify shift no
# oracle-compare: thermo=all atoms=all rel=1e-7 abs=1e-9
units           metal
atom_style      atomic
boundary        p p p
lattice         sc 3.6
region          box block 0 3 0 2 0 2
create_box      2 box
create_atoms    1 box
mass            * 12.0
group           g2 id 2:12:2
set             group g2 type 2
variable        dx atom 0.12*sin(1.3*x+0.7*y)
variable        dy atom 0.12*cos(0.9*y-0.4*z)
variable        dz atom 0.12*sin(1.1*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.01*sin(id)
variable        vy atom 0.01*cos(2*id)
variable        vz atom 0.01*sin(3*id)
velocity        all set v_vx v_vy v_vz
timestep        0.001
pair_style      momb 12.0 0.75 20.0
pair_coeff      1 1 0.3 1.2 2.5 10.2847 2.361
pair_coeff      1 2 0.12 1.6 2.9 22.9973 2.702
pair_coeff      2 2 0.5 1.0 3.0 30.4846 2.757
fix             1 all nve
thermo_style    custom step pe evdwl
thermo_modify   format float %.15g norm no
thermo          10
run             50
