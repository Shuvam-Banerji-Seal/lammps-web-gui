# oracle: reset_atoms mol variants on bonded molecules and singles (compress, offset, single, group-restricted fragments); each variant is written to its own file
# oracle-inputs: w104cf_reset_mol.data
# oracle-files: w104cf_mol_all.txt w104cf_mol_single.txt w104cf_mol_nocompress.txt w104cf_mol_group.txt w104cf_mol_split.txt w104cf_mol_offset0.txt
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=1e-12
units           lj
atom_style      bond
read_data       w104cf_reset_mol.data
reset_atoms     mol all
write_dump      all custom w104cf_mol_all.txt id mol modify sort id
clear
units           lj
atom_style      bond
read_data       w104cf_reset_mol.data
reset_atoms     mol all single yes
write_dump      all custom w104cf_mol_single.txt id mol modify sort id
clear
units           lj
atom_style      bond
read_data       w104cf_reset_mol.data
reset_atoms     mol all compress no single yes
write_dump      all custom w104cf_mol_nocompress.txt id mol modify sort id
clear
units           lj
atom_style      bond
read_data       w104cf_reset_mol.data
group           g id 1 2 3 5 6 7 8 9 10
reset_atoms     mol g
write_dump      all custom w104cf_mol_group.txt id mol modify sort id
clear
units           lj
atom_style      bond
read_data       w104cf_reset_mol.data
group           g id 1 3 4 5 6 7 8 9 10
reset_atoms     mol g offset 10 single yes
write_dump      all custom w104cf_mol_split.txt id mol modify sort id
clear
units           lj
atom_style      bond
read_data       w104cf_reset_mol.data
reset_atoms     mol all offset 0 single yes
write_dump      all custom w104cf_mol_offset0.txt id mol modify sort id
clear
units           lj
atom_style      bond
read_data       w104cf_reset_mol.data
pair_style      lj/cut 2.0
pair_coeff      * * 0.2 1.0
bond_style      harmonic
bond_coeff      1 40.0 1.2
reset_atoms     mol all
thermo_style    custom step pe epair ebond
thermo_modify   format float %.15g norm no
thermo          10
run             0
