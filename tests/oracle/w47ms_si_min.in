# oracle: pair_style meam/spline Si_1.meam.spline, displaced fcc 2x2x2 cell relaxed by cg minimize (atoms only); the final pe and forces compared
# oracle-potentials: Si_1.meam.spline
# oracle-compare: thermo=first-last atoms=all abs=1e-8 skip=fnorm,fmax
units           metal
atom_style      atomic
lattice         fcc 3.98
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box
mass            1 28.085
variable        dx atom 0.08*sin(1.3*x+0.7*y)
variable        dy atom 0.08*cos(0.9*y-0.4*z)
variable        dz atom 0.08*sin(1.1*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
pair_style      meam/spline
pair_coeff      * * Si_1.meam.spline Si
thermo_style    custom step pe fnorm fmax press
thermo_modify   format float %.15g norm no
min_style       cg
minimize        0.0 1.0e-10 2000 20000
