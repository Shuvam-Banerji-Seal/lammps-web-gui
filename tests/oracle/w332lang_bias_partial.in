# oracle: fix langevin with fix_modify temp of a compute temp/partial 0 1 1: the x components are free of drag and random force (a velocity component that is zero once the bias is removed gets no random force); without tally the fix scalar f_2 is 0
# oracle-compare: thermo=all atoms=all
units           lj
atom_style      atomic
atom_modify     map array sort 0 0.0
lattice         sc 0.8
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
mass            1 1.0
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0
velocity        all create 1.0 4928 loop all
timestep        0.005
compute         tp all temp/partial 0 1 1
fix             1 all nve
fix             2 all langevin 1.0 1.0 0.5 9182 zero yes
fix_modify      2 temp tp
variable        vx equal vcm(all,x)
thermo_style    custom step temp c_tp pe f_2 v_vx
thermo_modify   format float %.15g
thermo          10
run             60
