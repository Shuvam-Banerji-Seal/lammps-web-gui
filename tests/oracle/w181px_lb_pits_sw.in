# oracle: fix lb/fluid with pit geometry and side walls (npits 2 with sw, no wp) and fix lb/viscous with a rigid 320-atom sphere (examples/PACKAGES/latboltz/pit_geometry/in.pits, sw variant, cut down: dx 8 (30 x 25 x 31 nodes), 40 steps)
# native: b332f28 built with -D PKG_LATBOLTZ=on -D PKG_MOLECULE=on -D PKG_RIGID=on (serial, 1 process; the installed lmp lacks LATBOLTZ)
# measured (engine vs native, relative): thermo 2.9e-15 (values above 1e-6; absolute 3.4e-8 on f_1[2] = 1.16e7), per-atom 8.8e-14 (xu of atom 52); the case runs in about 2 s
# oracle-inputs: w181px_lb_pits_cut.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units          micro
dimension      3
boundary       p p f
atom_style     atomic
neighbor       1.0 bin
neigh_modify   delay 0 every 1
comm_modify cutoff 10.0
read_data      w181px_lb_pits_cut.data
pair_style     lj/cut 2.45
pair_coeff     * * 0.0 0.0 2.45
neigh_modify   exclude type 1 1
mass           * 100.0
timestep       2.0
group          sphere1 id <> 1 320
velocity       all set 0.0 0.0 0.0 units box
fix   1 all lb/fluid 1 1.0 1.0 dx 8.0 linearInit pressurebcx 0.01 npits 2 6 13 5 0 sw
fix   2 all lb/viscous
fix   3 all rigid group 1 sphere1
variable vx equal vcm(all,x)
variable vy equal vcm(all,y)
variable vz equal vcm(all,z)
variable omegax equal omega(all,x)
variable omegay equal omega(all,y)
variable omegaz equal omega(all,z)
thermo_style   custom step f_1[1] f_1[2] f_1[3] v_vx v_vy v_vz v_omegax v_omegay v_omegaz
thermo_modify  format float %.15g
thermo         10
run   40
