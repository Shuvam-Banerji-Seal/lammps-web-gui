# oracle: pair_style hybrid/overlay lj/cut gauss/cut coul/diel (gauss-diel overlay), pair_modify shift yes, dielectric 0.4255, periodic 12-atom cell, 50 steps of nve
# oracle-compare: thermo=all atoms=all rel=1e-7 abs=1e-9
units           real
atom_style      full
boundary        p p p
lattice         sc 4.4
region          box block 0 3 0 2 0 2
create_box      2 box
create_atoms    1 box
mass            * 1.0
group           g1 id 1:12:2
group           g2 id 2:12:2
set             group g1 type 1
set             group g2 type 2
set             group g1 charge 0.5
set             group g2 charge -0.5
variable        dx atom 0.15*sin(1.3*x+0.7*y)
variable        dy atom 0.15*cos(0.9*y-0.4*z)
variable        dz atom 0.15*sin(1.1*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.01*sin(id)
variable        vy atom 0.01*cos(2*id)
variable        vz atom 0.01*sin(3*id)
velocity        all set v_vx v_vy v_vz
timestep        0.5
pair_style      hybrid/overlay lj/cut 3.5 gauss/cut 3.4 coul/diel 2.5
pair_coeff      * * lj/cut 0.5 1.775 3.268
pair_coeff      1 1 gauss/cut 0.2 3.1 0.6 3.4
pair_coeff      1 2 gauss/cut 0.3 3.4 0.9
pair_coeff      2 2 gauss/cut 0.1 2.9 0.5
pair_coeff      1 1 coul/diel 78.0 1.375 0.112
pair_coeff      1 2 coul/diel 78.0 1.6 0.2
pair_coeff      2 2 coul/diel 78.0 1.2 0.112
dielectric      0.4255
pair_modify     shift yes
fix             1 all nve
thermo_style    custom step pe evdwl ecoul
thermo_modify   format float %.15g norm no
thermo          10
run             50
