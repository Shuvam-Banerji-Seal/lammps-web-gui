# oracle: fix wall/piston zlo with rampNL2 and rough (the NL2 ramp wall velocity, the rough reflection offset) on a shrink-wrapped LJ fluid (no example input uses it)
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# native: b332f28 (installed lmp, package SHOCK)
# measured: thermo agrees with native to about 2e-14 relative in the rampNL2 run (the 1e-8 target holds with margin)
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
boundary        p p s
create_box      1 box
create_atoms    1 box
mass            1 1.0
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0 2.5
velocity        all create 1.0 12345 loop geom
timestep        0.005
fix             1 all nve
fix             2 all wall/piston zlo pos -0.5 vel 0.5 rampNL2 rough 0.05 units box
thermo_style    custom step temp pe ke press lz zlo
thermo_modify   format float %.15g
thermo          50
run             400
