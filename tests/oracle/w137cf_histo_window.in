# oracle: fix ave/histo with ave window 2 (the histograms of the last two outputs are summed, not averaged, and the
# oracle: min/max are over the window's entries). 32 LJ atoms, 4 samples per output (Nrepeat 4 at Nevery 1, Nfreq 4),
# oracle: outputs at steps 4, 8, 12 of a 12-step run. The atom-style variable v = x makes the values deterministic.
# oracle-files: w137cf_histo_window.histo
# oracle-compare: thermo=all atoms=none
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box
mass            1 1.0
pair_style      zero 2.5
pair_coeff      * *
variable        s equal step
fix             h all ave/histo 1 4 4 0 12 4 v_s ave window 2 mode scalar file w137cf_histo_window.histo
thermo_style    custom step f_h[1] f_h[2] f_h[3] f_h[4]
thermo_modify   format float %.15g
run             12
