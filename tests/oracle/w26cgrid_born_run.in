# oracle: compute born/matrix evaluated every step of an nve run
units           lj
atom_style      atomic
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 single 0.5 0.5 0.5
create_atoms    1 single 1.7 1.2 0.9
create_atoms    1 single 2.3 0.7 1.8
create_atoms    1 single 0.9 2.1 0.4
create_atoms    1 single 3.1 2.9 2.2
mass            1 1.0

pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
neighbor        0.3 bin
neigh_modify    delay 0 every 1 check no

fix             1 all nve

compute         myvirial all pressure NULL virial
compute         bm all born/matrix numdiff 1.0e-6 myvirial
compute         ba all born/matrix

thermo_style    custom step temp pe c_ba[1] c_ba[2] c_ba[3] c_ba[7] c_ba[11] c_bm[1] c_bm[2] c_bm[3] c_bm[7] c_bm[11]
thermo_modify   format float %.15g
thermo          2
run             6
