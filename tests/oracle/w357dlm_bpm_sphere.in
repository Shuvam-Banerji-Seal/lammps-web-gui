# oracle: fix nve/bpm/sphere update dipole/dlm: the quaternion takes the Richardson step with the angular velocity before the DLM update, which then turns omega and the dipole; pair lj/cut/dipole/cut torques on atom_style hybrid bpm/sphere dipole, and a dipole along +z
# oracle-files: w357dlm_bpm_sphere_rot.dump
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      hybrid bpm/sphere dipole
boundary        p p p
lattice         fcc 0.5
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
set             group all diameter 1.0
set             group all density 1.0
set             group all dipole/random 2281 0.8
set             atom 4 dipole 0 0 0.8
set             group all omega 0.2 0.1 -0.4
pair_style      lj/cut/dipole/cut 2.5
pair_coeff      * * 1.0 1.0
neighbor        0.3 bin
neigh_modify    delay 0
velocity        all create 0.6 7731 mom yes rot yes dist gaussian
fix             1 all nve/bpm/sphere update dipole/dlm
timestep        0.004
thermo_style    custom step pe ke etotal press
thermo_modify   format float %.15g norm no
thermo          10
run             60
write_dump      all custom w357dlm_bpm_sphere_rot.dump id mux muy muz omegax omegay omegaz modify format float %.15g sort id
