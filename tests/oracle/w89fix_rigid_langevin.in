# oracle: fix rigid single with fix langevin on the same atoms (the langevin forces enter the body force sums)
# oracle-compare: rel=1e-12 abs=1e-14
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 1.44 87287 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
timestep        0.005
fix             1 all rigid single
fix             2 all langevin 1.0 1.0 0.5 48279
thermo_style    custom step temp pe etotal press
thermo_modify   format float %.15g
thermo          1
run             5
