# oracle: pair granular heat area (h_s) with hertz/material, heat/flow type with two atom types (cp 1.0 and 2.5), gravity and a fixed-temperature plane via fix wall/gran/region granular heat area with temperature; 48 slightly overlapping spheres from a lattice (diameter 1.05 against a spacing of about 1.03), 100 steps
units           lj
atom_style      sphere
atom_modify     map array
comm_modify     vel yes
boundary        f f f
lattice         sc 0.9
region          box block 0 4 0 3 0 4
create_box      2 box
create_atoms    1 box
group           odd id 1:48:2
set             group odd type 2
set             type 1 diameter 1.05 density 1.0
set             type 2 diameter 1.05 density 1.4
displace_atoms  all move 0 0 0.5 units box
fix             pa all property/atom temperature heatflow
set             group all temperature 1.0
pair_style      granular
pair_coeff      * * hertz/material 1e4 0.1 0.3 tangential mindlin NULL 1.0 0.5 damping tsuji heat area 5.0
timestep        0.002
fix             1 all nve/sphere
fix             2 all heat/flow type 1.0 2.5
fix             grav all gravity 0.5 vector 0 0 -1
region          floor plane 0 0 0 0 0 1 side in
fix             3 all wall/gran/region granular hertz/material 1e4 0.1 0.3 tangential mindlin NULL 1.0 0.5 damping tsuji heat area 5.0 region floor temperature 2.0
compute         pa all property/atom temperature heatflow
compute         tsum all reduce sum c_pa[1]
compute         tmax all reduce max c_pa[1]
compute         tmin all reduce min c_pa[1]
compute         hsum all reduce sum c_pa[2]
compute         hmax all reduce max c_pa[2]
compute         hmin all reduce min c_pa[2]
thermo_style    custom step ke c_tsum c_tmax c_tmin c_hsum c_hmax c_hmin
thermo_modify   format float %.15g
thermo          10
run             100
