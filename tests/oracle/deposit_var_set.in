# oracle: fix deposit var and set: atoms deposited onto an fcc slab only where an equal-style test of the internal x and y variables holds (a disc), with near and attempt; set z creates its variable
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      atomic
boundary        p p f
lattice         fcc 0.8442
region          box block 0 6 0 6 0 12
create_box      2 box
region          slab block 0 6 0 6 0 1.5
create_atoms    1 region slab
mass            * 1.0
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0
neigh_modify    every 1 delay 0 check yes
region          top block 0 6 0 6 9 10
variable        xx internal 0.0
variable        disc equal "(v_xx-5.0)^2+(v_yy-5.0)^2 < 6.0 && v_zz > 15.5"
group           sub type 1
group           add type 2
fix             0 sub setforce 0 0 0
fix             1 add deposit 25 2 20 12345 region top near 1.0 attempt 20 var disc set x xx set y yy set z zz vz -1.0 -1.0
fix             2 add nve
thermo_style    custom step atoms temp pe ke press f_1
thermo_modify   format float %.15g lost ignore
thermo          50
run             500
