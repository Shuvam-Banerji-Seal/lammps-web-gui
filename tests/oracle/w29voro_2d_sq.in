# oracle: compute voronoi/atom in a 2d periodic box — per-atom volume is the cross-sectional area times the z extent, per-atom face count includes the two z faces
# oracle-files: w29voro_2d_sq.dump
units           lj
dimension       2
boundary        p p p
atom_style      atomic
lattice         sq 1.0 origin 0.5 0.5 0.0
region          box block 0 3 0 3 -1.0 1.0 units box
region          atoms block 0 3 0 3 0.0 0.0 units box
create_box      1 box
create_atoms    1 region atoms
mass            1 1.0
pair_style      lj/cut 0.5
pair_coeff      1 1 0.0 1.0
neighbor        0.3 nsq
comm_modify     cutoff 5.0
compute         v all voronoi/atom
thermo_style    custom step pe
thermo_modify   format float %.15g
dump            d all custom 1 w29voro_2d_sq.dump id c_v[*]
dump_modify     d sort id format float %.17g
run             0
