# oracle: fix press/berendsen x and y with couple xy (the z box length stays), 256-atom lj fcc melt
# oracle-compare: rel=1e-12 abs=1e-14
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 1.44 87287 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
timestep        0.005
fix             1 all nve
fix             2 all press/berendsen x 1.0 1.0 1.0 y 1.0 1.0 1.0 couple xy
thermo_style    custom step temp pe etotal press vol lx ly lz
thermo_modify   format float %.15g
thermo          1
run             10
