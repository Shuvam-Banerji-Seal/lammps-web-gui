# oracle: fix wall/gran/region on a side-out sphere (convex outer surface, Rw = +R), hertz/history, spheres under gravity
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-12
units           lj
atom_style      sphere
atom_modify     map array
comm_modify     vel yes
boundary        f f f
region          box block -8 8 -8 8 -8 8 units box
create_box      1 box
region          sph sphere 0.0 0.0 0.0 2.0 side out units box
create_atoms    1 single 2.4 0.0 0.0 units box
create_atoms    1 single 0.0 2.4 0.0 units box
create_atoms    1 single 0.0 0.0 -2.4 units box
create_atoms    1 single 2.2 1.0 0.0 units box
create_atoms    1 single 1.8 1.8 0.5 units box
create_atoms    1 single 2.4 -1.4 0.3 units box
set             type 1 diameter 1.0 density 1.0
velocity        all set -0.25 -0.1 0.0 units box
pair_style      none
timestep        0.0005
fix             1 all nve/sphere
fix             2 all gravity 1.0 vector 0 0 -1
fix             3 all wall/gran/region hertz/history 2000.0 1000.0 30.0 30.0 0.5 1 region sph
thermo_style    custom step ke pe etotal
thermo_modify   format float %.15g
thermo          25
run             300
