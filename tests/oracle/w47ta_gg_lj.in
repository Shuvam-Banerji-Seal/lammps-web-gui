# oracle: compute group/group pair-only (both orders, same group, molecule inter/intra, pair no) on lj/cut/coul/cut with charges, NVE 10 steps
units           lj
atom_style      full
boundary        p p p
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
group           odd id 1:108:2
set             group odd type 2
mass            1 1.0
mass            2 1.5
set             group odd charge 0.6
group           even subtract all odd
set             group even charge -0.6
group           m1 id 1:108:3
group           m2 id 2:108:3
group           m3 id 3:108:3
set             group m1 mol 1
set             group m2 mol 2
set             group m3 mol 3
region          lowz block INF INF INF INF INF 2.5 units box
group           lower region lowz
group           upper subtract all lower
variable        dx atom 0.04*sin(1.3*x+0.7*y)
variable        dy atom 0.04*cos(0.9*y-1.1*z)
variable        dz atom 0.04*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.8*sin(0.9*x+0.4*z)
variable        vy atom 0.8*cos(0.6*y+0.8*x)
variable        vz atom 0.8*sin(0.7*z-0.3*y)
velocity        all set v_vx v_vy v_vz units box
pair_style      lj/cut/coul/cut 2.5
pair_coeff      1 1 1.0 1.0
pair_coeff      2 2 0.8 1.05
pair_coeff      1 2 0.9 1.0
timestep        0.002
fix             1 all nve
compute         gab odd group/group even
compute         gba even group/group odd
compute         gaa odd group/group odd
compute         gall all group/group all
compute         gmi odd group/group even molecule inter
compute         gin odd group/group even molecule intra
compute         gnp odd group/group even pair no
compute         gx lower group/group upper
compute         gm1 m1 group/group m2 molecule inter
thermo_style    custom step pe c_gab c_gab[1] c_gab[2] c_gab[3] c_gba c_gba[1] c_gba[2] c_gba[3] c_gaa c_gaa[1] c_gaa[2] c_gaa[3] c_gall c_gall[1] c_gall[2] c_gall[3] c_gmi c_gmi[1] c_gin c_gin[1] c_gnp c_gnp[1] c_gx c_gx[1] c_gx[2] c_gx[3] c_gm1 c_gm1[1]
thermo_modify   format float %.15g
thermo          5
run             10
