# oracle: fix adapt on bond morse d0 and alpha, angle fourier C1, dihedral quadratic phi0, improper cvff k, then a second run without reset (the adapted values stay and are the next run's originals)
# oracle-inputs: mol_chains.data
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=1e-12
units           lj
atom_style      molecular
bond_style      morse
angle_style     fourier
dihedral_style  quadratic
improper_style  cvff
pair_style      lj/cut 2.5
read_data       mol_chains.data
pair_coeff      * * 0.5 0.9
pair_coeff      1 3 0.8 1.0
special_bonds   lj 0.0 0.5 0.8
bond_coeff      * 2.0 2.5 1.05
angle_coeff     * 30.0 0.4 0.3 0.2
dihedral_coeff  1 5.0 170.0
improper_coeff  1 3.0 -1 2
variable        d0 equal 2.0+0.02*step
variable        al equal 2.5-0.01*step
variable        c1 equal 0.3+0.004*step
variable        p0 equal (170.0-0.3*step)*PI/180.0
variable        kc equal 3.0+0.05*step
fix             ad all adapt 1 bond morse d0 1 v_d0 bond morse alpha 2 v_al angle fourier C1 * v_c1 dihedral quadratic phi0 1 v_p0 improper cvff k 1 v_kc
velocity        all create 1.0 4928459 mom no rot no
timestep        0.002
fix             1 all nve
thermo_style    custom step pe ebond eangle edihed eimp etotal
thermo_modify   format float %.15g norm no
thermo          5
run             20
unfix           ad
run             10
