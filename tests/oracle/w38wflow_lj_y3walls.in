# oracle: LJ fluid (fcc 0.8442, 864 atoms) with fix wall/flow along y, three walls in lattice units, 300 steps; thermo temp ke and reduce ave vy
# oracle-compare: thermo=all atoms=all rel=1e-7 abs=1e-9
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 6 0 6 0 6
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 1.0 87287
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes
fix             1 all nve
fix             2 all wall/flow y 0.5 1.0 4321 3 2 4 5
compute         vy all reduce ave vy
thermo_style    custom step temp ke pe c_vy
thermo_modify   format float %.15g
timestep        0.004
thermo          50
run             300
