# oracle: SPC/E-like water (64 molecules): fix shake on the O-H bonds and H-O-H angle, then velocity create before the first run (the temperature compute's dof must already exclude the constraints), run 0 and run 20 with nve
# oracle-inputs: w42gap_spce64.data
# oracle-compare: thermo=all atoms=none abs=1e-9
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 2.8e-12 (atoms not compared).
units           real
atom_style      full
read_data       w42gap_spce64.data
pair_style      lj/cut/coul/long 6.0
pair_coeff      * * 0.0 1.0
pair_coeff      1 1 0.15535 3.166
pair_modify   table 0
kspace_style    pppm 1.0e-4
bond_style      harmonic
angle_style     harmonic
bond_coeff      1 1000.00 1.000
angle_coeff     1 100.0 109.47
special_bonds   lj/coul 0.0 0.0 0.0
neighbor        2.0 bin
timestep        2.0
fix             1 all shake 0.0001 20 0 b 1 a 1
fix             2 all nve
velocity        all create 300.0 6244325
thermo_style    custom step temp pe ke etotal press
thermo_modify   format float %.15g
thermo          10
run             0
run             20
