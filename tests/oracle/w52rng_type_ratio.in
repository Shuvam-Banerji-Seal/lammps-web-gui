# oracle: set type/ratio on the left half of a 256-atom fcc lattice (eligible atoms only; 0.37 of them become type 2), run 0
# oracle-compare: thermo=all atoms=all
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
region          lhalf block 0 2 0 4 0 4
create_box      2 box
create_atoms    1 box
mass            * 1.0
group           left region lhalf
set             group left type/ratio 2 0.37 987
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0 2.5
neighbor        0.3 bin
neigh_modify    every 20 delay 0 check no
thermo_style    custom step pe press
thermo_modify   format float %.15g
thermo          1
run             0
