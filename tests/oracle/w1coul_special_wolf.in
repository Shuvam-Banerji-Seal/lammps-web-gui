# oracle: pair_style coul/wolf on charged bonded chains — special_bonds weights 0.0 / 0.5 / 0.8 on the damped Coulomb term
# oracle-inputs: w1lcoul_chains.data
units           lj
atom_style      full
bond_style      harmonic
angle_style     harmonic
dihedral_style  harmonic
improper_style  harmonic
pair_style      coul/wolf 0.6 3.5
read_data       w1lcoul_chains.data
pair_coeff      * *
bond_coeff      1 120.0 1.05
bond_coeff      2 90.0 1.1
angle_coeff     1 40.0 109.5
angle_coeff     2 25.0 120.0
dihedral_coeff  1 1.5 -1 3
improper_coeff  1 12.0 20.0
special_bonds   lj/coul 0.0 0.5 0.8
timestep        0.002
fix             1 all nve
thermo_style    custom step temp pe ebond eangle edihed eimp evdwl ecoul etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          10
run             50
