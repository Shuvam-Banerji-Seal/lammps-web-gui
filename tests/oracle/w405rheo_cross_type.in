# oracle: RHEO 2d Taylor-Green vortex of two atom types (the right half is type 2) with fix rheo RK1 8 shift scale/cross/type 0.05 0.02 0.5 (the docs' values): the shift normal to the type interface is scaled, and isolated atoms do not shift; compute rheo/property/atom shift/v/* reduced in thermo
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-13
# Measured with native LAMMPS: engine vs native thermo 1.4e-14, atoms 1.8e-15; the cross-type correction halves the shift (sum of squared x shift velocities 1.1e-6 against 2.2e-6 with plain shift at step 300).
units        lj
atom_style   rheo
dimension    2
boundary     p p p
comm_modify  vel yes
newton       off

region       box block 0 16 0 16 -0.01 0.01
create_box   2 box
lattice      sq 1.0
create_atoms 1 region box
displace_atoms all random 0.1 0.1 0 135414 units box
region       right block 8 16 INF INF INF INF units box
set          region right type 2

variable     rho0 equal 1.0
variable     mp equal ${rho0}/1.0
variable     cs equal 1.0
variable     eta equal 0.05
variable     zeta equal 1
variable     dt_max equal 0.1*3.0/${cs}/3
variable     Dr equal 0.1*3.0*${cs}
variable     u0 equal 0.05
variable     uy atom  ${u0}*sin(2*PI*x/lx)*cos(2*PI*y/ly)
variable     ux atom -${u0}*sin(2*PI*y/ly)*cos(2*PI*x/ly)

mass         * ${mp}
set          group all rheo/rho ${rho0}
set          group all rheo/status 0
velocity     all set v_ux v_uy 0.0 units box

timestep     ${dt_max}

pair_style   rheo 3.0 artificial/visc ${zeta} rho/damp ${Dr}
pair_coeff   * *

fix          1 all rheo 3.0 RK1 8 shift scale/cross/type 0.05 0.02 0.5
fix          2 all rheo/viscosity * constant ${eta}
fix          3 all rheo/pressure * linear
fix          4 all enforce2d

compute      rho all rheo/property/atom rho
compute      sv all rheo/property/atom shift/v/*
compute      svs all reduce sumsq c_sv[*]

thermo       50
thermo_style custom step time ke press c_svs[*]
thermo_modify format float %.15g

run          300
