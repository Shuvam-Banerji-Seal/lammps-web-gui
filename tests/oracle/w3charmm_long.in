# oracle: pair_style lj/charmm/coul/long with Ewald
units           real
atom_style      charge
lattice         fcc 5.4
region          box block 0 5 0 5 0 5
create_box      2 box
create_atoms    1 box
group           odd id 1:500:2
set             group odd type 2
mass            1 39.948
mass            2 39.948
set             type 1 charge 0.3
set             type 2 charge -0.3
variable        dx atom 0.1*sin(0.31*x+0.27*y)
variable        dy atom 0.1*cos(0.23*y-0.19*z)
variable        dz atom 0.1*sin(0.17*z+0.29*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.004*sin(0.31*x+0.27*y)
variable        vy atom 0.004*cos(0.23*y-0.19*z)
variable        vz atom 0.004*sin(0.17*z+0.29*x)
velocity        all set v_vx v_vy v_vz units box
pair_style      lj/charmm/coul/long 8.0 10.0
pair_coeff      1 1 0.238 3.405
pair_coeff      2 2 0.3 3.3 0.25 3.2
pair_modify     table 0
kspace_style    ewald 1.0e-5
kspace_modify   gewald 0.28 kmax/ewald 7 7 7
timestep        2.0
fix             1 all nve
thermo_style    custom step temp pe evdwl ecoul elong etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          10
run             40
