# oracle: fix rigid single langevin in 2d (only the rotation about the plane normal is active)
# oracle-inputs: rigid_tri.txt
# oracle-compare: abs=1e-8
units           lj
dimension       2
atom_style      molecular
region          box block 0 20 0 20 -0.5 0.5 units box
create_box      2 box
mass            1 1.0
mass            2 1.5
molecule        r rigid_tri.txt
create_atoms    0 single 10 10 0 mol r 1 rotate 0 0 0 1 units box
pair_style      zero 5.0
pair_coeff      * *
timestep        0.002
fix             1 all rigid single langevin 0.7 0.7 0.5 246810
thermo_style    custom step f_1[1][1] f_1[1][2] f_1[1][4] f_1[1][5] f_1[1][12]
thermo_modify   format float %.15g
thermo          20
run             200
