# oracle: pair_style comb + fix qeq/comb - Cu2O 3x3x3 cells cut from LAMMPS examples/comb in.comb.Cu2O.elastic (qeq every step, 5 steps; minimization and elastic loops removed)
# oracle-inputs: w58comb_cu2o.data
# oracle-potentials: ffield.comb
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units		metal
atom_style	charge
dimension       3
boundary        p p p
read_data	w58comb_cu2o.data
mass		1 63.54
mass		2 16.00
velocity	all create 1.0 277387
pair_style	comb
pair_coeff	* * ffield.comb Cu O
neighbor	0.5 bin
neigh_modify	every 20 delay 0 check no
timestep        0.00020
thermo_style	custom step temp etotal pe evdwl ecoul lx ly lz vol
thermo_modify	norm yes format float %.15g
thermo		1
fix   		1 all nve
fix   	 	2 all qeq/comb 1 0.0001
run		5
