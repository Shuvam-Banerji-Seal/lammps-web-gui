# Wave 15: compute pair with the vector of pair_style hbond/dreiding/lj (docs.lammps.org/pair_hbond_dreiding.html:
# "can be accessed via the compute pair command as a vector of values of length 2"). The system is the
# w14 water/acceptor system; the hbond sub-style sits in hybrid/overlay with lj/cut. thermo_modify norm yes:
# the scalar and the vector are extensive, so thermo divides them by the atom count.
# oracle-inputs: w14hbond_system.data
# oracle-compare: thermo=all atoms=all rel=1e-7 abs=1e-9
units           real
atom_style      full
boundary        p p p
read_data       w14hbond_system.data
special_bonds   lj/coul 0.0 0.0 1.0
pair_style      hybrid/overlay lj/cut 8.0 hbond/dreiding/lj 4 3.0 4.5 90.0
pair_coeff      * * lj/cut 0.1 2.8
pair_coeff      1 3 hbond/dreiding/lj 2 i 2.0 2.2
pair_coeff      1 5 hbond/dreiding/lj 2 i 1.5 2.4 2 3.0 4.5 90.0
bond_style      harmonic
bond_coeff      1 450.0 0.9572
bond_coeff      2 300.0 1.2
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
timestep        1.0
fix             1 all nve
compute         hb all pair hbond/dreiding/lj
compute         hbe all pair hbond/dreiding/lj 1 evdwl
compute         lj all pair lj/cut
thermo_style    custom step pe evdwl c_hb c_hbe c_hb[1] c_hb[2] c_lj
thermo_modify   format float %.15g norm yes
thermo          20
run             100
