# oracle: fix saed/vtk (XML ImageData .vti, Nevery 1 Nrepeat 2 Nfreq 2, ave running) on compute saed of 2x2x2 fcc Ni (32 atoms, displaced and moving), full reciprocal volume (Kmax 0.6, c 0.05, manual), 6 steps
# engine vs native fixture: thermo max relative error 1.3e-15; the three written .vti files are byte-identical (max relative error 0); engine time 0.2 s (one run).
# native: installed lmp (b332f28, DIFFRACTION)
# oracle-files: w171px_saed_vtk_xml.0.vti w171px_saed_vtk_xml.1.vti w171px_saed_vtk_xml.2.vti
# oracle-compare: thermo=all atoms=none rel=1e-8 abs=1e-10 filerel=1e-8
units           metal
atom_style      atomic
boundary        p p p
lattice         fcc 3.52
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box
mass            * 58.71
displace_atoms  all random 0.05 0.05 0.05 4928 units box
velocity        all set 0.001 0.002 -0.0015 units box
pair_style      none
fix             1 all nve
compute         SAED all saed 0.0251 Ni Kmax 0.6 Zone 0 0 0 c 0.05 0.05 0.05 dR_Ewald 0.01 manual
fix             2 all saed/vtk 1 2 2 c_SAED file w171px_saed_vtk_xml format xml ave running
thermo_style    custom step f_2[1] f_2[2]
thermo_modify   format float %.15g
thermo          2
timestep        0.001
run             6
