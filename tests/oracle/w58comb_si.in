# oracle: pair_style comb - pure Si diamond, fixed charges, 30 steps (LAMMPS examples/comb in.comb.Si, cut down to 30 steps)
# oracle-potentials: ffield.comb
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units		metal
atom_style	charge
dimension       3
boundary        p p p
lattice  	diamond 5.43
region		box block 0 4 0 4 0 4
create_box	1 box
create_atoms	1 box
mass		1 29.0
pair_style	comb
pair_coeff	* * ffield.comb Si
neighbor	0.5 bin
neigh_modify	every 1 delay 1 check yes
fix		1 all nve
timestep        0.00020
thermo_style	custom step temp etotal pe evdwl ecoul press vol lx ly lz xz
thermo_modify	norm yes format float %.15g
velocity	all create 10.1 2398378
thermo	  	1
run  		30
