# oracle: compute gaussian/grid/local on group odd (type 1 atoms, outside the group, do not contribute); 3 types with different R and sigma, grid 3 3 3, rcutfac 1.2
# oracle-compare: thermo=first atoms=all rel=1e-9 abs=1e-12
units metal
atom_modify map hash
lattice bcc 2.2
region box block 0 2 0 2 0 2
create_box 3 box
create_atoms 1 box
group odd id 1:16:2
set group odd type 2
group third id 1:16:4
set group third type 3
mass * 180.88
variable dx atom 0.08*sin(1.3*x+0.7*y)
variable dy atom 0.08*cos(0.9*y-1.1*z)
variable dz atom 0.08*sin(1.7*z+0.5*x)
displace_atoms all move v_dx v_dy v_dz units box
pair_style zero 4.0
pair_coeff * *
compute mygl odd gaussian/grid/local grid 3 3 3 1.2 0.5 0.7 0.9 0.2 0.3 0.25
compute s1 all reduce sum c_mygl[7] inputs local
compute s2 all reduce sum c_mygl[8] inputs local
compute s3 all reduce sum c_mygl[9] inputs local
compute m1 all reduce max c_mygl[7] inputs local
compute m2 all reduce max c_mygl[8] inputs local
compute m3 all reduce max c_mygl[9] inputs local
thermo_style custom step c_s1 c_s2 c_s3 c_m1 c_m2 c_m3
thermo_modify format float %.15g
run 0
