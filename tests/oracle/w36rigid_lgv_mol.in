# oracle: fix rigid langevin, bodystyle molecule, several bodies, ramped temperature Tstart != Tstop
# oracle-inputs: rigid_tetra.txt rigid_dimer.txt
# oracle-compare: abs=1e-8
units           lj
atom_style      molecular
region          box block 0 20 0 20 0 20 units box
create_box      2 box
mass            1 1.0
mass            2 1.5
molecule        t rigid_tetra.txt
molecule        d rigid_dimer.txt
create_atoms    0 single 4 4 4 mol t 1 rotate 0 0 0 1 units box
create_atoms    0 single 4 12 12 mol d 2 rotate 0 0 0 1 units box
create_atoms    0 single 12 4 12 mol t 3 rotate 0 0 0 1 units box
create_atoms    0 single 12 12 4 mol d 4 rotate 0 0 0 1 units box
create_atoms    0 single 16 16 16 mol t 5 rotate 0 0 0 1 units box
create_atoms    0 single 16 5 5 mol d 6 rotate 0 0 0 1 units box
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
pair_coeff      2 2 0.8 1.05
pair_coeff      1 2 0.9 1.02
variable        vx atom 0.3*sin(0.8*x+0.3*z)
variable        vy atom 0.3*cos(0.5*y+0.7*x)
variable        vz atom 0.3*sin(0.6*z-0.4*y)
velocity        all set v_vx v_vy v_vz units box
timestep        0.002
fix             1 all rigid molecule langevin 0.4 1.2 0.5 987654
thermo_style    custom step temp pe ke etotal f_1[1][1] f_1[1][2] f_1[1][3] f_1[2][1] f_1[2][2] f_1[2][3] f_1[3][1] f_1[3][2] f_1[3][3] f_1[1][4] f_1[1][5] f_1[1][6] f_1[6][4] f_1[6][5] f_1[6][6]
thermo_modify   format float %.15g
thermo          20
run             200
