# oracle: pair dpd/ext cut down from examples/PACKAGES/dpd-basic/dpdext/in.dpdext, pair temperature 0 (no random force; the velocities are seeded natively)
# Measured with native LAMMPS (black box): engine vs native max relative error 3.4e-15 (thermo), 2.8e-14 (per-atom). Noise off (pair temperature 0), so the four-deviate draws do not enter.
# oracle-compare: thermo=all atoms=all rel=1e-12 abs=0
variable T    equal 0.0
units        lj
boundary     p p p
atom_style   atomic
dimension    3
newton       on
comm_modify  vel yes
variable     L equal 3.0
lattice      fcc 3.0
region       simBox block 0 ${L} 0 ${L} 0 ${L}
create_box   2 simBox
create_atoms 1 random 30 12456 simBox
create_atoms 2 random 30 13245 simBox
mass         1 1.0
mass         2 2.0
pair_style       dpd/ext ${T} 1.0 3854262
pair_coeff   1 1 25.0 4.5 4.53 0.5 0.53   1.2
pair_coeff   1 2 25.1 4.51 4.54 0.51 0.54 1.21
pair_coeff   2 2 25.2 4.52 4.55 0.52 0.55 1.22
timestep     0.01
run_style    verlet
velocity all create 1.0 68768932
thermo_style custom step time temp press pe ke
thermo_modify format float %.15g
thermo       10
fix 1 all    nve
run          50
