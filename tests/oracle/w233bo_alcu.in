# oracle: pair_style bop with AlCu.bop.table (Al Cu, fcc 4x4x4 with a Cu sublattice, angular table with npower 7), displaced, velocity create, 50 steps of nve
# oracle-potentials: AlCu.bop.table
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 1.8e-12, atoms 4.8e-14.
units           metal
atom_style      atomic
lattice         fcc 3.8
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
group           cu id 2:256:2
set             group cu type 2
variable        dx atom 0.05*sin(1.3*x+0.7*y)
variable        dy atom 0.05*cos(0.9*y-0.4*z)
variable        dz atom 0.05*sin(1.1*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
pair_style      bop
pair_coeff      * * AlCu.bop.table Al Cu
comm_modify     cutoff 12.7
velocity        all create 300.0 4928459
timestep        0.001
fix             1 all nve
thermo_style    custom step pe ke press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g norm no
thermo          10
run             50
