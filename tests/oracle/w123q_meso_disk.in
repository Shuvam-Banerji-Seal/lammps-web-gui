# oracle: fix rigid/meso (one disk of type 2 in an SDPD fluid, 2d) cut down from examples/PACKAGES/dpd-smooth/2d-diffusion/in.lammps: the 100-atom block of the w112 case (box +-0.5, lattice 0.1) with a disk of radius 0.2 (about 12 atoms) typed 2 and held by fix rigid/meso single; 20 steps; thermo and per-atom state (x, v, f, rho, esph) compared
# measured max error vs native (relative): thermo 1.4e-19, atoms 2.8e-17 (the 2d flags and enforce2d of fix rigid, without them the body z-velocity is 7.6e-3 off).
# oracle-files: w123q_meso_disk_sph.dump
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10 atomrel=1e-8
dimension       2
units           micro
atom_style      sph
variable        a equal 0.1
variable        L equal 0.5
variable        T equal 300.
variable        rho_0 equal 1.
variable        c_0 equal 100.
variable        mu equal 1.
variable        h equal $a*4.5
variable        mass equal $a*$a*$a*${rho_0}
variable        dt equal 1e-3
variable        skin equal 0.2*$h
region          box block -$L $L -$L $L -0.5 0.5 units box
create_box      2 box
lattice         sq $a
create_atoms    1 box
region          sphere sphere 0 0 0 0.2 units box
set             region sphere type 2
group           fluid type 1
group           sphere type 2
mass            * ${mass}
set             group all sph/rho ${rho_0}
pair_style      sdpd/taitwater/isothermal $T ${mu} 76787
pair_coeff      * * ${rho_0} ${c_0} ${h}
fix             1 fluid sph
fix             2 sphere rigid/meso single
fix             3 all enforce2d
neighbor        ${skin} bin
neigh_modify    delay 0 every 1 check yes
timestep        ${dt}
thermo_style    custom step time pe ke etotal
thermo_modify   format float %.15g
thermo          5
compute         crho all sph/rho/atom
compute         ce all sph/e/atom
run             20
write_dump all custom w123q_meso_disk_sph.dump id type x y c_crho c_ce modify format float %.15g sort id
