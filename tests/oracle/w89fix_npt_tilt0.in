# oracle: the diagonal-only control of w89fix_npt_tilt (same triclinic box, no xy barostat)
# oracle-compare: rel=1e-12 abs=1e-14
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 1.44 87287 loop geom
change_box      all triclinic
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
timestep        0.005
fix             1 all npt temp 1 1 0.5 x 1 1 2 y 1 1 2 z 1 1 2 couple none
thermo_style    custom step temp press pe f_1
thermo_modify   format float %.15g
thermo          1
run             10
