# oracle: special_bonds amber (Coulomb 1-4 weight 5/6) on a five-atom chain, lj/cut/coul/cut
# oracle-inputs: w88pair_chain.data
units           real
atom_style      full
read_data       w88pair_chain.data
pair_style      lj/cut/coul/cut 10.0
pair_coeff      * * 0.2 1.1
bond_style      harmonic
bond_coeff      1 100.0 1.0
angle_style     harmonic
angle_coeff     1 10.0 110.0
dihedral_style  harmonic
dihedral_coeff  1 1.0 1 0
special_bonds   amber
thermo_style    custom step evdwl ecoul
thermo_modify   format float %.15g
run 0
