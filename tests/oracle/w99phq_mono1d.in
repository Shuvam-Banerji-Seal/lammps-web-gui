# oracle: fix phonon (displacement correlations, dynamical matrix log) on the 1-1D monoatomic chain of examples/PACKAGES/phonon/1-1D-mono
# Native reference: LAMMPS b332f28 built from source with PKG_KSPACE MANYBODY MISC MOLECULE PHONON QEQ QTB REAXFF SHOCK, because the installed binary has no QTB (cmake -D PKG_<name>=on for each; then LMP=<build>/lmp run-oracle.mjs)
# (b332f28, GPL-2.0): Langevin + setforce + nve, 16 atoms; cut down: 20000 steps, measurements every 10 steps after 2000 wait steps,
# output every 500 measurements (so the post_run output of the last 300 measurements is written too). The binary phonon.bin.N and the
# dump of the example are not part of this case.
# oracle-inputs: w99phq_mono1d_data.pos w99phq_mono1d.map
# oracle-files: phonon.log
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# measured (engine vs native, Node 24): thermo within 4.7e-17 absolute, per-atom within 2.0e-15; phonon.log within 5e-12 (relative)
dimension   2
boundary    p f p
units		   lj
atom_style	bond
atom_modify sort 0 1.
bond_style  harmonic
pair_style  none
comm_modify cutoff 2.0
read_data	w99phq_mono1d_data.pos
neighbor 0.5 nsq
neigh_modify delay 0 check no
variable r equal 571101
variable t equal 0.005
variable d equal 0.5
timestep  0.005
compute   MyTemp all temp/partial 1 0 0
velocity  all create $t 28711 mom yes rot yes dist gaussian temp MyTemp
velocity  all set NULL 0.0 0.0 units box
fix        1 all langevin $t $t $d $r
fix_modify 1 temp MyTemp
fix        2 all setforce NULL 0. 0.
fix        3 all nve
fix        4 all phonon 10 500 2000 w99phq_mono1d.map phonon sysdim 1
fix_modify 4 temp MyTemp
thermo_style  custom step temp pe etotal
thermo_modify temp MyTemp
thermo   100
thermo_modify   format float %.15g
run 		 20000
