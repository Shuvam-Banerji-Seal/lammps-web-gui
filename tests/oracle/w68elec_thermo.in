# oracle: ELECTRODE thermo: fix electrode/thermo (temp 300, relaxation 1, seed 1234), three steps of the thermopotentiostat
# oracle-inputs: w68elec_au_elyt.data
# oracle-compare: thermo=all atoms=all rel=1e-6 abs=1e-9
# Measured with native LAMMPS (black box): step 0: pe=205.653561445 c_qbot=-0.184162862926 c_qtop=0.184162862926; step 3: pe=140.752187947 c_qbot=-0.267197186785 c_qtop=0.267197186785
boundary        p p f
kspace_style    ewald/electrode 1.0e-8
kspace_modify   slab 8.0
units           real
atom_style      full
pair_style      lj/cut/coul/long 12
read_data       w68elec_au_elyt.data
group           bot type 1
group           top type 2
variable        q atom q
compute         qbot bot reduce sum v_q
compute         qtop top reduce sum v_q
thermo_style    custom step pe c_qbot c_qtop
thermo_modify   format float %.15g
fix             th bot electrode/thermo 0 2 couple top 1 temp 300 1 1234
run             3
