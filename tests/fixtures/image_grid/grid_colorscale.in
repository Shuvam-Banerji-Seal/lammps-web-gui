# image_grid fixture: native b332f28 (/home/roy/.local/bin/lmp), dump image PPM (run 0 then run 1, the step 1 image).
units lj
dimension 2
atom_style atomic
lattice sq 0.8
region box block 0 6 0 5 -0.5 0.5
create_box 1 box
create_atoms 1 box
mass * 1.0
pair_style lj/cut 2.5
pair_coeff * * 1.0 1.0
fix nve all nve
compute pg all property/grid 6 5 1 x y
fix sc all graphics/labels 1 colorscale viz "Grid x" 60 20 0 size 28 length 300 horizontal tics 4 map grid
dump viz all image 1 img.*.ppm type type size 128 128 box yes 0.02 grid c_pg:grid:data[1] fix sc type 1 0
dump_modify viz pad 0 adiam * 0.3 gmap min max cf 0.0 3 min blue 0.5 yellow max red
run 0
run 1
