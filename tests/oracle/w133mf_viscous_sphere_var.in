# oracle: fix viscous/sphere with an atom-style variable scale (v_name) on finite-size spheres in contact.
# oracle-compare: thermo=all rel=1e-8 abs=1e-10
# measured with native LAMMPS (per-atom compare): max relative error 4e-11 (thermo rows agree to 1e-13)
# native: b332f28 (installed lmp: EXTRA-FIX, GRANULAR)
units           lj
comm_modify    vel yes
atom_style      sphere
boundary        p p p
lattice         fcc 1.0
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
set             type 1 diameter 1.0
set             group all density 1.0
displace_atoms  all random 0.1 0.1 0.1 4321 units box
variable        vx atom 0.8*sin(0.9*x+0.4*z)
variable        vy atom 0.8*cos(0.6*y+0.8*x)
variable        vz atom 0.8*sin(0.7*z-0.3*y)
variable        g atom 0.5+0.5*cos(0.8*x-0.5*y)
velocity        all set v_vx v_vy v_vz units box
set             group all omega 0.4 -0.3 0.6
pair_style      gran/hooke/history 2000.0 NULL 50.0 NULL 0.5 0
pair_coeff      * *
timestep        0.002
fix             1 all nve/sphere
fix             2 all viscous/sphere 0.3 scale v_g
thermo_style    custom step temp pe ke
thermo_modify format float %.15g
thermo          50
run             200
