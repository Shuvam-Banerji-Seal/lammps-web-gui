# oracle: fix momentum/chunk (linear 1 1 1, angular, rescale) on 18 branched molecules of mol_chains.data every 3 steps during an NVE run; checks the chunk momentum, angular momentum removal and the kinetic energy rescale
# oracle-inputs: mol_chains.data
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=1e-12
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 6.2e-10, atoms 7.5e-14.
units           lj
atom_style      molecular
bond_style      class2
angle_style     harmonic
dihedral_style  harmonic
improper_style  harmonic
pair_style      lj/cut 2.5
read_data       mol_chains.data
pair_coeff      * * 0.5 0.9
pair_coeff      1 3 0.8 1.0
bond_coeff      1 1.05 100.0 -50.0 20.0
bond_coeff      2 1.1 90.0 -40.0 15.0
angle_coeff     1 40.0 109.5
angle_coeff     2 25.0 120.0
dihedral_coeff  1 1.5 -1 3
improper_coeff  1 12.0 20.0
special_bonds   lj 0.0 0.5 0.8
timestep        0.002
velocity        all create 1.0 4928459 mom no rot no
fix             1 all nve
compute cm all chunk/atom molecule compress yes
compute vcm all vcm/chunk cm
compute mom all momentum
compute ine all inertia
fix             2 all momentum/chunk 3 cm linear 1 1 1 angular rescale
thermo_style    custom step c_mom[1] c_mom[2] c_mom[3] c_vcm[1][1] c_vcm[9][2] c_vcm[18][3] c_ine[1] c_ine[5] ke pe
thermo_modify   format float %.15g norm no
thermo          4
run             20
