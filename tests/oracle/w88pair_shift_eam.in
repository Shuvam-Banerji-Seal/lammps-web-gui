# oracle: pair_modify shift yes on eam (native accepts and ignores it)
# oracle-potentials: Cu_u3.eam
units metal
atom_style atomic
lattice fcc 3.615
region box block 0 4 0 4 0 4
create_box 1 box
create_atoms 1 box
mass * 63.55
pair_style eam
pair_coeff * * Cu_u3.eam
pair_modify shift yes
thermo_style custom step pe evdwl etail
thermo_modify format float %.15g
run 0
