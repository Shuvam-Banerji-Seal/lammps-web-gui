# oracle: fix shake accepts the mol template keyword; a molecule that already exists is not constrained by the template's SHAKE info alone
# oracle-inputs: w26mol2.txt
units           real
atom_style      full
region          box block 0 20 0 20 0 20 units box
create_box      1 box bond/types 1 extra/bond/per/atom 1 extra/special/per/atom 2
mass            1 12.0
molecule        t w26mol2.txt
create_atoms    0 single 10 10 10 mol t 1 units box
pair_style      lj/cut 5.0
pair_coeff      * * 0.0 1.0
bond_style      harmonic
bond_coeff      1 300.0 1.0
fix             1 all nve
fix             2 all shake 1e-12 200 0 mol t
thermo_style    custom step temp pe ebond press
thermo_modify   format float %.15g
thermo          1
run             0
