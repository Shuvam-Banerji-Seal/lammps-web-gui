# image_autobond fixture: native b332f28 (/home/roy/.local/bin/lmp), dump image PPM, run 0.
units lj
atom_style atomic
region box block 0 5 0 5 0 5
create_box 2 box
create_atoms 1 random 70 48211 NULL overlap 0.8 maxtry 200
create_atoms 2 random 30 9177 NULL overlap 0.8 maxtry 200
mass * 1.0
pair_style lj/cut 2.5
pair_coeff * * 1.0 1.0
dump d all image 1 img.*.ppm type type size 128 128 view 60 30 zoom 0.9 box yes 0.02 autobond 1.3 0.12
dump_modify d pad 0 adiam * 0.25
run 0
