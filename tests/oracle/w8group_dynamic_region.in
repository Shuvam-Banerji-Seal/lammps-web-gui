# oracle: group dynamic by region (every 1 and every 5), fixes and temperature computes on the changing groups, then group static
units           lj
atom_style      atomic
boundary        p p p
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
group           odd id 1:256:2
set             group odd type 2
mass            1 1.0
mass            2 1.5
variable        vx atom 1.4*sin(0.9*x+0.4*z)
variable        vy atom 1.4*cos(0.6*y+0.8*x)
variable        vz atom 1.4*sin(0.7*z-0.3*y)
velocity        all set v_vx v_vy v_vz units box
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
pair_coeff      2 2 0.8 1.05
neighbor        0.3 bin
neigh_modify    every 2 delay 0 check yes
timestep        0.004
region          slab block INF INF 1.5 2.5 INF INF
region          ball sphere 3.3 3.3 3.3 1.3 units box
group           inslab dynamic all region slab
group           inball dynamic odd region ball every 5
variable        nslab equal count(inslab)
variable        nball equal count(inball)
fix             1 all nve
fix             2 inslab addforce 0.6 0.0 0.0
fix             3 inball viscous 0.4
compute         tslab inslab temp
compute         kball inball ke
compute         tball inball temp/com
thermo_style    custom step temp pe etotal press v_nslab v_nball c_tslab c_kball c_tball f_2[1] f_2[2]
thermo_modify   format float %.15g
thermo          5
run             100
group           inslab static
run             40
