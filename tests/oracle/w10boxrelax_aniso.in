# oracle: fix box/relax x 1.0 y 0.5 z 0.0 on a perturbed LJ fcc box (cg); final state compared
# oracle-compare: thermo=first-last atoms=all rel=1e-6 abs=1e-9 skip=fnorm,fmax
units           lj
atom_style      atomic
lattice         fcc 1.0
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 1.0
variable        dx atom 0.07*sin(3.1*x+1.7*y)
variable        dy atom 0.07*cos(2.3*y+0.9*z)
variable        dz atom 0.07*sin(1.9*z+2.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
pair_modify     shift yes

fix             1 all box/relax x 1.0 y 0.5 z 0.0
thermo_style    custom step pe fnorm fmax press pxx pyy pzz vol lx ly lz xy f_1
thermo_modify   format float %.15g
min_style       cg
minimize        0.0 1.0e-10 20000 200000
