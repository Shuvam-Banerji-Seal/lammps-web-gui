# oracle: eFF CH4 (fixed boundaries, the default velocity create): eff/cut, temp/eff and nve/eff for 20 steps (examples/PACKAGES/eff/CH4 cut down)
# oracle-inputs: w63eff_ch4.data
# oracle-files: w63eff_ch4_er.dump
# oracle-compare: thermo=all atoms=all
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 3.3e-15, atoms 0.
units           electron
newton          on
boundary        f f f
atom_style      electron
read_data       w63eff_ch4.data
pair_style      eff/cut 100.0
pair_coeff      * *
comm_modify     vel yes
compute         effTemp all temp/eff
compute         er all property/atom spin eradius ervel erforce
thermo          5
thermo_style    custom step pe ke temp press
thermo_modify   temp effTemp
thermo_modify   format float %.15g
velocity        all create 300.0 4928459 dist gaussian rot yes mom yes
timestep        0.005
fix             1 all nve/eff
run             20
write_dump      all custom w63eff_ch4_er.dump id c_er[1] c_er[2] c_er[3] c_er[4] modify format float %.15g
