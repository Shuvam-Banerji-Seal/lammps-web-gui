# oracle: superellipsoid drop (cut down from examples/ASPHERE/superellipsoid_gran/in.drop_test): a small sc floor of type-1 superellipsoid wall particles and 4 falling type-2 superellipsoids (hertz + viscoelastic damping, curvature_gaussian, quat/random, block 4 and 2.5 exponents) that land on the floor within the run; per-atom positions, velocities, forces, torques and angular velocity checked at the end
# Measured with native LAMMPS (black box), max relative error of the engine vs native: positions 3e-10 (x 6.5e-11),
# velocities 3e-9, forces 1e-7, torques 9e-9, orientations 3e-10; thermo (ke, rotational ke) matches to 1e-8.
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# oracle-files: oracle_sf.dump
units           si
atom_style      ellipsoid superellipsoid
dimension       3
boundary        p p f
comm_modify     vel yes
newton          off
processors      * * 1

neighbor 0.5 bin
neigh_modify   delay 0 every 1 check yes

variable        box_length equal 4
variable        box_height equal 8

region          box block 0 ${box_length} 0 ${box_length} 0 ${box_height}
create_box      2 box

lattice         sc 1.0
region          floor_reg block 0 ${box_length} 0 ${box_length} 0 0.1

variable        insertion_length equal ${box_length}-1.0

create_atoms    1 region floor_reg

region          drop_zone block 1 ${insertion_length} 1 ${insertion_length} 1.6 2.6
create_atoms    2 random 4 12345 drop_zone overlap 2.0 maxtry 100

set             type 1 mass 1.0
set             type 1 shape 1.0 1.0 1.0
variable        blockiness equal 4.0
set             type 1 block 4.0 4.0
set             type 2 mass 1.0
set             type 2 shape 2.0 1.0 1.0
set             type 2 block 2.5 2.5
set             type 2 quat/random 84729

group           wall type 1
group           mobile type 2

pair_style granular/superellipsoid curvature_gaussian
pair_coeff * * hertz 10000.0 200.0 tangential classic 2850 0.0 0.5 damping viscoelastic

compute         orient all property/atom quatw quati quatj quatk
compute         block all property/atom block1 block2

neigh_modify exclude group wall wall

fix             2 mobile gravity 9.81 vector 0 0 -1

fix             3 mobile nve/asphere

compute rke all erotate/asphere

thermo          500
thermo_style  custom time step ke c_rke
thermo_modify format float %.15g

timestep        0.0001
run             6000
write_dump all custom oracle_sf.dump id type x y z vx vy vz fx fy fz tqx tqy tqz c_orient[*] c_block[*] modify format float %.15g sort id
