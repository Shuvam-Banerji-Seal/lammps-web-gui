# oracle: compute chunk/atom bin/3d with fix ave/chunk vx, vy, temp, norm sample and ave running
# oracle-files: prof3d.txt
units           lj
atom_style      atomic
boundary        p p p
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
group           odd id 1:108:2
set             group odd type 2
mass            1 1.0
mass            2 1.5
variable        dx atom 0.04*sin(1.3*x+0.7*y)
variable        dy atom 0.04*cos(0.9*y-1.1*z)
variable        dz atom 0.04*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.8*sin(0.9*x+0.4*z)
variable        vy atom 0.8*cos(0.6*y+0.8*x)
variable        vz atom 0.8*sin(0.7*z-0.3*y)
velocity        all set v_vx v_vy v_vz units box
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
pair_coeff      2 2 0.8 1.05
timestep        0.002
fix             1 all nve
compute         c3 all chunk/atom bin/3d x lower 0.5 y lower 0.5 z center 0.5 units lattice
fix             2 all ave/chunk 2 2 4 c3 vx vy temp norm sample ave running file prof3d.txt
thermo_style    custom step temp pe etotal c_c3
thermo_modify   format float %.15g
thermo          8
run             16
