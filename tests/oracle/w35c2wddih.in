# oracle: write_data of a class 2 dih system: the cross-term sections follow the style's Coeffs section, then read_data of the written file and 20 more nve steps
# oracle-inputs: w35c2dih.data
# oracle-files: w35c2wddih.data
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-9
units lj
atom_style molecular
bond_style class2
angle_style harmonic
dihedral_style class2
pair_style lj/cut 2.5
read_data w35c2dih.data
pair_coeff * * 0.5 0.9
special_bonds lj 0.0 0.5 0.8
timestep 0.002
fix 1 all nve
thermo_style custom step temp pe ebond eangle edihed eimp evdwl etotal press pxx pyy pzz pxy pxz pyz
thermo_modify format float %.15g
thermo 10
run 0
run 50
write_data w35c2wddih.data
clear
units lj
atom_style molecular
bond_style class2
angle_style harmonic
dihedral_style class2
pair_style lj/cut 2.5
read_data w35c2wddih.data
special_bonds lj 0.0 0.5 0.8
timestep 0.002
fix 1 all nve
thermo_style custom step temp pe ebond eangle edihed eimp evdwl etotal press pxx pyy pzz pxy pxz pyz
thermo_modify format float %.15g
thermo 10
run 20
