# Wave 15: compute pair (docs.lammps.org/compute_pair.html) on the sub-styles of pair_style hybrid/overlay:
# lj/cut, two morse instances (nsub 1 and 2) and the hybrid total; evalue epair, evdwl and ecoul.
# 108 LJ atoms (two types split by x = 2.1, off the lattice), deterministic velocities, 40 steps.
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      2 box
region          r1 block 0 2.1 0 5.1 0 5.1
region          r2 block 2.1 5.1 0 5.1 0 5.1
create_atoms    1 region r1
create_atoms    2 region r2
mass            * 1.0
variable        vx atom 1.4*sin(1.7*x+2.3*y+0.7*z)
variable        vy atom 1.4*cos(2.1*x-1.1*y+0.3*z)
variable        vz atom 1.4*sin(0.5*x+1.9*z+1.3*y)
velocity        all set v_vx v_vy v_vz units box
velocity        all zero linear
pair_style      hybrid/overlay lj/cut 2.5 morse 2.0 morse 2.5
pair_coeff      * * lj/cut 1.0 1.0 2.5
pair_coeff      1 2 morse 1 1.0 1.5 1.2 2.0
pair_coeff      2 2 morse 2 0.7 1.8 1.3 2.0
pair_coeff      1 1 morse 2 0.3 2.0 1.0 2.0
fix             1 all nve
timestep        0.002
compute         lj all pair lj/cut
compute         m1 all pair morse 1
compute         m2 all pair morse 2 evdwl
compute         mc all pair morse 2 ecoul
compute         tot all pair hybrid/overlay
compute         totv all pair hybrid/overlay evdwl
compute         ljc all pair lj/cut 1 ecoul
thermo_style    custom step pe evdwl c_lj c_m1 c_m2 c_mc c_tot c_totv c_ljc
thermo_modify   format float %.15g
thermo          10
run             40
