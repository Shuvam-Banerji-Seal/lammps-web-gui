# oracle: fix adapt on coul/cut and coul/debye scale (native prefactor qqrd2e * scale * qi qj, init_one mirrors the pair), the 1-1 pair of coul/cut and the 2-2 pair of coul/debye ramped under hybrid/overlay with lj/cut, scale yes
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=1e-10
units           lj
atom_style      charge
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
mass            * 1.0
set             group all type/fraction 2 0.5 4321
set             type 1 charge 0.4
set             type 2 charge -0.4
velocity        all create 1.2 87287 loop geom
pair_style      hybrid/overlay lj/cut 2.5 coul/cut 2.5 coul/debye 1.5 2.5
pair_coeff      * * lj/cut 1.0 1.0
pair_coeff      1 1 coul/cut
pair_coeff      2 2 coul/debye
pair_coeff      1 2 coul/cut
variable        a equal 1.0+0.02*elapsed
variable        b equal 1.0-0.01*elapsed
fix             1 all nve
fix             2 all adapt 2 pair coul/cut scale 1 1 v_a pair coul/debye scale 2 2 v_b scale yes
thermo_style    custom step temp pe ecoul press
thermo_modify   format float %.15g
thermo          10
run             40
