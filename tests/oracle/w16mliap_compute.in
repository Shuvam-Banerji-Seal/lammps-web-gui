# oracle: compute mliap model linear with descriptor sna (2 types, twojmax 2), every array entry through thermo, pair zbl reference
# oracle-inputs: w16mliap_compute.mliap.descriptor
# oracle-compare: thermo=first
units           metal
atom_style      atomic
lattice         bcc 3.0
region          box block 0 1 0 1 0 1
create_box      2 box
create_atoms    1 box
group           odd id 1:2:2
set             group odd type 2
mass            * 50.0
variable        dx atom 0.05*sin(1.3*x+0.7*y)
variable        dy atom 0.05*cos(0.9*y-1.1*z)
variable        dz atom 0.05*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
pair_style      zbl 4 4.8
pair_coeff      * * 73 73
compute g all mliap model linear descriptor sna w16mliap_compute.mliap.descriptor gradgradflag 1
thermo_style    custom step step pe c_g[1][1] c_g[1][2] c_g[1][3] c_g[1][4] c_g[1][5] c_g[1][6] c_g[1][7] c_g[1][8] c_g[1][9] c_g[1][10] c_g[1][11] c_g[1][12] c_g[1][13] c_g[2][1] c_g[2][2] c_g[2][3] c_g[2][4] c_g[2][5] c_g[2][6] c_g[2][7] c_g[2][8] c_g[2][9] c_g[2][10] c_g[2][11] c_g[2][12] c_g[2][13] c_g[3][1] c_g[3][2] c_g[3][3] c_g[3][4] c_g[3][5] c_g[3][6] c_g[3][7] c_g[3][8] c_g[3][9] c_g[3][10] c_g[3][11] c_g[3][12] c_g[3][13] c_g[4][1] c_g[4][2] c_g[4][3] c_g[4][4] c_g[4][5] c_g[4][6] c_g[4][7] c_g[4][8] c_g[4][9] c_g[4][10] c_g[4][11] c_g[4][12] c_g[4][13] c_g[5][1] c_g[5][2] c_g[5][3] c_g[5][4] c_g[5][5] c_g[5][6] c_g[5][7] c_g[5][8] c_g[5][9] c_g[5][10] c_g[5][11] c_g[5][12] c_g[5][13] c_g[6][1] c_g[6][2] c_g[6][3] c_g[6][4] c_g[6][5] c_g[6][6] c_g[6][7] c_g[6][8] c_g[6][9] c_g[6][10] c_g[6][11] c_g[6][12] c_g[6][13] c_g[7][1] c_g[7][2] c_g[7][3] c_g[7][4] c_g[7][5] c_g[7][6] c_g[7][7] c_g[7][8] c_g[7][9] c_g[7][10] c_g[7][11] c_g[7][12] c_g[7][13] c_g[8][1] c_g[8][2] c_g[8][3] c_g[8][4] c_g[8][5] c_g[8][6] c_g[8][7] c_g[8][8] c_g[8][9] c_g[8][10] c_g[8][11] c_g[8][12] c_g[8][13] c_g[9][1] c_g[9][2] c_g[9][3] c_g[9][4] c_g[9][5] c_g[9][6] c_g[9][7] c_g[9][8] c_g[9][9] c_g[9][10] c_g[9][11] c_g[9][12] c_g[9][13] c_g[10][1] c_g[10][2] c_g[10][3] c_g[10][4] c_g[10][5] c_g[10][6] c_g[10][7] c_g[10][8] c_g[10][9] c_g[10][10] c_g[10][11] c_g[10][12] c_g[10][13] c_g[11][1] c_g[11][2] c_g[11][3] c_g[11][4] c_g[11][5] c_g[11][6] c_g[11][7] c_g[11][8] c_g[11][9] c_g[11][10] c_g[11][11] c_g[11][12] c_g[11][13] c_g[12][1] c_g[12][2] c_g[12][3] c_g[12][4] c_g[12][5] c_g[12][6] c_g[12][7] c_g[12][8] c_g[12][9] c_g[12][10] c_g[12][11] c_g[12][12] c_g[12][13] c_g[13][1] c_g[13][2] c_g[13][3] c_g[13][4] c_g[13][5] c_g[13][6] c_g[13][7] c_g[13][8] c_g[13][9] c_g[13][10] c_g[13][11] c_g[13][12] c_g[13][13]
thermo_modify   format float %.15g
run             0
