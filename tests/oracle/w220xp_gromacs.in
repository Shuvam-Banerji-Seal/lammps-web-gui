# oracle: pair lj/gromacs/coul/gromacs 1.6 2.2 1.2 2.6 on a bonded charged chain (mixed epsilon and sigma), special_bonds lj/coul 0.0 0.5 0.8, NVE 200 steps
# oracle-inputs: w220xp_chain.data
# oracle-compare: thermo=all atoms=all rel=1e-12 abs=1e-13
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 3.7e-13, atoms 2.6e-13.
units        lj
boundary     p p p
atom_style   full
read_data    w220xp_chain.data
mass         * 1.0
velocity     all create 1.0 4242
bond_style   harmonic
bond_coeff   1 50.0 1.2
special_bonds lj/coul 0.0 0.5 0.8
timestep     0.002
fix          1 all nve
pair_style   lj/gromacs/coul/gromacs 1.6 2.2 1.2 2.6
pair_coeff   1 1 1.0 1.0
pair_coeff   2 2 0.8 1.1
thermo_style custom step pe evdwl ecoul elong ke press pxx pyy pzz pxy pxz pyz
thermo_modify format float %.15g
thermo       20
run          200
