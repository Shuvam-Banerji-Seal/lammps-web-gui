# oracle: pair_style rebo - diamond lattice 2x2x2 cells (64 atoms), lightly displaced, periodic
# oracle-potentials: CH.rebo
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           metal
atom_style      atomic
timestep        0.0005
lattice         diamond 3.567
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box
mass            1 12.011
variable        dx atom 0.04*sin(0.9*x+0.4*y)
variable        dy atom 0.04*cos(0.7*y-0.5*z)
variable        dz atom 0.04*sin(1.1*z+0.3*x)
displace_atoms  all move v_dx v_dy v_dz units box
pair_style      rebo
pair_coeff      * * CH.rebo C
thermo_style    custom step temp pe etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          10
run             0
velocity        all create 300.0 4321 loop all
fix             1 all nve
run             30
