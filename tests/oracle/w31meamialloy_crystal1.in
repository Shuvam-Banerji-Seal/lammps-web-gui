# oracle: pair_style meam, two-element disordered fcc alloy (w31meamialloy_lib.meam + w31meamialloy_1.meam, zbl 0, ialloy = 1), 2x2x2 cells of 4 atoms (32 atoms, A/B types interleaved), lattice constant 3.9 A, 0.04 A sinusoidal displacement, velocities from atom-style variables, fix nve, 40 steps of 0.001 ps
# oracle: ialloy = 1 (docs.lammps.org/pair_meam.html: "0 = standard averaging", "1 = alternative averaging", "2 = no averaging of t (use single-element values)"); unlike the B1 reference the like neighbours of this disordered fcc alloy are not all screened, so every central atom mixes A and B partial densities
# oracle-inputs: w31meamialloy_lib.meam w31meamialloy_1.meam
# oracle-compare: thermo=all atoms=all rel=1e-6 abs=1e-9
# oracle-tolerance: rel=1e-6 is needed for press only (the same offset as w12meam_fcc and w15meam_bcc).
units           metal
atom_style      atomic
variable        a equal 3.9
region          box block 0 7.8 0 7.8 0 7.8
create_box      2 box
create_atoms    1 single 0.0000000000 0.0000000000 0.0000000000
create_atoms    2 single 1.9500000000 1.9500000000 0.0000000000
create_atoms    1 single 1.9500000000 0.0000000000 1.9500000000
create_atoms    2 single 0.0000000000 1.9500000000 1.9500000000
create_atoms    2 single 0.0000000000 0.0000000000 3.9000000000
create_atoms    1 single 1.9500000000 1.9500000000 3.9000000000
create_atoms    2 single 1.9500000000 0.0000000000 5.8500000000
create_atoms    1 single 0.0000000000 1.9500000000 5.8500000000
create_atoms    2 single 0.0000000000 3.9000000000 0.0000000000
create_atoms    1 single 1.9500000000 5.8500000000 0.0000000000
create_atoms    2 single 1.9500000000 3.9000000000 1.9500000000
create_atoms    1 single 0.0000000000 5.8500000000 1.9500000000
create_atoms    1 single 0.0000000000 3.9000000000 3.9000000000
create_atoms    2 single 1.9500000000 5.8500000000 3.9000000000
create_atoms    1 single 1.9500000000 3.9000000000 5.8500000000
create_atoms    2 single 0.0000000000 5.8500000000 5.8500000000
create_atoms    1 single 3.9000000000 0.0000000000 0.0000000000
create_atoms    2 single 5.8500000000 1.9500000000 0.0000000000
create_atoms    1 single 5.8500000000 0.0000000000 1.9500000000
create_atoms    2 single 3.9000000000 1.9500000000 1.9500000000
create_atoms    2 single 3.9000000000 0.0000000000 3.9000000000
create_atoms    1 single 5.8500000000 1.9500000000 3.9000000000
create_atoms    2 single 5.8500000000 0.0000000000 5.8500000000
create_atoms    1 single 3.9000000000 1.9500000000 5.8500000000
create_atoms    2 single 3.9000000000 3.9000000000 0.0000000000
create_atoms    1 single 5.8500000000 5.8500000000 0.0000000000
create_atoms    2 single 5.8500000000 3.9000000000 1.9500000000
create_atoms    1 single 3.9000000000 5.8500000000 1.9500000000
create_atoms    1 single 3.9000000000 3.9000000000 3.9000000000
create_atoms    2 single 5.8500000000 5.8500000000 3.9000000000
create_atoms    1 single 5.8500000000 3.9000000000 5.8500000000
create_atoms    2 single 3.9000000000 5.8500000000 5.8500000000
mass            1 63.546
mass            2 58.69
variable        dx atom 0.04*sin(2.3*x+1.1*y+0.4*z)
variable        dy atom 0.04*cos(1.9*y-0.7*x+0.3*z)
variable        dz atom 0.04*sin(1.3*z+0.8*x-0.5*y)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.4*cos(1.7*y-0.6*z)
variable        vy atom 0.4*sin(1.2*z+0.9*x)
variable        vz atom 0.3*cos(2.1*x-0.8*y+0.2)
velocity        all set v_vx v_vy v_vz units box
pair_style      meam
pair_coeff      * * w31meamialloy_lib.meam A B w31meamialloy_1.meam A B
timestep        0.001
fix             1 all nve
thermo          10
thermo_style    custom step pe ke press pxx pyy pzz
thermo_modify   format float %.15g
run             40
