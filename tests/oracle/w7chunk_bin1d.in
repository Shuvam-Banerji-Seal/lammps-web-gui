# oracle: compute chunk/atom bin/1d with fix ave/chunk density/mass, vx and temp profiles (norm sample, ave one)
# oracle-files: prof1d.txt
units           lj
atom_style      atomic
boundary        p p p
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
group           odd id 1:108:2
set             group odd type 2
mass            1 1.0
mass            2 1.5
region          lowz block INF INF INF INF INF 2.5 units box
group           lower region lowz
group           upper subtract all lower
variable        dx atom 0.04*sin(1.3*x+0.7*y)
variable        dy atom 0.04*cos(0.9*y-1.1*z)
variable        dz atom 0.04*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.8*sin(0.9*x+0.4*z)
variable        vy atom 0.8*cos(0.6*y+0.8*x)
variable        vz atom 0.8*sin(0.7*z-0.3*y)
velocity        all set v_vx v_vy v_vz units box
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
pair_coeff      2 2 0.8 1.05
timestep        0.002
fix             1 all nve
compute         cb all chunk/atom bin/1d x lower 0.5 units lattice
compute         cn all chunk/atom bin/1d x center 0.5 units box discard no bound x 1.0 upper
fix             2 all ave/chunk 5 2 10 cb density/mass vx temp norm sample format " %.12g" file prof1d.txt
thermo_style    custom step temp pe etotal c_cb c_cn
thermo_modify   format float %.15g
thermo          10
run             50
