# oracle: write_data of 2d nparticle bodies after 100 steps of w152body_local_nparticle: the Bodies section (src/BODY/body_nparticle.cpp pack_data_body) compared with native
# oracle-inputs: w152body_local_nparticle.data
# oracle-files: w616wd_nparticle.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-12 filerel=1e-12
units           lj
dimension       2
atom_style      body nparticle 2 6
atom_modify     sort 0 0.0
read_data       w152body_local_nparticle.data
velocity        all create 1.44 87287 loop geom
pair_style      body/nparticle 5.0
pair_coeff      * * 1.0 1.0
neighbor        0.5 bin
neigh_modify    every 1 delay 0 check yes
fix             1 all nve/body
fix             2 all enforce2d
thermo_style    custom step pe ke etotal
thermo_modify   format float %.15g
thermo          200
run             100
write_data      w616wd_nparticle.data
