# oracle: create_atoms random with overlap under the default units lattice: the overlap distance is in lattice spacings
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 random 60 12345 box overlap 0.6 maxtry 3
mass            1 1.0
thermo_style    custom step atoms xlat
thermo_modify   format float %.15g
run             0
