# oracle: fix msst (shock along z, default q, mu, tscale; f_msst and f_msst[1..4] in thermo) on a 4x4x4 LJ fcc crystal, 100 steps
# Native reference: LAMMPS b332f28 (installed binary has SHOCK)
# measured (engine vs native, Node 24): thermo within 4.2e-13 relative (worst f_msst[1]), per-atom within 1.1e-11
# oracle-compare: thermo=all atoms=all rel=1e-8
units           lj
atom_style      atomic
boundary        p p p
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 0.8 4928 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
fix             1 all nve
fix             msst all msst z 1.5 q 10.0 mu 0.5 tscale 0.1
thermo_style    custom step temp pe ke econserve vol lz pzz f_msst f_msst[1] f_msst[2] f_msst[3] f_msst[4]
thermo_modify   format float %.15g
timestep        0.002
thermo          10
run             100
