# oracle: fix nve/body on one free body (no other particle, so no torque) with a non-principal angular momentum, a translational velocity and 200 steps; the orientation has no thermo output, the final atom state holds the translation and the energies are zero
# oracle-inputs: w48bd_free.data
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           lj
dimension       3
atom_style      body nparticle 1 4
read_data       w48bd_free.data
set             atom 1 angmom 0.4 -0.3 0.7
velocity        all set 0.1 -0.05 0.2
pair_style      body/nparticle 4.0
pair_coeff      * * 1.0 1.0
fix             1 all nve/body
thermo_style    custom step pe ke temp etotal press
thermo_modify   format float %.15g
thermo          20
run             200
