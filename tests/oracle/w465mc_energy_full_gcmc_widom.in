# oracle: fixes gcmc and widom with full_energy, together with fix langevin and fix efield (energy yes): each full
# energy evaluation runs the pre_force and post_force fixes (energy_full: langevin draws its random forces there, the
# efield energy is that of the call); a charged lj/cut gas in metal units, fix nve on all atoms
# oracle-compare: thermo=all atoms=none rel=1e-8
units           metal
atom_style      charge
pair_style      lj/cut 3.0
pair_modify     tail no
region          box block 0 6 0 6 0 6
create_box      1 box
pair_coeff      * * 0.01 1.0
mass            1 1.0
create_atoms    1 random 20 4321 box overlap 1.2 maxtry 100
set             type 1 charge 0.2
velocity        all create 300.0 4928 loop geom
fix             integ all nve
fix             lan all langevin 300.0 300.0 0.1 48279
fix             ef all efield 0.05 0.0 0.0
fix_modify      ef energy yes
fix             mygcmc all gcmc 1 3 3 1 29494 300.0 0.0 0.5 full_energy charge 0.2
fix             w all widom 2 3 1 12345 300.0 full_energy charge 0.2
thermo_style    custom step atoms pe ke f_mygcmc[1] f_mygcmc[2] f_mygcmc[3] f_mygcmc[4] f_mygcmc[5] f_mygcmc[6] f_w[1] f_w[2] f_ef
thermo          2
thermo_modify   format float %.15g
run             20
