# oracle-compare: thermo=all atoms=all rel=1e-7 abs=1e-9
# Small molecule with bond, lbound and angle restraints; K and r0 ramp over the run.
units           lj
atom_style      atomic
atom_modify     map array
region          box block -6 6 -6 6 -6 6
create_box      1 box
create_atoms    1 single 0.0 0.0 0.0 units box
create_atoms    1 single 1.2 0.0 0.0 units box
create_atoms    1 single 1.5 1.1 0.2 units box
create_atoms    1 single -0.4 1.0 0.3 units box
create_atoms    1 single 0.3 -1.1 -0.5 units box
mass            1 1.0
pair_style      lj/cut 2.5
pair_coeff      1 1 0.2 1.0 2.5
velocity        all create 0.5 4928 loop all
timestep        0.002
fix             1 all nve
fix             R all restrain bond 1 2 50.0 100.0 1.0 1.4 lbound 3 4 20.0 20.0 2.5 2.2 angle 1 2 3 10.0 30.0 100.0
fix_modify      R energy yes
thermo_style    custom step pe ke f_R f_R[1] f_R[2] f_R[3]
thermo_modify   norm no format float %.12g
thermo          10
run             100
