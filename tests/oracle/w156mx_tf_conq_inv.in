# oracle: ELECTRODE conq with fix_modify tf (Thomas-Fermi), target charges -0.2 and 0.2, mat_inv, symm off
# native: LAMMPS b332f28 (installed lmp, ELECTRODE package). Measured max relative error vs native: thermo 1.6e-15, per-atom 2.4e-13
# oracle-inputs: w68elec_au_elyt.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
boundary        p p f
kspace_style    ewald/electrode 1.0e-8
kspace_modify   slab 8.0
units           real
atom_style      full
pair_style      lj/cut/coul/long 12
read_data       w68elec_au_elyt.data
group           bot type 1
group           top type 2
variable        q atom q
compute         qbot bot reduce sum v_q
compute         qtop top reduce sum v_q
thermo_style    custom step pe c_qbot c_qtop
thermo_modify   format float %.15g
fix             q bot electrode/conq -0.2 2 couple top 0.2
fix_modify      q tf 1 1.0 18.1715745
fix_modify      q tf 2 1.0 18.1715745
run             0
