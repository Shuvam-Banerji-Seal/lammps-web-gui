# oracle: fix srd with overlap yes (collisions_multi: the first of several overlapping big particles is applied) and noslip, big spheres of three sizes, 2d (cut-down of examples/ASPHERE/poly/in.poly with overlap yes, 4x4 big particles, 400 SRD steps)
# oracle-compare: thermo=all atoms=all rel=1e-12 abs=1e-13 skip=f_2[5] atomskip=fx,fy,fz
# Measured with native LAMMPS (black box): the engine agrees with every thermo column to a relative error of 1e-13 and with the positions and velocities of every atom; f_2[5] (the count of rescaled SRD velocities) is skipped: at step 180 one SRD particle sits on the vmax boundary, as in w79srd_poly. The forces on SRD atoms are skipped (atomskip): native reports nonzero forces on a few SRD atoms that the engine leaves at zero.
units		lj
atom_style	sphere
atom_modify	first big
dimension	2

lattice		sq 0.3
region		box block 0 4 0 4 -0.5 0.5
create_box	4 box
create_atoms	1 region box

group		big type 1
set		group big type/fraction 2 0.33 394895
set		group big type/fraction 3 0.5 989894
group		big type 2 3
set		type 1*3 mass 1.0
velocity	big create 1.44 87287 loop geom

pair_style	lj/cut 1.12
pair_coeff	1 1 1.0 1.0 1.12
pair_coeff	2 2 1.0 2.0 2.24
pair_coeff	3 3 1.0 1.5 1.68
pair_coeff	4 4 0.0 1.0 0.0

neighbor	0.3 bin
neigh_modify	delay 0 every 1 check yes

fix		1 big nve
fix		2 all enforce2d
run		100
unfix		1
unfix		2

region		plane block INF INF INF INF -0.001 0.001 units box
lattice		sq 85.0
create_atoms	4 region plane
set		type 4 mass 0.1
group		small type 4
velocity	small create 1.0 593849 loop geom

pair_style	lj/cut 2.5
pair_coeff	1 1 1.0 1.0
pair_coeff	2 2 1.0 2.0
pair_coeff	3 3 1.0 1.5
pair_coeff	1 4 0.0 1.0 0.5
pair_coeff	2 4 0.0 1.0 1.0
pair_coeff	3 4 0.0 1.0 0.75
pair_coeff	4 4 0.0 1.0 0.0

delete_atoms	overlap 1.0 small big
reset_timestep	0

neighbor	0.3 multi
neigh_modify	delay 0 every 1 check yes
comm_modify	mode multi group big vel yes
neigh_modify	include big

pair_style	lj/cut 1.12
pair_coeff	1 1 1.0 1.0 1.12
pair_coeff	2 2 1.0 2.0 2.24
pair_coeff	3 3 1.0 1.5 1.68
pair_coeff	4 4 0.0 1.0 0.0

timestep	0.001
fix		1 big nve
fix		2 small srd 20 big 1.0 0.25 49894 shift yes 54979 search 0.2 inside ignore overlap yes bounce 50
fix		3 all enforce2d

compute		tbig big temp/sphere
variable	pebig equal pe*atoms/count(big)
variable	ebig equal etotal*atoms/count(big)
thermo_style	custom step temp f_2[8] etotal v_pebig v_ebig press f_2[1] f_2[2] f_2[3] f_2[4] f_2[5] f_2[6] f_2[7] f_2[9] f_2[10] f_2[11]
thermo_modify	temp tbig format float %.15g
thermo		20

run		400
