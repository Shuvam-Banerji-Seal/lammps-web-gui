# oracle: compute property/atom nbonds (native num_bond, src/compute_property_atom.cpp pack_nbonds): the bonds each atom stores, the first atom of a data-file bond and the lower ID of a create_bonds many bond (newton_bond on), dumped per atom and summed
# oracle-inputs: w220xp_chain.data
# oracle-files: w616pa_nbonds.dump
# oracle-compare: thermo=all atoms=all rel=1e-12 abs=1e-14
units        lj
boundary     p p p
atom_style   full
read_data    w220xp_chain.data extra/bond/per/atom 20 extra/special/per/atom 40
mass         * 1.0
bond_style   harmonic
bond_coeff   1 50.0 1.2
special_bonds lj/coul 0.0 0.5 0.8
pair_style   lj/cut 1.5
pair_coeff   * * 1.0 1.0
group        two type 2
create_bonds many two two 1 1.6 1.8
compute      nb all property/atom nbonds
compute      nbs all reduce sum c_nb
dump         d all custom 1 w616pa_nbonds.dump id c_nb
dump_modify  d sort id
thermo_style custom step pe c_nbs
thermo_modify format float %.15g
run          0
