# oracle: variable omega(group,x|y|z) (variable.cpp at b332f28: point-mass group->angmom and group->inertia, then group->omega) for a singular 10-atom wire (group wire), a singular 2-atom group (pair) and a non-singular 4-atom tetrahedron (tet), after velocity create without mom or rot
# native: b332f28 installed lmp (/home/roy/.local/bin/lmp), no extra package
# measured: (filled in by the run)
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units          lj
dimension      3
boundary       f f f
atom_style     atomic
region         box block -10 10 -10 10 -10 10
create_box     1 box
create_atoms   1 single 0.0 0.0 0.0 units box
create_atoms   1 single 0.6 0.8 0.0 units box
create_atoms   1 single 1.2 1.6 0.0 units box
create_atoms   1 single 1.8 2.4 0.0 units box
create_atoms   1 single 2.4 3.2 0.0 units box
create_atoms   1 single 3.0 4.0 0.0 units box
create_atoms   1 single 3.6 4.8 0.0 units box
create_atoms   1 single 4.2 5.6 0.0 units box
create_atoms   1 single 4.8 6.4 0.0 units box
create_atoms   1 single 5.4 7.2 0.0 units box
create_atoms   1 single 5.0 0.0 0.0 units box
create_atoms   1 single 5.0 1.5 0.0 units box
create_atoms   1 single 5.6 0.5 1.2 units box
create_atoms   1 single 4.6 0.7 -0.9 units box
mass           * 1.0
pair_style     lj/cut 2.5
pair_coeff     * * 0.0 1.0 2.5
group          wire id 1:10
group          pair id 1:2
group          tet id 11:14
velocity       all create 1.0 9876 dist gaussian
variable       wx equal omega(wire,x)
variable       wy equal omega(wire,y)
variable       wz equal omega(wire,z)
variable       px equal omega(pair,x)
variable       py equal omega(pair,y)
variable       pz equal omega(pair,z)
variable       tx equal omega(tet,x)
variable       ty equal omega(tet,y)
variable       tz equal omega(tet,z)
thermo_style   custom step v_wx v_wy v_wz v_px v_py v_pz v_tx v_ty v_tz
thermo_modify  format float %.15g
thermo         1
run            0
