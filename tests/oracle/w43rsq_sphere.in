# oracle: pair resquared with LJ spheres only (point particles, all shape parameters 0): plain Lennard-Jones with A12 as epsilon, pair_modify shift yes, a per-pair cutoff, mixed sigma and epsilon for the unset pair, run 0 then 40 steps of fix nve on point particles
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
# oracle-files: w43rsq_sphere_tq.dump
units           lj
atom_style      ellipsoid
boundary        f f f
region          box block 0 10 0 10 0 10
create_box      2 box
create_atoms  1 single 3.341567 6.855680 3.384800 units box
create_atoms  2 single 7.319253 4.464083 2.206957 units box
create_atoms  1 single 6.593070 8.526952 6.609380 units box
create_atoms  2 single 8.427421 1.681755 8.711631 units box
create_atoms  1 single 8.685971 7.242983 7.500773 units box
create_atoms  2 single 1.535197 8.081504 2.317879 units box
create_atoms  1 single 6.725337 3.505955 6.837891 units box
create_atoms  2 single 5.117510 3.773864 6.175631 units box
create_atoms  1 single 3.214201 1.079122 5.489935 units box
create_atoms  2 single 1.637582 4.428292 1.491268 units box
create_atoms  1 single 5.810279 7.809160 8.051742 units box
create_atoms  2 single 2.879695 7.925447 8.375137 units box
set             atom * mass 1.0
pair_style      resquared 3.0
pair_modify     shift yes
pair_coeff      1 1 1.0 1.0 1 1 1 1 1 1
pair_coeff      2 2 0.8 1.2 2 2 2 2 2 2 2.5
pair_coeff      1 2 0.9 1.1 2 2 2 2 2 2
thermo_style    custom step pe ke etotal
thermo_modify   format float %.15g
velocity        all create 0.6 4711
fix             1 all nve
run             0
write_dump all custom w43rsq_sphere_tq.dump id fx fy fz tqx tqy tqz modify format float %.15g sort id
run             40
