# oracle: pair_style lcbop - diamond carbon 4x4x4 cell (512 atoms), 50 NVE steps
# oracle-potentials: C.lcbop
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 1.7e-11, atoms 6.7e-13.
units           metal
atom_style      atomic
boundary        p p p
lattice         diamond 3.567
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
mass            1 12.011
pair_style      lcbop
pair_coeff      * * C.lcbop C
thermo_style    custom step pe ke press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
timestep        0.0005
velocity        all create 300.0 4928459 loop all
fix             1 all nve
thermo          10
run             50
