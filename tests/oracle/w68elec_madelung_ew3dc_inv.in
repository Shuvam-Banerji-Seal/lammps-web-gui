# oracle: ELECTRODE madelung in.madelung-ewald-ew3dc: ewald/electrode with the EW3DC slab correction, fix electrode/conp mat_inv, symm on
# oracle-inputs: w68elec_au_elyt.data
# oracle-compare: thermo=all atoms=all
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 2.6e-15, atoms 6.8e-14.
# Measured with native LAMMPS (black box): step 0: pe=139.943952357 c_qbot=-0.279214485147 c_qtop=0.279214485147 f_conp=-6.43883931625
boundary        p p f
kspace_style    ewald/electrode 1.0e-8
kspace_modify   slab 8.0
units           real
atom_style      full
pair_style      lj/cut/coul/long 12
read_data       w68elec_au_elyt.data
group           bot type 1
group           top type 2
variable        q atom q
compute         qbot bot reduce sum v_q
compute         qtop top reduce sum v_q
fix             conp bot electrode/conp 0 2 couple top 1 symm on
thermo_style    custom step pe c_qbot c_qtop f_conp
thermo_modify   format float %.15g
run             0
