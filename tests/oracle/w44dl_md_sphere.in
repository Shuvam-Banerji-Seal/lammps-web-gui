# oracle: lj/cut/dipole/long + kspace ewald/dipole with fix nve/sphere update dipole, 4x4x4 sc lattice of dipolar spheres, 30 steps
# oracle-files: w44dl_md_sphere_mu.dump
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           lj
atom_style      hybrid sphere dipole
lattice         sc 0.4
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
mass            * 1.0
set             type * diameter 1.0 density 1.0
set             group all dipole 0.8 0.3 0.5
variable        dx atom 0.08*sin(0.53*x+0.21*y)
variable        dy atom 0.08*cos(0.37*y-0.19*z)
variable        dz atom 0.08*sin(0.29*z+0.41*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.3*sin(0.7*x+0.3*z)
variable        vy atom 0.3*cos(0.5*y+0.2*x)
variable        vz atom 0.3*sin(0.4*z-0.6*y)
velocity        all set v_vx v_vy v_vz units box
velocity        all zero linear
set             group all omega 0.2 -0.1 0.3
pair_style      lj/cut/dipole/long 2.5
pair_coeff      * * 1.0 1.0
kspace_style    ewald/dipole 1.0e-4
timestep        0.002
fix             1 all nve/sphere update dipole
thermo_style    custom step temp pe ke press elong
thermo_modify   format float %.15g norm no
thermo          10
run             30
write_dump      all custom w44dl_md_sphere_mu.dump id mux muy muz tqx tqy tqz modify format float %.17g sort id
