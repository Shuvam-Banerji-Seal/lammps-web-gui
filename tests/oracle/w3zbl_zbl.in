# oracle: pair_style zbl with two elements (Z = 29 and 14), inside the switching region
units           metal
atom_style      atomic
lattice         fcc 3.0
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
group           odd id 1:108:2
set             group odd type 2
mass            1 63.55
mass            2 28.09
variable        dx atom 0.05*sin(0.9*x+0.4*y)
variable        dy atom 0.05*cos(0.7*y-0.5*z)
variable        dz atom 0.05*sin(1.1*z+0.3*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 3.0*sin(0.5*x+0.2*z)
variable        vy atom 3.0*cos(0.4*y+0.6*x)
variable        vz atom 3.0*sin(0.3*z-0.5*y)
velocity        all set v_vx v_vy v_vz units box
pair_style      zbl 2.0 3.2
pair_coeff      1 1 29.0 29.0
pair_coeff      2 2 14.0 14.0
pair_coeff      1 2 29.0 14.0
timestep        0.0002
fix             1 all nve
thermo_style    custom step temp pe etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          10
run             50
