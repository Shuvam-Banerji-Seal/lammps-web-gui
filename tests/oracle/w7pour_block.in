# oracle: fix pour block region, diam one, 20 particles in 5 events under gravity (pair gran/hooke between poured spheres, fix nve/sphere)
# oracle-compare: thermo=all atoms=all
units           lj
atom_style      sphere
atom_modify     map array
comm_modify     vel yes
boundary        p p f
region          box block -10 10 -10 10 -10 10
create_box      1 box
region          reg block -3 3 -3 3 0 4 side in units box
pair_style      gran/hooke 2000.0 700.0 50.0 30.0 0.5 1
pair_coeff      * *
timestep        0.002
fix             1 all nve/sphere
fix             2 all gravity 1.0 vector 0 0 -1
fix             4 all wall/gran hooke 2000.0 700.0 50.0 30.0 0.5 1 zplane -2.0 NULL
fix             3 all pour 20 1 12345 region reg diam one 1.0 dens 1.0 1.0 vol 0.01 100
compute         er all erotate/sphere
thermo_style    custom step atoms ke c_er
thermo_modify   format float %.15g
thermo          200
run             6000
