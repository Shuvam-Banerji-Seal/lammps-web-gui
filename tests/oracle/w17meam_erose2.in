# oracle: pair_style meam, single element bcc reference (w16meamcut_bcc_lib.meam + w17meam_erose2.meam, zbl 0, erose_form = 2, attrac(1,1) = 0.4, repuls(1,1) = 0.9), 2x2x2 bcc cell (16 atoms), lattice constant 3.16 A, 0.05 A sinusoidal displacement, velocities from atom-style variables, fix nve, 50 steps of 0.001 ps
# oracle: docs.lammps.org/pair_meam.html (plans/lammps-docs/pair_meam.rst), quoted: "if erose_form = 2: erose = -Ec\*(1 +astar + a3\*(astar\*\*3))\*exp(-astar)", "a3 = repuls, astar < 0", "a3 = attrac, astar >= 0"
# oracle-inputs: w16meamcut_bcc_lib.meam w17meam_erose2.meam
# oracle-compare: thermo=all atoms=all rel=1e-6 abs=1e-9
# oracle-tolerance: the pair term is the Rose energy of this form, tabulated as in meam.ts; native dimers with these parameters agree with the engine to 1e-15 eV (measured with native LAMMPS, black box, dimers at 2.2, 2.7, 3.2 and 3.95 A)
units           metal
atom_style      atomic
lattice         bcc 3.16
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box
mass            1 183.84
variable        dx atom 0.05*sin(2.3*x+1.1*y+0.4*z)
variable        dy atom 0.05*cos(1.9*y-0.7*x+0.3*z)
variable        dz atom 0.05*sin(1.3*z+0.8*x-0.5*y)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.4*cos(1.7*y-0.6*z)
variable        vy atom 0.4*sin(1.2*z+0.9*x)
variable        vz atom 0.3*cos(2.1*x-0.8*y+0.2)
velocity        all set v_vx v_vy v_vz units box
pair_style      meam
pair_coeff      * * w16meamcut_bcc_lib.meam W w17meam_erose2.meam W
timestep        0.001
fix             1 all nve
thermo          10
thermo_style    custom step pe press
thermo_modify   format float %.15g
run             50
