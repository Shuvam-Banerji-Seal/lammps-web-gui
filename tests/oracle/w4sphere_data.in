# oracle: atom_style sphere — create_atoms defaults, set diameter/density/mass/omega, write_data and read_data round trip
# oracle-files: s1.data s2.data
# oracle-compare: atoms=none
units           lj
atom_style      sphere
lattice         sc 1.0
region          box block 0 2 0 2 0 2
create_box      2 box
create_atoms    1 box
set             atom 2 diameter 1.5
set             atom 3 density 2.0
set             atom 4 mass 3.0
set             atom 5 omega 0.1 0.2 0.3
set             atom 6 diameter 0.0
set             atom 7 diameter 0.0
set             atom 7 density 2.5
set             atom 8 type 2
velocity        all set 0.1 0.2 0.3
write_data      s1.data
clear
units           lj
atom_style      sphere
read_data       s1.data
set             atom 1 diameter 0.8 density 1.7
write_data      s2.data
