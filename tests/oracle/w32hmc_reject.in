# oracle: fix hmc deterministic-reject limit (T -> 0) — Metropolis accept iff dH < 0, restore on reject, resample no
units           lj
atom_style      atomic
boundary        p p p
region          box block 0 8 0 8 0 8
create_box      1 box
create_atoms    1 single 2.0 2.0 2.0 units box
create_atoms    1 single 2.9 2.0 2.0 units box
create_atoms    1 single 2.0 5.0 2.0 units box
create_atoms    1 single 2.9 5.0 2.0 units box
mass            1 1.0
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
velocity        all set 0.0 0.0 0.0
fix             1 all nve
fix             2 all hmc 1 98765 1.0e-9 resample no
timestep        0.01
thermo_style    custom step temp pe ke etotal f_2 f_2[1] f_2[2]
thermo_modify   format float %.15g
thermo          1
run             8
