# oracle: compute stress/mop with the kin, pair, bond, angle, dihedral, conf and total keywords, stress/mop/profile with bond, angle and dihedral, and stress/cartesian with bond and with the default keywords (ke, pair, bond), on the mol_chains force field (harmonic bonds and angles, opls dihedrals; the harmonic impropers are not in these computes, as native)
# oracle-inputs: mol_chains.data
# oracle-compare: thermo=all atoms=all
# Measured with native LAMMPS: engine vs native thermo 1.3e-14, atoms 3.0e-14; the plane x = 6.5 is crossed by pairs, bonds, angles and dihedrals (one dihedral type).
units           lj
atom_style      molecular
bond_style      harmonic
angle_style     harmonic
dihedral_style  opls
improper_style  harmonic
pair_style      lj/cut 2.5
read_data       mol_chains.data
pair_coeff      * * 0.5 0.9
pair_coeff      1 3 0.8 1.0
bond_coeff      1 120.0 1.05
bond_coeff      2 90.0 1.1
angle_coeff     1 40.0 109.5
angle_coeff     2 25.0 120.0
dihedral_coeff  1 1.2 -0.3 0.6 0.1
improper_coeff  1 12.0 20.0
special_bonds   lj 0.0 0.5 0.8
timestep        0.002
fix             1 all nve
compute         mop all stress/mop x 6.5 kin pair bond angle dihedral conf total
compute         mpp all stress/mop/profile x 0.0 2.0 bond angle dihedral
compute         sc all stress/cartesian y 2.0 NULL 0 bond
compute         scp all stress/cartesian y 2.0 NULL 0
thermo_style    custom step pe c_mop[*] c_mpp[3][2] c_mpp[3][3] c_mpp[3][4] c_mpp[4][5] c_mpp[4][6] c_mpp[4][7] c_mpp[5][8] c_mpp[5][9] c_mpp[5][10] c_sc[3][6] c_sc[3][7] c_sc[3][8] c_scp[4][6] c_scp[4][8]
thermo_modify   format float %.15g
thermo          10
run             50
