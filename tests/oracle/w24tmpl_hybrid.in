# oracle: atom_style hybrid template charge with a two-molecule template (offsets none), read_data with template and charge columns, 100-step nve, then write_data
# oracle-inputs: w24tmpl_a.txt w24tmpl_b.txt w24tmpl_hybrid.data
# oracle-files: w24tmpl_hybrid_out.data
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           real
boundary        p p p
molecule        wmix w24tmpl_a.txt w24tmpl_b.txt
atom_style      hybrid template wmix charge
pair_style      lj/cut/coul/cut 4.0
pair_modify     mix geometric
bond_style      harmonic
angle_style     harmonic
dihedral_style  harmonic
read_data       w24tmpl_hybrid.data
fix             1 all nve
timestep        1.0
thermo          10
thermo_style    custom step temp pe ebond eangle edihed ecoul etotal press atoms
thermo_modify   format float %.15g norm no
run             100
write_data      w24tmpl_hybrid_out.data
