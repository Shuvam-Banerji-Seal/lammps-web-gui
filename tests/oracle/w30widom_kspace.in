# oracle: Widom atom insertion with kspace (full_energy auto-enabled) and a point charge
# oracle-compare: rel=1e-5 (PPPM roundoff in the energy difference is amplified by the Boltzmann exponential)
units real
atom_style charge
boundary p p p
region box block 0 20 0 20 0 20
create_box 2 box
create_atoms 1 single 5.0 5.0 5.0 units box
create_atoms 1 single 15.0 15.0 15.0 units box
set atom 1 charge 1.0
set atom 2 charge 1.0
mass 1 1.0
mass 2 1.0
pair_style lj/cut/coul/long 8.0
pair_coeff 1 1 0.1 2.0
pair_coeff 1 2 0.1 2.0
pair_coeff 2 2 0.1 2.0
kspace_style pppm 1e-4
kspace_modify gewald 0.3 mesh 20 20 20 order 4
fix w all widom 1 2 2 12345 300.0 charge -2.0
thermo_style custom step pe f_w[1] f_w[2] f_w[3]
thermo_modify format float %.15g
thermo 1
run 4
