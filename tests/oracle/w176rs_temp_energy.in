# oracle: fix temp/berendsen and temp/rescale keep their cumulative energy change through write_restart/read_restart (fix_temp_berendsen.cpp write_restart "energy"): 20 steps, write_restart, clear, read_restart, both fixes re-specified, 20 more steps. Native: built from b332f28 (installed lmp).
# oracle-compare: thermo=all atoms=all rel=1e-8
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 1.6 4321 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
timestep        0.004
fix             1 all nve
fix             b all temp/berendsen 1.0 1.0 0.5
fix             r all temp/rescale 5 0.9 0.9 0.02 0.5
thermo_style    custom step temp pe etotal ecouple econserve f_b f_r
thermo_modify   format float %.15g
thermo          5
run             20
write_restart   w176rs_temp_energy.restart
clear
read_restart    w176rs_temp_energy.restart
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
fix             1 all nve
fix             b all temp/berendsen 1.0 1.0 0.5
fix             r all temp/rescale 5 0.9 0.9 0.02 0.5
thermo_style    custom step temp pe etotal ecouple econserve f_b f_r
thermo_modify   format float %.15g
thermo          5
run             20
