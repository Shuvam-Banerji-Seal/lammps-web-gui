# Wave 43: cut-down of examples/ttm/in.ttm.mod: 64 Si atoms (2x2x2 diamond cells, Stillinger-Weber), the example's ttm/mod
# parameters (n_ion 0.05, D_e 20000, the a_i/C_0/A polynomial, gamma_p, gamma_s, v_0), 4x4x4 electron grid, set 1000 K, 300 steps.
# oracle-inputs: w43tm_si.par
# oracle-potentials: Si.sw
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           metal
atom_style      atomic
boundary        p p p
lattice         diamond 5.4309
region          box block 0 2 0 2 0 2
create_box      1 box
mass            1 28.0855
create_atoms    1 box basis 1 1 basis 2 1 basis 3 1 basis 4 1 basis 5 1 basis 6 1 basis 7 1 basis 8 1
pair_style      sw
pair_coeff      * * Si.sw Si
neighbor        2.0 bin
neigh_modify    every 5 delay 0 check yes
fix             1 all nve
fix             twotemp all ttm/mod 1354684 w43tm_si.par 4 4 4 set 1000.0
timestep        0.0001
thermo          50
thermo_style    custom step temp etotal f_twotemp[1] f_twotemp[2]
thermo_modify   format float %.15g
run             300
