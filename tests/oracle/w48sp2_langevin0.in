# oracle: fix langevin/spin at temperature 0 (transverse damping 0.1) with zeeman precession, 20 steps, lattice frozen
# oracle-files: w48sp2_langevin0.dump
units           metal
atom_style      spin
boundary        f f f
atom_modify     map array
region          box block -10 10 -10 10 -10 10
create_box      1 box
create_atoms    1 single 0.0 0.0 0.0
create_atoms    1 single 2.0 0.0 0.0
mass            1 55.845
set             atom 1 spin/atom 2.2 1.0 0.3 0.2
set             atom 2 spin/atom 2.2 -0.4 0.8 0.5
fix             2 all precession/spin zeeman 10.0 0 0 1
fix             3 all langevin/spin 0.0 0.1 21
fix             1 all nve/spin lattice frozen
timestep        0.001
compute         p all property/atom spx spy spz sp fmx fmy fmz fx fy fz
run             20
write_dump      all custom w48sp2_langevin0.dump id c_p[1] c_p[2] c_p[3] c_p[4] c_p[5] c_p[6] c_p[7] c_p[8] c_p[9] c_p[10] modify format float %.15g
