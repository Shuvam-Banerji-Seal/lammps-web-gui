# oracle: pair dispersion/d3 bjm (b3-lyp) under hybrid/overlay with lj/cut, and compute pair of the d3 part
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 1.1e-12, atoms 6.0e-13.
units           metal
atom_style      atomic
boundary        p p p
lattice         diamond 3.57
region          box block 0 2 0 2 0 2
create_box      2 box
create_atoms    1 box
set             type 1 type/fraction 2 0.25 4127
displace_atoms  all random 0.08 0.08 0.08 9731 units box
mass            1 12.011
mass            2 15.999
pair_style      hybrid/overlay lj/cut 4.0 dispersion/d3 bjm b3-lyp 9.0 6.0
pair_coeff      * * lj/cut 0.002 2.4
pair_coeff      * * dispersion/d3 C O
compute         d3 all pair dispersion/d3
velocity        all create 600.0 87287 loop geom
fix             1 all nve
timestep        0.0005
thermo_style    custom step pe ke press pxx pyy pzz pxy pxz pyz c_d3
thermo_modify   format float %.15g
thermo          10
run             60
