# oracle: variables, loops, if/jump, computes and thermo references
# oracle-files: vars.txt
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 1.0
variable        vx atom 0.8*sin(2.2*x+1.3*y+0.4*z)
variable        vy atom 0.8*cos(1.6*x-0.8*y+0.9*z)
variable        vz atom 0.8*sin(0.6*x+1.1*z+1.8*y)
velocity        all set v_vx v_vy v_vz units box
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
compute         myke all ke
compute         mype all pe pair
compute         myp all pressure thermo_temp virial
group           half id <= 54
compute         thalf half temp
variable        e equal c_mype/atoms
variable        cm equal xcm(all,x)
variable        g equal gyration(half)
variable        nh equal count(half)
fix             1 all nve
thermo_style    custom step temp pe ke c_myke c_mype v_e c_myp c_thalf v_cm v_g v_nh
thermo_modify   format float %.15g
thermo          5
print           "start $(step) natoms=$(atoms) nhalf=${nh}" file vars.txt
variable        i loop 3
label           loop
run             10
print           "loop $i step=$(step) T=$(temp:%.10f) pe=$(pe:%.10f) ke=$(ke:%.10f)" append vars.txt
if              "$i == 2" then "print 'two reached' append vars.txt"
next            i
jump            SELF loop
print           "done $(step) $(v_cm:%.12f) $(v_g:%.12f)" append vars.txt
