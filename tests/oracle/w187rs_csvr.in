# oracle: fix temp/csvr keeps its energy and its RanMars stream through write_restart/read_restart (fix_temp_csvr.cpp write_restart and restart): 20 steps, write_restart, clear, read_restart, temp/csvr re-specified, 20 more steps. Native: built from b332f28 (installed lmp).
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=1e-12
# measured: fails at rel=1e-12 abs=0 and passes at rel=1e-11 abs=0 (the error is between 1e-12 and 1e-11 relative), so the tolerance is 1e-10; the run takes about 1 s
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 1.6 4321 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
timestep        0.004
fix             1 all nve
fix             t all temp/csvr 1.0 1.0 0.5 7531
thermo_style    custom step temp pe etotal ecouple econserve
thermo_modify   format float %.15g
thermo          4
run             20
write_restart   w187rs_csvr.restart
clear
read_restart    w187rs_csvr.restart
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
fix             1 all nve
fix             t all temp/csvr 1.0 1.0 0.5 7531
thermo_style    custom step temp pe etotal ecouple econserve
thermo_modify   format float %.15g
thermo          4
run             20
