# oracle: LJ fluid steered by fix smd (constant velocity pull, tethered to z = 1.0, virial yes), 3x3x3 fcc, f_ID = the 7 global vector values
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 6.7e-15, atoms 1.5e-13.
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 1.0 87287 loop all
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0 2.5
group           pull id 1:27
timestep        0.002
fix             1 all nve
fix             2 pull smd cvel 5.0 0.5 tether NULL NULL 1.0 0.5
fix_modify     2 virial yes
thermo_style    custom step temp pe press f_2[1] f_2[2] f_2[3] f_2[4] f_2[5] f_2[6] f_2[7]
thermo_modify   format float %.15g
thermo          10
run             100
