# oracle: pair_style mliap model linear with descriptor sna (2 elements, twojmax 4, same numbers as the snap case w8snap_linear), perturbed bcc, 2 types, 20 NVE steps
# oracle-inputs: w16mliap_linear.mliap.model w16mliap_linear.mliap.descriptor
# oracle-compare: thermo=all
units           lj
atom_style      atomic
lattice         bcc 0.9
region          box block 0 2 0 2 0 2
create_box      2 box
create_atoms    1 box
group           odd id 1:128:2
set             group odd type 2
mass            * 1.0
variable        dx atom 0.05*sin(1.3*x+0.7*y)
variable        dy atom 0.05*cos(0.9*y-1.1*z)
variable        dz atom 0.05*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
velocity        all create 0.3 4928459
pair_style      mliap model linear w16mliap_linear.mliap.model descriptor sna w16mliap_linear.mliap.descriptor
pair_coeff      * * A B
fix             1 all nve
thermo_style    custom step pe press
thermo_modify   format float %.15g
timestep        0.001
run             20
