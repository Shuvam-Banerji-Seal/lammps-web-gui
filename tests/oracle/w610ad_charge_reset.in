# oracle: fix adapt atom charge (no scale) reset yes every 5 steps with lj/cut/coul/cut, the charges changed by set after the fix is defined: native restores the charges the fix stored when it was defined; two runs
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      charge
lattice         sc 0.8
region          b block 0 4 0 4 0 4
create_box      2 b
create_atoms    1 box
mass            * 1.0
group           odd id 1:64:2
set             group all charge 0.5
set             group odd type 2
set             group odd charge -0.5
variable        dx atom 0.1*sin(1.3*x+0.7*y)
variable        dy atom 0.1*cos(0.9*y-1.1*z)
variable        dz atom 0.1*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.5*sin(1.7*x+2.3*y+0.7*z)
variable        vy atom 0.5*cos(2.1*x-1.1*y+0.3*z)
variable        vz atom 0.5*sin(0.5*x+1.9*z+1.3*y)
velocity        all set v_vx v_vy v_vz units box
timestep        0.002
pair_style      lj/cut/coul/cut 2.5
pair_coeff      * * 0.5 1.0
variable        qq equal -0.5-0.01*elapsed
fix             1 odd adapt 5 atom charge v_qq reset yes
set             group odd charge -0.8
fix             2 all nve
compute         qq all property/atom q
compute         sq all reduce sum c_qq
thermo_style    custom step temp pe ke etotal press c_sq
thermo_modify   format float %.15g
thermo          10
run             40
run             20
