# oracle: APIP with a funcfl EAM fast potential and two ACE potentials on a displaced 2x2x2 fcc Cu cell (atom_style apip conservative, switching parameters from an atom-style variable): hybrid/overlay eam/apip (Cu_u3.eam) + pace/precise/apip (Cu-PBE-core-rep.ace), 6 NVE steps, then hybrid/overlay pace/fast/apip (Cu-1.yace of examples/PACKAGES/apip) + pace/precise/apip, 6 more steps
# Native reference: LAMMPS b332f28 built with PKG_APIP and PKG_ML-PACE (/store/shuvam/software/lammps-build-apip/lmp)
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 1.8e-13, atoms 1.2e-14.
# oracle-potentials: Cu_u3.eam Cu-PBE-core-rep.ace
# oracle-examples: PACKAGES/apip/Cu-1.yace
# oracle-compare: thermo=all atoms=all
units           metal
atom_style      apip conservative
lattice         fcc 3.615
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box
mass            1 63.546
displace_atoms  all random 0.08 0.08 0.08 4928459
variable        lam atom 0.5+0.5*sin(0.9*x-0.6*y+0.3*z)
set             group all apip/lambda v_lam
pair_style      hybrid/overlay eam/apip pace/precise/apip
pair_coeff      * * eam/apip Cu_u3.eam
pair_coeff      * * pace/precise/apip Cu-PBE-core-rep.ace Cu
compute         eatom all pe/atom
compute         esum all reduce sum c_eatom
compute         satom all stress/atom NULL
compute         ssum all reduce sum c_satom[1] c_satom[2] c_satom[3]
thermo_style    custom step pe press pxx pyy pzz pxy pxz pyz c_esum c_ssum[1] c_ssum[2] c_ssum[3]
thermo_modify   format float %.15g
velocity        all create 300 4928459 loop geom
fix             1 all nve
thermo          3
run             6
pair_style      hybrid/overlay pace/fast/apip pace/precise/apip
pair_coeff      * * pace/fast/apip Cu-1.yace Cu
pair_coeff      * * pace/precise/apip Cu-PBE-core-rep.ace Cu
run             6
