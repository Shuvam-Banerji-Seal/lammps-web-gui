# oracle: compute sna/atom with pairs closer than rmin0 (theta0 < 0 branch; f_c = 1 there), two types, twojmax 4, written by a dump
# oracle-files: sna_close.dump
# oracle-compare: thermo=first-last
units           lj
atom_style      atomic
boundary        p p p
region          box block 0 6 0 6 0 6
create_box      2 box
create_atoms    1 single 0.0 0.0 0.0
create_atoms    2 single 0.09 0.0 0.0
create_atoms    1 single 0.7 0.3 -0.4
create_atoms    2 single -0.2 0.9 0.5
create_atoms    1 single 1.1 -0.8 0.6
create_atoms    2 single 0.5 0.45 1.9
create_atoms    1 single -0.9 -0.5 -0.7
create_atoms    2 single 2.1 1.6 0.4
create_atoms    1 single 2.25 1.58 0.45
mass            * 1.0
pair_style      zero 4.5
pair_coeff      * *
compute         b all sna/atom 1.1 0.85 4 1.6 2.0 0.9 1.2 rmin0 0.1
thermo_style    custom step pe
thermo_modify   format float %.15g
dump            d all custom 1 sna_close.dump id c_b[*]
dump_modify     d sort id format float %.12g
run             0
