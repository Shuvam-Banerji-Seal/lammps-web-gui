# Wave 14: pair_style hbond/dreiding/morse (docs.lammps.org/pair_hbond_dreiding.html) through
# hybrid/overlay with lj/cut. Same system as w14hbond_lj. n = 2 global; the (1,5) pair overrides n = 4.
# Morse D0 = 1.5, alpha = 1.2, r0 = 2.5 (acceptor 3) and D0 = 1.0, alpha = 1.5, r0 = 2.2 (acceptor 5).
# oracle-inputs: w14hbond_system.data
# oracle-compare: thermo=all atoms=all rel=1e-7 abs=1e-9
units           real
atom_style      full
boundary        p p p
read_data       w14hbond_system.data
special_bonds   lj/coul 0.0 0.0 1.0
pair_style      hybrid/overlay lj/cut 8.0 hbond/dreiding/morse 2 3.0 4.5 90.0
pair_coeff      * * lj/cut 0.1 2.8
pair_coeff      1 3 hbond/dreiding/morse 2 i 3.0 1.2 2.5
pair_coeff      1 5 hbond/dreiding/morse 2 i 2.0 1.5 2.2 4 3.0 4.5 90.0
bond_style      harmonic
bond_coeff      1 450.0 0.9572
bond_coeff      2 300.0 1.2
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
timestep        1.0
fix             1 all nve
thermo_style    custom step pe evdwl ebond press
thermo_modify   format float %.15g
thermo          20
run             100
