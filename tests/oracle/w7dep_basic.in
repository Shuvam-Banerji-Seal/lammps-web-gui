# oracle: fix deposit block region, M=2, N=6, vx vy vz ranges (velocity draws after each position), near 0.5 rejections, pair lj/cut with zero epsilon
# oracle-compare: thermo=all atoms=all
units           lj
atom_style      atomic
atom_modify     map array
boundary        p p f
region          box block -10 10 -10 10 -10 10
create_box      1 box
mass            1 1.0
region          reg block 0 4 0 4 0 4 side in units box
pair_style      lj/cut 2.5
pair_coeff      * * 0.0 1.0
timestep        0.01
fix             1 all nve
fix             3 all deposit 6 1 2 12345 region reg units box vx -0.5 0.5 vy -0.5 0.5 vz -1.0 -0.5 near 0.5 attempt 10
thermo_style    custom step atoms pe
thermo_modify   format float %.15g
thermo          2
run             30
