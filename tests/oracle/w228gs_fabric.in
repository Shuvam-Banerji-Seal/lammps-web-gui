# oracle: compute fabric (radius cutoff, non-periodic box so no ghost partners; contact, branch, force/normal and force/tangential tensors, type/include 1,2 1,2) on finite-size spheres in contact (gran/hooke/history), vector sampled each step over 10 steps
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10 filerel=1e-8
# oracle-files: w228gs_fabric.out
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 0.0e+0, atoms 3.8e-15.
units           lj
atom_style      sphere
comm_modify     vel yes
boundary        f f f
lattice         sc 0.8
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
group           half id 1:32
set             group half type 2
set             type 1 diameter 1.1
set             type 2 diameter 1.0
set             group all density 1.0
velocity        all create 0.3 4242 loop geom
set             group all omega 0.2 -0.1 0.3
pair_style      gran/hooke/history 2000.0 NULL 50.0 NULL 0.5 0
pair_coeff      * *
timestep        0.002
fix             1 all nve/sphere
compute         f all fabric radius contact branch force/normal force/tangential type/include 1,2 1,2
fix             2 all ave/time 1 1 1 c_f file w228gs_fabric.out mode vector format " %.15g"
thermo_style    custom step pe c_f
thermo_modify   format float %.15g
thermo          5
run             10
