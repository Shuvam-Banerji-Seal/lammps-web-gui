# oracle: change_box x scale with y volume and z volume (both rescaled by the square root of the factor), x final with
# z volume, and a volume-preserving change in 2d-like aspect, each with remap; then kspace_modify compute no and yes
# with kspace_style ewald/dipole (a style outside the Ewald/PPPM base) on dipoles, energies and pressures in thermo
# oracle-compare: thermo=all atoms=all
units           lj
atom_style      hybrid sphere dipole
lattice         sc 0.5
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
set             group all dipole/random 98934 0.75
set             group all diameter 1.0
velocity        all create 1.0 87287 loop geom
pair_style      lj/cut/dipole/long 3.0
pair_coeff      * * 1.0 1.0
kspace_style    ewald/dipole 1.0e-4
thermo_style    custom step pe elong press vol lx ly lz
thermo_modify   format float %.15g
fix             1 all nve
run             0
change_box      all x scale 1.1 y volume z volume remap units box
run             0
change_box      all x final 0 7.5 z volume remap units box
run             0
change_box      all y delta -0.2 0.3 x volume remap units box
run             0
kspace_modify   compute no
run             2
kspace_modify   compute yes
run             2
