# oracle: reset_atoms image all on bonded fragments with mixed image flags (floor of the fragment's mid image; negative and odd sums)
# oracle-inputs: w104cf_reset_image.data
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=1e-12
units           lj
atom_style      bond
read_data       w104cf_reset_image.data
pair_style      lj/cut 2.0
pair_coeff      * * 0.2 1.0
bond_style      harmonic
bond_coeff      1 40.0 1.2
reset_atoms     image all
thermo_style    custom step pe epair ebond
thermo_modify   format float %.15g norm no
thermo          10
run             0
