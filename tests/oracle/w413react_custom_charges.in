# oracle: fix bond/react on tiny nylon (400 steps) with custom_charges fq on the second step: only the six atoms of fragment fq take the post-reaction charges
# oracle-inputs: w408react_tiny_nylon.data w408react_rxn1_stp1_unreacted.molecule_template w408react_rxn1_stp1_reacted.molecule_template w408react_rxn1_stp2_unreacted_fragq.molecule_template w408react_rxn1_stp2_reacted.molecule_template w408react_rxn1_stp1_map w408react_rxn1_stp2_map
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-6
# pair_modify table 0: with the coulomb table (its lookup rounds rsq to single precision), earlier 1e-13 differences put one pair (atoms 23 and 31) on the other side of a table step at step 191 and the run then differs by 5e-8.
# Measured with native LAMMPS: engine vs native thermo 1.1e-11, atoms 6.9e-12.
# two monomer nylon example
# reaction produces a condensed water molecule

units real

boundary p p p

atom_style full

kspace_style pppm 1.0e-4

pair_style lj/class2/coul/long 8.5

angle_style class2

bond_style class2

dihedral_style class2

improper_style class2

special_bonds lj/coul 0 0 1
pair_modify tail yes mix sixthpower table 0

read_data w408react_tiny_nylon.data &
  extra/bond/per/atom 5  &
  extra/angle/per/atom 15 &
  extra/dihedral/per/atom 15 &
  extra/improper/per/atom 25 &
  extra/special/per/atom 25


velocity all create 300.0 4928459 dist gaussian

molecule mol1 w408react_rxn1_stp1_unreacted.molecule_template
molecule mol2 w408react_rxn1_stp1_reacted.molecule_template
molecule mol3 w408react_rxn1_stp2_unreacted_fragq.molecule_template
molecule mol4 w408react_rxn1_stp2_reacted.molecule_template

thermo 10

# dump 1 all xyz 1 test_vis.xyz
# dump_modify 1 types labels

fix myrxns all bond/react stabilization no &
  react rxn1 all 1 0.0 2.9 mol1 mol2 w408react_rxn1_stp1_map &
  react rxn2 all 1 0.0 5.0 mol3 mol4 w408react_rxn1_stp2_map custom_charges fq

fix 1 all nve/limit .03

thermo_style custom step temp press density f_myrxns[1] f_myrxns[2]
thermo_modify format float %.15g

# restart 100 restart1 restart2

run 400

# write_restart restart_longrun
# write_data restart_longrun.data nofix
