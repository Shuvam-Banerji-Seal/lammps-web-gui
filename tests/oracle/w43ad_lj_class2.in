# oracle: fix adapt pair lj/class2 sigma (type pair 1 1) and epsilon on the 2 2 pair, scale no, reset yes across two runs
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           lj
atom_style      atomic
lattice         sc 0.8
region          b block 0 4 0 4 0 4
create_box      2 b
create_atoms    1 box
mass            * 1.0
set             group all type 1
group           odd id 1:64:2
set             group odd type 2
variable        dx atom 0.1*sin(1.3*x+0.7*y)
variable        dy atom 0.1*cos(0.9*y-1.1*z)
variable        dz atom 0.1*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.5*sin(1.7*x+2.3*y+0.7*z)
variable        vy atom 0.5*cos(2.1*x-1.1*y+0.3*z)
variable        vz atom 0.5*sin(0.5*x+1.9*z+1.3*y)
velocity        all set v_vx v_vy v_vz units box
timestep        0.002
thermo_style    custom step temp pe ke etotal press pxx pyy pzz
thermo_modify   format float %.15g
thermo          10
pair_style      lj/class2 2.5
pair_coeff      1 1 1.0 1.0
pair_coeff      2 2 0.5 1.1
pair_coeff      1 2 0.8 1.05
variable        sg equal ramp(1.0,1.3)
variable        ep equal ramp(0.5,0.9)
fix             2 all nve
fix             1 all adapt 1 pair lj/class2 sigma 1 1 v_sg pair lj/class2 epsilon 2 2 v_ep reset yes
run             60
unfix           1
run             40
