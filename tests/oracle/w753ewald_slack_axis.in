# oracle: Ewald k vectors of a 10 x 10 x 19.9999 box with kmax/ewald 5 3 9: native keeps vectors up to 1.00001 times the cutoff sphere ((4,0,6) and (3,0,8) lie 4e-6 and 6e-6 outside it) and runs the axis vectors (0,m,0) to the largest kmax (m = 4, 5)
units           real
atom_style      charge
region          box block 0 10 0 10 0 19.9999 units box
create_box      2 box
lattice         sc 2.5
create_atoms    1 box
group           odd id 1:128:2
set             group odd type 2
mass            1 15.0
mass            2 20.0
set             type 1 charge 0.45
set             type 2 charge -0.45
variable        dx atom 0.2*sin(0.43*x+0.27*z)
variable        dy atom 0.2*cos(0.31*y-0.23*z)
variable        dz atom 0.2*sin(0.37*z+0.19*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.003*sin(0.6*x+0.2*z)
variable        vy atom 0.003*cos(0.5*y+0.3*x)
variable        vz atom 0.003*sin(0.4*z-0.5*y)
velocity        all set v_vx v_vy v_vz units box
pair_style      lj/cut/coul/long 4.5
pair_coeff      * * 0.15 2.4
pair_modify     table 0
kspace_style    ewald 1.0e-5
kspace_modify   gewald 0.35 kmax/ewald 5 3 9
fix             1 all nve
thermo_style    custom step temp pe evdwl ecoul elong etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          10
run             30
