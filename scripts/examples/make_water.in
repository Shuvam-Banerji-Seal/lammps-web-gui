units           real
atom_style      full
boundary        p p p
variable        L equal 18.6413
lattice         sc 3.10688
region          box block 0 6 0 6 0 6
create_box      2 box bond/types 1 angle/types 1 extra/bond/per/atom 2 extra/angle/per/atom 1 extra/special/per/atom 2
mass            1 15.9994
mass            2 1.008
molecule        water water_spce.mol
create_atoms    0 box mol water 482793
pair_style      lj/cut/coul/long 10.0
pair_modify     mix arithmetic tail yes
kspace_style    pppm 1.0e-5
pair_coeff      1 1 0.15535 3.16557
pair_coeff      2 2 0.0 1.0
bond_style      harmonic
bond_coeff      1 1000.0 1.0
angle_style     harmonic
angle_coeff     1 1000.0 109.47
velocity        all create 300.0 4928459 mom yes rot yes dist gaussian
fix             rigid all shake 0.0001 20 0 b 1 a 1
fix             nvt all nvt temp 300.0 300.0 100.0
timestep        2.0
thermo          500
thermo_style    custom step temp pe press density
run             10000
write_data      water_spce.data nocoeff
