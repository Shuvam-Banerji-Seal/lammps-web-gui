# oracle: fix rigid with force and torque components switched off
# oracle-inputs: rigid_tetra.txt rigid_dimer.txt rigid_tri.txt
# oracle-compare: abs=1e-8 skip=f_1
units           lj
atom_style      molecular
region          box block 0 9 0 9 0 9 units box
create_box      2 box
mass            1 1.0
mass            2 1.5
molecule        t rigid_tetra.txt
molecule        d rigid_dimer.txt
molecule        r rigid_tri.txt
create_atoms    0 single 1.600 1.600 1.600 mol t 1 rotate 0 1 1 1 units box
create_atoms    0 single 1.600 1.600 4.600 mol d 1 rotate 37 2 2 2 units box
create_atoms    0 single 1.600 1.600 7.600 mol r 1 rotate 74 3 3 3 units box
create_atoms    0 single 1.600 4.600 1.600 mol t 1 rotate 111 1 4 4 units box
create_atoms    0 single 1.600 4.600 4.600 mol d 1 rotate 148 2 5 5 units box
create_atoms    0 single 1.600 4.600 7.600 mol r 1 rotate 185 3 1 6 units box
create_atoms    0 single 1.600 7.600 1.600 mol t 1 rotate 222 1 2 7 units box
create_atoms    0 single 1.600 7.600 4.600 mol d 1 rotate 259 2 3 1 units box
create_atoms    0 single 1.600 7.600 7.600 mol r 1 rotate 296 3 4 2 units box
create_atoms    0 single 4.600 1.600 1.600 mol t 1 rotate 333 1 5 3 units box
create_atoms    0 single 4.600 1.600 4.600 mol d 1 rotate 10 2 1 4 units box
create_atoms    0 single 4.600 1.600 7.600 mol r 1 rotate 47 3 2 5 units box
create_atoms    0 single 4.600 4.600 1.600 mol t 1 rotate 84 1 3 6 units box
create_atoms    0 single 4.600 4.600 4.600 mol d 1 rotate 121 2 4 7 units box
create_atoms    0 single 4.600 4.600 7.600 mol r 1 rotate 158 3 5 1 units box
create_atoms    0 single 4.600 7.600 1.600 mol t 1 rotate 195 1 1 2 units box
create_atoms    0 single 4.600 7.600 4.600 mol d 1 rotate 232 2 2 3 units box
create_atoms    0 single 4.600 7.600 7.600 mol r 1 rotate 269 3 3 4 units box
create_atoms    0 single 7.600 1.600 1.600 mol t 1 rotate 306 1 4 5 units box
create_atoms    0 single 7.600 1.600 4.600 mol d 1 rotate 343 2 5 6 units box
create_atoms    0 single 7.600 1.600 7.600 mol r 1 rotate 20 3 1 7 units box
create_atoms    0 single 7.600 4.600 1.600 mol t 1 rotate 57 1 2 1 units box
create_atoms    0 single 7.600 4.600 4.600 mol d 1 rotate 94 2 3 2 units box
create_atoms    0 single 7.600 4.600 7.600 mol r 1 rotate 131 3 4 3 units box
create_atoms    0 single 7.600 7.600 1.600 mol t 1 rotate 168 1 5 4 units box
create_atoms    0 single 7.600 7.600 4.600 mol d 1 rotate 205 2 1 5 units box
create_atoms    0 single 7.600 7.600 7.600 mol r 1 rotate 242 3 2 6 units box
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
pair_coeff      2 2 0.8 1.05
neigh_modify    exclude molecule/intra all
variable        vx atom 0.6*sin(0.9*x+0.4*z)
variable        vy atom 0.6*cos(0.6*y+0.8*x)
variable        vz atom 0.6*sin(0.7*z-0.3*y)
velocity        all set v_vx v_vy v_vz units box
timestep        0.002
fix             1 all rigid molecule force 1*9 off on on torque 10* on off off
thermo_style    custom step temp pe ke etotal press pxx pyy pzz pxy pxz pyz f_1 f_1[1][1] f_1[1][4] f_1[2][7] f_1[3][10]
thermo_modify   format float %.15g
thermo          10
run             60
