# oracle: pair_style tracker (hybrid/overlay with lj/cut) and fix STORE/LOCAL output read by dump local and ave/histo (examples/PACKAGES/tracker/in.track cut down: 200 steps, output every 100)
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10 filerel=1e-8
# measured: thermo, atoms and both written files agree with native to better than 1e-14 relative (native b332f28 lmp, package MISC)
# oracle-files: w142mx_lifetime_hist.dat w142mx_contact_history.dat
# native: b332f28 (installed lmp, package MISC)
units		lj
atom_style	atomic

lattice		fcc 0.8442
region		box block 0 4 0 4 0 4
create_box	2 box
create_atoms	2 box
mass		1 1.0
mass            2 1.0
velocity	all create 2.0 87287 loop geom

pair_style	hybrid/overlay lj/cut 2.5 tracker trackfix 100 id1 id2 time/created time/broken time/total time/min 0.5
pair_coeff	* * lj/cut 1.0 1.0 2.5
pair_coeff  * * tracker 2.5

neighbor	0.3 bin
neigh_modify	every 20 delay 0 check no

fix		1 all nve
fix     2 all ave/histo 100 1 100 0 6 30 f_trackfix[5] mode vector kind local file w142mx_lifetime_hist.dat

dump 1 all local 100 w142mx_contact_history.dat f_trackfix[1] f_trackfix[2] f_trackfix[3] f_trackfix[4]
dump_modify 1 header no

thermo_style	custom step pe ke etotal temp
thermo_modify format float %.15g
thermo 50
run 200
