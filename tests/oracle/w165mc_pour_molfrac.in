# oracle-inputs: w165mc_pour_molfrac_dimer.mol w165mc_pour_molfrac_single.mol w165mc_pour_molfrac_trimer.mol
# oracle: fix pour with a molecule template of three molecule files and molfrac 0.25 0.25 0.5 (cumulative draws), 40 molecules in a block region
# Measured max relative error of the engine against native (thermo 4.4e-15, per-atom 5.7e-12; 88 atoms). native: b332f28 (installed lmp, black box)
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      hybrid sphere bond
boundary        p p f
region          box block 0 10 0 10 0 30 units box
create_box      2 box bond/types 1 extra/bond/per/atom 2 extra/special/per/atom 2
molecule        tmpl w165mc_pour_molfrac_dimer.mol w165mc_pour_molfrac_single.mol w165mc_pour_molfrac_trimer.mol
pair_style      lj/cut 1.12246
pair_coeff      * * 1.0 1.0
bond_style      harmonic
bond_coeff      1 100.0 1.0
mass            * 1.0
fix             1 all nve
fix             g all gravity 1.0 vector 0 0 -1
region          slab block 1 9 1 9 12 20 units box
fix             2 all pour 40 0 4767548 vol 0.2 10 region slab mol tmpl molfrac 0.25 0.25 0.5
thermo_style    custom step atoms pe
thermo_modify   format float %.15g
thermo          40
run             200
