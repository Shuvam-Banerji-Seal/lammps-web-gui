# oracle: pair_style meam/sw/spline with the single-element Ti.meam.sw.spline file, fcc 2x2x2 cell with displaced atoms and velocities, 60 steps of nve
# oracle-potentials: Ti.meam.sw.spline
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           metal
atom_style      atomic
lattice         fcc 4.0
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box
mass            1 47.867
variable        dx atom 0.05*sin(1.3*x+0.7*y)
variable        dy atom 0.05*cos(0.9*y-0.4*z)
variable        dz atom 0.05*sin(1.1*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.02*sin(id)
variable        vy atom 0.02*cos(2*id)
variable        vz atom 0.02*sin(3*id)
velocity        all set v_vx v_vy v_vz
pair_style      meam/sw/spline
pair_coeff      * * Ti.meam.sw.spline Ti
timestep        0.001
fix             1 all nve
thermo_style    custom step pe press etotal
thermo_modify   format float %.15g norm no
thermo          10
run             60
