# oracle: fix move transrot with update dipole (atom_style hybrid sphere dipole) in units lattice (lattice sc 0.8), a 27-atom cluster rotating through the lower periodic boundaries while a separate cluster runs fix nve under lj/cut (cutoff reaching the moving cluster's images); sphere omega and dipoles checked through property/atom checksums
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           lj
atom_style      hybrid sphere dipole
lattice         sc 0.8
region          box block 0 10 0 10 0 10
create_box      2 box
region          cl block 0.5 3.5 0.5 3.5 0.5 3.5
region          far block 5.5 8.5 5.5 8.5 5.5 8.5
create_atoms    1 region cl
create_atoms    1 region far
group           mover region cl
group           rest region far
set             group mover type 2
set             group all dipole 1.0 0.5 0.2
set             group all diameter 1.0
set             group all density 1.0
variable        vx atom 0.1*sin(id)
variable        vy atom 0.1*cos(2*id)
variable        vz atom 0.05*sin(3*id)
velocity        rest set v_vx v_vy v_vz
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0
fix             1 mover move transrot -0.3 -0.2 -0.1 2.0 2.0 2.0 0.2 0.3 1.0 4.0 update dipole
fix             2 rest nve
compute         p all property/atom omegax omegay omegaz mux muy muz
variable        a1 atom c_p[1]*(1+0.1*id)
variable        a2 atom c_p[2]*(1+0.2*id)
variable        a3 atom c_p[3]*(1+0.3*id)
variable        a4 atom c_p[4]*(1+0.1*id)
variable        a5 atom c_p[5]*(1+0.2*id)
variable        a6 atom c_p[6]*(1+0.3*id)
compute         r all reduce sum v_a1 v_a2 v_a3 v_a4 v_a5 v_a6
timestep        0.005
thermo_style    custom step pe ke c_r[1] c_r[2] c_r[3] c_r[4] c_r[5] c_r[6]
thermo_modify   format float %.15g norm no
thermo          20
run             200
