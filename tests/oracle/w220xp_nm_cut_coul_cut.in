# oracle: pair nm/cut/coul/cut 2.5 3.0 on charges +1/-1 (per-pair cutoffs for 1 2), 216 atoms NVE 200 steps
# oracle-compare: thermo=all atoms=all rel=1e-12 abs=1e-13
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 8.8e-13, atoms 3.3e-13.
units        lj
boundary     p p p
atom_style   charge
lattice      sc 0.5
region       box block 0 6 0 6 0 6
create_box   2 box
create_atoms 1 box
set          group all type/fraction 2 0.5 4321
set          type 1 charge 1.0
set          type 2 charge -1.0
mass         * 1.0
velocity     all create 1.0 4242
timestep     0.002
fix          1 all nve
pair_style   nm/cut/coul/cut 2.5 3.0
pair_coeff   1 1 1.0 1.1 8 4
pair_coeff   1 2 0.7 1.2 8 6 2.4 2.9
pair_coeff   2 2 0.8 1.0 9 6
thermo_style custom step pe evdwl ecoul elong ke press pxx pyy pzz pxy pxz pyz
thermo_modify format float %.15g
thermo       20
run          200
