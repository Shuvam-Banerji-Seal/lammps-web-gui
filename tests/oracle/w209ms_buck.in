# oracle: pair_style buck/coul/msm 7.0 8.0 with pair_modify shift yes (native offset A exp(-rc/rho) - C/rc^6) and kspace_style msm order 6, mesh 8 8 8, cutoff/adjust no, pressure/scalar no (the virial tensor), rocksalt ions, NVE, 40 steps.
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 1.5e-12, atoms 1.9e-14.
units           metal
atom_style      charge
lattice         fcc 5.64
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
lattice         fcc 5.64 origin 0.5 0.0 0.0
create_atoms    2 box
mass            1 22.99
mass            2 35.45
set             type 1 charge 1.0
set             type 2 charge -1.0
variable        dx atom 0.12*sin(0.53*x+0.21*y)
variable        dy atom 0.12*cos(0.37*y-0.19*z)
variable        dz atom 0.12*sin(0.29*z+0.41*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 2.0*sin(0.7*x+0.3*z)
variable        vy atom 2.0*cos(0.5*y+0.2*x)
variable        vz atom 2.0*sin(0.4*z-0.6*y)
velocity        all set v_vx v_vy v_vz units box
velocity        all zero linear
pair_style      buck/coul/msm 7.0 8.0
pair_coeff      1 1 488.0 0.30 1.0
pair_coeff      1 2 1254.0 0.30 0.0
pair_coeff      2 2 3485.0 0.30 69.0 6.5
pair_modify     shift yes
kspace_style    msm 1.0e-4
kspace_modify   order 6 mesh 8 8 8 cutoff/adjust no pressure/scalar no
timestep        0.001
fix             1 all nve
thermo_style    custom step temp pe evdwl ecoul elong etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          10
run             40
