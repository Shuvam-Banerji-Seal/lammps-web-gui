# oracle: set dipole/random (3d, Dlen 1.5) on a 256-atom fcc lattice; the moments are summed in thermo, run 0
# oracle-compare: thermo=all atoms=all
units           lj
atom_style      dipole
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
mass            1 1.0
set             group all dipole/random 4321 1.5
compute         mu all property/atom mux muy muz
compute         msq all reduce sumsq c_mu[1] c_mu[2] c_mu[3]
compute         msum all reduce sum c_mu[1] c_mu[2] c_mu[3]
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
neighbor        0.3 bin
neigh_modify    every 20 delay 0 check no
thermo_style    custom step pe c_msq[1] c_msq[2] c_msq[3] c_msum[1] c_msum[2] c_msum[3]
thermo_modify   format float %.15g
thermo          1
run             0
