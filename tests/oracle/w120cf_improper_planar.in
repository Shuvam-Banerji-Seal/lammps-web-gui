# oracle: improper_style harmonic on chains held near planar (chi from 0.003 to 0.3 deg), static forces and energy after run 0; the older Blondel-Karplus gradient differed from native's cos-based force by rounding amplified near planar (1/sin)
# oracle-inputs: w120cf_improper_planar.data
# oracle-compare: thermo=all atoms=all rel=1e-12 abs=1e-12 atomrel=1e-10
units           real
atom_style      molecular
bond_style      harmonic
improper_style  harmonic
pair_style      zero 5.0
read_data       w120cf_improper_planar.data
pair_coeff      * *
bond_coeff      1 300.0 1.1
improper_coeff  1 150.0 10.0
thermo_style    custom step pe ebond eimp etotal pxx pyy pzz
thermo_modify   format float %.15g
run             0
