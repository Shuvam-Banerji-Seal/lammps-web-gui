# oracle: pouring spheres into a rotating box of line segments made by fix surface/global (in.line.gran.global cut down: 30 spheres poured, 1000 steps; 2d, molecule lines, fix_modify move rotate)
# oracle-note: stopped at step 1000 (cut-down length); the spheres reach the rotating lines from about step 700 on. Measured: the same case run to 1200 steps has per-atom error 6.6e-8 and to 2000 steps 3e-4 in the thermo rows; the cause of the late growth is not identified (see the report).
# oracle-inputs: w127gsg_surf.line
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# oracle-measured: max relative error (native fixture vs engine, scale max(1,|LAMMPS|)): thermo 9.8e-13, per-atom 1.6e-9 (measured with tests/fixtures/oracle, 2026-10-13)
units           lj
atom_style      sphere
boundary        f f p
dimension       2
comm_modify     vel yes

region          box block -15 15 -15 15 -0.5 0.5 units box
create_box      2 box

pair_style      granular
pair_coeff      * * hooke 4000.0 100.0 &
                    tangential linear_history 1000.0 1.0 0.5 &
                    damping mass_velocity

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

molecule        lines w127gsg_surf.line

fix             20 all surface/global input mol lines &
                model * * granular hooke 4000.0 100.0 &
                    tangential linear_history 1000.0 1.0 0.5 &
                    damping mass_velocity

fix_modify      20 move * rotate 0 0 0 0 0 1 25

fix             2 all nve/sphere
fix             3 all gravity 1.0 vector 0 -1 0

region          slab block -3 3 -2 2 -0.5 0.5 units box
fix             ins all pour 30 1 4767548 vol 0.4 10 &
                diam one 1.0 region slab

fix             10 all enforce2d

timestep        0.005

compute         1 all temp
compute_modify  1 dynamic/dof yes

compute         2 all temp/sphere
compute_modify  2 dynamic/dof yes

thermo_style    custom step atoms temp c_1 c_2 press
thermo_modify   format float %.15g lost ignore
compute_modify  thermo_temp dynamic/dof yes
thermo          100

run             1000
