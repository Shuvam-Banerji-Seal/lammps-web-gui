# oracle: pair lubricateU with flaglog 0 (no log terms), flagHI 1, flagVF 0, mu 1.5, cutinner 2.01, cutoff 2.5, gdot 0.01 on 64 spheres (diameter 2), fix nve/noforce, 20 steps
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 1.4e-15, atoms 2.2e-19.
# native: installed lmp (b332f28)
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      sphere
boundary        p p p
lattice         sc 0.072338
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
displace_atoms  all random 0.1 0.1 0.1 4711 units box
set             type 1 diameter 2.0
set             type 1 mass 4.18879
velocity        all create 0.5 87287 loop geom
comm_modify     vel yes
pair_style      lubricateU 1.5 0 2.01 2.5 0.01 1 0
pair_coeff      * *
fix             1 all nve/noforce
timestep        0.05
thermo_style    custom step temp press atoms
thermo_modify   format float %.15g
thermo          5
run             20
