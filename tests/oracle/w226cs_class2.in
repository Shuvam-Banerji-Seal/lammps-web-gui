# oracle: lj/class2/coul/long/cs (core-shell dimers), ewald, table 0
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 8.9e-14, atoms 2.5e-14.
# oracle-inputs: w226cs_coreshell.data
units           real
atom_style      full
read_data       w226cs_coreshell.data
pair_style      lj/class2/coul/long/cs 8.0
pair_coeff      * * 0.05 2.5
bond_style      harmonic
bond_coeff      1 60.0 0.0
bond_coeff      2 25.0 0.0
special_bonds   lj/coul 0.0 0.0 1.0
pair_modify    table 0
kspace_style    ewald 1.0e-6
timestep        0.1
velocity        all create 300.0 4928 mom yes rot no
fix             1 all nve
thermo_style    custom step pe ecoul elong evdwl ke press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          20
run             100
