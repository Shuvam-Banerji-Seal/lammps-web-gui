# oracle: Ewald slab geometry (boundary p p f, kspace_modify slab 3.0), net charge, explicit kmax/ewald
units           real
atom_style      charge
boundary        p p f
lattice         sc 3.2
region          box block 0 5 0 5 0 4 units lattice
create_box      2 box
region          film block INF INF INF INF 0.5 3.5 units lattice
create_atoms    1 region film
group           odd id 1:200:2
set             group odd type 2
mass            * 18.0
set             type 1 charge 0.5
set             type 2 charge -0.5
variable        dz atom 0.1*sin(0.4*x+0.3*y)
displace_atoms  all move 0.0 0.0 v_dz units box
variable        vx atom 0.002*sin(0.6*x+0.2*z)
variable        vy atom 0.002*cos(0.5*y+0.3*x)
variable        vz atom 0.001*sin(0.4*z-0.5*y)
velocity        all set v_vx v_vy v_vz units box
pair_style      lj/cut/coul/long 6.0
pair_coeff      * * 0.15 2.9
pair_modify     table 0
kspace_style    ewald 1.0e-5
kspace_modify   gewald 0.4 kmax/ewald 7 7 16 slab 3.0
fix             1 all nve
thermo_style    custom step temp pe evdwl ecoul elong etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          10
run             30
