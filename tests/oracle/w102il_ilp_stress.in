# oracle: pair_style hybrid/overlay ilp/graphene/hbn 16.0 1 - hBN/graphene bilayer (1440 atoms, the example's data file, displaced at random by up to 0.05 A, B N C mapping, no other style), tap on, 10 NVE steps; compute stress/atom NULL pair (the per-atom virial of the pair style), summed over the atoms by compute reduce: c_sr[1..6]
# measured (engine vs native, black box; rel over |value| >= 1e-6; per-atom scale max(1,|value|)): thermo max abs 1.3e-7 (the c_sr sums are about 5e7), max rel 2.6e-12; per-atom max scaled 1.4e-14
# oracle-inputs: w102il_ilp_grhbn.data
# oracle-potentials: BNCH.ILP
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           metal
boundary        p p p
atom_style      full
read_data       w102il_ilp_grhbn.data
displace_atoms   all random 0.05 0.05 0.05 4711 units box
mass            1 10.8110
mass            2 14.0067
mass            3 12.0107
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
pair_style      hybrid/overlay ilp/graphene/hbn 16.0 1
pair_coeff      * * ilp/graphene/hbn BNCH.ILP B N C
compute         1 all pair ilp/graphene/hbn
compute         st all stress/atom NULL pair
compute         sr all reduce sum c_st[1] c_st[2] c_st[3] c_st[4] c_st[5] c_st[6]
timestep        0.001
thermo_style    custom step pe etotal press c_1[1] c_1[2] c_sr[1] c_sr[2] c_sr[3] c_sr[4] c_sr[5] c_sr[6]
thermo_modify   format float %.15g
thermo          5
run             0
velocity        all create 300.0 12345 dist gaussian mom yes rot yes
fix             1 all nve
run             10
