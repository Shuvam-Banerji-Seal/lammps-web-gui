# oracle: fix atom/swap with fix langevin, fix efield and fix spring/self: each energy evaluation of the swaps runs the
# pre_force and post_force fixes (energy_full: langevin draws its random forces there, the fix energies come from the
# same call), binary lj/cut liquid with charges
# oracle-compare: thermo=all atoms=all
units           lj
atom_style      charge
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
set             type 1 type/fraction 2 0.5 4242
set             type 1 charge 0.1
set             type 2 charge 0.1
mass            1 1.0
mass            2 2.5
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
pair_coeff      1 2 0.8 1.05
pair_coeff      2 2 0.6 0.95
velocity        all create 1.0 87287 loop geom
fix             integ all nve
fix             lan all langevin 1.0 1.0 0.5 48279
fix             ef all efield 0.2 0.0 0.0
fix_modify      ef energy yes
fix             ss all spring/self 0.5
fix_modify      ss energy yes
fix             sw all atom/swap 5 20 12345 1.0 types 1 2 ke no
thermo_style    custom step pe ke temp f_sw[1] f_sw[2] f_ef f_ss
thermo_modify   format float %.15g
thermo          5
run             40
