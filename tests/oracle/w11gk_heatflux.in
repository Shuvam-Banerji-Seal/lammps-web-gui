# oracle: LJ fluid, compute heat/flux from ke/atom, pe/atom and stress/atom NULL virial: the six components
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 1.44 87287 loop all
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0 2.5
timestep        0.002
fix             1 all nve
compute         myKE all ke/atom
compute         myPE all pe/atom
compute         myStress all stress/atom NULL virial
compute         flux all heat/flux myKE myPE myStress
thermo_style    custom step temp pe c_flux[1] c_flux[2] c_flux[3] c_flux[4] c_flux[5] c_flux[6]
thermo_modify   format float %.15g
thermo          10
run             100
