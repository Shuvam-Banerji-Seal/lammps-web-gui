# oracle: general triclinic custom lattice (triclinic/general), create_box NULL and create_atoms box
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      atomic
lattice         custom 1.0 a1 1.0 0.5 0.2 a2 0.3 1.0 0.0 a3 0.1 0.2 1.1 &
                basis 0.0 0.0 0.0 basis 0.5 0.5 0.5 triclinic/general
create_box      1 NULL 0 3 0 3 0 3
create_atoms    1 box
mass            1 1.0
variable        dx atom 0.06*sin(2.1*x+0.7*y)
variable        dy atom 0.06*cos(1.3*y+1.1*z)
variable        dz atom 0.06*sin(0.9*z+1.7*x)
displace_atoms  all move v_dx v_dy v_dz units box
velocity        all set 0.3 -0.2 0.15 units box
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
fix             1 all nve
thermo_style    custom step temp pe etotal press cella cellb cellc cellalpha cellbeta cellgamma
thermo_modify   format float %.15g
thermo          10
run             40
