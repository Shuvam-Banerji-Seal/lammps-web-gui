# oracle: threebody/table with the spce.3b symmetric table (1-1-1), a 4-atom cluster (nearer neighbour first and second) with forces only
# oracle-inputs: w49mt_spce.3b w49mt_1-1-1.table
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units real
atom_style atomic
boundary f f f
lattice none 1.0
region b block -60 60 -60 60 -60 60
create_box 1 b
create_atoms 1 single 0 0 0 units box
create_atoms 1 single 2.9 0.0 0.0 units box
create_atoms 1 single -1.2 2.6 0.4 units box
create_atoms 1 single 0.8 -2.1 1.9 units box
mass 1 18.0
pair_style threebody/table
pair_coeff * * w49mt_spce.3b type
thermo_style custom step pe
thermo_modify format float %.15g
run 0
