# oracle: fix atom/swap on a dynamic group (the atoms whose scaled |vx| has a fractional part above 0.5, re-evaluated
# every 2 steps): only the group's atoms are swap candidates; binary lj/cut fcc liquid with fix nve
# oracle-compare: thermo=all atoms=all
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
set             type 1 type/fraction 2 0.5 4242
mass            1 1.0
mass            2 2.5
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
pair_coeff      1 2 0.8 1.05
pair_coeff      2 2 0.6 0.95
velocity        all create 1.0 87287 loop geom
variable        up atom (abs(vx)*1e2-floor(abs(vx)*1e2))>0.5
group           dyn dynamic all var up every 2
variable        ndyn equal count(dyn)
fix             integ all nve
fix             sw dyn atom/swap 5 20 12345 1.0 types 1 2 ke no
variable        is2 atom type==2
compute         n2 dyn reduce sum v_is2
thermo_style    custom step pe ke temp f_sw[1] f_sw[2] c_n2 v_ndyn
thermo_modify   format float %.15g
thermo          5
run             40
