compute         p all property/atom tqx tqy tqz
variable        t1 atom c_p[1]*(1+0.1*id)
variable        t2 atom c_p[2]*(1+0.1*id)
variable        t3 atom c_p[3]*(1+0.1*id)
variable        t4 atom c_p[1]*(1+0.2*id)+c_p[2]*(2+0.3*id)
variable        t5 atom c_p[3]*(1+0.4*id)-c_p[1]*(0.5+0.1*id)
compute         r all reduce sum v_t1 v_t2 v_t3 v_t4 v_t5
timestep        0.002
thermo_style    custom step atoms pe evdwl press c_r[1] c_r[2] c_r[3] c_r[4] c_r[5]
thermo_modify   format float %.15g norm no
run             0
set             atom 4 quat -0.4161032521 0.8316713916 -0.3676693895 96.09994073
displace_atoms  all move 0.05 0.1 -0.08 units box
run             0
set             atom 2 quat 0.1340855543 0.9095754566 0.393311013 19.48149557
run             0
