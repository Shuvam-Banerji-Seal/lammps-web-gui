# oracle: LJ melt of 200 steps with restart 25; writing a restart forces a neighbor rebuild on that step
# oracle-compare: thermo=all atoms=none rel=1e-9 abs=1e-12
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 5 0 5 0 5
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 3.0 87287
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
neighbor        0.3 bin
neigh_modify    every 10 delay 0 check yes
fix             1 all nve
restart         25 w40core.*.restart
thermo_style    custom step temp pe ke etotal press
thermo_modify   format float %.15g
thermo          25
run             200
