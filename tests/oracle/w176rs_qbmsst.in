# oracle: fix qbmsst state (omega, e0, v0, p0, T_qm) survives write_restart/read_restart: 20 steps, write_restart, clear, read_restart, fix qbmsst re-specified, 20 more steps. Native: built from b332f28 with PKG_QTB (the installed binary has no QTB).
# oracle-compare: thermo=all atoms=all rel=1e-8
units           lj
atom_style      atomic
boundary        p p p
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 0.8 4928 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
timestep        0.002
fix             1 all nve
fix             shock all qbmsst z 1.5 q 10.0 tscale 0.1 damp 1.0 f_max 4.0 N_f 20 seed 35082 eta 1.0 beta 5 T_init 0.8
thermo_style    custom step temp press econserve vol lz pzz f_shock[1] f_shock[2] f_shock[3] f_shock[4] f_shock[5]
thermo_modify   format float %.15g
thermo          5
run             20
write_restart   w176rs_qbmsst.restart
clear
read_restart    w176rs_qbmsst.restart
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
fix             1 all nve
fix             shock all qbmsst z 1.5 q 10.0 tscale 0.1 damp 1.0 f_max 4.0 N_f 20 seed 35082 eta 1.0 beta 5 T_init 0.8
thermo_style    custom step temp press econserve vol lz pzz f_shock[1] f_shock[2] f_shock[3] f_shock[4] f_shock[5]
thermo_modify   format float %.15g
thermo          5
run             20
