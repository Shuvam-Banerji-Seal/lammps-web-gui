# oracle: compute chunk/atom bin/cylinder along x, y and z in lattice, box and reduced units, with bound, discard mixed/yes, pbc yes; fix ave/chunk density/number, density/mass (metal units: mv2d), vx and temp on the cylinder bins (norm sample and norm all), and compute property/chunk coord1 coord2
# oracle-files: cyl.txt cylall.txt
units           metal
atom_style      atomic
boundary        p p p
lattice         fcc 3.615
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
group           odd id 1:256:2
set             group odd type 2
mass            1 63.55
mass            2 58.69
variable        dx atom 0.1*sin(0.5*x+0.3*y)
variable        dy atom 0.1*cos(0.4*y-0.45*z)
variable        dz atom 0.1*sin(0.6*z+0.2*x)
displace_atoms  all move v_dx v_dy v_dz units box
velocity        all create 300.0 4928459 loop geom
pair_style      lj/cut 5.0
pair_coeff      1 1 0.409 2.338
pair_coeff      2 2 0.52 2.28
pair_coeff      1 2 0.46 2.31
timestep        0.001
fix             1 all nve
compute         cc all chunk/atom bin/cylinder z lower 1.0 2 2 0.0 1.8 4 units lattice
compute         cb all chunk/atom bin/cylinder x center 3.0 7 7 1.0 6.0 5 units box bound x 2.0 12.0
compute         cr all chunk/atom bin/cylinder y lower 0.2 0.0 0.0 0.05 0.45 3 units reduced pbc yes
compute         cd odd chunk/atom bin/cylinder z upper 3.0 3 3 2.0 5.0 3 units box discard yes
compute         rs all reduce sum c_cc c_cb c_cr c_cd
compute         pc all property/chunk cc coord1 coord2 count
fix             2 all ave/chunk 5 2 10 cc density/number density/mass vx temp norm sample format " %.12g" file cyl.txt
fix             3 all ave/chunk 5 2 10 cb density/mass vz norm all format " %.12g" file cylall.txt
thermo_style    custom step temp pe etotal c_cc c_cb c_cr c_cd c_rs[1] c_rs[2] c_rs[3] c_rs[4] c_pc[6][1] c_pc[6][2] c_pc[11][3]
thermo_modify   norm no format float %.15g
thermo          10
run             50
