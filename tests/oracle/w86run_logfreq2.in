# oracle: step-sequence variables logfreq, logfreq2, stagger, stride, stride2 (variable.html); non-integer arguments truncate (black box)
# oracle-compare: thermo=all rel=1e-12 abs=1e-14
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box
mass            1 1.0
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
variable        b equal logfreq2(1,3,2)
variable        e equal logfreq2(1,3,10)
variable        f equal logfreq2(1.5,3,10)
variable        g equal logfreq(5.5,2,10)
variable        s equal stagger(5.5,2)
variable        t equal stride(2.7,20,5)
variable        u equal stride2(2.7,20,5,7.5,12,3)
thermo_style    custom step v_b v_e v_f v_g v_s v_t v_u
thermo_modify   format float %.15g
thermo          1
run             40
