# oracle: type labels in a data file (Atom, Bond, Angle, Dihedral, Improper Type Labels) used by Masses, Atoms, Bonds, Angles, Dihedrals, Impropers and the coefficient commands by label; set/group by label; run
# oracle-inputs: w90label_data.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           real
atom_style      full
read_data       w90label_data.data
pair_style      lj/cut 6.0
bond_style      harmonic
angle_style     harmonic
dihedral_style  harmonic
improper_style  harmonic
pair_coeff      C C 0.001 3.40
pair_coeff      C H 0.001 2.50
pair_coeff      H H 0.001 2.20
pair_modify     mix arithmetic
bond_coeff      CH 300.0 1.10
bond_coeff      CC 250.0 1.50
angle_coeff     HCH 40.0 109.5
dihedral_coeff  ddd 1.0 1 2
improper_coeff  iii 10.0 0.0
mass            C 12.011
group           hyd type H
set             type C type 1
set             group hyd type H
timestep        0.5
fix             1 all nve
thermo_style    custom step temp pe ebond eangle edihed eimp evdwl etotal press
thermo_modify   format float %.15g
thermo          5
run             20
