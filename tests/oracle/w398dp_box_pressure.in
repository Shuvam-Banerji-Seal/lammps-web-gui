# oracle: fix deform/pressure box pressure 1.0 0.05 with x erate 0.05 on an fcc LJ liquid (all three lengths follow the scalar pressure, x also strains), remap x; compute temp/deform reads the box rates
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# Measured with native LAMMPS: engine vs native thermo 5.2e-13, atoms 1.5e-11.
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 4 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 1.44 87287 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
timestep        0.005
fix             1 all nve
fix             2 all deform/pressure 1 x erate 0.05 box pressure 1.0 0.05
compute         tdef all temp/deform
thermo_style    custom step temp c_tdef press lx ly lz vol
thermo_modify   format float %.15g
thermo          20
run             300
