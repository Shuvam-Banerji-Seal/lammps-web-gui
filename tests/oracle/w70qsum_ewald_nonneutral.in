# oracle: fix adapt atom charge on the +1 atoms only (scale no, ramp 1 to 2; net charge becomes non-zero) with kspace ewald: the background term follows the net charge at each step
# oracle-compare: thermo=all atoms=all rel=1e-5 abs=1e-8
units           lj
atom_style      charge
lattice         sc 0.8
region          b block 0 4 0 4 0 4
create_box      2 b
create_atoms    1 box
mass            * 1.0
set             group all charge 1.0
group           odd id 1:64:2
group           even id 2:64:2
set             group odd type 2
set             group odd charge -1.0
variable        dx atom 0.1*sin(1.3*x+0.7*y)
variable        dy atom 0.1*cos(0.9*y-1.1*z)
variable        dz atom 0.1*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.5*sin(1.7*x+2.3*y+0.7*z)
variable        vy atom 0.5*cos(2.1*x-1.1*y+0.3*z)
variable        vz atom 0.5*sin(0.5*x+1.9*z+1.3*y)
velocity        all set v_vx v_vy v_vz units box
timestep        0.002
thermo_style    custom step pe ecoul elong press
thermo_modify   format float %.15g
thermo          10
pair_style      lj/cut/coul/long 2.5
pair_coeff      * * 0.5 1.0
kspace_style ewald 1e-5
variable qf equal ramp(1.0,2.0)
fix 1 even adapt 1 atom charge v_qf scale no
fix 2 all nve
run 100
