# oracle-inputs: w107meam_fetic_lib.meam w107meam_fetibr.meam
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-12
# oracle: multi-element MEAM (Fe, Ti) on an hcp Ti crystal with five Fe atoms: the Fe-Ti pair (b2, nn2 = 1) and the hcp Ti reference (fully screened); pe and per-atom forces
# Measured (engine vs native LAMMPS, black box): pe and per-atom forces agree; per-atom max relative error 2e-11.
units           metal
atom_style      atomic
boundary        p p p
lattice         hcp 2.92
region          box block 0 3 0 3 0 3 units lattice
create_box      2 box
create_atoms    1 box
set atom 1 type 2
set atom 5 type 2
set atom 9 type 2
set atom 20 type 2
set atom 33 type 2
mass            1 47.880
mass            2 55.847
pair_style      meam
pair_coeff      * * w107meam_fetic_lib.meam Fe Ti w107meam_fetibr.meam Ti Fe
thermo_style    custom step pe etotal
thermo_modify   format float %.15g norm no
thermo          1
run             0
