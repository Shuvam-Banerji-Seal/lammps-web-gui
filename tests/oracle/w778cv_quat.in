# oracle: the quaternion orientation component of fix colvars (colvar::orientation): a harmonic restraint on the
#   optimal rotation of 6 atoms (centre (2 0 0 0), normalized by apply_constraints; quaternion dist2 and dist2_grad;
#   the force reaches the atoms through project_force_to_C_from_dxdq and project_force_to_group2) with
#   outputAppliedForce, and a second orientation with closestToQuaternion (0 0 1 0) under a no-grid metadynamics bias
#   (quaternion hills in the state). The colvar values and forces print as "( q0 , q1 , q2 , q3 )".
# Measured with native LAMMPS: files equal to every printed digit to step 20, then within 8.5e-15 (LJ trajectory bits).
# oracle-inputs: w778cv_quat.colvars
# oracle-files: oq.colvars.traj oq.colvars.state
# oracle-compare: thermo=all atoms=all rel=1e-10 filerel=1e-10
units           lj
atom_modify     map array
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
set             atom 1*128 type 2
mass            1 1.0
mass            2 2.5
velocity        all create 1.5 87287 loop geom
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0 2.5
neighbor        0.3 bin
neigh_modify    every 1 delay 0 check yes
fix             1 all nve
fix             2 all colvars w778cv_quat.colvars output oq
fix_modify      2 energy yes
thermo_style    custom step temp pe etotal f_2 f_2[1][1] f_2[1][2] f_2[1][3] f_2[1][4] f_2[2][1] f_2[2][3]
thermo_modify   format float %.15g
thermo          5
run             50
run             30
