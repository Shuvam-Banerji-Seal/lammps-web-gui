# oracle: fix deposit gaussian: positions drawn from a normal distribution about (xmid, ymid, zmid) in lattice units (sigma scaled by the x spacing) until inside the region, 2 gaussian draws per pair, then fix nve
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      atomic
boundary        p p f
lattice         fcc 0.8442
region          box block 0 6 0 6 0 12
create_box      2 box
region          slab block 0 6 0 6 0 1.5
create_atoms    1 region slab
mass            * 1.0
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0
neigh_modify    every 1 delay 0 check yes
region          top block 0 6 0 6 8 10
group           sub type 1
group           add type 2
fix             0 sub setforce 0 0 0
fix             1 add deposit 20 2 25 4321 region top near 0.9 gaussian 3.0 3.0 9.0 0.8 vz -1.0 -0.5
fix             2 add nve
thermo_style    custom step atoms temp pe ke press f_1
thermo_modify   format float %.15g lost ignore
thermo          50
run             500
