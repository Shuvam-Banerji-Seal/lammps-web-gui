# oracle: reset_timestep without the time keyword: the clock runs on from the new step; a smaller step restarts it at 0
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 1.0 4928 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
timestep        0.005
fix             1 all nve
thermo_style    custom step time temp
thermo_modify   format float %.15g
thermo          1
run             2
reset_timestep  100
run             1
reset_timestep  50
run             1
reset_timestep  7 time 3.5
run             1
reset_timestep  10
run             1
reset_timestep  0
run             1
