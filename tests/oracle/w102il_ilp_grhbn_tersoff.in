# oracle: pair_style hybrid/overlay tersoff ilp/graphene/hbn 16.0 coul/shield 16.0 - graphene on hBN bilayer (1440 atoms, the example's data file, NULL element mapping, no REBO), 10 NVE steps; compute pair c_1, c_2[1], c_2[2], c_3
# measured (engine vs native, black box; rel over |value| >= 1e-6; per-atom scale max(1,|value|)): thermo max abs 1.3e-10, max rel 1.7e-13; per-atom max scaled 2.1e-12
# oracle-inputs: w102il_ilp_grhbn.data
# oracle-potentials: BNC.tersoff BNCH.ILP
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           metal
boundary        p p p
atom_style      full
read_data       w102il_ilp_grhbn.data
mass            1 10.8110
mass            2 14.0067
mass            3 12.0107
group           hBN molecule 1
group           gr molecule 2
pair_style      hybrid/overlay tersoff ilp/graphene/hbn 16.0 coul/shield 16.0
pair_coeff      * * tersoff BNC.tersoff B N NULL
pair_coeff      * * ilp/graphene/hbn BNCH.ILP B N C
pair_coeff      1 1 coul/shield 0.70
pair_coeff      1 2 coul/shield 0.69498201415576216335
pair_coeff      2 2 coul/shield 0.69
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
compute         1 all pair tersoff
compute         2 all pair ilp/graphene/hbn
compute         3 all pair coul/shield
timestep        0.001
thermo_style    custom step pe etotal press c_1 c_2[1] c_2[2] c_3
thermo_modify   format float %.15g
thermo          5
run             0
velocity        all create 300.0 12345 dist gaussian mom yes rot yes
fix             1 all nve
run             10
