# oracle: fix gravity disable — the atoms get no acceleration; the scalar and fix_modify energy are 0
# oracle-compare: thermo=all atoms=all rel=1e-8
units           lj
atom_style      atomic
boundary        p p p
lattice         fcc 0.8442
region          box block 0 2 0 2 0 2
create_box      2 box
create_atoms    1 box
group           odd id 1:32:2
set             group odd type 2
mass            1 1.0
mass            2 1.5
variable        vx atom 0.8*sin(0.9*x+0.4*z)
variable        vy atom 0.8*cos(0.6*y+0.8*x)
variable        vz atom 0.8*sin(0.7*z-0.3*y)
velocity        all set v_vx v_vy v_vz units box
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
pair_coeff      2 2 0.8 1.05
timestep        0.002
fix             1 all nve
fix             2 all gravity 0.5 vector 0.2 0.0 -1.0 disable
fix_modify      2 energy yes
thermo_style    custom step temp pe etotal press pxx pyy pzz pxy pxz pyz f_2
thermo_modify   format float %.15g
thermo          10
run             50
