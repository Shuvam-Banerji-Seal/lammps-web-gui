# oracle: compute plasticity/atom with pair peri/eps on the 6x6x6 cell block with sinusoidal initial velocities (the w107 setup, yield 1e9): the per-atom lambdaValue is summed and maxed in thermo and dumped per atom
# oracle-files: w240pl_block.dump
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=0 filerel=1e-8
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 6.7e-12, atoms 1.1e-12.
units           si
boundary        s s s
atom_style      peri
atom_modify     map array
neighbor        0.0010 bin
lattice         sc 0.0005
region          target block 0 6 0 6 0 6 units lattice
create_box      1 target
create_atoms    1 box
pair_style      peri/eps
pair_coeff      * * 14.9e9 14.9e9 0.0015001 0.0005 0.25 10.0e8
set             group all density 2200
set             group all volume 1.25e-10
variable        vx atom 60.0*sin(2000*y+0.3)
variable        vy atom 60.0*cos(2500*z)
variable        vz atom 60.0*sin(1800*x)
velocity        all set v_vx v_vy v_vz units box
fix             1 all nve
compute         1 all plasticity/atom
compute         2 all reduce sum c_1
compute         3 all reduce max c_1
compute         4 all damage/atom
compute         5 all reduce sum c_4
thermo_style    custom step pe ke etotal c_2 c_3 c_5
thermo_modify   format float %.15g norm no
timestep        1.0e-7
thermo          10
dump            d all custom 50 w240pl_block.dump id c_1
dump_modify     d sort id format float %.15g
run             100
