# Wave 41: cut-down of examples/ttm/in.ttm.cascade (bcc Fe, eam/fs, fix ttm/cascade with the cutoff keyword, set 1800):
# 4x4x4 bcc cells (128 atoms), a 4x4x4 electron grid, the example's positional parameters, own C_e and kappa_e
# tables, and one fast atom (a PKA) above v_0 so that the cutoff acts. 100 steps.
# oracle-inputs: w41ttm_ce.tab w41ttm_ke.tab
# oracle-potentials: Fe_mm.eam.fs
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
# Note: the atoms are moved 0.5 A off the lattice planes (displace_atoms below): an atom on a cell face takes its cell
# from round-off (measured: the sign of a 1e-23 residual decides the cell), so the grid would not be reproduced.
units           metal
atom_style      atomic
boundary        p p p

variable        latc  equal 2.87
lattice         bcc ${latc}
region          sim_box block -2 2 -2 2 -2 2 units lattice
create_box      1 sim_box
create_atoms    1 region sim_box
displace_atoms all move 0.5 0.5 0.5 units box

mass            1 55.845

pair_style      eam/fs
pair_coeff      * * Fe_mm.eam.fs Fe

neighbor        2.0 bin
neigh_modify    every 5 delay 0 check yes

fix             1 all nve

group           pka id 1
velocity        pka set 200.0 120.0 -80.0 units box

fix             twotemp all ttm/cascade 342785 1.2470e-5 1 0.005365 29.5917 47.5679 58.4613 4 4 4 set 1800.0 cetab w41ttm_ce.tab ketab w41ttm_ke.tab cutoff

timestep        0.0001
thermo          10

thermo_style    custom step temp etotal f_twotemp[1] f_twotemp[2]
                thermo_modify format float "%20.16g"

run             100
