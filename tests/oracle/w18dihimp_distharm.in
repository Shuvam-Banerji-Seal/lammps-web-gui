# oracle: improper_style distharm alone (dihedral K=0), mol_chains.data
# oracle-inputs: mol_chains.data
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           lj
atom_style      molecular
bond_style      harmonic
angle_style     harmonic
dihedral_style  cosine/squared/restricted
improper_style  distharm
pair_style      lj/cut 2.5
read_data       mol_chains.data
pair_coeff      * * 0.5 0.9
pair_coeff      1 3 0.8 1.0
bond_coeff      1 120.0 1.05
bond_coeff      2 90.0 1.1
angle_coeff     1 40.0 109.5
angle_coeff     2 25.0 120.0
dihedral_coeff  1 0.0 120
improper_coeff  1 25.0 0.15
special_bonds   lj 0.0 0.5 0.8
variable        vx atom 0.1*sin(1.3*x+0.7*y)
variable        vy atom 0.1*cos(0.9*y-0.4*z)
variable        vz atom 0.1*sin(1.1*z+0.5*x)
velocity        all set v_vx v_vy v_vz
velocity        all zero linear
timestep        0.002
fix             1 all nve
thermo_style    custom step temp pe ebond eangle edihed eimp evdwl etotal press
thermo_modify   format float %.15g norm no
thermo          10
run             50
