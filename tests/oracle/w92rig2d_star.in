# oracle: cut-down of ASPHERE/star (in.star and in.star.mp, no fix srd): two 9-sphere star molecules as fix rigid molecule in 2d with soft equilibration (fix adapt ramp), then fix rigid/small molecule; temp/sphere and erotate/sphere with 2d rigid dof
# oracle-inputs: w92rig2d_star.data
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           lj
atom_style      sphere
atom_modify     map array
dimension       2
fix             molprop all property/atom mol ghost yes
read_data       w92rig2d_star.data fix molprop NULL Molecules
set             type 1 mass 1.0
group           big type 1
velocity        big set 0.3 -0.2 0  units box
pair_style      soft 1.12
pair_coeff      1 1 0.0
pair_coeff      2 2 0.0 0.0
pair_coeff      1 2 0.0 0.0
variable        prefactor equal ramp(0,60)
fix             soft all adapt 1 pair soft a * * v_prefactor
neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes
comm_modify     cutoff 3.0
fix             1 big rigid molecule
fix             2 all enforce2d
compute         tbig all temp/sphere
compute         ers all erotate/sphere
thermo_style    custom step temp ke pe c_ers f_1 f_1[1][1] f_1[1][2] f_1[1][3] f_1[1][4] f_1[1][5] f_1[1][6] f_1[1][7] f_1[1][8] f_1[1][9] f_1[1][10] f_1[1][11] f_1[1][12]
thermo_modify   temp tbig
thermo_modify   format float %.15g
thermo          10
run             100
unfix           soft
unfix           1
fix             1 big rigid/small molecule
run             50
