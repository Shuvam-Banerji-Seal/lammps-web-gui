# oracle: dihedral_style hybrid with a charmm sub-style. Native's charmm tallies its 1-4 LJ and Coulomb through
#   force->pair->ev_tally into the pair energies (src/MOLECULE/dihedral_charmm.cpp at b332f28), outside the hybrid's
#   sum of its sub-styles' own energy (src/dihedral_hybrid.cpp); the engine's hybrid dropped them (evdwl, ecoul).
# oracle-inputs: w13dihcharmm_chains.data
# oracle-compare: thermo=all rel=1e-9 abs=1e-10
units           real
atom_style      full
read_data       w13dihcharmm_chains.data
special_bonds   charmm
bond_style      harmonic
bond_coeff      1 300.0 1.5
angle_style     harmonic
angle_coeff     1 50.0 110.0
dihedral_style  hybrid charmm harmonic
dihedral_coeff  1 charmm 0.2 1 180 1.0
dihedral_coeff  2 charmm 1.8 1 0 0.5
dihedral_coeff  3 harmonic 3.1 -1 2
pair_style      lj/charmm/coul/charmm 8.0 10.0
pair_coeff      1 1 0.1 3.0 0.05 3.5
pair_coeff      2 2 0.15 3.2 0.1 3.1
pair_coeff      3 3 0.12 3.1 0.08 3.3
timestep        0.5
velocity        all create 300.0 4928459 units box
fix             1 all nve
thermo_style    custom step temp pe edihed evdwl ecoul press
thermo_modify   format float %.15g
thermo          10
run             50
