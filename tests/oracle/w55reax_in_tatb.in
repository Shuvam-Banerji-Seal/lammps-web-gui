# oracle: LAMMPS examples/reaxff/in.reaxff.tatb (b332f28, GPL-2.0), cut down: 384-atom TATB cell, 20 steps (thermo every 5);
# the reaxff/bonds and reaxff/species fixes and the reaxff/atom compute and dumps of that example are not in this case (stage 3, refused by name)
# oracle-inputs: w55reax_tatb.data w55reax_tatb.control w55reax_ffield.reax
# oracle-compare: thermo=all atoms=all rel=1e-4 abs=1e-6 skip=v_nqeq
# measured (engine vs native): energies within 3.4e-5 relative (largest v_eqeq), pressure within 3.6e-6 (largest on the RDX rows); v_nqeq (the CG iteration count of fix qeq/reaxff) is not compared: it flips by 1-2 at the tolerance boundary, see w55reax_qeq_rdx_tight
units           real
atom_style      charge
read_data       w55reax_tatb.data
pair_style      reaxff w55reax_tatb.control
pair_coeff      * * w55reax_ffield.reax C H O N
compute reax all pair reaxff
variable eb      equal c_reax[1]
variable ea      equal c_reax[2]
variable elp     equal c_reax[3]
variable emol    equal c_reax[4]
variable ev      equal c_reax[5]
variable epen    equal c_reax[6]
variable ecoa    equal c_reax[7]
variable ehb     equal c_reax[8]
variable et      equal c_reax[9]
variable eco     equal c_reax[10]
variable ew      equal c_reax[11]
variable ep      equal c_reax[12]
variable efi     equal c_reax[13]
variable eqeq    equal c_reax[14]
neighbor        2.5 bin
neigh_modify    delay 0 every 5 check no
fix             1 all nve
fix             2 all qeq/reaxff 1 0.0 10.0 1.0e-6 reaxff
variable nqeq   equal f_2
thermo          5
thermo_style    custom step temp epair etotal press v_eb v_ea v_elp v_emol v_ev v_epen v_ecoa v_ehb v_et v_eco v_ew v_ep v_efi v_eqeq v_nqeq
thermo_modify   format float %.15g
timestep        0.0625
run             20
