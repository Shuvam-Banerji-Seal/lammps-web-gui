# oracle: fix shake with a loose tolerance (tol 1e-3, iter 5) on the SPC/E box (run 0): native gives the same step-0 values as with tol 1e-4 (two setup force sweeps, one coordinate sweep)
# oracle-inputs: w48sh_spce.data
# oracle-compare: thermo=all atoms=all
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 3.4e-13, atoms 9.2e-11.
# oracle-tolerance: same as w48sh_run0 (rel 1e-7)
units		real
atom_style	full
read_data	w48sh_spce.data
pair_style	lj/cut/coul/long 12.0 12.0
kspace_style	pppm 1.0e-4
pair_coeff	1 1 0.15535 3.166
pair_coeff	* 2 0.0000 0.0000
bond_style	harmonic
angle_style	harmonic
dihedral_style	none
improper_style	none
bond_coeff	1 1000.00 1.000
angle_coeff	1 100.0 109.47
special_bonds   lj/coul 0.0 0.0 1.0
neighbor        2.0 bin
fix             1 all shake 0.001 5 0 b 1 a 1
fix             2 all nve
thermo_style    custom step temp pe ecoul evdwl elong press
thermo_modify   format float %.15g
run             0
