# oracle: compute bond/local b1..b7 (the bond_style bpm/rotational single() extra outputs) on a stretched BPM dimer
# oracle-compare: thermo=all atoms=all
# oracle-files: w131cf_bpm_bond_extra.local
units lj
atom_style bpm/sphere
region box block -10 10 -10 10 -10 10
create_box 1 box bond/types 1 extra/bond/per/atom 2
create_atoms 1 single 0.0 0.0 0.0
create_atoms 1 single 1.2 0.1 0.0
create_bonds single/bond 1 1 2
comm_modify vel yes cutoff 2.6
pair_style zero 2.0
pair_coeff * *
special_bonds lj 0 1 1 coul 1 1 1
bond_style bpm/rotational break no smooth no
bond_coeff 1 1.0 0.2 0.01 0.01 0.0 0.0 0.0 0.0 0.2 0.04 0.002 0.002
set atom 2 vy 0.3
fix 1 all nve/bpm/sphere
compute b all bond/local b1 b2 b3 b4 b5 b6 b7
dump 1 all local 5 w131cf_bpm_bond_extra.local c_b[*]
thermo_style custom step pe ebond
thermo_modify format float %.15g norm no
thermo 5
run 20
