# oracle: RHEO Poiseuille flow (cut down, 300 steps) with fix rheo kernel wendland/c4: the kernel of every density, gradient and force term
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-13
units        lj
atom_style   rheo
dimension    2
boundary     p p p
comm_modify  vel yes

region       box block 0 12 -6 6 -0.01 0.01
create_box   2 box
lattice      sq 1.0

region       inner   block INF INF -4.5 4.5 INF INF units box
region       walls   block INF INF -4.5 4.5 INF INF units box side out

create_atoms 2 region walls
create_atoms 1 region inner

group        fluid type 1
group        rig type 2

displace_atoms fluid random 0.1 0.1 0 135414 units box

variable     rho0 equal 1.0
variable     cs equal 1.0
variable     mp equal ${rho0}/1.0
variable     zeta equal 1.0
variable     fext equal 1e-4/1.0
variable     dt_max equal  0.1*3.0/${cs}/3
variable     Dr equal 0.05*3.0*${cs}
variable     eta equal 0.1

mass         * ${mp}
set          group all rheo/rho ${rho0}
set          group all rheo/status 0
set          group rig rheo/status 1

timestep     ${dt_max}

pair_style   rheo 3.0 artificial/visc ${zeta} rho/damp ${Dr}
pair_coeff   * *

fix          1 all rheo 3.0 wendland/c4 10 shift
fix          2 all rheo/viscosity * constant ${eta}
fix          3 all rheo/pressure * linear
fix          4 rig setforce 0.0 0.0 0.0
fix          5 fluid addforce ${fext} 0.0 0.0
fix          6 all enforce2d

compute      rho all rheo/property/atom rho

thermo       50
thermo_style custom step time ke press
thermo_modify format float %.15g

run          300
