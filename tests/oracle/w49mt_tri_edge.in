# oracle: threebody/table range edges: a leg 1.85 below rmin (inside half a grid step) and a leg 2.5 with the cut
# oracle-inputs: w49mt_custom37.3b w49mt_custom.table
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units real
atom_style atomic
boundary f f f
lattice none 1.0
region b block -60 60 -60 60 -60 60
create_box 1 b
create_atoms 1 single 0 0 0 units box
create_atoms 1 single 1.85 0 0 units box
create_atoms 1 single -2.165063509461097 1.2499999999999998 0 units box
mass 1 18.0
pair_style threebody/table
pair_coeff * * w49mt_custom37.3b type
thermo_style custom step pe
thermo_modify format float %.15g
run 0
