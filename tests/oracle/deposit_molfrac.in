# oracle: fix deposit mol with a template of two molecules (a dimer and a trimer) chosen by molfrac 0.3 0.7, one selection draw per trial, then fix nve
# oracle-inputs: w26depmol_dimer.mol deposit_molfrac_trimer.mol
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      bond
boundary        p p f
region          box block 0 10 0 10 0 20
create_box      3 box bond/types 1 extra/bond/per/atom 2 extra/special/per/atom 2
molecule        two w26depmol_dimer.mol deposit_molfrac_trimer.mol
pair_style      lj/cut 2.5
pair_coeff      * * 0.0 1.0
mass            * 1.0
bond_style      harmonic
bond_coeff      1 20.0 1.0
region          slab block 0 10 0 10 15 18
fix             1 all deposit 12 0 2 24680 region slab mol two molfrac 0.3 0.7 near 1.2 vz -1.0 -0.5 units box
fix             2 all nve
thermo_style    custom step atoms temp pe ebond evdwl etotal press f_1
thermo_modify   format float %.15g
thermo          5
run             30
