# oracle: fix deposit local placement with delta, M=1, N=6, vz -0.2 and a rate
# oracle-compare: thermo=all atoms=all
units           lj
atom_style      atomic
atom_modify     map array
boundary        p p f
region          box block -10 10 -10 10 -10 10
create_box      1 box
mass            1 1.0
region          reg block 0 2 0 2 0 1 side in units box
pair_style      lj/cut 2.5
pair_coeff      * * 0.0 1.0
timestep        0.01
fix             1 all nve
fix             3 all deposit 6 1 1 4242 region reg units box local 0.5 1.5 0.6 vz -0.2 -0.2 rate 0.3 units box id next
thermo_style    custom step atoms pe
thermo_modify   format float %.15g
thermo          1
run             16
