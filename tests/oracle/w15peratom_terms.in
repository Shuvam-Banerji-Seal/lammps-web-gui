# oracle: compute pe/atom and stress/atom with keyword subsets (pair, bond, angle, dihedral, improper) summed by compute reduce
# oracle-inputs: mol_chains.data
units           lj
atom_style      molecular
bond_style      harmonic
angle_style     harmonic
dihedral_style  harmonic
improper_style  harmonic
pair_style      lj/cut 2.5
read_data       mol_chains.data
pair_coeff      * * 0.5 0.9
pair_coeff      1 3 0.8 1.0
bond_coeff      1 120.0 1.05
bond_coeff      2 90.0 1.1
angle_coeff     1 40.0 109.5
angle_coeff     2 25.0 120.0
dihedral_coeff  1 1.5 -1 3
improper_coeff  1 12.0 20.0
special_bonds   lj 0.0 0.5 0.8
compute         ep all pe/atom pair
compute         eb all pe/atom bond
compute         ea all pe/atom angle dihedral
compute         ei all pe/atom improper
compute         eall all pe/atom
compute         sp all stress/atom NULL pair
compute         sb all stress/atom NULL bond angle
compute         sv all stress/atom NULL virial
compute         rep all reduce sum c_ep
compute         reb all reduce sum c_eb
compute         rea all reduce sum c_ea
compute         rei all reduce sum c_ei
compute         rall all reduce sum c_eall
compute         rsp all reduce sum c_sp[1] c_sp[2] c_sp[4]
compute         rsb all reduce sum c_sb[1] c_sb[3] c_sb[6]
compute         rsv all reduce sum c_sv[2] c_sv[5]
timestep        0.002
fix             1 all nve
thermo_style    custom step pe evdwl ebond c_rep c_reb c_rea c_rei c_rall c_rsp[1] c_rsp[2] c_rsp[3] c_rsb[1] c_rsb[2] c_rsb[3] c_rsv[1] c_rsv[2]
thermo_modify   format float %.15g
thermo          10
run             30
