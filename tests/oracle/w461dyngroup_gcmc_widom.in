# oracle: fixes gcmc (translations and exchanges) and widom on a dynamic group (the atoms in the lower half in x,
# re-evaluated every step), an lj/cut gas in metal units; inserted atoms join the group until its next update
# oracle-compare: thermo=all atoms=none rel=1e-8
units           metal
atom_style      atomic
pair_style      lj/cut 3.0
pair_modify     tail no
region          box block 0 6 0 6 0 6
create_box      1 box
pair_coeff      * * 0.01 1.0
mass            1 1.0
create_atoms    1 random 20 4321 box
region          lower block INF 3.0 INF INF INF INF
group           dyn dynamic all region lower every 1
variable        ndyn equal count(dyn)
fix             mygcmc dyn gcmc 1 3 3 1 29494 300.0 0.0 0.5
fix             w dyn widom 2 3 1 12345 300.0
thermo_style    custom step atoms pe f_mygcmc[1] f_mygcmc[2] f_mygcmc[3] f_mygcmc[4] f_mygcmc[5] f_mygcmc[6] f_w[1] f_w[2] v_ndyn
thermo          1
thermo_modify   format float %.15g
run             20
