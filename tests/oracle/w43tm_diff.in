# Wave 43: fix ttm/mod diffusion on a 4x4x4 electron grid (cells of 1.5 A over the 6 A box) with a vacuum cell (T_e = 0),
# D_e 20 at dt 0.02 (C_s = 0.53, three sub-steps), temperature-dependent C_e (a_0 0.5, a_1 0.3, rho_e 1.2), gamma_p 5, seed 4242.
# oracle-inputs: w43tm_diff.par w43tm_diff.init
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           metal
atom_style      atomic
lattice         sc 3.0
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box
mass            1 10.0
displace_atoms  all move 0.5 0.5 0.5 units box
variable        vx atom 3.0*sin(0.9*x+0.4*y)
variable        vy atom 2.5*cos(0.7*y-0.5*z)
variable        vz atom 2.0*sin(1.1*z+0.3*x)
velocity        all set v_vx v_vy v_vz units box
velocity        all zero linear
pair_style      lj/cut 3.0
pair_coeff      1 1 0.0 2.0
fix             1 all nve
fix             2 all ttm/mod 4242 w43tm_diff.par 4 4 4 infile w43tm_diff.init
timestep        0.02
thermo_style    custom step temp pe f_2[1] f_2[2]
thermo_modify   format float %.15g
thermo          1
run             4
