# oracle: pair_style hybrid/overlay pedone 15.0 coul/long 15.0 with pppm (pair_modify table 0), CaO fcc crystal (cut-down pedone.relax example), variable displacement, 100 steps of nve
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           metal
atom_style      charge
lattice         fcc 4.8105
region          box block 0 2 0 2 0 2
create_box      2 box
create_atoms    1 box
lattice         fcc 4.8105 origin 0.5 0.5 0.5
create_atoms    2 box
mass            1 40.078
mass            2 15.999
variable        dx atom 0.03*sin(1.3*x+0.7*y)
variable        dy atom 0.03*cos(0.9*y-0.4*z)
variable        dz atom 0.03*sin(1.1*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
set             type 1 charge 1.2
set             type 2 charge -1.2
variable        vx atom 0.01*sin(id)
variable        vy atom 0.01*cos(2*id)
variable        vz atom 0.01*sin(3*id)
velocity        all set v_vx v_vy v_vz
timestep        0.002
neigh_modify    delay 5 every 1 check yes
pair_style      hybrid/overlay pedone 15.0 coul/long 15.0
kspace_style    pppm 1.0e-6
pair_modify    table 0
pair_coeff      * * coul/long
pair_coeff      1 2 pedone 0.030211 2.241334 2.923245 5.0
pair_coeff      2 2 pedone 0.042395 1.379316 3.618701 22.0
fix             1 all nve
thermo_style    custom step pe press etotal
thermo_modify   format float %.15g norm no
thermo          10
run             100
