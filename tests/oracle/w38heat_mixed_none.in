# oracle: pair granular with heat none for the 1-1 pair and heat area for the 2-2 and the explicit 1-2 pairs (no heat on type 1 atoms, Q between types 1 and 2 and between type 2 atoms), heat/flow type 1.0 3.0, 16 slightly overlapping spheres of two types with a velocity pattern, 100 steps
units           lj
atom_style      sphere
atom_modify     map array
comm_modify     vel yes
boundary        f f f
lattice         sc 0.9
region          box block 0 4 0 2 0 2
create_box      2 box
create_atoms    1 box
group           odd id 1:16:2
set             group odd type 2
set             type 1 diameter 1.05 density 1.0
set             type 2 diameter 1.05 density 1.4
variable        vx atom 0.1*sin(1.3*id)
variable        vy atom 0.1*cos(0.7*id)
velocity        all set v_vx v_vy 0.0 units box
fix             pa all property/atom temperature heatflow
set             type 1 temperature 1.0
set             type 2 temperature 2.0
pair_style      granular
pair_coeff      1 1 hooke 2000.0 0.0 tangential linear_nohistory 0.0 0.0 heat none
pair_coeff      2 2 hooke 2000.0 0.0 tangential linear_nohistory 0.0 0.0 heat area 0.8
pair_coeff      1 2 hooke 2000.0 0.0 tangential linear_nohistory 0.0 0.0 heat area 0.8
timestep        0.0005
fix             1 all nve/sphere
fix             2 all heat/flow type 1.0 3.0
compute         pa all property/atom temperature heatflow
compute         tsum all reduce sum c_pa[1]
compute         tmax all reduce max c_pa[1]
compute         tmin all reduce min c_pa[1]
compute         hsum all reduce sum c_pa[2]
compute         hmax all reduce max c_pa[2]
compute         hmin all reduce min c_pa[2]
thermo_style    custom step ke c_tsum c_tmax c_tmin c_hsum c_hmax c_hmin
thermo_modify   format float %.15g
thermo          10
run             100
