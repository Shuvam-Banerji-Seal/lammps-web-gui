# oracle: fix store/state keywords com (xu yu zu relative to the group centre) and thresh (variable gate, tested at definition, at the first run and each step)
# Measured max relative error of the engine against native (thermo 2.8e-15, per-atom 3.6e-15, dumped store values exact). native: b332f28 (installed lmp, black box)
# oracle-files: d.com
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 2 0 2 0 2
create_box      2 box
create_atoms    1 box
mass            * 1.0
velocity        all create 1.2 87287 loop geom
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0 2.5
group           half type 1
fix             1 all nve
variable        gate equal "step >= 4"
fix             c all store/state 0 xu yu zu com yes
fix             t all store/state 2 xu yu zu com no thresh v_gate > 0.5
fix             h half store/state 0 x y z
dump            d all custom 2 d.com id f_c[1] f_c[2] f_c[3] f_t[1] f_t[2] f_t[3] f_h[1] f_h[2] f_h[3]
dump_modify     d format float %.15g
thermo_style    custom step pe ke
thermo_modify   format float %.15g
thermo          2
run             8
