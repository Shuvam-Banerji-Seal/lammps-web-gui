# oracle: bpm/spring with normalize yes and smooth no on a dimer of reference length 2, then broken by stretch
# oracle-inputs: w51bpm_dimer_r2.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      bond
newton          on off
read_data       w51bpm_dimer_r2.data
pair_style      bpm/spring
pair_coeff      1 1 1.0 1.0 0.5
bond_style      bpm/spring normalize yes smooth no
bond_coeff      1 1.0 0.1 0.5
neighbor        0.3 bin
comm_modify     vel yes cutoff 2.0
special_bonds   lj 0 1 1 coul 1 1 1
fix             1 all nve
compute         nb all nbond/atom
compute         tb all reduce sum c_nb
thermo_style    custom step pe ebond epair fmax c_tb
thermo_modify   format float %.15g norm no
timestep        0.01
run             0
set             atom 2 x 2.15 vx 0.5
thermo          1
run             4
