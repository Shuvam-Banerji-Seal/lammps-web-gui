# oracle: timestep 0 is accepted (the run takes no motion); a later positive timestep resumes the clock
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 1.0 4928 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
timestep        0.005
fix             1 all nve
thermo_style    custom step time temp pe
thermo_modify   format float %.15g
run             2
timestep        0
run             3
timestep        0.005
run             2
