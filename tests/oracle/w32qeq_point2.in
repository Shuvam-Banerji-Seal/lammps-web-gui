# oracle: fix qeq/point, two charged atoms in metal units, pair coul/cut, run 0
# oracle-inputs: w32qeq_point.params
# oracle-files: w32qeq_point2_q.dump
units metal
atom_style charge
boundary f f f
region box block 0 30 0 30 0 30
create_box 2 box
create_atoms 1 single 5 15 15
create_atoms 2 single 8 15 15
mass 1 1.0
mass 2 1.0
set atom 1 charge 0.0
set atom 2 charge 0.0
pair_style coul/cut 20.0
pair_coeff * *
fix q all qeq/point 1 20 1.0e-14 200 w32qeq_point.params
thermo_style custom step pe ecoul f_q
thermo_modify format float %.15g
run 0
write_dump all custom w32qeq_point2_q.dump id q modify format float %.15g sort id
