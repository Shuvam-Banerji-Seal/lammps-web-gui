# oracle: w83sph_cavity, cut-down of examples/PACKAGES/sph/cavity_flow (smaller box, 200 steps; same spacing and cutoff). Measured max relative error vs native LAMMPS (black box): 3.4e-15 thermo, 1.4e-18 per atom.
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
dimension          2
units              si
atom_style         sph

region             box block -0.050e-3 0.344e-3 -0.05e-3 0.344e-3 -1.0e-6 1.0e-6 units box
create_box         3 box

region             fluid block 0.0001e-3 0.299e-3 0.0001e-3 0.299e-3 EDGE EDGE side in units box
lattice            sq 0.025e-3
create_atoms       1 region fluid

region             walls block 0.0001e-3 0.299e-3 0.0001e-3 EDGE EDGE EDGE side out units box
lattice            sq2 0.025e-3
create_atoms       2 region walls

region             driver block EDGE EDGE 0.299e-3 EDGE EDGE EDGE side in units box
create_atoms       3 region driver

group              fluid type 1
group              walls type 2
group              driver type 3
group              integrate_full union fluid driver

mass               3 2.0e-7
mass               2 2.0e-7
mass               1 4.0e-7
set                group all sph/rho 1000.0

pair_style         hybrid sph/taitwater/morris
pair_coeff         * *    sph/taitwater/morris 1000 0.1 1.0e-3 6.5e-5
pair_coeff         2 3    none

compute            rho_peratom all sph/rho/atom
compute            e_peratom all sph/e/atom
compute            ke_peratom all ke/atom
compute            esph all reduce sum c_e_peratom
compute            rhosum all reduce sum c_rho_peratom
compute            ke all ke
variable           etot equal c_ke+c_esph

velocity           driver set 0.001 0.0 0.0 units box
fix                freeze_fix driver setforce 0.0 0.0 0.0

fix                integrate_fix_full integrate_full sph
fix                integrate_fix_stationary walls sph/stationary

thermo             20
thermo_style       custom step c_esph v_etot c_rhosum c_ke
thermo_modify      norm no format float %.15g

neighbor           3.0e-6 bin
timestep           5.0e-5
run                200
