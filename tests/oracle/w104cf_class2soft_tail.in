# oracle: lj/class2/soft (lambda 0.6, n 2) with pair_modify tail yes: energy and pressure tail of the 9-6 soft pair, two types
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=1e-12
units           lj
atom_style      atomic
lattice         fcc 0.6
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
lattice         fcc 0.6 origin 0.5 0.0 0.0
create_atoms    2 box
mass            * 1.0
variable        vx atom 1.0*sin(1.7*x+2.3*y+0.7*z)
variable        vy atom 1.0*cos(2.1*x-1.1*y+0.3*z)
variable        vz atom 1.0*sin(0.5*x+1.9*z+1.3*y)
velocity        all set v_vx v_vy v_vz units box
velocity        all zero linear
neighbor        0.3 bin
neigh_modify    every 1 delay 0 check yes
timestep        0.001
fix             1 all nve
thermo_style    custom step temp pe evdwl ecoul press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g norm no
thermo          10
pair_style      lj/class2/soft 2 0.5 2.5
pair_coeff      1 1 1.0 1.0 0.6
pair_coeff      2 2 0.8 1.1 0.6
pair_coeff      1 2 0.9 1.05 0.6
pair_modify     tail yes
run             20
