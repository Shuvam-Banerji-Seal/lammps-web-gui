# oracle: fix ehex with nevery 5 and thin reservoir slabs; atoms cross the region boundaries during the run
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
group           odd id 1:108:2
set             group odd type 2
mass            1 1.0
mass            2 1.5
region          hot block INF INF INF INF 0.5 1.5 units box
region          cold block INF INF INF INF 3.0 4.0 units box
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
pair_coeff      1 2 1.0 1.0
pair_coeff      2 2 0.9 1.05
velocity        all create 2.0 777 mom no rot no
timestep        0.002
fix             1 all nve
fix             2 all ehex 5 0.4 region hot
fix             3 all ehex 5 -0.4 region cold
compute         th all temp/region hot
compute         tc all temp/region cold
thermo_style    custom step temp pe etotal c_th c_tc f_2 f_3
thermo_modify   format float %.15g
thermo          25
run             300
