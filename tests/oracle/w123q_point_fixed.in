# oracle: fix qeq/point on a group with fixed non-group charges, pair coul/cut, tight and loose tolerances, 20 nve steps with nevery 2 (f_q = iterations)
# measured max error vs native (relative): thermo 1.6e-15, atoms 5.8e-15; f_q (iterations) equal in every row. Main before this port: f_q 5 vs 2, atoms 2.6e-2.
# oracle-inputs: w32qeq_point.params
# oracle-files: w123q_point_fixed_q.dump
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10 atomrel=1e-8
units metal
atom_style charge
boundary f f f
region box block 0 30 0 30 0 30
create_box 2 box
create_atoms 1 single 5 15 15
create_atoms 2 single 8 15 15
create_atoms 1 single 11 15 15
create_atoms 2 single 8 18 15
create_atoms 1 single 8 12 15
create_atoms 2 single 13 19 16
mass 1 1.0
mass 2 1.0
set atom 1 charge 0.0
set atom 2 charge 0.0
set atom 3 charge 0.0
set atom 4 charge 0.3
set atom 5 charge -0.2
set atom 6 charge 0.0
group mob id 1 2 3 5 6
group fixed id 4
pair_style coul/cut 12.0
pair_coeff * *
fix q mob qeq/point 2 8 1.0e-4 200 w32qeq_point.params
fix 1 mob nve
velocity mob create 300.0 4928459
timestep 0.001
thermo_style custom step pe ecoul f_q
thermo_modify format float %.15g
thermo 10
run 0
run 20
write_dump all custom w123q_point_fixed_q.dump id q modify format float %.15g sort id
