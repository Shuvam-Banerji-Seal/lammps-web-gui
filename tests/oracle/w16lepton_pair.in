# oracle: pair_style lepton with LJ-like and named-intermediate expressions, per-type cutoffs, pe/atom (no mixing)
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      2 box
region          left block 0 2.25 0 4 0 4
region          right block 2.25 4 0 4 0 4
create_atoms    1 region left
create_atoms    2 region right
mass            * 1.0
variable        vx atom 0.5*sin(1.3*x+0.7*y)
variable        vy atom 0.5*cos(0.9*y-0.4*z)
variable        vz atom 0.5*sin(1.1*z+0.5*x)
velocity        all set v_vx v_vy v_vz
velocity        all zero linear
pair_style      lepton 2.5
pair_coeff      1 1 "4.0*eps*((sig/r)^12 - (sig/r)^6);eps=1.0;sig=1.0"
pair_coeff      1 2 "e1^2*0.5+e1*0.1; e1=4.0*eps*((sig/r)^12-(sig/r)^6); eps=0.8; sig=1.1" 1.8
pair_coeff      2 2 "0.02*sin(r)*cos(r)+0.01*sqrt(r)*abs(r-1.2)*step(r-1.1)+0.03*min(r,2.0)*exp(-r)" 2.2
fix             1 all nve
compute         ep all pe/atom pair
compute         rep all reduce sum c_ep
thermo_style    custom step temp pe evdwl press pxx c_rep
thermo_modify   format float %.15g
thermo          10
run             40
