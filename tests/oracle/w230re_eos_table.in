# oracle: fix eos/table (linear table of the internal energy against the internal temperature, 200 entries) with pair dpd/fdt/energy and fix dpd/energy (isoenergetic DPD, atom_style dpd) on the first 1000 atoms of examples/PACKAGES/dpd-react/dpde-vv, 50 steps
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 3.7e-15, atoms 0.
# oracle-inputs: w95dreact_dpd_1000.data w230re_eos_table.txt
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=1e-15 atomrel=1e-10
boundary        p p p

units           metal
atom_style      dpd
read_data       w95dreact_dpd_1000.data

comm_modify     mode single vel yes
mass            1 125.9

pair_style      dpd/fdt/energy 8.6 245455
pair_coeff      1 1 0.075 0.022 3.2E-05 8.60

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check no once no

timestep        0.001

fix             1 all dpd/energy
fix             2 all nve
fix             3 all eos/table linear w230re_eos_table.txt 200 EOS_TABLE

compute         dpdU all dpd

variable        totEnergy equal pe+ke+c_dpdU[1]+c_dpdU[2]

thermo          10
thermo_style    custom step temp press pe ke c_dpdU[1] c_dpdU[2] v_totEnergy c_dpdU[4]
thermo_modify   format float %.15g

run             50
