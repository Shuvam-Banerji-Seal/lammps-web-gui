# oracle: velocity create loop geom (uniform) then a 60-step lj/cut run on a 256-atom fcc lattice (short enough to stay within round-off)
# oracle-compare: thermo=all atoms=all
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 3.0 5432 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
neighbor        0.3 bin
neigh_modify    every 20 delay 0 check no
fix             1 all nve
thermo_style    custom step temp pe ke etotal press
thermo_modify   format float %.15g
thermo          10
run             60
