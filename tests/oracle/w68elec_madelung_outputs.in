# oracle: ELECTRODE madelung in.madelung-ewald-ew3dc with the fix's vector and array outputs (f_conp[i], f_conp[i][j]): ewald/electrode EW3DC, fix electrode/conp mat_inv, symm on
# oracle-inputs: w68elec_au_elyt.data
# oracle-compare: thermo=all atoms=all rel=1e-6 abs=1e-9
boundary        p p f
kspace_style    ewald/electrode 1.0e-8
kspace_modify   slab 8.0
units           real
atom_style      full
pair_style      lj/cut/coul/long 12
read_data       w68elec_au_elyt.data
group           bot type 1
group           top type 2
variable        q atom q
compute         qbot bot reduce sum v_q
compute         qtop top reduce sum v_q
fix             conp bot electrode/conp 0 2 couple top 1 symm on
thermo_style    custom step pe c_qbot c_qtop f_conp f_conp[1] f_conp[2] f_conp[1][1] f_conp[1][2] f_conp[1][3] f_conp[1][4] f_conp[2][1] f_conp[2][2] f_conp[2][3] f_conp[2][4]
thermo_modify   format float %.15g
run             0
