# oracle: pair_style eam: a funcfl file read and then replaced still sets the cutoff (native init_one takes the largest cutoff of every funcfl file read): Ag_u3 (cutoff 5.55) replaced by Cu_u3 (cutoff 4.95, table to 4.99), so pairs out to 5.55 take Cu's last table values; the single file's tables are on native's grid of Nr - 1 points
# oracle-potentials: Cu_u3.eam Ag_u3.eam
# oracle-compare: thermo=all atoms=all rel=1e-12 abs=1e-12
units           metal
atom_style      atomic
lattice         fcc 3.615
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
pair_style      eam
pair_coeff      * * Ag_u3.eam
pair_coeff      * * Cu_u3.eam
velocity        all create 1200.0 87287 loop geom
fix             1 all nve
timestep        0.002
thermo_style    custom step temp pe ke etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          20
run             100
