# oracle: pair_style meam, library Bi entry (sc, ibar = -5, nn2 = 1, erose_form 0, Cmin 0.68, Cmax 1.70), displaced sc cell, velocities from atom-style variables, 50 steps of nve
# oracle-potentials: library.meam Bi.meam
# oracle-compare: thermo=all atoms=all abs=1e-8
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 2e-14, atoms 9.9e-16. The off-diagonal pyz is left out of the thermo columns.
units           metal
atom_style      atomic
lattice         sc 3.27
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 208.98
variable        dx atom 0.05*sin(1.3*x+0.7*y)
variable        dy atom 0.05*cos(0.9*y-0.4*z)
variable        dz atom 0.05*sin(1.1*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.01*sin(id)
variable        vy atom 0.01*cos(2*id)
variable        vz atom 0.01*sin(3*id)
velocity        all set v_vx v_vy v_vz
pair_style      meam
pair_coeff      * * library.meam Bi Bi.meam Bi
timestep        0.001
fix             1 all nve
thermo_style    custom step pe ke press pxx pyy pzz
thermo_modify   format float %.15g norm no
thermo          10
run             50
