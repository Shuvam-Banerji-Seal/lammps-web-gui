# oracle: delete_atoms random fraction with eflag no (approximate): each eligible atom is deleted when a uniform draw is at or below the fraction
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 random 80 12345 NULL
mass            1 1.0
delete_atoms    random fraction 0.3 no all NULL 4321
thermo_style    custom step atoms
thermo_modify   format float %.15g
run             0
