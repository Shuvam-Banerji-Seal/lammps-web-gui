# oracle-inputs: w12tip4p_long_water.data
# oracle: pair_style lj/charmm/coul/msm 3.5 4.5 (the CHARMM LJ switching between 3.5 and 4.5 A and the tabulated MSM short-range Coulomb term) on 27 flexible 3-site waters with special_bonds charmm (excluded 1-2 and 1-3 pairs through ctable), kspace_style msm order 8, cutoff/adjust yes, pressure/scalar yes (the LJ forces alone in the fdotr virial), NVE, 1 fs, 40 steps.
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 1.9e-13, atoms 1.9e-12.
units           real
atom_style      full
boundary        p p p
read_data       w12tip4p_long_water.data
pair_style      lj/charmm/coul/msm 3.5 4.5
pair_coeff      1 1 0.1852 3.1589
pair_coeff      2 2 0.0460 0.4000
bond_style      harmonic
bond_coeff      1 450.0 0.9572
angle_style     harmonic
angle_coeff     1 55.0 104.52
special_bonds   charmm
kspace_style    msm 1.0e-4
kspace_modify   order 8
velocity        all create 300.0 4928459 dist gaussian
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
timestep        1.0
fix             1 all nve
thermo_style    custom step temp pe evdwl ecoul elong ebond eangle press
thermo_modify   format float %.15g
thermo          10
run             40
