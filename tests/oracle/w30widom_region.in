# oracle: Widom atom insertion inside a block region; only the region volume is compared
# oracle-compare: skip=f_w[1],f_w[2]
units lj
atom_style atomic
boundary p p p
region box block 0 6 0 6 0 6
region ins block 1 3 1 3 1 3
create_box 2 box
create_atoms 1 single 2.0 2.0 2.0 units box
mass 1 1.0
mass 2 1.0
pair_style lj/cut 2.0
pair_coeff 1 1 1.0 1.0
pair_coeff 1 2 1.0 1.0
pair_coeff 2 2 1.0 1.0
fix w all widom 1 2 2 12345 1.0 region ins
thermo_style custom step f_w[1] f_w[2] f_w[3]
thermo_modify format float %.15g
thermo 1
run 6
