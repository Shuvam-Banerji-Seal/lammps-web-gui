# oracle: fix ave/histo written by two runs: the second run starts on the step the first one ended on (the step is written once); the file is compared token by token
# oracle-files: h.txt
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 1.44 87287
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
fix             1 all nve
variable        vx atom vx
fix             h all ave/histo 1 1 100 -3.0 3.0 12 v_vx file h.txt mode vector
thermo_style    custom step temp pe ke etotal press
thermo_modify   format float %.15g
thermo          100
run             100
run             100
