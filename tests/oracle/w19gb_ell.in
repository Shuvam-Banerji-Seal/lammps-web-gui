pair_style gayberne 1.3 0.8 1.5 5.0
pair_coeff 1 1 1.0 1.0 1.0 0.6 0.5 1.0 0.5 1.0
pair_coeff 2 2 0.7 0.9 0.8 0.4 0.3 0.8 0.4 0.3 4.0
