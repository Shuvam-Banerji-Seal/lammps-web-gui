# oracle: chunk computes on the branched chains (18 molecules of 5 atoms): angmom/chunk, omega/chunk, inertia/chunk, gyration/chunk (vector and tensor), gyration/shape/chunk, com/chunk, property/chunk (count, id), reduce/chunk, chunk/spread/atom and momentum, after a short NVE run
# oracle-inputs: mol_chains.data
# oracle-compare: thermo=all atoms=all rel=1e-6 abs=1e-8
units           lj
atom_style      molecular
bond_style      class2
angle_style     harmonic
dihedral_style  harmonic
improper_style  harmonic
pair_style      lj/cut 2.5
read_data       mol_chains.data
pair_coeff      * * 0.5 0.9
pair_coeff      1 3 0.8 1.0
bond_coeff      1 1.05 100.0 -50.0 20.0
bond_coeff      2 1.1 90.0 -40.0 15.0
angle_coeff     1 40.0 109.5
angle_coeff     2 25.0 120.0
dihedral_coeff  1 1.5 -1 3
improper_coeff  1 12.0 20.0
special_bonds   lj 0.0 0.5 0.8
timestep        0.002
fix             1 all nve
compute cm all chunk/atom molecule compress yes
compute ang all angmom/chunk cm
compute om all omega/chunk cm
compute ine all inertia/chunk cm
compute gy all gyration/chunk cm
compute gyt all gyration/chunk cm tensor
compute gsh all gyration/shape/chunk gyt
compute com all com/chunk cm
compute cnt all property/chunk cm count id
compute pa all property/atom vx vy vz
compute rmx all reduce/chunk cm max c_pa[*]
compute spr all chunk/spread/atom cm c_gy
compute rsp all reduce/chunk cm sum c_spr
compute mom all momentum
thermo_modify   format float %.15g norm no
thermo_style    custom step c_ang[1][1] c_ang[1][2] c_ang[1][3] c_om[1][1] c_om[1][2] c_om[1][3] c_ine[1][1] c_ine[1][2] c_ine[1][3] c_ine[1][4] c_ine[1][5] c_ine[1][6] c_gy[1] c_gyt[1][6] c_com[1][1] c_com[1][3] c_gsh[1][1] c_gsh[1][2] c_gsh[1][3] c_gsh[1][4] c_gsh[1][5] c_gsh[1][6] c_cnt[1][1] c_cnt[1][2] c_rmx[1][1] c_rmx[1][3] c_rsp[1] c_ang[2][1] c_ang[2][2] c_ang[2][3] c_om[2][1] c_om[2][2] c_om[2][3] c_ine[2][1] c_ine[2][2] c_ine[2][3] c_ine[2][4] c_ine[2][5] c_ine[2][6] c_gy[2] c_gyt[2][6] c_com[2][1] c_com[2][3] c_gsh[2][1] c_gsh[2][2] c_gsh[2][3] c_gsh[2][4] c_gsh[2][5] c_gsh[2][6] c_cnt[2][1] c_cnt[2][2] c_rmx[2][1] c_rmx[2][3] c_rsp[2] c_ang[3][1] c_ang[3][2] c_ang[3][3] c_om[3][1] c_om[3][2] c_om[3][3] c_ine[3][1] c_ine[3][2] c_ine[3][3] c_ine[3][4] c_ine[3][5] c_ine[3][6] c_gy[3] c_gyt[3][6] c_com[3][1] c_com[3][3] c_gsh[3][1] c_gsh[3][2] c_gsh[3][3] c_gsh[3][4] c_gsh[3][5] c_gsh[3][6] c_cnt[3][1] c_cnt[3][2] c_rmx[3][1] c_rmx[3][3] c_rsp[3] c_ang[4][1] c_ang[4][2] c_ang[4][3] c_om[4][1] c_om[4][2] c_om[4][3] c_ine[4][1] c_ine[4][2] c_ine[4][3] c_ine[4][4] c_ine[4][5] c_ine[4][6] c_gy[4] c_gyt[4][6] c_com[4][1] c_com[4][3] c_gsh[4][1] c_gsh[4][2] c_gsh[4][3] c_gsh[4][4] c_gsh[4][5] c_gsh[4][6] c_cnt[4][1] c_cnt[4][2] c_rmx[4][1] c_rmx[4][3] c_rsp[4] c_ang[5][1] c_ang[5][2] c_ang[5][3] c_om[5][1] c_om[5][2] c_om[5][3] c_ine[5][1] c_ine[5][2] c_ine[5][3] c_ine[5][4] c_ine[5][5] c_ine[5][6] c_gy[5] c_gyt[5][6] c_com[5][1] c_com[5][3] c_gsh[5][1] c_gsh[5][2] c_gsh[5][3] c_gsh[5][4] c_gsh[5][5] c_gsh[5][6] c_cnt[5][1] c_cnt[5][2] c_rmx[5][1] c_rmx[5][3] c_rsp[5] c_ang[6][1] c_ang[6][2] c_ang[6][3] c_om[6][1] c_om[6][2] c_om[6][3] c_ine[6][1] c_ine[6][2] c_ine[6][3] c_ine[6][4] c_ine[6][5] c_ine[6][6] c_gy[6] c_gyt[6][6] c_com[6][1] c_com[6][3] c_gsh[6][1] c_gsh[6][2] c_gsh[6][3] c_gsh[6][4] c_gsh[6][5] c_gsh[6][6] c_cnt[6][1] c_cnt[6][2] c_rmx[6][1] c_rmx[6][3] c_rsp[6] c_ang[7][1] c_ang[7][2] c_ang[7][3] c_om[7][1] c_om[7][2] c_om[7][3] c_ine[7][1] c_ine[7