# oracle: fix flow/gauss in 2d, work via fix_modify energy yes (no keyword) (cut down from examples/PACKAGES/flow_gauss/in.GD): momentum conservation in x and y of a
# group, the energy keyword (work done) and the scalar/vector outputs. A thermostat on the group keeps the fluid steady.
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# measured with native LAMMPS: max relative error about 1e-13 (per-atom; thermo agrees to 1e-12)
# note: the left group is pushed by fix addforce, so the conserved group force is nonzero (the wall-fluid forces and the push)
# native: b332f28 built with the installed lmp (EXTRA-FIX)
units           lj
dimension       2
atom_style      atomic
lattice         sq 0.8
region          box block -8 8 -6 6 -0.1 0.1 units lattice
create_box      2 box
create_atoms    1 box
mass            * 1.0
region          half block -8 0 -6 6 -0.1 0.1 units lattice
group           left region half
group           right subtract all left
set             group right type 2
pair_style      lj/cut 2.5
pair_modify     shift yes
pair_coeff      * * 1.0 1.0 2.5
neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes
velocity        all create 1.0 78915 dist gaussian mom yes loop geom
timestep        0.002
fix             1 all nve
fix             2 all enforce2d
fix             3 left nvt temp 1.0 1.0 0.2
fix             ext left addforce 0.1 0.0 0.0
fix             GD left flow/gauss 1 0 0
fix_modify   GD energy yes
thermo          10
thermo_style    custom step temp pe ke f_GD f_GD[1] f_GD[2] press
thermo_modify   format float %.15g
run             60
