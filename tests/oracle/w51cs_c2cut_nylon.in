# oracle: cut-down of examples/PACKAGES/reaction/tiny_nylon (bond/react removed, 50 steps): lj/class2/coul/cut 8.5 (no kspace)
# oracle-inputs: w51cs_tiny_nylon.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           real
atom_style      full
boundary        p p p
pair_style      lj/class2/coul/cut 8.5

bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2
special_bonds   lj/coul 0 0 1
pair_modify     tail yes mix sixthpower
read_data       w51cs_tiny_nylon.data
velocity        all create 300.0 4928459 dist gaussian
timestep        1.0
fix             1 all nve
thermo          10
thermo_style    custom step temp pe evdwl ecoul elong ebond eangle edihed eimp etotal press
thermo_modify   format float %.15g
run             50
