# oracle: fix dt/reset in metal units with a hot Cu atom (cascade-like): dt, time, pe, ke and the last reset step over 300 steps
# oracle-potentials: AlCu.eam.alloy
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units metal
atom_style atomic
boundary p p p
lattice fcc 3.615
region box block 0 4 0 4 0 4
create_box 1 box
create_atoms 1 box
mass 1 63.546
pair_style eam/alloy
pair_coeff * * AlCu.eam.alloy Cu
velocity all create 300 42534 mom yes rot yes
group pka id 1
velocity pka set 200 100 50 units box
fix 1 all nve
fix 2 all dt/reset 1 NULL 0.0005 0.02 emax 10.0 units box
timestep 0.0001
thermo_style custom step dt time pe ke f_2
thermo_modify format float %.15g
thermo 20
run 300
