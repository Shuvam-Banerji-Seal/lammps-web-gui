# oracle: fix mol/swap Monte Carlo type swaps on a frozen mixed-molecule system (attempts/accepts vector and pe)
# oracle-inputs: w30molswap_mix.data
# oracle-compare: atoms=all
units           lj
atom_style      molecular
neighbor        0.3 bin
neigh_modify    delay 0

pair_style      lj/cut 2.0
read_data       w30molswap_mix.data
pair_coeff      1 1 0.1 1.0
pair_coeff      1 2 0.5 1.0
pair_coeff      2 2 1.0 1.0
pair_coeff      1 3 0.3 1.0
pair_coeff      2 3 0.7 1.0
pair_coeff      3 3 0.2 1.0

fix             swap all mol/swap 2 1 1 2 482794 1.0
thermo          1
thermo_style    custom step pe f_swap[1] f_swap[2]
thermo_modify   format float %.15g
run             30
