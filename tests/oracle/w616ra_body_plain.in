# oracle: create_atoms single and random without a molecule in atom_style body nparticle: point particles (native AtomVecBody::create_atom_post: radius 0.5, rmass 1.0, no body) with pair body/nparticle and fix nve, 100 steps
# oracle-compare: thermo=all atoms=all rel=1e-12 abs=1e-14
units           lj
atom_style      body nparticle 1 6
region          reg block 0 10 0 10 0 10 units box
create_box      1 reg
create_atoms    1 single 5 5 5
create_atoms    1 random 3 777 NULL
pair_style      body/nparticle 5.0
pair_coeff      * * 1.0 1.0
comm_modify     vel yes
fix             1 all nve
velocity        all create 1.0 8848
thermo_style    custom step atoms ke pe etotal press
thermo_modify   format float %.15g
thermo          50
run             100
