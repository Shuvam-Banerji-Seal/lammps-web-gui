# oracle: pair morse/smooth/linear 2.5 (explicit d0 alpha r0 per pair, cutoff per pair), 216 atoms NVE 200 steps
# oracle-compare: thermo=all atoms=all rel=1e-12 abs=1e-13
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 2.5e-13, atoms 6.7e-15.
units        lj
boundary     p p p
atom_style   atomic
lattice      sc 0.5
region       box block 0 6 0 6 0 6
create_box   2 box
create_atoms 1 box
set          group all type/fraction 2 0.5 4321
mass         * 1.0
velocity     all create 1.0 4242
timestep     0.002
fix          1 all nve
pair_style   morse/smooth/linear 2.5
pair_coeff   1 1 1.0 1.5 1.1
pair_coeff   1 2 0.7 1.3 1.2 2.4
pair_coeff   2 2 0.8 1.8 1.0 2.2
thermo_style custom step pe evdwl ecoul elong ke press pxx pyy pzz pxy pxz pyz
thermo_modify format float %.15g
thermo       20
run          200
