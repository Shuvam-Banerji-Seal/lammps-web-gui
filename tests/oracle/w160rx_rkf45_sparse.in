# oracle: DPD-REACT reactive fluid, sparse stoichiometry and the lammps_rkf45 solver (minSteps 1, maxIters 100, relTol 1e-6, absTol 1e-8), with a mixed start (every species 0.1, rdx 1: so the exp6 energies and the species are O(0.1), above the harness absolute floors): fix rx (rk4, dense) + pair exp6/rx (1fluid, exponent scaling) + fix eos/table/rx + fix shardlow, the examples/PACKAGES/dpd-react/dpdrx-shardlow input cut down to a 4x4x6 hcp box (shardlow needs sub-domains above 2 (rcut + skin) = 36 A), 10 + 10 steps (rx data files: the example's reaction file, exp6 parameters and heats of formation as they are; the EOS table sub-sampled to 201 rows)
# oracle-inputs: w160rx_kinetics.dpdrx w160rx_params.exp6 w160rx_table.eos w160rx_thermo.dpdrx
# oracle-files: oracle_rx.dump
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-15 atomrel=1e-8 filerel=1e-8
# native: /home/roy/.local/bin/lmp (b332f28, DPD-REACT included)
# Measured with native LAMMPS: the mixed start, with stoichiometry in the sparse form and the lammps_rkf45 solver (minSteps 1, maxIters 100, relTol 1e-6, absTol 1e-8); the species order (unordered_set iteration) and the clamp rounding it decides match native.
# Measured against the engine: max relative error 3e-15 (thermo, species), 1e-14 (per-atom internal energies).

boundary        p p p
units           metal
atom_style      dpd
atom_modify     map array
fix             4 all rx w160rx_kinetics.dpdrx none sparse lammps_rkf45 1 100 1.0e-6 1.0e-8

lattice         hcp 6.6520898 origin 0.0833333333333 0.25 0.25 orient z 1 0 0 orient x 0 1 0 orient y 0 0 1
region          box block 0 4.0 0 4.0 0.0 6.0 units lattice
create_box      2 box
region          atoms block 0 4.0 0 4.0 0.0 6.0 units lattice
create_atoms    1 region atoms

comm_modify     mode single vel yes
mass            * 222.12

# species concentrations (the example's rdx = 1; the other species start at 0.1 instead of 0)
set             atom * d_rdx 1.00
set             atom * d_h2 0.1
set             atom * d_no2 0.1
set             atom * d_n2 0.1
set             atom * d_hcn 0.1
set             atom * d_no 0.1
set             atom * d_h2o 0.1
set             atom * d_co 0.1
set             atom * d_co2 0.1

velocity        all create 2065.0 875661 dist gaussian loop geom
set             atom * dpd/theta 2065.00

timestep        0.001

pair_style      hybrid/overlay dpd/fdt/energy 16.00 234324 exp6/rx 16.00
pair_coeff      * * dpd/fdt/energy 0.0 0.05 10.0 16.00
pair_coeff      * * exp6/rx w160rx_params.exp6 1fluid 1fluid exponent 1.0 1.0 16.00

fix             1 all shardlow
fix             2 all nve
fix             3 all eos/table/rx linear w160rx_table.eos 201 KEYWORD w160rx_thermo.dpdrx

compute         dpdU all dpd
compute         dpdUatom all dpd/atom

variable        totEnergy equal pe+c_dpdU[1]+c_dpdU[2]+c_dpdU[3]

thermo          1
thermo_style    custom step temp press vol pe ke c_dpdU[1] c_dpdU[2] c_dpdU[3] v_totEnergy c_dpdU[4]
thermo_modify   format float %.15g flush yes

fix_modify      4 rx_chemistry off
run             10
fix_modify      4 rx_chemistry on
run             10

write_dump      all custom oracle_rx.dump id d_rdx d_h2 d_no2 d_n2 d_hcn d_no d_h2o d_co d_co2 d_rdxOld d_h2Old d_no2Old d_n2Old d_hcnOld d_noOld d_h2oOld d_coOld d_co2Old c_dpdUatom[1] c_dpdUatom[2] c_dpdUatom[3] c_dpdUatom[4] modify format float %.17g sort id
