# Wave 15: compute pair on a plain (non-hybrid) pair style: lj/cut with pair_modify tail yes. The scalar is
# the pair energy without the tail correction ("The energy returned by the evdwl keyword does not include
# tail corrections, even if they are enabled via the pair_modify command." docs.lammps.org/compute_pair.html),
# so pe minus the scalar is the tail energy.
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      2 box
region          r1 block 0 2.1 0 5.1 0 5.1
region          r2 block 2.1 5.1 0 5.1 0 5.1
create_atoms    1 region r1
create_atoms    2 region r2
mass            * 1.0
variable        vx atom 1.4*sin(1.7*x+2.3*y+0.7*z)
variable        vy atom 1.4*cos(2.1*x-1.1*y+0.3*z)
variable        vz atom 1.4*sin(0.5*x+1.9*z+1.3*y)
velocity        all set v_vx v_vy v_vz units box
velocity        all zero linear
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0 2.5
pair_modify     tail yes
fix             1 all nve
timestep        0.002
compute         e all pair lj/cut
compute         el all pair lj/cut evdwl
compute         ec all pair lj/cut ecoul
thermo_style    custom step pe evdwl c_e c_el c_ec
thermo_modify   format float %.15g
thermo          10
run             40
