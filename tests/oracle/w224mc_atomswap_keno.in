# oracle: fix atom/swap (canonical, ke no) on an LJ binary fcc mixture (256 atoms, two types with different epsilon, sigma and mass 1 and 2.5), 40 steps, an MC event every 5 steps with 20 cycles each: the swapped velocities are kept
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 4.5e-15, atoms 9.2e-14.
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
set             type 1 type/fraction 2 0.5 4242
mass            1 1.0
mass            2 2.5
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
pair_coeff      1 2 0.8 1.05
pair_coeff      2 2 0.6 0.95
velocity        all create 1.0 87287 loop geom
fix             integ all nve
fix             sw all atom/swap 5 20 12345 1.0 types 1 2 ke no
variable        is2 atom type==2
compute         n2 all reduce sum v_is2
thermo_style    custom step pe ke temp f_sw[1] f_sw[2] c_n2
thermo_modify   format float %.15g
thermo          1
run             40
