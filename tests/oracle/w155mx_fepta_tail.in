# oracle: compute fep/ta (test-area perturbation, yz, scale 0.998, tail yes) with lj/cut and pair_modify tail yes, cut down from PACKAGES/fep/ta, NVE
# native: b332f28 (installed lmp). Measured max relative error 5.5e-11 (target 1e-8).
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           real
boundary        p p p
atom_style      atomic
pair_style      lj/cut 5.0
pair_modify     tail yes
lattice         fcc 4.0
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box basis 1 1 basis 2 2
mass            * 39.9
pair_coeff      1 1 0.2 3.4
pair_coeff      1 2 0.1 3.0
pair_coeff      2 2 0.3 3.2
timestep        2.0
velocity        all create 120.0 4321
fix             INTEG all nve
compute         TA all fep/ta 120.0 yz 0.998 tail yes
thermo_style    custom step etotal pe press c_TA[1] c_TA[2] c_TA[3]
thermo_modify   format float %.15g
thermo          5
run             20
