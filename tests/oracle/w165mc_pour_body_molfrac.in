# oracle-inputs: w165mc_body_cube.mol w165mc_body_tetra.mol w165mc_body_rod.mol w165mc_body_point.mol
# oracle: fix pour of four body molecule files (cube, tetra, rod, point; toff 1 2 3) with molfrac 0.25 0.25 0.25 0.25 into a slab, cut down from examples/body in.pour3d (40 bodies, 200 steps)
# Measured max relative error of the engine against native (thermo exact, per-atom 3.1e-14). native: b332f28 (installed lmp, black box)
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units       lj
boundary    p p fm
comm_modify vel yes
atom_style  body rounded/polyhedron 1 8
atom_modify map array
region      reg block 0 50 0 50 0 50 units box
create_box  4 reg
pair_style  body/rounded/polyhedron 20 5 0 1 0.5
pair_coeff  * * 100 5
neighbor    0.5 bin
neigh_modify every 1 delay 0 check yes
timestep    0.001
fix         1 all nve/body
fix         2 all gravity 1.0 spherical 0.0 -180.0
molecule    object w165mc_body_cube.mol w165mc_body_tetra.mol toff 1 &
            w165mc_body_rod.mol toff 2 w165mc_body_point.mol toff 3
region      slab block 5 45 5 45 25 35 units box
fix         ins all pour 40 0 4767548 vol 0.4 10 region slab mol object molfrac 0.25 0.25 0.25 0.25
fix         4 all wall/body/polyhedron 2000 50 50 zplane 0.0 NULL
thermo_style custom step atoms ke pe
thermo_modify format float %.15g
thermo      50
run         200
