# oracle: compute centroid/stress/atom (NULL angle) with angle_style class2xe (bond-bond and bond-angle cross terms) on the mol_chains angles of w145pr, dihedral harmonic, pair zero; the angle terms tally the centroid virial with Angle::ev_tally (angle_class2xe.cpp line 261), so the centroid sum matches the virial; static (run 0)
# oracle-inputs: mol_chains.data
# oracle-files: w255cs_angle_class2xe.dump
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=1e-10 filerel=1e-10
units           lj
atom_style      molecular
bond_style      harmonic
angle_style     class2xe
dihedral_style  harmonic
improper_style  harmonic
pair_style      zero 2.5
read_data       mol_chains.data
pair_coeff      * *
bond_coeff      1 120.0 1.05
bond_coeff      2 90.0 1.1
angle_coeff     1 110.77 41.453 -10.604 5.129
angle_coeff     1 bb 90.4638 0.13682580 1.53 1.101
angle_coeff     1 ba 82.6961 98.2315 0.35423657 0.24110803 1.53 1.101
angle_coeff     2 120.05 44.7148 -22.7352 0.0
angle_coeff     2 bb 116.34805 0.22772772 1.501 1.417
angle_coeff     2 ba 82.6961 150.0 0.53340706 0.32185452 1.501 1.417
dihedral_coeff  1 1.5 -1 3
improper_coeff  1 12.0 20.0
special_bonds   lj 0.0 0.5 0.8
compute         pe all pe/atom
compute         st all stress/atom NULL
compute         cs all centroid/stress/atom NULL
compute         csv all centroid/stress/atom NULL virial
compute         csa all centroid/stress/atom NULL angle
compute         sum all reduce sum c_cs[1] c_cs[2] c_cs[3] c_cs[4] c_cs[5] c_cs[6] c_cs[7] c_cs[8] c_cs[9] c_st[4] c_pe
compute         sumA all reduce sum c_csa[1] c_csa[2] c_csa[3] c_csa[4] c_csa[5] c_csa[6] c_csa[7] c_csa[8] c_csa[9]
thermo_style    custom step eangle press c_sum[1] c_sum[2] c_sum[3] c_sum[4] c_sum[5] c_sum[6] c_sum[7] c_sum[8] c_sum[9] c_sum[10] c_sum[11] c_sumA[1] c_sumA[5] c_sumA[9]
thermo_modify   format float %.15g norm no
thermo          1
dump            d all custom 1 w255cs_angle_class2xe.dump id c_pe c_st[1] c_st[4] c_st[6] c_cs[1] c_cs[2] c_cs[3] c_cs[4] c_cs[5] c_cs[6] c_cs[7] c_cs[8] c_cs[9] c_csv[4] c_csv[7] c_csa[1] c_csa[5] c_csa[9]
dump_modify     d sort id format float %.15g
run             0
