# oracle: ewald/dipole with the collective, fftbench, overlap, minorder and cutoff/adjust keywords (accepted, no effect with one process), four point dipoles
# oracle-files: w51km_dipole_noeffect_mu.dump
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           real
atom_style      hybrid charge sphere dipole
boundary        p p p
region          box block -6 6 -6 6 -6 6
create_box      1 box
create_atoms    1 single 0.0 0.0 0.0
create_atoms    1 single 2.5 0.3 -0.4
create_atoms    1 single -1.2 2.2 1.1
create_atoms    1 single 3.1 -2.0 0.7
mass            1 1.0
set             group all charge 0.0
set             group all diameter 1.0
set             atom 1 dipole 0.3 0.5 0.7
set             atom 2 dipole -0.2 0.9 0.4
set             atom 3 dipole 0.6 -0.4 0.1
set             atom 4 dipole -0.5 0.2 0.8
pair_style      lj/cut/dipole/long 5.0
pair_coeff      * * 0.0 1.0
kspace_style    ewald/dipole 1.0e-4
kspace_modify   collective yes nonblocking yes fftbench yes overlap no minorder 2 cutoff/adjust yes
thermo_style    custom step pe ecoul elong evdwl press
thermo_modify   format float %.15g norm no
run             0
write_dump      all custom w51km_dipole_noeffect_mu.dump id tqx tqy tqz modify format float %.15g sort id
