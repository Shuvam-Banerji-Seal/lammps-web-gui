# oracle: fix langevin/eff (tally yes, Tstart Tstop damp seed) on the eFF SiH4 system with fix nve/eff, 20 steps
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 3.7e-15, atoms 0.
# oracle-inputs: w110effecp_sih4.data
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=1e-12 atomrel=1e-10
units           electron
newton          on
boundary        f f f
atom_style      electron
read_data       w110effecp_sih4.data
pair_style      eff/cut 1000.0 ecp 1 Si
pair_coeff      * *
comm_modify     vel yes
velocity        all set 0.0 0.0 0.0 units box
timestep        0.001
fix             1 all nve/eff
fix             2 all langevin/eff 300.0 300.0 20.0 4321 tally yes scale 3 2.0
compute         effTemp all temp/eff
thermo_style    custom step temp pe ke etotal f_2 c_effTemp
thermo_modify   temp effTemp format float %.15g
thermo          5
run             20
