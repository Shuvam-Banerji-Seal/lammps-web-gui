# oracle: fix addtorque/group on a two-atom (singular inertia) group with a variable torque and a pre-existing force
# oracle-compare: thermo=all atoms=all rel=1e-6 abs=1e-9
units           lj
atom_style      atomic
atom_modify     map array
region          box block -6 6 -6 6 -6 6
create_box      2 box
create_atoms    1 single 0.0 0.0 0.0 units box
create_atoms    1 single 1.2 0.0 0.0 units box
create_atoms    2 single 1.5 1.1 0.2 units box
create_atoms    2 single -0.4 1.0 0.3 units box
mass            * 1.0
pair_style      lj/cut 2.5
pair_coeff      * * 0.2 1.0 2.5
set             atom 1 vx 0.3 vy -0.2 vz 0.5
set             atom 2 vx -0.1 vy 0.4 vz 0.2
set             atom 3 vx 0.2 vy 0.1 vz -0.3
set             atom 4 vx 0.5 vy 0.0 vz 0.1
group           pair id 1 2
group           one id 2
variable        tz equal 0.7+0.1*step
fix             1 all nve
fix             3 one addforce 1.0 0.5 -0.2
fix             4 pair addtorque/group 2.0 0.5 v_tz
thermo_style    custom step pe ke f_4 f_4[1] f_4[2] f_4[3]
thermo_modify   format float %.15g
thermo          4
run             12
