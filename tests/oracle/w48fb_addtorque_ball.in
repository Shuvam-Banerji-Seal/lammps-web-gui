# oracle: fix addtorque/group on a dynamic group of a cut-down ball (examples/PACKAGES/addtorque_group)
# oracle-compare: thermo=all atoms=all rel=1e-6 abs=1e-9
units           lj
lattice         fcc 0.8442
boundary        f f f
region          ball sphere 0.0 0.0 0.0 2.5
region          box block -10 10 -10 10 -10 10
region          half block -10 0 -10 10 -10 10

create_box      2 box
create_atoms    1 region ball
pair_style      lj/cut 4.0
pair_coeff      * * 1.0 1.0
mass            * 1.0

set             region half type 2
group           ball dynamic all region ball
neigh_modify    delay 2 every 1 check yes
velocity        all create 1.2 12351235 loop all
fix             1 all nve
fix             2 all wall/reflect xlo EDGE xhi EDGE ylo EDGE yhi EDGE zlo EDGE zhi EDGE
thermo_style    custom step ke pe
thermo_modify   format float %.15g
thermo          5
run             10 post no
fix             4 ball addtorque/group 0.0 0.0 20.0
fix_modify      4 energy yes
run             15 post no
