# oracle: displace_atoms random (units lattice) on an fcc crystal before any run, then a run from the displaced positions
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
mass            1 1.0
displace_atoms  all random 0.02 0.02 0.02 4242 units lattice
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
timestep        0.005
fix             1 all nve
thermo_style    custom step temp pe etotal press
thermo_modify   format float %.15g
thermo          10
run             10
