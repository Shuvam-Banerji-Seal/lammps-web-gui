# oracle: sdpd/taitwater/isothermal fluid with a ring of wall atoms moved by fix meso/move rotate about the origin (period 2, axis z), 2d, 100 atoms, 300 steps
# measured max error vs native: thermo max relative 4.6e-15 (row 14 ke); per atom (relative to max(1,|value|)) 1.1e-14 (atom 43 vx). The wall atoms are moved by fix meso/move and their internal energy and density advance with fix sph half steps.
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
dimension       2
units           micro
atom_style      sph
variable        a equal 0.1
variable        T equal 300.
variable        rho_0 equal 1.
variable        c_0 equal 100.
variable        mu equal 1.
variable        h equal $a*4.5
variable        mass equal $a*$a*$a*${rho_0}
variable        dt equal 1e-3
variable        skin equal 0.2*$h
region          box block -0.5 0.5 -0.5 0.5 -0.5 0.5 units box
create_box      4 box
lattice         sq $a
create_atoms    1 box
region          upper_wall block INF INF +0.2 INF INF INF units box
set             region upper_wall type 3
region          lower_wall block INF INF INF -0.2 INF INF units box
set             region lower_wall type 4
group           fluid type 1
group           upper_wall type 3
group           lower_wall type 4
mass            * ${mass}
set             group all sph/rho ${rho_0}
pair_style      sdpd/taitwater/isothermal $T ${mu} 76787
pair_coeff      * * ${rho_0} ${c_0} ${h}
fix             1 fluid sph
fix             3 upper_wall meso/move rotate 0 0 0 0 0 1 2.0 units box
fix             4 lower_wall meso/move rotate 0 0 0 0 0 1 2.0 units box
fix             2 all enforce2d
neighbor        ${skin} bin
neigh_modify    delay 0 every 1 check yes
timestep        ${dt}
thermo_style    custom step time pe ke etotal
thermo_modify   format float %.15g
thermo          20
run             300
