# oracle: fix wall/gran/region hertz/history on a plane region (side in) as a flat wall: the distance is the projection onto the unit normal, effective radius = particle radius (curvature 0); polydisperse spheres under gravity, fix nve/sphere
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style sphere
atom_modify map array
comm_modify vel yes
boundary        f f f
region box block -4 4 -4 4 -1 8 units box
create_box 2 box
region reg plane 0.0 0.0 2.0 1.0 0.5 1.0 side in units box
region seed block -3 3 -3 3 2.5 6.0 units box
region fill intersect 2 seed reg
lattice sc 0.9
create_atoms 1 region fill
group odd id 1:60:2
set group odd type 2
set type 1 diameter 1.0 density 1.0
set type 2 diameter 1.15 density 1.4
velocity all set 0 0 -1.5 units box
variable wx atom 0.3*sin(0.3*id)
variable wy atom 0.3*cos(0.7*id)
variable wz atom 0.2*sin(1.1*id)
set group all omega v_wx v_wy v_wz
pair_style none
timestep 0.0005
fix 1 all nve/sphere
fix 2 all gravity 1.0 vector -1.0 -0.5 -1.0
fix 3 all wall/gran/region hertz/history 2000.0 1000.0 0.4 0.3 0.6 1 region reg
compute er all erotate/sphere
thermo_style custom step ke c_er press
thermo_modify format float %.15g
thermo 30
run 300
