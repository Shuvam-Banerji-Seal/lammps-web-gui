# Usage: lmp -var u <units> -in scripts/oracle/constants.in   (see src/engine/units.ts)
# measures the conversion constants a unit style uses, from observable output
units           ${u}
atom_style      charge
atom_modify     map yes
boundary        p p p
region          box block 0 10 0 10 0 10 units box
create_box      1 box
create_atoms    1 single 1 1 1 units box
create_atoms    1 single 4 1 1 units box
mass            1 1.0
set             atom * charge 1.0
pair_style      coul/cut 5
pair_coeff      * *
velocity        all set 1.0 0 0 units box
thermo_modify   norm no
run             0
variable        ke equal ke
variable        temp equal temp
variable        pe equal pe
variable        dens equal density
variable        vol equal vol
print           "KE $(v_ke:%.17g) TEMP $(v_temp:%.17g) PE $(v_pe:%.17g) DENS $(v_dens:%.17g) VOL $(v_vol:%.17g)"
# pressure with no pair virial: kspace/pair off
pair_style      zero 5
pair_coeff      * *
variable        p equal press
run             0
print           "PRESS0 $(v_p:%.17g)"
# ftm2v: constant force, one step from rest
velocity        all set 0 0 0 units box
fix             1 all nve
fix             2 all addforce 1.0 0 0
variable        dt equal dt
run             1
variable        vx equal vx[1]
print           "DT $(v_dt:%.17g) VX $(v_vx:%.17g)"
unfix           2
# qe2f: field on a unit charge
velocity        all set 0 0 0 units box
fix             3 all efield 1.0 0 0
run             0
variable        fx equal fx[1]
print           "FX_EFIELD $(v_fx:%.17g)"
