# oracle: dihedral_write of a harmonic dihedral type (dihedral table file, N 25 values, keyword HARM)
# oracle-files: w225cm_dihedral.table
# oracle-compare: thermo=all atoms=none
units           real
atom_style      full
region          box block -5 5 -5 5 -5 5
create_box      2 box bond/types 1 dihedral/types 2 extra/bond/per/atom 2 extra/dihedral/per/atom 2 extra/special/per/atom 3
create_atoms    1 single 0.0 0.0 0.0
mass            * 12.0
pair_style      zero 10.0
pair_coeff      * *
dihedral_style  harmonic
dihedral_coeff  1 2.0 1 180
dihedral_coeff  2 1.5 -1 3
dihedral_write  2 25 w225cm_dihedral.table HARM
