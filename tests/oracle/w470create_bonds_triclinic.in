# oracle: create_bonds many in a triclinic box (images through the tilted box vectors), a second pass with 1-2 and 1-3
# special exclusions (a special pair is skipped at its minimum images only), and a small untilted box where neighbours sit at
# exactly half a box length; bond counts, bond and pair energies in thermo
# oracle-compare: thermo=all atoms=all
units           lj
atom_style      bond
lattice         sc 1.0
region          box prism 0 3 0 3 0 3 0.6 -0.4 0.3
create_box      1 box bond/types 2 extra/bond/per/atom 40 extra/special/per/atom 200
create_atoms    1 box
mass            1 1.0
pair_style      lj/cut 2.55
pair_coeff      1 1 0.2 1.0
bond_style      harmonic
bond_coeff      1 10.0 1.0
bond_coeff      2 5.0 1.5
special_bonds   lj 0 0 1
create_bonds    many all all 1 0.9 1.1
thermo_style    custom step bonds pe ebond evdwl press
thermo_modify   format float %.15g
run             0
create_bonds    many all all 2 1.1 1.8
run             0
change_box      all x final 0 2 y final 0 2 z final 0 2 xy final 0.0 xz final 0.0 yz final 0.0 remap units box
create_bonds    many all all 2 0.9 1.25
run             0
