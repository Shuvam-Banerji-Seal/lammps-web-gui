# oracle: DRUDE ethanol without its drude atoms and dihedrals (250 molecules, 2250 atoms, 5 types, from examples/PACKAGES/drude/ethanol): fix shake 1e-4 20 0 on the C-H, O-H and C-O bonds (b 2 3 5), i.e. 2-, 3- and 4-atom clusters; run 0: step-0 thermo and per-atom forces
# oracle-inputs: w73shake_eth.data
units real
boundary p p p
atom_style full
bond_style harmonic
angle_style harmonic
dihedral_style opls
special_bonds lj/coul 0.0 0.0 0.5
pair_style lj/cut/coul/cut 8.0
read_data w73shake_eth.data
pair_coeff * * 0.0 0.0
pair_coeff 1 1 0.065997 3.500000 # C3H C3H
pair_coeff 1 2 0.065997 3.500000 # C3H CTO
pair_coeff 1 3 0.044496 2.958040 # C3H H
pair_coeff 1 4 0.105921 3.304542 # C3H OH
pair_coeff 1 5 0.000000 0.000000 # C3H HO
pair_coeff 2 2 0.065997 3.500000 # CTO CTO
pair_coeff 2 3 0.044496 2.958040 # CTO H
pair_coeff 2 4 0.105921 3.304542 # CTO OH
pair_coeff 2 5 0.000000 0.000000 # CTO HO
pair_coeff 3 3 0.029999 2.500000 # H H
pair_coeff 3 4 0.071413 2.792848 # H OH
pair_coeff 3 5 0.000000 0.000000 # H HO
pair_coeff 4 4 0.169996 3.120000 # OH OH
pair_coeff 4 5 0.000000 0.000000 # OH HO
pair_coeff 5 5 0.000000 0.000000 # HO HO
group gATOMS type 1 2 3 4 5
fix fSHAKE gATOMS shake 0.0001 20 0 b 2 3 5
fix fNVE all nve
thermo_style custom step temp pe ebond eangle evdwl ecoul press pxx pyy pzz
thermo_modify format float %.15g
run 0
