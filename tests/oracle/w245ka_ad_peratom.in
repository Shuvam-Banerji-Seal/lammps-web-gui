# oracle: per-atom k-space energy and virial with kspace_modify diff ad: compute pe/atom and stress/atom (all and kspace) against native; ad builds the per-atom virial bricks with poisson_peratom and takes the energy from its own potential brick
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 5.5e-14, atoms 5.4e-14; the per-atom energy and stress dump agrees within 1e-10.
# oracle-files: w245ka_ad.dump
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=1e-10 filerel=1e-10
units           real
atom_style      charge
boundary        p p p
lattice         sc 3.1
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
set             type 1 type/fraction 2 0.5 4321
set             type 1 charge 0.6
set             type 2 charge -0.6

displace_atoms  all random 0.3 0.3 0.3 9187 units box
mass            * 20.0
pair_style      lj/cut/coul/long 5.0
pair_coeff      * * 0.1 2.6
kspace_style    pppm 1.0e-5
kspace_modify   diff ad
compute         pe all pe/atom
compute         pek all pe/atom kspace
compute         st all stress/atom NULL
compute         stk all stress/atom NULL kspace
compute         spe all reduce sum c_pe c_pek
velocity        all create 300 8812 loop geom
fix             1 all nve
timestep        1.0
thermo_style    custom step pe elong c_spe[1] c_spe[2] press
thermo_modify   format float %.15g norm no
thermo          5
dump            d all custom 10 w245ka_ad.dump id c_pe c_pek c_st[1] c_st[2] c_st[3] c_st[4] c_st[5] c_st[6] c_stk[1] c_stk[3] c_stk[6]
dump_modify     d sort id format float %.15g
run             10
