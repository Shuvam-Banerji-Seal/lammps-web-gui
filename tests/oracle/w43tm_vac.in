# Wave 43: fix ttm/mod with two empty cells (T_e = 0, cells (1,1,1) and (2,2,2)) that hold atoms of an eight-atom sc crystal:
# the atoms there take no electron-ion force and draw no random number, the empty cells exchange no energy; D_e 0.4,
# gamma_p 15, gamma_s 3 with v_0 1, seed 4242; outfile every step (compared token by token).
# oracle-inputs: w43tm_vac.par w43tm_vac.init
# oracle-files: w43tm_vac.out.1 w43tm_vac.out.2 w43tm_vac.out.3
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           metal
atom_style      atomic
lattice         sc 3.0
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box
mass            1 10.0
displace_atoms  all move 0.5 0.5 0.5 units box
variable        vx atom 9.0*sin(0.9*x+0.4*y)
variable        vy atom 7.0*cos(0.7*y-0.5*z)
variable        vz atom 6.0*sin(1.1*z+0.3*x)
velocity        all set v_vx v_vy v_vz units box
velocity        all zero linear
pair_style      lj/cut 3.0
pair_coeff      1 1 0.0 2.0
fix             1 all nve
fix             2 all ttm/mod 4242 w43tm_vac.par 2 2 2 infile w43tm_vac.init outfile 1 w43tm_vac.out
timestep        0.001
thermo_style    custom step temp pe f_2[1] f_2[2]
thermo_modify   format float %.15g
thermo          1
run             3
