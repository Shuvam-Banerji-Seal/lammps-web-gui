# oracle-inputs: w115p_mil53_pair.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# oracle: pair mm3/switch3/coulgauss/long (MIL-53(Al), 152 atoms) of examples/PACKAGES/yaff/mil53al cut down: bonded terms removed from the data file (no bond, angle, dihedral or improper), pppm, pair_modify table 16, 3 steps
units           real
atom_style      full
boundary        p p p
dielectric      1
special_bonds   lj 0.000000 0.000000 1.000000 coul 1.000000 1.000000 1.000000
pair_style      mm3/switch3/coulgauss/long  12.0000  4.0000
pair_modify     table 16
pair_modify     mix arithmetic
pair_modify     tail no
read_data       w115p_mil53_pair.data
kspace_style    pppm 0.0000001
neighbor        2.0 bin
neigh_modify    every 2 delay 4 check yes
thermo_style    custom step etotal ke temp pe evdwl ecoul elong press pxx pyy pzz
thermo_modify   format float %.15g
thermo          1
timestep        0.5
velocity        all create 0.0 5
fix             1 all nve
run             3
