# image_grid fixture: native b332f28 (/home/roy/.local/bin/lmp), dump image PPM.
units lj
dimension 2
atom_style atomic
lattice sq 0.8
region box block 0 6 0 5 -0.5 0.5
create_box 1 box
create_atoms 1 box
mass * 1.0
pair_style lj/cut 2.5
pair_coeff * * 1.0 1.0
compute pg all property/grid 6 5 1 x y
dump d all image 1 img.*.ppm type type size 128 128 box yes 0.02 grid c_pg:grid:data[1]
dump_modify d pad 0 adiam * 0.3
run 0
