# oracle: atom_style body rounded/polyhedron with a box polyhedron (8 vertices, 12 edges, 6 faces, off-diagonal inertia), a one-vertex body (sphere) and a two-vertex body (rod with a zero moment), free rotation under fix nve/body with no interaction (pair zero), 200 steps; thermo pe ke etotal and the atom state
# oracle-inputs: w121body_free_polyhedra.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-12
units           lj
dimension       3
atom_style      body rounded/polyhedron 1 8
atom_modify     map array
read_data       w121body_free_polyhedra.data
set             atom 1 angmom 0.3 -0.2 0.5
set             atom 2 angmom -0.4 0.1 0.2
set             atom 3 angmom 0.2 0.3 -0.1
set             atom 1 vx 0.1 vy 0.0 vz -0.05
set             atom 2 vx -0.02 vy 0.05 vz 0.0
set             atom 3 vx 0.0 vy 0.1 vz 0.02
pair_style      zero 1.0
pair_coeff      * *
fix             1 all nve/body
group           boxsph id 1 2
compute         q boxsph property/atom quatw quati quatj quatk
compute         qs boxsph reduce sum c_q[1] c_q[2] c_q[3] c_q[4]
compute         am all property/atom angmomx angmomy angmomz
compute         ams all reduce sum c_am[1] c_am[2] c_am[3]
thermo_style    custom step pe ke etotal press c_qs[1] c_qs[2] c_qs[3] c_qs[4] c_ams[1] c_ams[2] c_ams[3]
thermo_modify   format float %.15g
thermo          20
timestep        0.005
run             200
