# oracle: pair hybrid/overlay lj/cut 2.5 + coul/cut/global 2.5 + coul/exclude 2.5 on a molecular chain system: the excluded special pairs keep the list
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 4.8e-12, atoms 5.7e-13. The energy columns (pe, evdwl, ecoul, ke) agree to 1e-14; the thermo maximum is in the pressure components, whose virial is summed in a different order (fdotr).
# oracle-inputs: w219xp_chains.data
# oracle-compare: thermo=all atoms=all rel=1e-11 abs=1e-13
units        lj
atom_style   full
read_data    w219xp_chains.data
mass         * 1.0
velocity     all create 1.0 4242
timestep     0.001
fix          1 all nve
special_bonds lj/coul 0.0 0.5 0.8
pair_style   hybrid/overlay lj/cut 2.5 coul/cut/global 2.5 coul/exclude 2.5
pair_coeff   * * lj/cut 0.2 1.0
pair_coeff   * * coul/cut/global
pair_coeff   * * coul/exclude
bond_style   harmonic
bond_coeff   1 200.0 1.1
thermo_style custom step pe evdwl ecoul ke press pxx pyy pzz pxy pxz pyz
thermo_modify format float %.15g
thermo       20
run          200
