# oracle: angle_style mwlc (k1 k2 mu T, kB = force->boltz of real units), 150 steps, nve
# native: b332f28 (installed /home/roy/.local/bin/lmp)
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 8.2e-13, atoms 1.3e-11.
# oracle-inputs: w217xb_mol.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           real
atom_style      molecular
bond_style      harmonic
angle_style     mwlc
dihedral_style  harmonic
improper_style  harmonic
pair_style      zero 2.5
read_data       w217xb_mol.data
pair_coeff      * *
bond_coeff      1 300.0 1.2
bond_coeff      2 250.0 1.3
angle_coeff     1 2.0 1.0 1.5 300.0
angle_coeff     2 3.0 0.5 0.8 350.0
dihedral_coeff  1 1.5 -1 3
dihedral_coeff  2 0.7 1 2
improper_coeff  1 12.0 20.0
variable        vx atom 0.02*sin(1.3*x+0.7*y)
variable        vy atom 0.02*cos(0.9*y-0.4*z)
variable        vz atom 0.02*sin(1.1*z+0.5*x)
velocity        all set v_vx v_vy v_vz
velocity        all zero linear
timestep        0.1
fix             1 all nve
thermo_style    custom step pe ebond eangle edihed eimp ke press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g norm no
thermo          25
run             150
