# oracle: read_data of an atom_style template file (template index and atom columns, topology from the molecule template), 100-step nve, then write_data
# oracle-inputs: w24tmpl_a.txt w24tmpl_read.data
# oracle-files: w24tmpl_read_out.data
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           real
boundary        p p p
molecule        chain w24tmpl_a.txt
atom_style      template chain
pair_style      lj/cut 4.0
pair_modify     mix geometric
bond_style      harmonic
angle_style     harmonic
dihedral_style  harmonic
read_data       w24tmpl_read.data
fix             1 all nve
timestep        1.0
thermo          10
thermo_style    custom step temp pe ebond eangle edihed etotal press atoms
thermo_modify   format float %.15g norm no
run             100
write_data      w24tmpl_read_out.data
