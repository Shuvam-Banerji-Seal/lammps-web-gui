# oracle: compute property/atom nbonds with newton_bond off (native num_bond: each bond at both of its atoms)
# oracle-inputs: w220xp_chain.data
# oracle-files: w616pa_nbonds_off.dump
# oracle-compare: thermo=all atoms=all rel=1e-12 abs=1e-14
newton       on off
units        lj
boundary     p p p
atom_style   full
read_data    w220xp_chain.data extra/bond/per/atom 6 extra/special/per/atom 12
mass         * 1.0
bond_style   harmonic
bond_coeff   1 50.0 1.2
special_bonds lj/coul 0.0 0.5 0.8
pair_style   lj/cut 1.5
pair_coeff   * * 1.0 1.0
group        two type 2
create_bonds many two two 1 1.1 1.3
compute      nb all property/atom nbonds
compute      nbs all reduce sum c_nb
dump         d all custom 1 w616pa_nbonds_off.dump id c_nb
dump_modify  d sort id
thermo_style custom step pe c_nbs
thermo_modify format float %.15g
run          0
