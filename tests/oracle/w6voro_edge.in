# oracle: compute voronoi/atom edge_histo (global vector of face edge counts) on a distorted fcc crystal, printed via thermo
# oracle-compare: thermo=all
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 1.0
variable        dx atom 0.08*sin(1.3*x+0.7*y)
variable        dy atom 0.08*cos(0.9*y-1.1*z)
variable        dz atom 0.08*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
compute         v all voronoi/atom edge_histo 8
thermo_style    custom step c_v[1] c_v[2] c_v[3] c_v[4] c_v[5] c_v[6] c_v[7] c_v[8] c_v[9]
thermo_modify   format float %.15g
run             0
