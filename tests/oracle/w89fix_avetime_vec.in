# oracle: fix ave/time with two inputs (c_p extensive, c_t intensive): thermo normalises only the extensive element
# oracle-compare: rel=1e-12 abs=1e-14
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 1.44 87287 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
timestep        0.005
fix             1 all nve
compute         p all pe
compute         t all temp
fix             a all ave/time 2 2 4 c_p c_t ave one
thermo_style    custom step temp f_a[1] f_a[2]
thermo_modify   format float %.15g
thermo          4
run             8
