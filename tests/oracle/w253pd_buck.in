# oracle: pair buck/long/coul/long long long 2.5 with kspace pppm/disp 1.0e-4 (automatic Coulomb G-ewald and grid, dispersion auto with the geometric B = sqrt(C_ii) of buck_c), charges +-0.5 on 108 fcc atoms, run 0 then 20 NVE steps
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 5.0e-14, atoms 1.2e-15.
# oracle-compare: thermo=all atoms=all
units           lj
atom_style      charge
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
mass            * 1.0
group           odd id 1:108:2
set             group odd type 2
set             type 1 charge 0.5
set             type 2 charge -0.5
displace_atoms  all random 0.05 0.05 0.05 4421 units box
velocity        all create 1.44 87287 loop geom
pair_style      buck/long/coul/long long long 2.5
pair_coeff      1 1 10.0 0.35 1.0
pair_coeff      1 2 8.0 0.35 0.6
pair_coeff      2 2 6.0 0.40 0.5
kspace_style    pppm/disp 1.0e-4
kspace_modify   disp/auto yes
timestep        0.005
fix             1 all nve
thermo_style    custom step temp pe evdwl elong ecoul press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          5
run             0
run             20
