# oracle: so3 descriptor 2 elements, 8 random atoms in a periodic 7 A box, 2 types, linear model, 20 NVE steps
# oracle-inputs: w37so3_cluster.mliap.descriptor w37so3_cluster.mliap.model
# oracle-compare: thermo=all atoms=all rel=1e-8
units           metal
atom_style      atomic
boundary        p p p
region          box block 0 7 0 7 0 7
create_box      2 box
create_atoms 2 single 3.290635 5.097850 2.126260 units box
create_atoms 1 single 6.211088 2.870620 5.016301 units box
create_atoms 1 single 1.856548 1.716167 5.688071 units box
create_atoms 2 single 3.488110 2.911105 5.094314 units box
create_atoms 1 single 3.635455 5.119521 6.997642 units box
create_atoms 1 single 1.444673 5.268135 3.279733 units box
create_atoms 2 single 4.963244 6.103347 1.038600 units box
create_atoms 1 single 1.488277 2.883373 0.409395 units box
mass            * 1.0
velocity        all create 300.0 4928459
pair_style      mliap model linear w37so3_cluster.mliap.model descriptor so3 w37so3_cluster.mliap.descriptor
pair_coeff      * * A B
fix             1 all nve
thermo_style    custom step pe press
thermo_modify   format float %.15g
timestep        0.0005
thermo          5
run             20
