# oracle: pair_style eim, three elements mapped to four atom types (type 4 repeats Qa), fcc crystal with displaced atoms, NVE
# oracle-inputs: w14eim_three.eim
# oracle-compare: thermo=all atoms=all
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 4.9e-14, atoms 1.1e-14.
units           metal
atom_style      atomic
lattice         fcc 4.1
region          box block 0 2 0 2 0 2
create_box      4 box
create_atoms    1 box
group           bb id 2 7 12 17 22 27 32
group           cc id 3 8 13 18 23 28
group           dd id 5 10 15 20 25 30
set             group bb type 2
set             group cc type 3
set             group dd type 4
pair_style      eim
pair_coeff      * * Qa Qb Qc w14eim_three.eim Qa Qb Qc Qa
variable        dx atom 0.08*sin(0.9*x+0.4*y)
variable        dy atom 0.08*cos(0.7*y-0.5*z)
variable        dz atom 0.08*sin(1.1*z+0.3*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.5*sin(0.9*x+0.4*z)
variable        vy atom 0.5*cos(0.6*y+0.8*x)
variable        vz atom 0.5*sin(0.7*z-0.3*y)
velocity        all set v_vx v_vy v_vz units box
velocity        all zero linear
timestep        0.001
fix             1 all nve
thermo_style    custom step temp pe etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          5
run             10
