# oracle: w484nh_drag_aniso_ploop — fix npt aniso with unequal Pdamp (x y z), drag 0.5 and ploop 2: native's pdrag_factor = 1 - dt p_freq_max drag / nc_pchain
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# Measured with native LAMMPS: max relative error 6.1e-15 on thermo, 3.6e-13 per atom.
units lj
atom_style atomic
lattice fcc 0.8442
region box block 0 4 0 4 0 4
create_box 1 box
create_atoms 1 box
mass 1 1.0
velocity all create 1.0 87287 loop geom
pair_style lj/cut 2.5
pair_coeff 1 1 1.0 1.0 2.5
fix 1 all npt temp 1.0 1.0 0.5 x 1.0 1.0 0.7 y 1.0 1.0 1.3 z 1.0 1.0 2.0 drag 0.5 ploop 2
thermo_style custom step temp pe press pxx pyy pzz vol lx ly lz f_1
thermo_modify format float %.15g
thermo 10
run 60
