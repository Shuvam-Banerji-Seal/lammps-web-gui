# oracle: fix wall/gran/region on a union region (a block container with an overlapping chimney block), normal-only hooke, spheres under gravity
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           lj
atom_style      sphere
atom_modify     map array
comm_modify     vel yes
boundary        f f f
region          box block -8 8 -8 8 -2 14 units box
create_box      1 box
region          A block -4 4 -4 4 0 6 side in units box
region          B block -2 2 -2 2 2 10 side in units box
region          U union 2 A B
lattice         sc 1.2 origin 0.5 0.5 0.5
create_atoms    1 region U
set             type 1 diameter 0.9 density 1.0
velocity        all set 0 0 -0.5 units box
pair_style      none
timestep        0.0005
fix             1 all nve/sphere
fix             2 all gravity 1.0 vector 0 0 -1
fix             3 all wall/gran/region hooke/history 2000.0 1000.0 30.0 30.0 0.5 1 region U
thermo_style    custom step ke pe etotal
thermo_modify   format float %.15g
thermo          20
run             200
