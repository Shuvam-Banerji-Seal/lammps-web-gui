# oracle: fix wall/gran/region on a region that moves (move v_dx), hooke with normal damping; the wall velocity enters the contact
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           lj
atom_style      sphere
atom_modify     map array
comm_modify     vel yes
boundary        f f f
region          box block -10 14 -8 8 -2 12 units box
create_box      1 box
variable        dx equal 0.02*time
region          A block -4 4 -4 4 0 6 side in units box move v_dx NULL NULL
lattice         sc 1.2 origin 0.5 0.5 0.5
create_atoms    1 region A
set             type 1 diameter 0.9 density 1.0
velocity        all set 0 0 -0.5 units box
pair_style      none
timestep        0.0005
fix             1 all nve/sphere
fix             2 all gravity 1.0 vector 0 0 -1
fix             3 all wall/gran/region hooke 2000.0 1000.0 30.0 30.0 0.5 1 region A
thermo_style    custom step ke pe etotal
thermo_modify   format float %.15g
thermo          20
run             200
