# oracle: min_style spin (damped spin minimization, alpha_damp 1.0, discrete_factor 10) on bcc iron 3x3x3 cells, 54 random spins, spin/exchange and precession/spin anisotropy, 100 iterations
# measured with native LAMMPS (black box), engine vs native fixture: thermo max relative error 2.0e-13; spin dump 2.6e-10; re-measured under Node 20: the same.
# oracle-files: w103spin_min_spin.dump
# oracle-compare: thermo=all atoms=none rel=1e-8 abs=1e-10
units           metal
atom_style      spin
boundary        p p p
atom_modify     map array
lattice         bcc 2.8665
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 55.845
set             group all spin/atom/random 31 2.2
pair_style      spin/exchange 3.5
pair_coeff      * * exchange 3.4 0.02726 0.2171 1.841
neighbor        0.1 bin
neigh_modify    every 10 check yes delay 20
fix             1 all precession/spin anisotropy 0.0001 0.0 0.0 1.0
fix_modify      1 energy yes
timestep        0.0001
compute         s all spin
compute         p all property/atom spx spy spz sp fmx fmy fmz
thermo_style    custom step pe c_s[1] c_s[2] c_s[3] c_s[4] c_s[5] c_s[6]
thermo_modify   format float %.15g
thermo          10
min_style       spin
min_modify      alpha_damp 1.0 discrete_factor 10.0
minimize        1.0e-10 1.0e-10 100 1000
write_dump      all custom w103spin_min_spin.dump id c_p[1] c_p[2] c_p[3] c_p[4] c_p[5] c_p[6] c_p[7] modify format float %.15g sort id
