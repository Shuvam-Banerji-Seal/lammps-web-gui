# oracle: fix graphics/isosurface on a dynamic group (the atoms whose scaled |vx| has a fractional part above 0.5,
# re-evaluated every 5 steps): the surface is built from the group's atoms of each output step; a ball of lj/cut atoms
# oracle-files: w463iso.0.stl w463iso.5.stl w463iso.10.stl
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      atomic
boundary        p p f
lattice         fcc 0.8442
region          box block 0 6 0 6 0 6
create_box      1 box
region          ball sphere 0.0 3.0 3.0 1.8
create_atoms    1 region ball
mass            1 1.0
velocity        all create 2.0 4711 loop geom
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0 2.5
neighbor        0.5 bin
neigh_modify    every 20 delay 0 check no
variable        up atom (abs(vx)*1e2-floor(abs(vx)*1e2))>0.5
group           dyn dynamic all var up every 5
variable        ndyn equal count(dyn)
fix             1 all nve
fix             iso dyn graphics/isosurface 5 0.4 1.0 quality min filename w463iso.*.stl
thermo          5
thermo_style    custom step temp pe v_ndyn
thermo_modify   format float %.15g
run             10
