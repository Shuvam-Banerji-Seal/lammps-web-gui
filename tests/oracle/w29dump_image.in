# oracle: dump image renders a snapshot without changing the physics output of the run
units           lj
atom_style      atomic
boundary        f f f
region          box block 0 10 0 10 0 10
create_box      2 box
create_atoms    1 single 5.0 5.0 5.0
create_atoms    2 single 5.0 7.0 5.0
mass            * 1.0
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0 2.5
dump            im all image 1 img.*.ppm type type size 64 64 box no 0.02 view 90 0
thermo_style    custom step pe
thermo_modify   format float %.15g
run             0
