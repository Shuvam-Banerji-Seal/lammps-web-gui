# oracle: compute pe/atom and stress/atom (kspace terms) with kspace_style pppm/electrode, slab 8.0 and fix electrode/conp algo cg (the w68elec_madelung_pppm_cg system), per-atom values dumped at step 0
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 3.0e-15, atoms 1.1e-14.
# oracle-inputs: w68elec_au_elyt.data
# oracle-files: w268el_pppm_peratom.dump
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=1e-12 filerel=1e-10
boundary        p p f
kspace_style    pppm/electrode 1.0e-8
kspace_modify   slab 8.0
units           real
atom_style      full
pair_style      lj/cut/coul/long 12
read_data       w68elec_au_elyt.data
group           bot type 1
group           top type 2
variable        q atom q
compute         qbot bot reduce sum v_q
compute         qtop top reduce sum v_q
fix             conp bot electrode/conp 0 2 couple top 1 symm on algo cg 1e-6
thermo_style    custom step pe c_qbot c_qtop f_conp
thermo_modify   format float %.15g
compute         pa all pe/atom kspace
compute         sa all stress/atom NULL kspace
dump            d all custom 1000 w268el_pppm_peratom.dump id c_pa c_sa[1] c_sa[2] c_sa[3]
dump_modify     d sort id format float %.15g
run             0
