# oracle: improper_style ring (K theta0, the second atom of each quadruplet is the atom of symmetry), 150 steps, nve
# native: b332f28 (installed /home/roy/.local/bin/lmp)
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 1.2e-14, atoms 2.6e-13.
# oracle-inputs: w217xb_mol.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      molecular
bond_style      harmonic
angle_style     harmonic
dihedral_style  harmonic
improper_style  ring
pair_style      zero 2.5
read_data       w217xb_mol.data
pair_coeff      * *
bond_coeff      1 50.0 1.1
bond_coeff      2 40.0 1.2
angle_coeff     1 20.0 110.0
angle_coeff     2 15.0 105.0
dihedral_coeff  1 1.5 -1 3
dihedral_coeff  2 0.7 1 2
improper_coeff  1 80.0 70.5
variable        vx atom 0.02*sin(1.3*x+0.7*y)
variable        vy atom 0.02*cos(0.9*y-0.4*z)
variable        vz atom 0.02*sin(1.1*z+0.5*x)
velocity        all set v_vx v_vy v_vz
velocity        all zero linear
timestep        0.0005
fix             1 all nve
thermo_style    custom step pe ebond eangle edihed eimp ke press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g norm no
thermo          25
run             150
