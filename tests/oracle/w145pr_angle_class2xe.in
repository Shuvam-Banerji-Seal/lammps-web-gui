# oracle: angle_style class2xe (ClassII-xe) on the mol_chains angles, the coefficients of the class2xe example (PCFF
# c2/c3/cp/hc angle types) on two types, other terms harmonic, pair zero; 40 steps. Cut down from
# examples/PACKAGES/class2xe/in.NVT_class2xe.script (the example's dihedral class2xe is not used here).
# native: b332f28 (installed /home/roy/.local/bin/lmp)
# measured 2026-10-14 (engine vs native, max relative error, thermo |a-b|/|b|, per-atom |a-b|/max(1,|b|)): thermo 9.9e-15, per-atom 1.8e-13; passes at rel 1e-8 abs 1e-10.
# oracle-inputs: mol_chains.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      molecular
bond_style      harmonic
angle_style     class2xe
dihedral_style  harmonic
improper_style  harmonic
pair_style      zero 2.5
read_data       mol_chains.data
pair_coeff      * *
bond_coeff      1 120.0 1.05
bond_coeff      2 90.0 1.1
angle_coeff     1 110.77 41.453 -10.604 5.129
angle_coeff     1 bb 90.4638 0.13682580 1.53 1.101
angle_coeff     1 ba 82.6961 98.2315 0.35423657 0.24110803 1.53 1.101
angle_coeff     2 120.05 44.7148 -22.7352 0.0
angle_coeff     2 bb 116.34805 0.22772772 1.501 1.417
angle_coeff     2 ba 82.6961 150.0 0.53340706 0.32185452 1.501 1.417
dihedral_coeff  1 1.5 -1 3
improper_coeff  1 12.0 20.0
special_bonds   lj 0.0 0.5 0.8
variable        vx atom 0.1*sin(1.3*x+0.7*y)
variable        vy atom 0.1*cos(0.9*y-0.4*z)
variable        vz atom 0.1*sin(1.1*z+0.5*x)
velocity        all set v_vx v_vy v_vz
velocity        all zero linear
timestep        0.002
fix             1 all nve
thermo_style    custom step temp pe ebond eangle edihed eimp evdwl etotal press
thermo_modify   format float %.15g norm no
thermo          10
run             40
