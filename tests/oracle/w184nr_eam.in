# oracle: native binary restart of pair eam, which stores no restart info (the NO_PAIR marker): the pair style is specified again after read_restart, run 40 steps
# oracle-inputs: w184nr_eam.restart
# oracle-potentials: Cu_u3.eam
# native: b332f28 built as the parity binary wrote w184nr_eam.restart (fcc Cu 3x3x3, eam, 40 steps, 108 atoms)
read_restart    w184nr_eam.restart
pair_style      eam
pair_coeff      * * Cu_u3.eam
timestep        0.001
fix             1 all nve
thermo_style    custom step temp epair etotal press
thermo_modify   format float %.15g
thermo          20
run             40
# oracle-compare: thermo=all atoms=all rel=1e-12 abs=1e-14
# measured: max relative error 1.0e-13 (vz of atom 72 after 40 steps), so the tolerance is 1e-12
