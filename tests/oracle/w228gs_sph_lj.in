# oracle: pair sph/lj (Lennard-Jones equation of state, artificial viscosity) with fix sph and compute sph/t/atom on a periodic 64-particle sph block, 20 steps
# oracle-inputs: w228gs_sph_lj.data
# oracle-files: w228gs_sph_lj.dump
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10 filerel=1e-8
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 7.3e-16, atoms 3.0e-14.
units           lj
atom_style      sph
read_data       w228gs_sph_lj.data
mass            1 1.0
pair_style      sph/lj
pair_coeff      * * 0.1 1.3
compute         t all sph/t/atom
fix             1 all nve
fix             2 all sph
timestep        0.0005
dump            1 all custom 10 w228gs_sph_lj.dump id x y z vx vy vz c_t
dump_modify     1 sort id format float %.15g
thermo_style    custom step pe ke
thermo_modify   format float %.15g
run             20
