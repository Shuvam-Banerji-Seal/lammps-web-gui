# oracle: fix srd with big sphere particles and SRD particles, 2d (cut-down of examples/srd/in.srd.mixture: 3x3 box, no equilibration run, 400 SRD steps)
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# Measured with native LAMMPS (black box): the engine agrees to a relative error between 1e-12 and 1e-11 (the first difference above 1e-12 is at step 280, v_pebig); the per-atom state passes at 1e-11 too. Native atom_modify first disables the spatial sort, which the engine now matches.
units		lj
atom_style	sphere
atom_modify	first big
dimension	2

lattice		sq 0.4
region		box block 0 3 0 3 -0.5 0.5
create_box	2 box
create_atoms	1 region box
set		type 1 mass 1.0
set		type 1 diameter 1.0

group		big type 1
velocity	big create 1.44 87287 loop geom

pair_style	lj/cut 2.5
pair_coeff	1 1 1.0 1.0
pair_coeff	2 2 0.0 1.0 0.0
pair_coeff	1 2 0.0 1.0 0.0

neighbor	0.3 bin
neigh_modify	delay 0 every 1 check yes


lattice		sq 0.4
region		plane block 0 3 0 3 -0.001 0.001
lattice		sq 85.0
create_atoms	2 region plane
set		type 2 mass 0.01
set		type 2 diameter 0.0

group		small type 2

velocity	small create 1.0 593849 loop geom

pair_style	lj/cut 2.5
pair_coeff	1 1 1.0 1.0
pair_coeff	2 2 0.0 1.0 0.0
pair_coeff	1 2 0.0 1.0 0.5

delete_atoms	overlap 0.5 small big

reset_timestep	0

neighbor	0.3 multi
neigh_modify	delay 0 every 1 check yes

comm_modify	mode multi group big vel yes
neigh_modify	include big

pair_style	lj/cut 2.5
pair_coeff	1 1 1.0 1.0
pair_coeff	2 2 0.0 1.0 0.0
pair_coeff	1 2 0.0 1.0 0.0

timestep	0.001

fix		1 big nve
fix	        2 small srd 20 big 1.0 0.25 49894 radius 0.88 search 0.2 collision slip
fix		3 all enforce2d

compute		tbig big temp
variable	pebig equal pe*atoms/count(big)
variable	ebig equal etotal*atoms/count(big)
thermo_style	custom step temp f_2[7] etotal v_pebig v_ebig press f_2[1] f_2[2] f_2[3] f_2[4] f_2[5] f_2[6] f_2[8] f_2[9] f_2[10]

thermo_modify	temp tbig format float %.15g
thermo		20

run		400
