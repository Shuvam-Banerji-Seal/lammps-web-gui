# oracle: compute voronoi/atom in a restricted triclinic box with surface, edge_histo and radius keywords
# oracle-files: w29voro_tri_kw.dump
units           lj
boundary        p p p
atom_style      atomic
lattice         sc 1.0 origin 0.5 0.5 0.5
region          box block 0 4 0 4 0 4 units box
region          atoms block 0 4 0 4 0 4 units box
create_box      2 box
create_atoms    1 region atoms
mass            * 1.0
region          left block INF 2.0 INF INF INF INF units box
group           small region left
set             group small type 2
variable        rad atom (type==1)*0.25+(type==2)*0.1
change_box      all triclinic
change_box      all xy final 0.5 remap units box
pair_style      lj/cut 0.5
pair_coeff      * * 0.0 1.0
neighbor        0.3 bin
comm_modify     cutoff 5.0
compute         v all voronoi/atom surface small edge_histo 8 radius v_rad
thermo_style    custom step c_v[1] c_v[2] c_v[3] c_v[4] c_v[5] c_v[6] c_v[7] c_v[8] c_v[9]
thermo_modify   format float %.15g
dump            d all custom 1 w29voro_tri_kw.dump id type c_v[*]
dump_modify     d sort id format float %.17g
run             0
