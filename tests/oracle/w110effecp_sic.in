# oracle: eFF ECP SiC bulk (examples/PACKAGES/eff/ECP/SiC/bulk cut down): periodic, eff/cut 20.0 limit/eradius pressure/evirials ecp 1 Si 2 C with two pair_coeff ECP lines, cg minimization for 3 iterations
# oracle-inputs: w110effecp_sic.data
# oracle-files: w110effecp_sic_er.dump
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-12 atomrel=1e-8 filerel=1e-8
units           electron
newton          on
boundary        p p p
atom_style      electron
read_data       w110effecp_sic.data
pair_style      eff/cut 20.0 limit/eradius pressure/evirials ecp 1 Si 2 C
pair_coeff      * *
pair_coeff      1 s 0.320852 2.283269 0.814857
pair_coeff      2 p 22.721015 0.728733 1.103199 17.695345 6.693621
comm_modify     vel yes
neigh_modify    one 4000 page 40000
compute         energies all pair eff/cut
variable        eke equal c_energies[1]
variable        epauli equal c_energies[2]
variable        ecoul equal c_energies[3]
variable        erres equal c_energies[4]
variable        etotalnew equal c_energies[1]+c_energies[2]+c_energies[3]+c_energies[4]
thermo          1
thermo_style    custom step etotal pe ke v_etotalnew v_eke v_epauli v_ecoul v_erres press
thermo_modify   format float %.15g
compute         er all property/atom spin eradius ervel erforce
min_style       cg
min_modify      line quadratic
minimize        0 1e-8 3 30
write_dump      all custom w110effecp_sic_er.dump id c_er[1] c_er[2] c_er[3] c_er[4] modify format float %.15g
