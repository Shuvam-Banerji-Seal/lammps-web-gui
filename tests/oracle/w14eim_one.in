# oracle: pair_style eim, one element (p = 2 pair term), fcc crystal with displaced atoms, NVE
# oracle-inputs: w14eim_one.eim
# oracle-compare: thermo=all atoms=all
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 3.3e-13, atoms 8.4e-14.
units           metal
atom_style      atomic
lattice         fcc 4.1
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box
pair_style      eim
pair_coeff      * * Qa w14eim_one.eim Qa
variable        dx atom 0.08*sin(0.9*x+0.4*y)
variable        dy atom 0.08*cos(0.7*y-0.5*z)
variable        dz atom 0.08*sin(1.1*z+0.3*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 2.0*sin(0.9*x+0.4*z)
variable        vy atom 2.0*cos(0.6*y+0.8*x)
variable        vz atom 2.0*sin(0.7*z-0.3*y)
velocity        all set v_vx v_vy v_vz units box
velocity        all zero linear
timestep        0.001
fix             1 all nve
thermo_style    custom step temp pe etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          10
run             50
