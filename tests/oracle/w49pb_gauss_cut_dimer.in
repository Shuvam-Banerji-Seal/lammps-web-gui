# oracle: pair_style gauss/cut 8.0 with explicit 1-1 and 2-2 (1-2 mixed geometric, then arithmetic, pair_modify shift yes in the second block), dimer scan with per-pair cutoffs 6.0 and 5.0
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           real
atom_style      full
clear
units           real
atom_style      full
boundary        f f f
region          box block -60 60 -60 60 -60 60
create_box      2 box
create_atoms    1 single 0 0 0 units box
create_atoms    1 single 1.5 0 0 units box
mass            * 1.0
pair_style      gauss/cut 8.0
pair_coeff      1 1 1.5 3.2 0.7 6.0
pair_coeff      2 2 0.4 3.0 0.9 5.0
pair_modify     mix geometric shift no
thermo_style    custom step pe evdwl ecoul fmax
thermo_modify   format float %.15g norm no
run             0
clear
units           real
atom_style      full
boundary        f f f
region          box block -60 60 -60 60 -60 60
create_box      2 box
create_atoms    1 single 0 0 0 units box
create_atoms    1 single 2.4 0 0 units box
mass            * 1.0
pair_style      gauss/cut 8.0
pair_coeff      1 1 1.5 3.2 0.7 6.0
pair_coeff      2 2 0.4 3.0 0.9 5.0
pair_modify     mix geometric shift no
thermo_style    custom step pe evdwl ecoul fmax
thermo_modify   format float %.15g norm no
run             0
clear
