# oracle: fix adapt 0 on the four opbend weights of pair amoeba (reset no) with the solvated ubiquitin of w119amoeba_ub: improper amoeba copies them from the pair in its init_style, so the first run 0 keeps the file's weights and the second run 0 has the adapted ones
# oracle-inputs: w119amoeba_ub_cut.data w119amoeba_ub.prm w119amoeba_ub.key w119amoeba_ub_bitorsion.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           real
boundary        p p p
atom_modify     sort 0 0.0
atom_style      amoeba
bond_style      class2
angle_style     amoeba
dihedral_style  fourier
improper_style  amoeba
fix             amtype all property/atom i_amtype ghost yes
fix             extra all property/atom i_amgroup d_redID d_pval ghost yes
fix             extra2 all property/atom i_polaxe d2_xyzaxis 3
fix             pit all amoeba/pitorsion
fix_modify      pit energy yes
fix             bit all amoeba/bitorsion w119amoeba_ub_bitorsion.data
fix_modify      bit energy yes
read_data       w119amoeba_ub_cut.data fix amtype NULL "Tinker Types" &
                fix pit "pitorsion types" "PiTorsion Coeffs" &
                fix pit pitorsions PiTorsions &
                fix bit bitorsions BiTorsions
pair_style      amoeba
pair_coeff      * * w119amoeba_ub.prm w119amoeba_ub.key
special_bonds   lj/coul 0.5 0.5 0.5 one/five yes
compute         virial all pressure NULL virial
variable        c equal 1.5
variable        q equal 0.5
variable        p equal 2.0
variable        x equal 3.0
fix             ob all adapt 0 pair amoeba opbend_cubic * * v_c pair amoeba opbend_quartic * * v_q &
                pair amoeba opbend_pentic * * v_p pair amoeba opbend_sextic * * v_x scale yes reset no
thermo_style    custom step temp epair ebond eangle edihed eimp emol etotal press c_virial[1] c_virial[2] c_virial[3] c_virial[4] c_virial[5] c_virial[6]
thermo_modify   format float %.15g
run             0
run             0
