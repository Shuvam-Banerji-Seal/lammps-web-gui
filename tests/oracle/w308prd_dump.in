# oracle: w308prd_dump — w195prd_si with a dump on every partition: only partition 1 writes, and only at the events (the initial minimum and each event, with the event's quenched coordinates; prd.rst: the requested dump frequency is ignored)
# oracle-partitions: 3
# oracle-potentials: Si.sw
# oracle-files: prd_dump.0
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10 atomrel=1e-8
# Measured max relative error, engine vs native (thermo rows, final atoms; the dump file within 1e-6): thermo 5.3e-15, atoms 3.6e-13 (every partition).
units           metal
atom_style      atomic
atom_modify     map array
boundary        p p p
atom_modify     sort 0 0.0
variable a equal 5.431
lattice         custom $a a1 1.0 0.0 0.0 a2 0.0 1.0 0.0 a3 0.0 0.0 1.0 &
                basis 0.0 0.0 0.0 basis 0.0 0.5 0.5 basis 0.5 0.0 0.5 basis 0.5 0.5 0.0 &
                basis 0.25 0.25 0.25 basis 0.25 0.75 0.75 basis 0.75 0.25 0.75 basis 0.75 0.75 0.25
region          myreg block 0 2 0 2 0 2
create_box      1 myreg
create_atoms    1 region myreg
mass            1 28.06
group           Si type 1
velocity        all create 1800.0 5287287 mom yes rot yes dist gaussian
group           del id 30
delete_atoms    group del
pair_style      sw
pair_coeff      * * Si.sw Si
thermo          10
fix             1 all nvt temp 1800.0 1800.0 0.1
timestep        1.0e-3
neighbor        1.0 bin
neigh_modify    every 1 delay 10 check yes
run             20
compute         1 all event/displace 0.5
compute         pa all pe/atom
thermo_style    custom step temp pe
thermo_modify   format float %.15g
variable        pp world 0 1 2
dump            d1 all custom 7 prd_dump.${pp} id type x y z c_pa
dump_modify     d1 sort id format float %.15g
prd 200 20 2 2 40 1 54985 temp 1800.0 min 1.0e-5 1.0e-5 100 100 vel all uniform
