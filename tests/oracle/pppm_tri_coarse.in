# oracle: PPPM on a coarse mesh in a triclinic box: the influence function sums 0, 1, 1 alias images per dimension
units           real
atom_style      charge
lattice         sc 3.1
region          box prism 0 5 0 4 0 4 1.2 -0.6 0.8 units lattice
create_box      2 box
create_atoms    1 box
group           odd id 1:80:2
set             group odd type 2
mass            1 15.0
mass            2 20.0
set             type 1 charge 0.42
set             type 2 charge -0.38
variable        dx atom 0.15*sin(0.43*x+0.27*y)
variable        dy atom 0.15*cos(0.31*y-0.23*z)
variable        dz atom 0.15*sin(0.37*z+0.19*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.003*sin(0.6*x+0.2*z)
variable        vy atom 0.003*cos(0.5*y+0.3*x)
variable        vz atom 0.003*sin(0.4*z-0.5*y)
velocity        all set v_vx v_vy v_vz units box
pair_style      lj/cut/coul/long 6.0
pair_coeff      * * 0.15 2.9
pair_modify     table 0
kspace_style    pppm 1.0e-5
kspace_modify   gewald 0.79 mesh 8 8 8 order 6
fix             1 all nve
thermo_style    custom step temp pe evdwl ecoul elong etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          10
run             30
