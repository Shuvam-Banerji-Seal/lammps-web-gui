# oracle: cut-down in.ellipse.resquared (examples/ellipse): 2d RE-squared ellipsoids of two shapes and two epsilon triples on an 8x8 square lattice, fix nve/asphere and fix enforce2d for 300 steps; explicit type assignment, orientations and velocities (no RNG) instead of type/fraction, quat/random and velocity loop geom; thermo with epair and press, dumps of forces and torques after the run
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
# oracle-files: w43rsq_ellipse_tq.dump
units        lj
atom_style   ellipsoid
dimension    2

lattice      sq 0.1
region       box block 0 8 0 8 -0.5 0.5
create_box   2 box
create_atoms 1 box
set          atom 13 type 2
set          atom 16 type 2
set          atom 21 type 2
set          atom 33 type 2
set          atom 53 type 2
set          atom 62 type 2
set          type 1 mass 1.0
set          type 2 mass 1.5
set          type 1 shape 1 1 1
set          type 2 shape 3 1 1
set          atom 1 quat 0 0 1 338.278359
set          atom 2 quat 0 0 1 105.237000
set          atom 3 quat 0 0 1 343.095666
set          atom 4 quat 0 0 1 359.891509
set          atom 5 quat 0 0 1 85.611788
set          atom 6 quat 0 0 1 200.120700
set          atom 7 quat 0 0 1 238.003407
set          atom 8 quat 0 0 1 0.873415
set          atom 9 quat 0 0 1 100.778567
set          atom 10 quat 0 0 1 300.753106
set          atom 11 quat 0 0 1 178.974023
set          atom 12 quat 0 0 1 285.277884
set          atom 13 quat 0 0 1 68.843061
set          atom 14 quat 0 0 1 359.181363
set          atom 15 quat 0 0 1 139.879156
set          atom 16 quat 0 0 1 119.336064
set          atom 17 quat 0 0 1 42.230982
set          atom 18 quat 0 0 1 198.355547
set          atom 19 quat 0 0 1 93.727454
set          atom 20 quat 0 0 1 169.079124
set          atom 21 quat 0 0 1 81.215404
set          atom 22 quat 0 0 1 25.877939
set          atom 23 quat 0 0 1 304.341613
set          atom 24 quat 0 0 1 251.002956
set          atom 25 quat 0 0 1 324.414606
set          atom 26 quat 0 0 1 214.315460
set          atom 27 quat 0 0 1 193.948182
set          atom 28 quat 0 0 1 35.944041
set          atom 29 quat 0 0 1 288.505622
set          atom 30 quat 0 0 1 254.662281
set          atom 31 quat 0 0 1 76.333308
set          atom 32 quat 0 0 1 118.395415
set          atom 33 quat 0 0 1 31.595647
set          atom 34 quat 0 0 1 207.680149
set          atom 35 quat 0 0 1 297.850232
set          atom 36 quat 0 0 1 330.069929
set          atom 37 quat 0 0 1 282.307465
set          atom 38 quat 0 0 1 350.368483
set          atom 39 quat 0 0 1 97.892551
set          atom 40 quat 0 0 1 225.744884
set          atom 41 quat 0 0 1 331.102566
set          atom 42 quat 0 0 1 351.066160
set          atom 43 quat 0 0 1 126.508845
set          atom 44 quat 0 0 1 190.700188
set          atom 45 quat 0 0 1 298.147479
set          atom 46 quat 0 0 1 277.837712
set          atom 47 quat 0 0 1 145.465923
set          atom 48 quat 0 0 1 209.706100
set          atom 49 quat 0 0 1 218.013145
set          atom 50 quat 0 0 1 89.209894
set          atom 51 quat 0 0 1 206.158811
set          atom 52 quat 0 0 1 144.951818
set          atom 53 quat 0 0 1 49.803452
set          atom 54 quat 0 0 1 289.388282
set          atom 55 quat 0 0 1 4.605288
set          atom 56 quat 0 0 1 354.539151
set          atom 57 quat 0 0 1 18.803713
set          atom 58 quat 0 0 1 227.689556
set          atom 59 quat 0 0 1 268.501244
set          atom 60 quat 0 0 1 273.656658
set          atom 61 quat 0 0 1 155.810093
set          atom 62 quat 0 0 1 92.174193
set          atom 63 quat 0 0 1 181.445217
set          atom 64 quat 0 0 1 202.615034
variable       vxe atom 0.8*sin(0.9*id)
variable       vye atom 0.8*cos(1.3*id)
velocity     all set v_vxe v_vye 0.0 sum no units box
variable     lze atom 0.4*sin(0.7*id)
set          group all angmom 0 0 v_lze
compute      rot all temp/asphere
group        spheroid type 1
variable     dof equal count(spheroid)+2
compute_modify rot extra/dof ${dof}

neighbor     0.8 bin

pair_style   resquared 4.0
pair_coeff   1 1 3.0 1 1 1 1 1 1 1 2.5
pair_coeff   1 2 3.0 1 1 1 1 0 0 0
pair_coeff   2 2 1.0 1 1 1 0.2 0 0 0

thermo_style custom step c_rot epair etotal press vol
thermo       100
thermo_modify format float %.15g

timestep     0.002

fix          1 all nve/asphere
fix          2 all enforce2d

run          300
write_dump all custom w43rsq_ellipse_tq.dump id fx fy fz tqx tqy tqz modify format float %.15g sort id
