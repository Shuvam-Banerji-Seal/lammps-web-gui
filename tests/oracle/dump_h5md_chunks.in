# oracle: dump h5md of 1372 atoms (native: the b332f28 build with the H5MD package): records of more than 4 x 256 atoms are stored in chunks of 256 atoms (lib/h5md/src/ch5md.c MAX_CHUNK), six per record, the last one partly filled
# oracle-files: c.h5
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 7 0 7 0 7
create_box      1 box
create_atoms    1 box
mass            1 1.0
displace_atoms  all random 0.05 0.05 0.05 9123
velocity        all create 1.0 87287 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
fix             1 all nve
thermo_style    custom step temp pe etotal press
thermo_modify   format float %.15g
dump            1 all h5md 5 c.h5 position image
run             5
