# oracle: compute pressure pair/hybrid with pair_style hybrid (sub-styles assigned by type pair) in a periodic box: lj/cut for 1-1, soft for 2-2, morse for 1-2
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
set             type 1 type/fraction 2 0.5 991
mass            * 1.0
velocity        all create 1.0 4428 loop geom
pair_style      hybrid lj/cut 2.5 soft 1.12 morse 2.0
pair_coeff      1 1 lj/cut 1.0 1.0
pair_coeff      2 2 soft 10.0
pair_coeff      1 2 morse 0.5 2.0 1.1
fix             1 all nve
compute         p1 all pressure NULL pair/hybrid lj/cut
compute         p2 all pressure NULL pair/hybrid soft
compute         p3 all pressure NULL pair/hybrid morse
thermo_style    custom step pe press c_p1 c_p2 c_p3 c_p3[2] c_p1[5]
thermo_modify   norm no format float %.15g
thermo          10
run             50
