# oracle: fix drag pulls group atoms toward a point with magnitude fmag and cutoff delta
units lj
atom_style atomic
boundary f f f
region box block -4 4 -4 4 -4 4
create_box 1 box
create_atoms 1 single -1.0 0.0 0.0
create_atoms 1 single 1.0 0.0 0.0
create_atoms 1 single 0.0 1.0 0.0
create_atoms 1 single 0.0 0.0 -1.0
mass 1 1.0
variable vx atom 0.01*sin(1.3*x+0.7*y)
variable vy atom 0.01*cos(0.9*y-0.4*z)
variable vz atom 0.01*sin(1.1*z+0.5*x)
velocity all set v_vx v_vy v_vz
pair_style lj/cut 2.5
pair_coeff 1 1 1.0 1.0
fix 1 all nve
fix 2 all drag 0.0 0.0 0.0 0.5 0.5
thermo_style custom step pe ke press f_2[1] f_2[2] f_2[3]
thermo_modify format float %.15g norm no
thermo 10
run 100
