# oracle: compute voronoi/atom in a restricted triclinic box (xy = 0.6) — periodic images along the tilted edge vectors
# oracle-files: w29voro_tri.dump
units           lj
boundary        p p p
atom_style      atomic
lattice         sc 1.0 origin 0.5 0.5 0.5
region          box block 0 3 0 3 0 3 units box
region          atoms block 0 3 0 3 0 3 units box
create_box      1 box
create_atoms    1 region atoms
mass            1 1.0
change_box      all triclinic
change_box      all xy final 0.6 remap units box
pair_style      lj/cut 0.5
pair_coeff      1 1 0.0 1.0
neighbor        0.3 bin
comm_modify     cutoff 5.0
compute         v all voronoi/atom
thermo_style    custom step pe
thermo_modify   format float %.15g
dump            d all custom 1 w29voro_tri.dump id c_v[*]
dump_modify     d sort id format float %.17g
run             0
