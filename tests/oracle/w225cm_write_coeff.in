# oracle: write_coeff of a molecular force field (pair lj/cut/coul/cut, bond, angle, dihedral and improper harmonic)
# oracle-files: w225cm_coeff.txt
# oracle-compare: thermo=all atoms=none
units           real
atom_style      full
region          box block -5 5 -5 5 -5 5
create_box      2 box bond/types 1 angle/types 1 dihedral/types 1 improper/types 1 extra/bond/per/atom 2 extra/angle/per/atom 1 extra/dihedral/per/atom 1 extra/improper/per/atom 1 extra/special/per/atom 3
create_atoms    1 single 0.0 0.0 0.0
create_atoms    2 single 1.0 0.0 0.0
mass            * 12.0
pair_style      lj/cut/coul/cut 8.0 10.0
pair_coeff      1 1 0.10 3.40
pair_coeff      1 2 0.20 3.10 9.0 9.5
pair_coeff      2 2 0.15 2.90
bond_style      harmonic
bond_coeff      1 300.0 1.09
angle_style     harmonic
angle_coeff     1 50.0 109.5
dihedral_style  harmonic
dihedral_coeff  1 2.0 1 180
improper_style  harmonic
improper_coeff  1 10.0 0.0
write_coeff     w225cm_coeff.txt
