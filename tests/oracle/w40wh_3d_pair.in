# oracle: 3d LJ fcc, one wall/harmonic/outside on xlo and one on xhi for a group, energy and virial (fix_modify energy yes virial yes)
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           lj
atom_style      atomic
boundary        s p p
lattice         fcc 0.8442
region          box block 0 4 0 3 0 3
create_box      2 box
create_atoms    1 box
group           outer id 1:200:2
set             group outer type 2
mass            1 1.0
mass            2 1.0
variable        vx atom 0.9*sin(1.7*x+2.3*y+0.7*z)
variable        vy atom 0.9*cos(2.1*x-1.1*y+0.3*z)
variable        vz atom 0.9*sin(0.5*x+1.9*z+1.3*y)
velocity        all set v_vx v_vy v_vz units box
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0 2.5
timestep        0.002
fix             1 all nve
fix             2 outer wall/harmonic/outside xlo 1.0 2.0 0.0 2.0 xhi 6.5 2.0 0.0 1.2 units box
fix_modify      2 energy yes virial yes
thermo_style    custom step temp pe etotal press pxx pyy pzz f_2 f_2[1] f_2[2]
thermo_modify   format float %.15g
thermo          10
run             100
