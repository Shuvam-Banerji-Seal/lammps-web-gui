# oracle: compute pe/atom and stress/atom (pair terms) with hbond/dreiding/morse/angleoffset (the w14hbond_offset system), each term split in thirds over hydrogen, donor and acceptor, dumps at the start and the end
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 2.8e-14, atoms 5.6e-13 (the dumped per-atom values included).
# oracle-inputs: w14hbond_system.data
# oracle-files: w274hb_offset_peratom.dump
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=1e-10 filerel=1e-9
units           real
atom_style      full
boundary        p p p
read_data       w14hbond_system.data
special_bonds   lj/coul 0.0 0.0 1.0
pair_style      hybrid/overlay lj/cut 8.0 hbond/dreiding/lj/angleoffset 4 3.0 4.5 90.0 150.0 hbond/dreiding/morse/angleoffset 2 3.0 4.5 90.0 150.0
pair_coeff      * * lj/cut 0.1 2.8
pair_coeff      1 3 hbond/dreiding/lj/angleoffset 2 i 2.0 2.2
pair_coeff      1 5 hbond/dreiding/morse/angleoffset 2 i 2.0 1.5 2.2 2 3.0 4.5 90.0 160.0
bond_style      harmonic
bond_coeff      1 450.0 0.9572
bond_coeff      2 300.0 1.2
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
timestep        1.0
fix             1 all nve
thermo_style    custom step pe evdwl ebond press
thermo_modify   format float %.15g
thermo          20
compute         pa all pe/atom pair
compute         sa all stress/atom NULL pair
dump            d all custom 100 w274hb_offset_peratom.dump id c_pa c_sa[1] c_sa[2] c_sa[3] c_sa[4] c_sa[5] c_sa[6]
dump_modify     d sort id format float %.15g
run             100
