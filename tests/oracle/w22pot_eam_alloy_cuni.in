# oracle: pair_style eam/alloy with CuNi.eam.alloy, element order in pair_coeff reversed from the file header, displaced lattice, velocities from atom-style variables, 50 steps of nve
# oracle-potentials: CuNi.eam.alloy
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           metal
atom_style      atomic
lattice         fcc 3.56
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
group         t2 id 2:108:2
set             group t2 type 2
mass            1 63.546
mass            2 58.693
variable        dx atom 0.05*sin(1.3*x+0.7*y)
variable        dy atom 0.05*cos(0.9*y-0.4*z)
variable        dz atom 0.05*sin(1.1*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.01*sin(id)
variable        vy atom 0.01*cos(2*id)
variable        vz atom 0.01*sin(3*id)
pair_style eam/alloy
pair_coeff * * CuNi.eam.alloy Cu Ni
velocity        all set v_vx v_vy v_vz
timestep        0.001
fix             1 all nve
thermo_style    custom step pe ke press pxx pyz
thermo_modify   format float %.15g norm no
thermo          10
run             50
