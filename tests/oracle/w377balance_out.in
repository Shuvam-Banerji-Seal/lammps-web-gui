# oracle: balance and fix balance with the out keyword: native's Pizza.py mdump text of the sub-domain nodes and cubes (one process: the whole box), written by the balance command once and by fix balance at each rebalance (threshold below 1), and not by a balance command whose threshold the imbalance does not reach
# oracle-files: w377balance_out.txt w377fix_out.txt w377none_out.txt
# oracle-compare: thermo=all atoms=all
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 4 0 4 0 3
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 1.0 87287 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
balance         0.9 x uniform y uniform out w377balance_out.txt
balance         1.5 shift x 5 1.1 out w377none_out.txt
fix             1 all nve
fix             2 all balance 10 0.95 shift xyz 10 1.1 out w377fix_out.txt
thermo_style    custom step temp pe f_2 f_2[1] f_2[2] f_2[3]
thermo_modify   format float %.15g
thermo          10
run             30
