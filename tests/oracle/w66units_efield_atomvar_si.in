# oracle: fix efield with an atom-style variable component: 60 steps (si)
# oracle-compare: thermo=all atoms=all
units           si
atom_style      charge
boundary        p p p
lattice         fcc 5e-10
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
group           odd id 1:108:2
group           even subtract all odd
set             group odd type 2
mass            1 1.99e-26
mass            2 3.32e-26
set             group odd charge 6.4e-20
set             group even charge -6.4e-20
velocity        all create 300 4928459 loop all
pair_style      lj/cut 7e-10
neighbor        1.0e-10 bin

pair_coeff      1 1 1.4e-21 3.4e-10
pair_coeff      2 2 1e-21 3.6e-10
timestep        1e-15
fix             1 all nve
variable        ex atom 20000000*sin(0.5*x+0.3*z)
fix             2 all efield v_ex -10000000 30000000
thermo_style    custom step temp pe etotal press
thermo_modify   format float %.15g
thermo          10
run             60
