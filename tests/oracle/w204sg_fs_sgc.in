# oracle: fix sgcmc (MC package, src/MC/fix_sgcmc.cpp at b332f28, ported in src/engine-gpl/mc/fix_sgcmc.ts) in the semi-grand canonical ensemble with pair eam/fs (VFe_mm.eam.fs, Fe and V): 1024 bcc atoms, 10% V, NVT at 600 K, an MC event every 10 steps (8 sampling windows, 25 trials each, the EAM density method), 40 steps; the accepted and rejected counts and the concentrations (f_mc) and the final types are compared.
# oracle-potentials: VFe_mm.eam.fs
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units metal
atom_style atomic
boundary p p p
lattice bcc 2.855
region box block 0 8 0 8 0 8
create_box 2 box
create_atoms 1 box
set type 1 type/fraction 2 0.1 12345
pair_style eam/fs
pair_coeff * * VFe_mm.eam.fs Fe V
timestep 0.002
velocity all create 1200 4928459 dist gaussian
fix integrate all nvt temp 600 600 0.1
fix mc all sgcmc 10 0.2 600 0.2 randseed 324234
thermo_style custom step temp pe press f_mc[1] f_mc[2] f_mc[3] f_mc[4]
thermo_modify format float %.15g
thermo 10
run 40
