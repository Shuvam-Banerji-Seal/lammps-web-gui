# oracle: pair hybrid/overlay lj/mdf 2.0 2.5 + coul/slater/cut 0.7 2.5 on a molecular chain system with special bonds
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 1.8e-12, atoms 1.1e-12. The energy columns (pe, evdwl, ecoul, ke) agree to 1e-14; the thermo maximum is in the pressure components, whose virial is summed in a different order (fdotr).
# oracle-inputs: w219xp_chains.data
# oracle-compare: thermo=all atoms=all rel=1e-11 abs=1e-13
units        lj
atom_style   full
read_data    w219xp_chains.data
mass         * 1.0
velocity     all create 1.0 4242
timestep     0.001
fix          1 all nve
special_bonds lj/coul 0.0 0.5 0.8
pair_style   hybrid/overlay lj/mdf 2.0 2.5 coul/slater/cut 0.7 2.5
pair_coeff   * * lj/mdf 1.0 1.0
pair_coeff   * * coul/slater/cut
bond_style   harmonic
bond_coeff   1 200.0 1.1
thermo_style custom step pe evdwl ecoul ke press pxx pyy pzz pxy pxz pyz
thermo_modify format float %.15g
thermo       20
run          200
