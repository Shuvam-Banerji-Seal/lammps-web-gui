# oracle: eFF CH4 (fixed boundaries) with fix temp/rescale/eff (velocities created at 1000 K, rescaled toward 300 K every 2 steps) and compute ke/atom/eff per atom (examples/PACKAGES/eff/CH4 cut down)
# oracle-inputs: w63eff_ch4.data
# oracle-files: w63eff_ch4_rescale_ke.dump
# oracle-compare: thermo=all atoms=all
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 1.8e-15, atoms 0.
units           electron
newton          on
boundary        f f f
atom_style      electron
read_data       w63eff_ch4.data
pair_style      eff/cut 100.0
pair_coeff      * *
comm_modify     vel yes
compute         effTemp all temp/eff
compute         keatom all ke/atom/eff
thermo          2
thermo_style    custom step pe ke temp
thermo_modify   temp effTemp
thermo_modify   format float %.15g
velocity        all create 1000.0 4928459 dist gaussian rot yes mom yes
timestep        0.005
fix             1 all nve/eff
fix             2 all temp/rescale/eff 2 0.0 300.0 0.02 0.5
run             10
write_dump      all custom w63eff_ch4_rescale_ke.dump id c_keatom modify format float %.15g
