# oracle: lj/cut/dipole/cut with fix nve/sphere update dipole and fix efield on charges and dipoles (energy yes): 100 steps
# oracle-files: w18dipole_efield_mu.dump
# oracle-compare: thermo=all atoms=all rel=1e-7 abs=1e-9
units           lj
atom_style      hybrid sphere dipole
lattice         sc 0.4
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
mass            * 1.0
set             type * diameter 1.0 density 1.0
group           g1 id 1:64:3
group           g2 id 2:64:3
group           g3 id 3:64:3
set             group g1 dipole 0.8 0.3 0.5
set             group g2 dipole -0.4 0.9 0.1
set             group g3 dipole 0.2 -0.6 0.7
set             type 1 charge 0.4
set             type 2 charge -0.3
variable        dx atom 0.08*sin(0.53*x+0.21*y)
variable        dy atom 0.08*cos(0.37*y-0.19*z)
variable        dz atom 0.08*sin(0.29*z+0.41*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.3*sin(0.7*x+0.3*z)
variable        vy atom 0.3*cos(0.5*y+0.2*x)
variable        vz atom 0.3*sin(0.4*z-0.6*y)
velocity        all set v_vx v_vy v_vz units box
velocity        all zero linear
set             group g1 omega 0.2 -0.1 0.3
set             group g2 omega -0.1 0.2 0.1
set             group g3 omega 0.1 0.1 -0.2
pair_style      lj/cut/dipole/cut 2.5
pair_coeff      * * 1.0 1.0
pair_coeff      1 2 0.8 1.1 2.2 2.5
timestep        0.002
fix             1 all nve/sphere update dipole
fix             2 all efield 0.05 -0.03 0.02
fix_modify      2 energy yes
thermo_style    custom step temp pe ke press
thermo_modify   format float %.15g norm no
thermo          20
run             100
write_dump      all custom w18dipole_efield_mu.dump id mux muy muz tqx tqy tqz modify format float %.17g sort id
