# oracle: pair granular heat radius (k_s) with hooke normal model, two overlapping spheres (atom 2 twice as dense), fix property/atom temperature heatflow, fix heat/flow constant, 200 steps; reduce sums and maxes of temperature and heatflow
units           lj
atom_style      sphere
atom_modify     map array
comm_modify     vel yes
boundary        f f f
region          b block -10 10 -10 10 -10 10
create_box      1 b
create_atoms    1 single 0 0 0
create_atoms    1 single 0.8 0 0
set             atom 1 diameter 1.0 density 1.0
set             atom 2 diameter 1.0 density 2.0
fix             pa all property/atom temperature heatflow
set             atom 1 temperature 1.0
set             atom 2 temperature 3.0
pair_style      granular
pair_coeff      * * hooke 2000.0 0.0 tangential linear_nohistory 0.0 0.0 heat radius 0.5
timestep        0.0001
fix             1 all nve/sphere
fix             2 all heat/flow constant 1.5
compute         pa all property/atom temperature heatflow
compute         tsum all reduce sum c_pa[1]
compute         tmax all reduce max c_pa[1]
compute         tmin all reduce min c_pa[1]
compute         hsum all reduce sum c_pa[2]
compute         hmax all reduce max c_pa[2]
compute         hmin all reduce min c_pa[2]
thermo_style    custom step ke c_tsum c_tmax c_tmin c_hsum c_hmax c_hmin
thermo_modify   format float %.15g
thermo          20
run             200
