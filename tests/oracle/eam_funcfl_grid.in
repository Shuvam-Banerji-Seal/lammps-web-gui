# oracle: pair_style eam with three funcfl files on different grids (Cu_u3 dr 0.0100, Ni_u3 dr 0.0097, Ag_u3 dr 0.0112): native puts every file on one grid (the largest dr and table end) and gives every type pair the largest cutoff; random three-element alloy, 100 steps of nve
# oracle-potentials: Cu_u3.eam Ni_u3.eam Ag_u3.eam
# oracle-compare: thermo=all atoms=all rel=1e-12 abs=1e-12
units           metal
atom_style      atomic
lattice         fcc 3.7
region          box block 0 4 0 4 0 4
create_box      3 box
create_atoms    1 box
set             group all type/fraction 2 0.35 4321
set             group all type/fraction 3 0.25 9876
pair_style      eam
pair_coeff      1 1 Cu_u3.eam
pair_coeff      2 2 Ni_u3.eam
pair_coeff      3 3 Ag_u3.eam
velocity        all create 900.0 4411 loop geom
fix             1 all nve
timestep        0.002
thermo_style    custom step temp pe ke etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          20
run             100
