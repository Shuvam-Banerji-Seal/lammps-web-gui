# oracle: PPPM slab box with automatic G-ewald and mesh (no gewald, no mesh): ELECTRODE madelung data (1x1x20 box, boundary p p f, 4 atoms, charges +-0.5), kspace_modify slab 8.0, accuracy 1e-5
# oracle-inputs: w68elec_au_elyt.data
boundary        p p f
kspace_style    pppm 1.0e-5
kspace_modify   slab 8.0
units           real
atom_style      full
pair_style      lj/cut/coul/long 12
read_data       w68elec_au_elyt.data
pair_coeff      * * 0 1
thermo_style    custom step pe elong
thermo_modify   format float %.15g
run             0
