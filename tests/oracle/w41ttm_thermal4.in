# Wave 41: fix ttm/thermal on a 4x4x4 electron grid (cells of 1.5 A over the 6 A box of eight atoms), per-cell
# C_vol, kappa_e, gamma_p and eta (deterministic pseudo-random values), infile temperatures, seed 99, source 0.02.
# The conductivity varies from cell to cell, so the pairwise harmonic flow of ttm/thermal is tested off the 2x2x2 grid.
# oracle-inputs: w41ttm_thermal4.props w41ttm_thermal4.init
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           metal
atom_style      atomic
lattice         sc 3.0
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box
mass            1 10.0
displace_atoms  all move 0.5 0.5 0.5 units box
variable        vx atom 3.0*sin(0.9*x+0.4*y)
variable        vy atom 2.5*cos(0.7*y-0.5*z)
variable        vz atom 2.0*sin(1.1*z+0.3*x)
velocity        all set v_vx v_vy v_vz units box
velocity        all zero linear
pair_style      lj/cut 3.0
pair_coeff      1 1 0.0 2.0
fix             1 all nve
fix             2 all ttm/thermal 99 w41ttm_thermal4.props 4 4 4 infile w41ttm_thermal4.init source 0.02
timestep        0.05
thermo_style    custom step temp pe f_2[1] f_2[2]
thermo_modify   format float %.15g
thermo          1
run             3
run             2
