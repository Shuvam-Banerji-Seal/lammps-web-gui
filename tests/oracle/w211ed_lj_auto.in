# oracle: kspace_style ewald/disp 1e-4 with the automatic G-ewald for dispersion only (pair lj/long/coul/long long off: g_ewald from the Newton solve of the Kolafa-Perram r^-6 error, g_ewald_6 = g_ewald, kmax from the rms estimate), 2-type LJ, NVE 30 steps.
# oracle-inputs: w16disp_fcc2.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 6.4e-13, atoms 2.0e-13.
units           lj
atom_style      charge
read_data       w16disp_fcc2.data
pair_style      lj/long/coul/long long off 2.5
pair_coeff      1 1 1.0 1.0
pair_coeff      2 2 0.5 1.1
kspace_style    ewald/disp 1.0e-4
timestep        0.005
fix             1 all nve
thermo_style    custom step temp pe evdwl elong press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          10
run             30
