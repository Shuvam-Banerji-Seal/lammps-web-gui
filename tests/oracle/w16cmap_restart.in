# Wave 16: fix cmap cross-terms in a restart file (docs.lammps.org/fix_cmap.html: "This fix writes the list of
# CMAP cross-terms to binary restart files"; read_restart, then the fix is specified again, then run).
# The run writes at step 20, reads the restart, re-specifies fix cmap and continues 20 steps (NVE).
# oracle-inputs: w15cmap_grid.txt w15cmap_chain.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           real
atom_style      full
boundary        f f f
fix             cmap all cmap w15cmap_grid.txt
read_data       w15cmap_chain.data fix cmap crossterm CMAP
bond_style      harmonic
angle_style     harmonic
dihedral_style  harmonic
pair_style      zero 10.0
pair_coeff      * *
bond_coeff      1 300.0 1.53
angle_coeff     1 60.0 111.0
dihedral_coeff  1 2.0 1 3
timestep        0.5
fix             1 all nve
thermo_style    custom step pe f_cmap edihed press
thermo_modify   format float %.15g
thermo          10
run             20
write_restart   w16cmap.restart
clear
read_restart    w16cmap.restart
fix             cmap all cmap w15cmap_grid.txt
pair_style      zero 10.0
pair_coeff      * *
fix             1 all nve
thermo_style    custom step pe f_cmap edihed press
thermo_modify   format float %.15g
thermo          10
run             20
