# oracle: compute dipole/tip4p and compute dipole/tip4p/chunk (compute_dipole.html, compute_dipole_chunk.html: "includes adjustments for the charge carrying point M in molecules with TIP4P water geometry"), on the w12tip4p_long water box (lj/cut/tip4p/long, pppm/tip4p, SHAKE), with the plain dipole for comparison: the whole system (mass and geometry centres), the waters of molecules 1-3 as chunks, 30 steps.
# oracle-inputs: w12tip4p_long_water.data
# oracle-compare: thermo=all atoms=all
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 9.3e-14, atoms 9.2e-12.
units           real
atom_style      full
boundary        p p p
read_data       w12tip4p_long_water.data
pair_style      lj/cut/tip4p/long 1 2 1 1 0.1546 8.5
pair_coeff      1 1 0.1852 3.1589
pair_coeff      1 2 0.0 1.0
pair_coeff      2 2 0.0 1.0
bond_style      harmonic
bond_coeff      1 450.0 0.9572
angle_style     harmonic
angle_coeff     1 55.0 104.52
kspace_style    pppm/tip4p 1.0e-5
kspace_modify   gewald 0.37833912 mesh 12 12 12 order 5
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
timestep        1.0
fix             1 all shake 1.0e-10 200 0 b 1 a 1
fix             2 all nve
compute         d all dipole
compute         dt all dipole/tip4p
compute         dg all dipole/tip4p geometry
group           first molecule 1 2 3
compute         mol first chunk/atom molecule
compute         dc first dipole/tip4p/chunk mol
thermo_style    custom step pe c_d c_d[1] c_dt c_dt[1] c_dt[2] c_dt[3] c_dg[3] c_dc[1][1] c_dc[2][2] c_dc[3][4]
thermo_modify   format float %.15g
thermo          10
run             30
