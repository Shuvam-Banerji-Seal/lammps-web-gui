# oracle: compute voronoi/atom neighbors yes (local array) in a periodic 2x2x2 fcc box with a smooth non-lattice displacement (every cell is irregular): native row order
# Measured (ORACLE_MEASURE=1): thermo 2.4e-15; the local rows agree at 1e-12 (filerel); engine ~0.2 s warm. native: lmp b332f28, sort off.
# oracle-files: w199vo_fcc.loc
# oracle-compare: thermo=all atoms=none rel=1e-8 abs=1e-10 filerel=1e-12
units           lj
atom_style      atomic
atom_modify     map array sort 0 0.0
lattice         fcc 1.0
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box
mass            1 1.0
variable        dx atom 0.12*sin(1.7*x+0.6*y)
variable        dy atom 0.12*cos(1.1*z-0.8*x)
variable        dz atom 0.12*sin(0.9*y+1.3*z)
displace_atoms  all move v_dx v_dy v_dz units box
pair_style      lj/cut 1.2
pair_coeff      * * 1.0 1.0
thermo_modify   format float %.15g
compute         v all voronoi/atom neighbors yes
dump            d all local 1 w199vo_fcc.loc c_v[1] c_v[2] c_v[3]
dump_modify     d format float %.15g
run             0
undump          d
