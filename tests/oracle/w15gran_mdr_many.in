# oracle: pair_style granular mdr — eight equal spheres in a 2x2x2 packing (elastic, Y large), damping mdr 2, tangential linear_nohistory, fix nve/sphere
units           lj
atom_style      sphere 1
atom_modify     map array
comm_modify     vel yes
newton          off
boundary        f f f
region          b block -10 10 -10 10 -10 10
create_box      1 b
create_atoms    1 single 0.0 0.0 0.0
create_atoms    1 single 0.92 0.0 0.0
create_atoms    1 single 0.0 0.92 0.0
create_atoms    1 single 0.92 0.92 0.0
create_atoms    1 single 0.0 0.0 0.92
create_atoms    1 single 0.92 0.0 0.92
create_atoms    1 single 0.0 0.92 0.92
create_atoms    1 single 0.92 0.92 0.92
set type 1 diameter 1.0 density 1.0
variable vx atom 0.4*sin(1.3*x+0.7*y)
variable vy atom 0.4*cos(0.9*y-1.1*z)
variable vz atom 0.4*sin(1.7*z+0.5*x)
velocity all set v_vx v_vy v_vz units box
pair_style granular
pair_coeff * * mdr 1.0 0.3 1000.0 0.0 0.0 0.1 damping mdr 2 tangential linear_nohistory 0.0 0.0
timestep 0.001
fix 1 all nve/sphere
thermo_style custom step ke
thermo_modify format float %.15g
thermo 50
run 400
