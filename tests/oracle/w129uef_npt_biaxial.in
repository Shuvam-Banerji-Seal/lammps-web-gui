# oracle: UEF npt/uef biaxial extension of a WCA fluid, iso 10 10 5 with ext z (examples/PACKAGES/uef/npt_biaxial: 500 atoms, cut to 250 steps)
# oracle-inputs: w129uef_data.wca
# Measured with native LAMMPS (max relative error of the engine, this case): thermo 6e-12; per atom position 4e-12, vx 6e-11,
# fz 8e-10. Run length: as for w129uef_nvt_uniaxial (the images stay below the native 512 limit only up to about 250 steps).
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10 atomrel=1e-8
units           lj
atom_style      atomic

pair_style      lj/cut 1.122562
read_data       w129uef_data.wca
pair_coeff      1 1 1.0 1.0
pair_modify     shift yes

neighbor        0.5 bin
neigh_modify    delay 0

change_box      all triclinic

fix             1 all npt/uef temp 0.722 0.722 0.5 iso 10 10 5 erate 0.5 0.5 ext z
fix             2 all momentum 100 linear 1 1 1

thermo_style    custom step c_1_press[1] c_1_press[2] c_1_press[3] lx ly lz xy xz yz f_1
thermo_modify   format float %.15g
thermo          25
run             250
