# oracle: pppm automatic G-ewald and mesh on an orthorhombic 10x12x14 box with a coarser accuracy (1e-3)
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# oracle-tolerance: G is chosen automatically and reproduced to the 8 printed digits of the native log (1e-8 relative); the box is lj reduced density scaled, so edges are 2^(1/3) times the cell counts
units           lj
atom_style      charge
lattice         custom 1.0 a1 1 0 0 a2 0 1 0 a3 0 0 1 basis 0 0 0 basis 0.5 0.5 0.5
region          box block 0 10 0 12 0 14
create_box      2 box
create_atoms    1 box basis 1 1 basis 2 2
mass            * 1.0
set             type 1 charge 1.0
set             type 2 charge -1.0
pair_style      lj/cut/coul/long 4.5
pair_coeff      * * 0.0 1.0
pair_modify   table 0
kspace_style    pppm 1.0e-3
thermo_style    custom step temp pe elong ecoul etotal press
thermo_modify   format float %.15g
thermo          1
run             0
