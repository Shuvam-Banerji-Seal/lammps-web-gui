# oracle: pair_style granular hooke tangential linear_history damping coeff_restitution synchronized_verlet — cut-down of examples/granular/in.sync_verlet (three particles from 3ps.dat, two of them frozen, one fine particle under gravity, fix wall/gran zplane, 3000 of the 300000 steps)
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           si
atom_style      sphere
newton          off
boundary        p p f
region          box block -0.03 0.03 -0.02 0.02 -0.02 0.02
create_box      2 box
create_atoms    1 single 0.005 0.0000279374816650248 0.0016005372526493155
create_atoms    1 single 0.01 0.0 0.0
create_atoms    1 single 0.0 0.0 0.0
set atom 1 type 2 diameter 0.0005 density 2500
set atom 2 type 1 diameter 0.01 density 2500
set atom 3 type 1 diameter 0.01 density 2500
group           ps type 1
group           fine type 2
pair_style      granular
pair_coeff * * hooke 1e4 0.5 tangential linear_history 8235 0 0.5 damping coeff_restitution synchronized_verlet
timestep        1e-6
fix             frz ps freeze
fix             g fine gravity 9.81 vector 0 0 -1
fix             1 fine nve/sphere
fix             2 all wall/gran granular hooke 1e4 0.5 tangential linear_history 8235 0 0.5 damping coeff_restitution zplane -0.02 0.02
comm_modify     vel yes
thermo          300
thermo_style    custom step ke
thermo_modify   format float %.15g
run             3000
