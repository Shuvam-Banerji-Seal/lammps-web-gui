# oracle: fix qtb on methane (ReaxFF, qeq/reax, nve) from examples/PACKAGES/qtb/methane_qtb (b332f28, GPL-2.0), cut down:
# Native reference: LAMMPS b332f28 built from source with PKG_KSPACE MANYBODY MISC MOLECULE PHONON QEQ QTB REAXFF SHOCK, because the installed binary has no QTB (cmake -D PKG_<name>=on for each; then LMP=<build>/lmp run-oracle.mjs)
# 2x2x2 replicas of the 5-atom cell (40 atoms), 100 steps (thermo every 20), f_max 0.3 and N_f 50 as in the example
# oracle-inputs: w99phq_methane_ffield.reax
# oracle-compare: thermo=all atoms=all rel=1e-5 abs=1e-8
# measured (engine vs native): Node 24 thermo within 2.2e-6 relative (the ReaxFF pressure), per-atom 7.3e-5; Node 20 2.0e-6 and 2.2e-5
units                   real
dimension               3
boundary                p p p
atom_style              charge
lattice                 custom 1.0 &
                        a1      3.9783624 0 0 &
                        a2      0 3.9783624 0 &
                        a3      0 0 3.9783624 &
                        &
                        basis   0.5 0.5 0.5 &
                        basis   0.663 0.663 0.663 &
                        basis   0.337 0.337 0.663 &
                        basis   0.663 0.337 0.337 &
                        basis   0.337 0.663 0.337
region                  simbox block 0 3.9783624 0 3.9783624 0 3.9783624 units box
create_box              2 simbox
create_atoms            1 box &
                        basis   1 1 &
                        basis   2 2 &
                        basis   3 2 &
                        basis   4 2 &
                        basis   5 2
replicate               2 2 2
mass                    1 12.011150
mass                    2  1.007970
pair_style              reaxff NULL
pair_coeff              * * w99phq_methane_ffield.reax C H
fix                     0 all qeq/reax 1 0.0 10.0 1.0e-6 reaxff
neighbor                2.5 bin
neigh_modify            every 10 delay 0 check no
velocity                all create 110.0 93 dist gaussian sum no mom yes rot yes loop all
thermo_style            custom step temp press etotal vol
thermo_modify           format float %.15g
thermo                  20
fix                     scapegoat_qtb all nve
fix                     methane_qtb all qtb temp 110.0 damp 200 seed 35082 f_max 0.3 N_f 50
timestep                0.25
run                     100
