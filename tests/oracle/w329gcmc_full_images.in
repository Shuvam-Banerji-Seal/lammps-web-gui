# oracle: fix gcmc full_energy with atom translations in units real: a rejected translation that left the box keeps the image flag the energy evaluation's wrap gave it (native puts back only the position), so unwrapped positions shift by a box length
# oracle-compare: thermo=all atoms=all rel=1e-8
units real
atom_style atomic
pair_style lj/cut 8.0
pair_modify tail no
region box block 0 20 0 20 0 20
create_box 1 box
pair_coeff * * 0.238 3.405
mass 1 39.948
group gcmcgroup type 1
fix mygcmc gcmcgroup gcmc 1 5 5 1 4321 120.0 -0.1 0.5 full_energy
thermo_style custom step atoms pe f_mygcmc[1] f_mygcmc[2] f_mygcmc[3] f_mygcmc[4] f_mygcmc[5] f_mygcmc[6]
thermo 10
thermo_modify format float %.15g
run 150
