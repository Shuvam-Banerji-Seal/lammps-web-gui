# oracle: displace_atoms random (2d: x and y only) on a 128-atom square lattice, run 0
# oracle-compare: thermo=all atoms=all
dimension       2
units           lj
atom_style      atomic
boundary        p p p
lattice         sq2 0.8
region          box block 0 8 0 8 -0.5 0.5
create_box      1 box
create_atoms    1 box
mass            1 1.0
displace_atoms  all random 0.1 0.2 0 4321 units box
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
neighbor        0.3 bin
neigh_modify    every 20 delay 0 check no
thermo_style    custom step pe press
thermo_modify   format float %.15g
thermo          1
run             0
