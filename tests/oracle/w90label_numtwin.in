# oracle: numeric twin of w90label_data (the same run with numeric types), the reference for the label case
# oracle-inputs: w90label_num.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           real
atom_style      full
read_data       w90label_num.data
pair_style      lj/cut 6.0
bond_style      harmonic
angle_style     harmonic
dihedral_style  harmonic
improper_style  harmonic
pair_coeff      1 1 0.001 3.40
pair_coeff      1 2 0.001 2.50
pair_coeff      2 2 0.001 2.20
pair_modify     mix arithmetic
bond_coeff      1 300.0 1.10
bond_coeff      2 250.0 1.50
angle_coeff     1 40.0 109.5
dihedral_coeff  1 1.0 1 2
improper_coeff  1 10.0 0.0
mass            1 12.011
group           hyd type 2
set             type 1 type 1
set             group hyd type 2
timestep        0.5
fix             1 all nve
thermo_style    custom step temp pe ebond eangle edihed eimp evdwl etotal press
thermo_modify   format float %.15g
thermo          5
run             20
