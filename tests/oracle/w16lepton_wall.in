# oracle: fix wall/lepton (lo and hi walls, expression with rc and a linear-in-r term, fix_modify energy and virial)
units           lj
atom_style      atomic
boundary        f p p
lattice         fcc 0.8442
region          box block 0 6 0 4 0 4
create_box      1 box
region          inner block 0.3 5.7 INF INF INF INF
create_atoms    1 region inner
mass            1 1.0
variable        vx atom 0.5*sin(1.3*x+0.7*y)
variable        vy atom 0.5*cos(0.9*y-0.4*z)
variable        vz atom 0.5*sin(1.1*z+0.5*x)
velocity        all set v_vx v_vy v_vz
velocity        all zero linear
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
fix             w1 all wall/lepton xlo EDGE "k*(r-rc)^2; k=1.0" 2.5
fix_modify      w1 energy yes virial yes
fix             w2 all wall/lepton xhi EDGE "2.0*r + 0.5*r^3" 1.5
fix_modify      w2 energy yes virial yes
fix             1 all nve
compute         ef all pe/atom fix
compute         ref all reduce sum c_ef
thermo_style    custom step pe f_w1 f_w2 c_ref press pxx
thermo_modify   format float %.15g
thermo          10
run             40
