# oracle: fix wall/region style colloid (the integrated colloid potential of finite-size particles) on a side-in sphere
# region and a side-out cylinder obstacle, energy yes; spheres of two diameters with fix nve/sphere and soft lj/cut
# pairs; the walls' energy and force vectors in thermo
# oracle-compare: thermo=all atoms=all
units           lj
atom_style      sphere
boundary        f f f
region          box block -8 8 -8 8 -8 8 units box
create_box      2 box
region          ball sphere 0 0 0 6.5 side in units box
region          post cylinder z 0 0 1.5 INF INF side out units box
lattice         sc 0.25
region          core sphere 0 0 0 4.8 units box
region          shell cylinder z 0 0 3.0 INF INF side out units box
region          seed intersect 2 core shell
create_atoms    1 region seed
group           big id 1:1000:3
set             group big type 2
set             type 1 diameter 1.0
set             type 2 diameter 1.6
set             group all density 1.0
velocity        all create 1.5 87287 loop geom
pair_style      lj/cut 1.5
pair_coeff      * * 0.2 1.0
fix             1 all nve/sphere
fix             2 all wall/region ball colloid 0.5 1.0 2.5
fix_modify      2 energy yes
fix             3 all wall/region post colloid 0.4 1.0 2.2
fix_modify      3 energy yes
thermo_style    custom step temp pe ke f_2 f_2[1] f_2[2] f_2[3] f_3 f_3[1] f_3[2]
thermo_modify   format float %.15g
thermo          20
timestep        0.002
run             120
