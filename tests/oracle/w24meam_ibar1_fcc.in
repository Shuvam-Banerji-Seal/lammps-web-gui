# oracle: pair_style meam, library Ni entry (fcc, ibar = 1), zbl off in w24meam_ibar1_fcc.meam, displaced fcc cell, velocities from atom-style variables, 50 steps of nve
# oracle-potentials: library.meam
# oracle-inputs: w24meam_ibar1_fcc.meam
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           metal
atom_style      atomic
lattice         fcc 3.52
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 58.69
variable        dx atom 0.06*sin(1.3*x+0.7*y)
variable        dy atom 0.06*cos(0.9*y-0.4*z)
variable        dz atom 0.06*sin(1.1*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.01*sin(id)
variable        vy atom 0.01*cos(2*id)
variable        vz atom 0.01*sin(3*id)
velocity        all set v_vx v_vy v_vz
pair_style      meam
pair_coeff      * * library.meam Ni w24meam_ibar1_fcc.meam Ni
timestep        0.001
fix             1 all nve
thermo_style    custom step pe ke press pxx pyz
thermo_modify   format float %.15g norm no
thermo          10
run             50
