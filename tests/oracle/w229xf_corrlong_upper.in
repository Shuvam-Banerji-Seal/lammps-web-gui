# oracle: LJ fluid, fix ave/correlate/long of three stress components (type upper, ncorr 5, nlen 8, ncount 2), file output
# oracle-files: corrl_upper.dat
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 1.3e-13, atoms 3.6e-13. (file compared with %g, 6 digits, at the file tolerance)
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 1.44 87287 loop all
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0 2.5
timestep        0.002
fix             1 all nve
compute         T all temp
compute         p all pressure T
fix             JJ all ave/correlate/long 2 20 c_p[4] c_p[5] c_p[6] type upper ncorr 5 nlen 8 ncount 2 file corrl_upper.dat
thermo_style    custom step temp pe c_p[4] c_p[5] c_p[6]
thermo_modify   format float %.15g
thermo          40
run             200
