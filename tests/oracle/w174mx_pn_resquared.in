# oracle: compute pair/local pN for pair resquared (native single_extra 6: the force and the torque on atom i, times factor_lj) on 8 ellipsoids of two types (shape and quaternion per type, no LJ spheres, native: b332f28 lmp, ASPHERE package): dump local at step 0 with cutoff type
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12 atomrel=1e-9 filerel=1e-9
# oracle-files: w174mx_pn_resquared.local
units           lj
atom_style      ellipsoid
boundary        f f f
region          box block 0 8 0 8 0 8
create_box      2 box
create_atoms    1 single 2.0 2.1 2.2 units box
create_atoms    2 single 2.9 2.4 2.5 units box
create_atoms    1 single 3.4 3.1 2.0 units box
create_atoms    2 single 2.6 3.6 3.1 units box
create_atoms    1 single 4.2 2.2 3.0 units box
create_atoms    2 single 4.8 3.2 2.6 units box
create_atoms    1 single 5.0 5.0 5.0 units box
create_atoms    2 single 4.4 4.8 5.6 units box
set             atom * mass 1.0
set             atom 1 shape 2.2 2.9 2.7
set             atom 1 quat 0.7 -0.2 0.4 35.0
set             atom 2 shape 2.0 2.4 2.1
set             atom 2 quat -0.4 0.6 0.3 -60.0
set             atom 3 shape 2.2 2.9 2.7
set             atom 3 quat 0.1 0.9 -0.3 110.0
set             atom 4 shape 2.0 2.4 2.1
set             atom 4 quat 0.8 0.1 0.5 75.0
set             atom 5 shape 2.2 2.9 2.7
set             atom 5 quat 0.5 0.5 0.5 20.0
set             atom 6 shape 2.0 2.4 2.1
set             atom 6 quat 0.2 0.3 0.9 50.0
set             atom 7 shape 2.2 2.9 2.7
set             atom 7 quat -0.6 0.5 0.6 140.0
set             atom 8 shape 2.0 2.4 2.1
set             atom 8 quat 0.3 -0.8 0.5 30.0
pair_style      resquared 3.0
pair_modify     shift yes
pair_coeff      1 1 1.0 1.0 1 1 1 1 1 1
pair_coeff      2 2 0.8 1.2 2 2 2 2 2 2 2.5
pair_coeff      1 2 0.9 1.1 2 2 2 2 2 2
compute         pl all pair/local dist eng force fx fy fz p1 p2 p3 p4 p5 p6 cutoff type
dump            d all local 1 w174mx_pn_resquared.local index c_pl[*]
dump_modify     d format float %.15g
thermo_style    custom step pe
thermo_modify   format float %.15g
run             0
