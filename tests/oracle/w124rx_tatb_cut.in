# oracle: the in.reaxff.tatb example (b332f28, GPL-2.0) with fix reaxff/species given the cutoff and element keywords:
# a 0.9 bond order cutoff for every type pair and element names C H O N; cut down to 384 atoms and 20 steps, as w124rx_tatb.
# oracle-inputs: w55reax_tatb.data w55reax_tatb.control w55reax_ffield.reax
# oracle-files: bonds.reaxff species.cut
# oracle-compare: thermo=all atoms=all rel=1e-4 abs=1e-6 skip=v_nqeq
# measured (engine vs native): species.cut and bonds.reaxff identical (every token); v_nmole and v_nspec exact (112 molecules:
# 16 of C6O6N6 and 96 of H, 2 species); thermo and per-atom errors as in w124rx_tatb (the qeq/reaxff port)
units           real
atom_style      charge
read_data       w55reax_tatb.data
pair_style      reaxff w55reax_tatb.control
pair_coeff      * * w55reax_ffield.reax C H O N
compute reax all pair reaxff
variable eb      equal c_reax[1]
variable ea      equal c_reax[2]
variable elp     equal c_reax[3]
variable emol    equal c_reax[4]
variable ev      equal c_reax[5]
variable epen    equal c_reax[6]
variable ecoa    equal c_reax[7]
variable ehb     equal c_reax[8]
variable et      equal c_reax[9]
variable eco     equal c_reax[10]
variable ew      equal c_reax[11]
variable ep      equal c_reax[12]
variable efi     equal c_reax[13]
variable eqeq    equal c_reax[14]
neighbor        2.5 bin
neigh_modify    delay 0 every 5 check no
fix             1 all nve
fix             2 all qeq/reaxff 1 0.0 10.0 1.0e-6 reaxff
fix             4 all reaxff/bonds 5 bonds.reaxff
fix             3 all reaxff/species 1 5 5 species.cut cutoff * * 0.9 element C H O N
variable nqeq   equal f_2
variable nmole  equal f_3[1]
variable nspec  equal f_3[2]
thermo          5
thermo_style    custom step temp epair etotal press v_eb v_ea v_elp v_emol v_ev v_epen v_ecoa v_ehb v_et v_eco v_ew v_ep v_efi v_eqeq v_nqeq v_nmole v_nspec
thermo_modify   format float %.15g
timestep        0.0625
run             20
