# oracle: pair_style vashishta single element
# oracle-inputs: w5vash_Si.vashishta
units           metal
atom_style      atomic
lattice         diamond 5.43
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box
mass            * 28.0
variable        dx atom 0.05*sin(0.9*x+0.4*y)
variable        dy atom 0.05*cos(0.7*y-0.5*z)
variable        dz atom 0.05*sin(1.1*z+0.3*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 3.0*sin(0.9*x+0.4*z)
variable        vy atom 3.0*cos(0.6*y+0.8*x)
variable        vz atom 3.0*sin(0.7*z-0.3*y)
velocity        all set v_vx v_vy v_vz units box
velocity        all zero linear
pair_style      vashishta
pair_coeff      * * w5vash_Si.vashishta Si
timestep        0.0005
fix             1 all nve
thermo_style    custom step temp pe etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          10
run             50
