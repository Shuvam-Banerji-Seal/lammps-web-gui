# oracle: dihedral_style table linear 360 with a DEGREES table (the default), forces in the fourth column
# oracle-inputs: w216tb_chains.data w216tb_dihedral.table
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 1.3e-13, atoms 8.2e-14.
units           lj
atom_style      molecular
read_data      w216tb_chains.data
pair_style      lj/cut 1.0
pair_coeff      * * 0.0 1.0
timestep       0.002
dihedral_style  table linear 360
dihedral_coeff 1 w216tb_dihedral.table DLIN
dihedral_coeff 2 w216tb_dihedral.table DLIN
fix             1 all nve
thermo          10
thermo_style    custom step pe ebond eangle edihed ke press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
run             100
