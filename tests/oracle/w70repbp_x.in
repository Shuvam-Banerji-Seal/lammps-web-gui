# oracle: replicate 3 3 1 bond/periodic of a 3-atom chain bonded around the periodic x boundary (examples/replicate in.replicate.bond.x): the closing bond joins neighbouring copies, 300-step nve
# oracle-inputs: w70repbp_data.bond.x
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
dimension       2
atom_style      molecular
read_data       w70repbp_data.bond.x
replicate       3 3 1 bond/periodic
mass            1 1.0
velocity        all create 0.02 87287 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
bond_style      harmonic
bond_coeff      1 50.0 1.0
special_bonds   fene
fix             1 all nve
thermo          50
thermo_modify   format float %.15g
run             300
