# oracle: fix pour block region with rate (region rises), diam poly, vel vz, 3 events of 2 particles, pair gran/hooke, fix nve/sphere, floor wall/gran
# oracle-compare: thermo=all atoms=all
units           lj
atom_style      sphere
atom_modify     map array
comm_modify     vel yes
boundary        p p f
region          box block -10 10 -10 10 -10 10
create_box      2 box
region          reg block -3 3 -3 3 0 2 side in units box
pair_style      gran/hooke 2000.0 700.0 50.0 30.0 0.5 1
pair_coeff      * *
timestep        0.002
fix             1 all nve/sphere
fix             2 all gravity 1.0 vector 0 0 -1
fix             4 all wall/gran hooke 2000.0 700.0 50.0 30.0 0.5 1 zplane -2.0 NULL
fix             3 all pour 6 2 777 region reg diam poly 2 0.6 0.5 0.8 0.5 dens 1.0 1.0 vel 0.0 0.0 0.0 0.0 -0.3 rate 0.4 vol 0.05 50
compute         er all erotate/sphere
thermo_style    custom step atoms ke c_er
thermo_modify   format float %.15g
thermo          200
run             4000
