# oracle: shell built-ins cd, mkdir, mv (into a folder), rm -f and putenv on the working directory; files written from a cd'ed directory
# Measured max relative error of the engine against native (thermo 2.9e-15, per-atom 5.1e-15; the written files match token by token). native: b332f28 (installed lmp, black box)
# oracle-files: out/w.data moved.dump
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 2 0 2 0 2
create_box      2 box
create_atoms    1 box
mass            * 1.0
velocity        all create 1.2 4928459 loop geom
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0 2.5
shell           mkdir out sub/deep
shell           putenv LAMMPS_POTENTIALS=pots
shell           cd out
shell           rm -f nothere.txt
dump            1 all custom 2 d.dump id type x y z vx vy vz
dump_modify     1 format float %.15g
write_data      w.data
shell           cd ..
shell           cd out
shell           cd ..
fix             1 all nve
thermo_style    custom step pe ke
thermo_modify   format float %.15g
thermo          2
run             4
# the dump file is complete only after the run (native keeps the dump's open handle, so a mv before the run would move the handle, not the content)
shell           mv out/d.dump moved.dump
shell           rm -f out/none.dump
