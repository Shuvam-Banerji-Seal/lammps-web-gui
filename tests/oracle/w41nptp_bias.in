# oracle: fix npt aniso with fix_modify temp of a compute temp/partial (velocity bias) and npt on a group subset, lj, 60 steps
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 1.0
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
velocity        all create 1.2 87287 loop all
compute         tp all temp/partial 0 1 1
fix             1 all npt temp 1.0 1.0 0.5 aniso 1.0 1.0 2.0
fix_modify      1 temp tp
thermo_style    custom step temp pe press pxx pyy pzz lx ly lz f_1
thermo_modify   format float %.15g
thermo          10
timestep        0.005
run             60
