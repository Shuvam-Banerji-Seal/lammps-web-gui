# oracle: fix gcmc molecule rotation with maxangle 0 (X=0 M=1, mcmoves 0 0 1) - the rotation angle is 0 so dU=0 and every rotation succeeds: f[7]=f[8]=step
# oracle-inputs: w32gcmc_dimer.mol
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=1e-12
units lj
atom_style molecular
pair_style lj/cut 3.0
pair_modify tail no
region box block 0 5 0 5 0 5
create_box 1 box
pair_coeff * * 1.0 1.0
mass 1 1.0
molecule dimer w32gcmc_dimer.mol
create_atoms 0 single 2.0 2.0 2.0 mol dimer 12345 units box

fix mygcmc all gcmc 1 0 1 0 29494 2.0 -1.0 0.0 mol dimer mcmoves 0 0 1 maxangle 0
thermo_style custom step atoms pe f_mygcmc[1] f_mygcmc[2] f_mygcmc[3] f_mygcmc[4] f_mygcmc[5] f_mygcmc[6] f_mygcmc[7] f_mygcmc[8]
thermo 1
thermo_modify format float %.15g
run 5
