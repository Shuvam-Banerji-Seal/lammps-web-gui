# oracle: pair_style hybrid/overlay lj/cut 6.5 + atm 4.5 4.0 (the doc usage with cut_triple raised from 2.5: on this fcc cell every triangle has a product above 2.5^3, so 2.5 gives no triplets), 50 MD steps
# oracle-compare: thermo=all atoms=all
units           metal
atom_style      atomic
lattice         fcc 4.05
region          box block 0 2 0 2 0 2
create_box      2 box
create_atoms    1 box
group           odd id 1:32:2
set             group odd type 2
mass            * 26.98
variable        dx atom 0.08*sin(0.9*x+0.4*y)
variable        dy atom 0.08*cos(0.7*y-0.5*z)
variable        dz atom 0.08*sin(1.1*z+0.3*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.5*sin(0.5*x+0.2*z)
variable        vy atom 0.5*cos(0.4*y+0.6*x)
variable        vz atom 0.5*sin(0.3*z-0.5*y)
velocity        all set v_vx v_vy v_vz units box
velocity        all zero linear
pair_style      hybrid/overlay lj/cut 6.5 atm 4.5 4.0
pair_coeff      * * lj/cut 0.01 2.5
pair_coeff      1 1 atm 1 0.064
pair_coeff      1 1 atm 2 0.080
pair_coeff      1 2 atm 2 0.100
pair_coeff      2 2 atm 2 0.125
timestep        0.001
fix             1 all nve
thermo_style    custom step temp pe evdwl etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          10
run             50
