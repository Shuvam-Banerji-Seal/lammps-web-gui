# oracle: LJ fluid, Muller-Plathe momentum exchange (fix viscosity x z 8, swap 2), thermo f_visc and per-atom state
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 1.44 87287 loop all
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0 2.5
timestep        0.002
fix             1 all nve
fix             visc all viscosity 10 x z 8 swap 2
thermo_style    custom step temp pe f_visc
thermo_modify   format float %.15g
thermo          10
run             200
