# oracle: w83sph_heat3d, cut-down of examples/PACKAGES/sph/heatconduction/sph_heat_conduction_3d.lmp (20 x 2 x 2 cells, 40 steps). Measured max relative error vs native LAMMPS (black box): 1.2e-16 thermo, 0 per atom.
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           si
atom_style      sph
newton          on
boundary        f p p

lattice         sc 0.01
region          box block 0 20 0 2 0 2
create_box      1 box
create_atoms    1 box
mass            1 1.0e-5

region          left  block EDGE 9.9 EDGE EDGE EDGE EDGE
region          right block 10 EDGE EDGE EDGE EDGE EDGE
set             region left  sph/e 1.0
set             region right sph/e 2.0
set             group all sph/rho 10.0

pair_style      sph/heatconduction
pair_coeff      1 1 1.0e-4           2.0e-2
neighbor        0.2e-2 bin
neigh_modify    every 20 delay 0 check no

compute         ie_atom all sph/e/atom
compute         ie all reduce sum c_ie_atom

thermo_style    custom step temp c_ie
thermo_modify   norm no format float %.15g

fix             integrate_fix all sph/stationary

thermo          10
timestep        0.25e-1
run             40
