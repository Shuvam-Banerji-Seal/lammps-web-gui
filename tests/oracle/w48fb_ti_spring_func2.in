# oracle: fix ti/spring (function 2) defined after a short run, with energy yes, forces vs native
# oracle-compare: thermo=all atoms=all
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 8.0e-13, atoms 1.1e-14.
units           lj
atom_style      atomic
lattice         fcc 0.9
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box
mass            1 1.0
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
velocity        all create 0.5 4321 loop all
timestep        0.002
fix             1 all nve
reset_timestep 4
fix             f2 all ti/spring 3.0 5 2 function 2
fix_modify      f2 energy yes
thermo_style    custom step pe f_f2 f_f2[1] f_f2[2]
thermo_modify   format float %.15g
thermo          1
run             36
