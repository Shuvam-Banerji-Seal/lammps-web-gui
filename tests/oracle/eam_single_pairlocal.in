# oracle: pair eam single() as native (pair_eam.cpp single): compute pair/local eng and force sum the pair term plus atom i's embedding energy shared over its numforce neighbors, with F' of both atoms; pair_write after the run swaps in an F' of zeros (pair.cpp write_file) but keeps atom 0's embedding share; 2 types (Cu_u3, Ni_u3), displaced lattice
# oracle-potentials: Cu_u3.eam Ni_u3.eam
# oracle-files: eam_single_pairlocal.table
# oracle-compare: thermo=all atoms=none filerel=1e-12
units           metal
atom_style      atomic
lattice         fcc 3.6
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
set             group all type/fraction 2 0.4 4321
displace_atoms  all random 0.08 0.08 0.08 4711
pair_style      eam
pair_coeff      1 1 Cu_u3.eam
pair_coeff      2 2 Ni_u3.eam
compute         pl all pair/local eng force dist
compute         sl all reduce sum c_pl[1] c_pl[2] c_pl[3] inputs local
compute         ml all reduce max c_pl[1] c_pl[2] inputs local
thermo_style    custom step pe c_sl[1] c_sl[2] c_sl[3] c_ml[1] c_ml[2]
thermo_modify   format float %.15g
run             0
pair_write      1 2 30 r 2.0 4.9 eam_single_pairlocal.table CUNI
