# oracle: fix setforce/spin 0 0 0 on one group zeroes its precession vectors (precession/spin zeeman + exchange), other atoms unchanged
# oracle-files: w48sp2_setforce.dump
units           metal
atom_style      spin
boundary        f f f
atom_modify     map array
region          box block -10 10 -10 10 -10 10
create_box      1 box
create_atoms    1 single 0.0 0.0 0.0
create_atoms    1 single 2.0 0.0 0.0
create_atoms    1 single 1.0 1.7 0.3
mass            1 55.845
set             atom 1 spin/atom 2.0 0.6 0.48 0.64
set             atom 2 spin/atom 3.0 -0.2 0.9 0.4
set             atom 3 spin/atom 1.5 0.5 -0.4 0.9
group           frozen id 2
pair_style      spin/exchange 4.0
pair_coeff      * * exchange 4.0 0.02726 0.2171 1.841 offset yes
fix             2 all precession/spin zeeman 10.0 0.1 0.2 1.0
fix             3 frozen setforce/spin 0.0 0.0 0.0
fix             1 all nve/spin lattice frozen
compute         p all property/atom spx spy spz sp fmx fmy fmz fx fy fz
run             0
write_dump      all custom w48sp2_setforce.dump id c_p[1] c_p[2] c_p[3] c_p[4] c_p[5] c_p[6] c_p[7] c_p[8] c_p[9] c_p[10] modify format float %.15g
