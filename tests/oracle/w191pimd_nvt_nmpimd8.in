# Measured with native LAMMPS: engine vs native (b332f28, installed /home/roy/.local/bin/lmp, PKG REPLICA) per partition: thermo max err 5.5e-14 (relative), per-atom max 3.6e-15 (8 beads, 50 steps, about 1.4 s engine incl. node start).
# oracle: w191pimd_nvt_nmpimd8 — fix pimd/nvt method nmpimd on 8 beads with fmass 0.5, sp 2.0, nhc 3 (normal-mode tables of an even ring)
# oracle-partitions: 8
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
variable ibead world 0 1 2 3 4 5 6 7
units metal
atom_style atomic
atom_modify map yes
boundary p p p
region box block -6 6 -6 6 -6 6
create_box 1 box
create_atoms 1 single -1.0 0.5 0.2
create_atoms 1 single 1.5 -0.7 0.9
create_atoms 1 single 0.3 2.0 -1.1
mass 1 12.0
pair_style lj/cut 5.0
pair_coeff * * 0.002 3.0
timestep 0.001
velocity all create 300.0 777${ibead} mom yes rot no dist gaussian
fix 1 all pimd/nvt method nmpimd fmass 0.5 sp 2.0 temp 300.0 nhc 3
thermo_style custom step temp f_1[1] f_1[2] f_1[3] pe
thermo_modify format float %.15g
thermo 10
run 50
