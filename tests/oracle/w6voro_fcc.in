# oracle: compute voronoi/atom (default volume and face count) on a perfectly distorted fcc crystal, written by a dump
# oracle-files: vor.dump
# oracle-compare: thermo=first-last
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 1.0
variable        dx atom 0.08*sin(1.3*x+0.7*y)
variable        dy atom 0.08*cos(0.9*y-1.1*z)
variable        dz atom 0.08*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
compute         v all voronoi/atom
thermo_style    custom step pe
thermo_modify   format float %.15g
dump            d all custom 1 vor.dump id c_v[*]
dump_modify     d sort id format float %.12g
run             0
