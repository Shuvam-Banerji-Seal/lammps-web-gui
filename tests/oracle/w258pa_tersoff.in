# oracle: per-atom energy and virial of pair_style tersoff (Si.tersoff, displaced diamond Si, two atom types both mapped to Si): compute pe/atom and stress/atom NULL dumped per atom at step 0 and after 10 nve steps
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 2.1e-13, atoms 1.4e-14; the per-atom dump agrees to 1e-10.
# oracle-potentials: Si.tersoff
# oracle-files: w258pa_tersoff.dump
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=1e-10 filerel=1e-10
units           metal
atom_style      atomic
lattice         diamond 5.431
region          box block 0 2 0 2 0 2
create_box      2 box
create_atoms    1 box
set             type 1 type/fraction 2 0.5 2741
mass            * 28.06
variable        dx atom 0.05*sin(1.3*x+0.7*y)
variable        dy atom 0.05*cos(0.9*y-0.4*z)
variable        dz atom 0.05*sin(1.1*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
pair_style      tersoff
pair_coeff      * * Si.tersoff Si Si
velocity        all create 600 4928 loop geom
timestep        0.001
fix             1 all nve
compute         pe all pe/atom
compute         st all stress/atom NULL
compute         sum all reduce sum c_pe c_st[1] c_st[2] c_st[3] c_st[4] c_st[5] c_st[6]
thermo_style    custom step pe press pxx pyy pzz pxy pxz pyz c_sum[1] c_sum[2] c_sum[3] c_sum[4] c_sum[5] c_sum[6] c_sum[7]
thermo_modify   format float %.15g norm no
thermo          5
dump            d all custom 10 w258pa_tersoff.dump id c_pe c_st[1] c_st[2] c_st[3] c_st[4] c_st[5] c_st[6]
dump_modify     d sort id format float %.15g
run             10
