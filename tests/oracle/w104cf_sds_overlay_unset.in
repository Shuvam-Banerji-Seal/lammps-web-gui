# oracle: hybrid/overlay where type pair (1,3) has no lj/sdk coefficients (only coul/long)
# oracle-inputs: w104cf_sds_small.data
# oracle-compare: thermo=all atoms=all rel=1e-6 abs=1e-9
units real
atom_style full
boundary p p p
bond_style harmonic
angle_style sdk
special_bonds lj/coul 0.0 0.0 1.0
read_data w104cf_sds_small.data
pair_style hybrid/overlay lj/sdk 15.0 coul/long 26.5
pair_coeff * * coul/long
pair_coeff 1 1 lj/sdk lj9_6 0.7000 4.3210
pair_coeff 1 2 lj/sdk lj9_6 0.3830 4.4135
pair_coeff 2 2 lj/sdk lj9_6 0.4200 4.5060
pair_coeff 2 3 lj/sdk lj9_6 0.4440 4.5455
pair_coeff 3 3 lj/sdk lj12_4 0.3500 4.3710
kspace_style ewald 1e-6
bond_coeff 1 300.0 3.0
angle_coeff 1 20.0 100.0
thermo_style custom step pe evdwl ecoul elong eangle press
thermo_modify format float %.15g norm no
run 0
