# oracle: fix hmc always-accept limit (T huge) — velocity resampling stream, per-cycle NVE trajectory and f_ counters
units           lj
atom_style      atomic
boundary        p p p
region          box block 0 8 0 8 0 8
create_box      1 box
create_atoms    1 single 2.0 2.0 2.0 units box
create_atoms    1 single 3.5 2.0 2.0 units box
create_atoms    1 single 2.0 5.0 2.0 units box
create_atoms    1 single 3.5 5.0 2.0 units box
mass            1 1.0
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
velocity        all set 0.0 0.0 0.0
fix             1 all nve
fix             2 all hmc 5 12345 1000000.0 resample yes
thermo_style    custom step temp pe ke etotal f_2 f_2[1] f_2[2]
thermo_modify   format float %.15g
thermo          5
run             20
