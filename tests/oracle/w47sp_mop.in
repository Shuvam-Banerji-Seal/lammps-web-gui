# oracle: compute stress/mop at one plane (center, kin conf; lower total; a group with the pair keyword) on a periodic lj fcc liquid after 20 nve steps
# oracle-compare: thermo=all atoms=none rel=1e-8 abs=1e-10
# oracle-files: w47sp_mop.time
# oracle-note: the values are sampled by fix ave/time with start 20 (the setup evaluation of stress/mop is an EngineError: native's setup row is not reproduced)
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
mass            1 1.0
variable        dxa atom 0.05*sin(2.3*y+0.4*z)
variable        dya atom 0.04*cos(1.7*z)
variable        dza atom 0.03*sin(1.3*z+0.5)
displace_atoms  all move v_dxa v_dya v_dza units box
variable        vxa atom 0.7*sin(2.3*y+0.4*z)+0.3*cos(1.1*x)
variable        vya atom 0.6*cos(1.7*z-0.9*x)
variable        vza atom 0.5*sin(1.3*x+0.8*y)
velocity        all set v_vxa v_vya v_vza units box
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0
fix             1 all nve
group           half id 1:128
compute         m1 all stress/mop x center kin conf
compute         m2 all stress/mop z lower total
compute         m3 half stress/mop y 0.8 pair kin
thermo_style    custom step
thermo_modify   format float %.15g
thermo          20
run             20
print "$(c_m1[1]) $(c_m1[2]) $(c_m1[3]) $(c_m1[4]) $(c_m1[5]) $(c_m1[6]) $(c_m2[1]) $(c_m2[2]) $(c_m2[3]) $(c_m3[1]) $(c_m3[2]) $(c_m3[3]) $(c_m3[4]) $(c_m3[5]) $(c_m3[6])" file w47sp_mop.time screen no
