# oracle: fix deposit and fix evaporate with pair_modify tail yes: atoms are added and removed during the runs without a pair reinit, so native's tail correction keeps the atom counts of each run's start (Pair::init); a second run recounts them
units           lj
atom_style      atomic
boundary        p p p
lattice         fcc 0.6
region          box block 0 4 0 4 0 4
create_box      2 box
region          low block INF INF INF INF 0 2
create_atoms    1 region low
mass            * 1.0
pair_style      lj/cut 2.5
pair_modify     tail yes
pair_coeff      1 1 1.0 1.0
pair_coeff      2 2 0.8 1.1
pair_coeff      1 2 0.9 1.05
velocity        all create 1.0 87287 loop geom
region          top block 0 4 0 4 2.5 3.8
region          ev block INF INF INF INF INF 0.5
fix             1 all nve
fix             2 all deposit 6 2 5 4471 region top near 0.9 vz -0.5 -0.5
fix             3 all evaporate 7 1 ev 9113
fix             4 all langevin 1.0 1.0 0.5 3311
thermo_style    custom step atoms pe press etotal
thermo_modify   norm no format float %.15g
thermo          5
run             40
run             20
