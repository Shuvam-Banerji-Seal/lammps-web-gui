# oracle: run_style respa 2 levels with fix nvt — thermostat half steps at the outermost level, bonds level 1, lj/cut level 2
# oracle-inputs: mol_chains.data
# oracle-compare: thermo=all atoms=all rel=1e-8
units           lj
atom_style      molecular
bond_style      harmonic
angle_style     none
dihedral_style  none
improper_style  none
pair_style      lj/cut 2.5
read_data       mol_chains.data
pair_coeff      * * 0.5 0.9
pair_coeff      1 3 0.8 1.0
bond_coeff      1 120.0 1.05
bond_coeff      2 90.0 1.1
special_bonds   lj 0.0 0.5 0.8
timestep        0.002
velocity        all create 0.8 4928459 dist gaussian
run_style       respa 2 3 bond 1 pair 2
fix             1 all nvt temp 0.8 0.8 0.2
thermo_style    custom step temp pe ebond evdwl etotal press
thermo_modify   format float %.15g
thermo          10
run             100
