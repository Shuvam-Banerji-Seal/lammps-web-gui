# oracle: write_molecule of a small molecule template (coords, types, charges, bonds, angles, special bonds)
# oracle-files: w225cm_mol_out.txt
# oracle-inputs: w225cm_mol.txt
# oracle-compare: thermo=all atoms=none
units           real
atom_style      full
region          box block -5 5 -5 5 -5 5
create_box      2 box bond/types 1 angle/types 1 extra/bond/per/atom 2 extra/angle/per/atom 2 extra/special/per/atom 3
molecule        water w225cm_mol.txt
write_molecule  water w225cm_mol_out.txt
