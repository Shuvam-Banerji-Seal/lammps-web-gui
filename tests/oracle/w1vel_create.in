# oracle: velocity create with the Park-Miller stream — loop all over atom IDs (non-members draw too), loop local, uniform and gaussian, mixed masses
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
mass            1 1.0
mass            2 2.5
group           heavy id 1:108:3
set             group heavy type 2
group           light type 1
velocity        light create 1.2 4928459 dist gaussian
velocity        heavy create 0.8 87287 loop local
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0
timestep        0.002
fix             1 all nve
thermo_style    custom step temp pe etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          10
run             30
velocity        all create 1.5 12345 mom yes rot yes
run             20
