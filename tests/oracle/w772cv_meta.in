# oracle: fix colvars metadynamics (Colvars colvarbias_meta) on a 256-atom LJ liquid: one distance colvar (width 0.25,
#   lowerBoundary 0.5, upperBoundary 5.5: a 20-bin grid), hills of weight 0.2 and hillWidth 2 every 5 steps, projected
#   onto the energy and gradient grids every 5 steps (the default gridsUpdateFrequency), hills within 7 bins of the
#   upper boundary kept off-grid, the state every 20 steps (which projects the pending hills first), the hills
#   trajectory and the PMF (writeFreeEnergyFile, default on); two runs (the second continues, no hill at its step 0).
# Measured with native LAMMPS: the traj, hills traj and PMF files of the engine are byte-identical, the state files
#   differ by 1 ulp in a few grid values (the hill centres inherit the LJ trajectory's last-bit differences).
# oracle-inputs: w772cv_meta.colvars
# oracle-files: mtd.colvars.traj mtd.colvars.state mtd.colvars.metadynamics1.hills.traj mtd.pmf mtd.pmf.BAK
# oracle-compare: thermo=all atoms=all rel=1e-10 filerel=1e-10
units           lj
atom_modify     map array
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
set             atom 1*128 type 2
mass            1 1.0
mass            2 2.5
velocity        all create 1.5 87287 loop geom
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0 2.5
neighbor        0.3 bin
neigh_modify    every 1 delay 0 check yes
fix             1 all nve
fix             2 all colvars w772cv_meta.colvars output mtd
fix_modify      2 energy yes
thermo_style    custom step temp pe etotal f_2 f_2[1][1]
thermo_modify   format float %.15g
thermo          5
run             50
run             30
