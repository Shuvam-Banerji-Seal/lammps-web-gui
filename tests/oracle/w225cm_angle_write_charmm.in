# oracle: angle_write of a charmm angle type (Urey-Bradley term) with 25 values
# oracle-files: w225cm_charmm.table
# oracle-compare: thermo=all atoms=none
units           real
atom_style      full
region          box block -5 5 -5 5 -5 5
create_box      2 box bond/types 1 angle/types 1 extra/bond/per/atom 2 extra/angle/per/atom 1 extra/special/per/atom 3
create_atoms    1 single 0.0 0.0 0.0
mass            * 12.0
pair_style      zero 10.0
pair_coeff      * *
angle_style     charmm
angle_coeff     1 50.0 109.5 5.0 1.8
angle_write     1 25 w225cm_charmm.table CHARMM
