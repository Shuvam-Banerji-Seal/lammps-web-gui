# image_select fixture: native b332f28 (/home/roy/.local/bin/lmp), dump image PPM, run 0.
units lj
atom_style atomic
boundary f f f
lattice sc 1.0
region box block 0 4 0 4 0 4
create_box 2 box
create_atoms 1 box
group third id 1:64:3
set group third type 2
mass * 1.0
pair_style lj/cut 2.5
pair_coeff * * 1.0 1.0
dump d all image 1 img.*.ppm type type size 96 96 view 60 30 box no 0.02 autobond 1.1 0.15
dump_modify d pad 0 adiam * 0.4 thresh z < 2.5 thresh id != 7
run 0
