# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# oracle-files: w9pair_ljsf_out.data
# oracle: pair_style lj/sf (force-shifted LJ) — per-pair cutoffs, geometric mixing of the 1-2 pair
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
group           odd id 1:108:2
set             group odd type 2
mass            1 1.0
mass            2 1.5
variable        dx atom 0.04*sin(1.3*x+0.7*y)
variable        dy atom 0.04*cos(0.9*y-1.1*z)
variable        dz atom 0.04*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.8*sin(0.9*x+0.4*z)
variable        vy atom 0.8*cos(0.6*y+0.8*x)
variable        vz atom 0.8*sin(0.7*z-0.3*y)
velocity        all set v_vx v_vy v_vz units box
velocity        all zero linear
pair_style      lj/sf 2.5
pair_coeff      1 1 1.0 1.0
pair_coeff      2 2 0.8 1.1 2.2
timestep        0.002
fix             1 all nve
thermo_style    custom step temp pe evdwl ecoul etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          10
run             50
write_data      w9pair_ljsf_out.data pair ij
