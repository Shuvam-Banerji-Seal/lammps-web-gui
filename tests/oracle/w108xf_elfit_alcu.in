# oracle: fix electron/stopping/fit (GPL port of EXTRA-FIX/fix_electron_stopping_fit.cpp), Cu projectile in Al, 6x6x6 fcc cells of examples/PACKAGES/electron_stopping/in.cascade_AlCu, 100 steps
# oracle-measured: thermo max rel 2.5e-15 (temp, f_3 3.5e-15); per-atom max rel 5.9e-10 (fz, abs 3.4e-13)
# oracle-potentials: AlCu.eam.alloy
# oracle-compare: rel=1e-8 abs=1e-10
units            metal
boundary         p p p
lattice          fcc 4.0495
region           box block -3 3 -3 3 -3 3
create_box       2 box
create_atoms     1 box
pair_style       eam/alloy
pair_coeff       * * AlCu.eam.alloy Al Cu
mass             1 26.982
mass             2 63.546
velocity         all create 300 42534 mom yes rot yes loop geom
set              atom 1 type 2
group            pka id 1
velocity         pka set 1120 1620 400
fix              1 all nve
fix              2 all dt/reset 1 NULL 0.001 0.05 emax 10.0
fix              3 all electron/stopping/fit 3.49 1.8e-3 9.0e-8 7.57 4.2e-3 5.0e-8
thermo_style     custom step dt time temp pe ke f_3
thermo_modify    format float %.15g
thermo           5
run              100
