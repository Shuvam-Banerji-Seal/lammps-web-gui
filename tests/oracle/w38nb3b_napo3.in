# oracle: cut-down examples/nb3b/in.nb3b.screened: hybrid/overlay coul/dsf + table + buck + nb3b/screened (P NULL O) on a random 75-atom P/Na/O box with charges, NVE 20 steps
# oracle-inputs: w38nb3b_Table_NP.dat
# oracle-potentials: PSiO.nb3b.screened
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           metal
dimension       3
boundary        p p p
atom_style      charge
region          box block 0 16 0 16 0 16
create_box      3 box
create_atoms    1 random 15 1001 box overlap 1.6 maxtry 200
create_atoms    2 random 15 2002 box overlap 1.6 maxtry 200
create_atoms    3 random 45 3003 box overlap 1.6 maxtry 200
set             type 1 charge 1.5
set             type 2 charge 0.9
set             type 3 charge -1.1
mass            1 30.97
mass            2 22.99
mass            3 16.00
pair_style      hybrid/overlay coul/dsf 0.2 12.0 table spline 20000 buck 7.0 nb3b/screened
pair_coeff      * * coul/dsf
pair_coeff      1 3 table w38nb3b_Table_NP.dat Pair_P-O 7.0
pair_coeff      2 3 table w38nb3b_Table_NP.dat Pair_Na-O 7.0
pair_coeff      3 3 table w38nb3b_Table_NP.dat Pair_O-O 7.0
pair_coeff      1 1 buck 5.093669 0.905598 0.0
pair_coeff      * * nb3b/screened PSiO.nb3b.screened P NULL O
neighbor        1.0 bin
neigh_modify    every 10 delay 10 check no
timestep        0.002
fix             1 all nve
thermo_style    custom step temp pe evdwl ecoul etotal press
thermo_modify   format float %.15g
thermo          5
run             20
