# oracle: ReaxFF water cut from examples/reaxff/water (see w65reaxq_acks2) with fix acks2/reaxff at tolerance 1e-12 (the iteration-count check), 10 NVE steps
# oracle-inputs: w65reaxq_water.data w65reaxq_acks2_ff.water w65reaxq_qeq_ff.water w65reaxq_gauss_exp.txt
# Measured (engine vs native, max relative error over the 11 rows at solver tolerance 1e-12): pe 2.0e-10, ecoul 1.4e-9,
# ke 1.5e-8, press 1.6e-5 (the solve is an ill-conditioned extended BiCGStab: even at 1e-14 the step-0 press error is 1.4e-8,
# and the iteration counts separate by step 4 from rounding order), so the tight variant is compared at rel=3e-5
# oracle-compare: thermo=all atoms=all rel=3e-5 abs=1e-8
units           real
atom_style      charge
boundary        p p p
read_data       w65reaxq_water.data
pair_style      reaxff NULL safezone 3.0 mincap 150
pair_coeff      * * w65reaxq_acks2_ff.water O H
fix             1 all acks2/reaxff 1 0.0 10.0 1e-12 reaxff maxiter 1000
neighbor        0.5 bin
neigh_modify    every 1 delay 0 check yes
velocity        all create 300.0 4928459 rot yes dist gaussian
timestep        0.5
fix             2 all nve
thermo_style    custom step temp pe ebond evdwl ecoul ke etotal press
thermo_modify   format float %.15g
thermo          1
run             10
