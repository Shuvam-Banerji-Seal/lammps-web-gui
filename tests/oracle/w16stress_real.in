# oracle: compute stress/atom (kinetic + virial) and compute heat/flux in units real; per-atom stress is in pressure*volume units (nktv2p)
units real
atom_style atomic
lattice fcc 5.26
region box block 0 3 0 3 0 3
create_box 1 box
create_atoms 1 box
mass 1 39.948
variable vx atom 0.003*sin(1.3*x+0.7*y)
variable vy atom 0.003*cos(0.9*y-0.4*z)
variable vz atom 0.003*sin(1.1*z+0.5*x)
velocity all set v_vx v_vy v_vz
pair_style lj/cut 10.0
pair_coeff 1 1 0.238 3.405
compute s all stress/atom NULL
compute sv all stress/atom NULL virial
compute r all reduce sum c_s[1] c_s[2] c_s[3] c_sv[1]
variable pv equal -(c_r[1]+c_r[2]+c_r[3])/(3*vol)
compute ke all ke/atom
compute pe all pe/atom
compute hf all heat/flux ke pe s
fix 1 all nve
thermo_style custom step pe press pxx c_r[1] c_r[2] c_r[3] c_r[4] v_pv c_hf[1] c_hf[2] c_hf[3] c_hf[4] c_hf[5] c_hf[6]
thermo_modify format float %.15g norm no
thermo 10
run 30
