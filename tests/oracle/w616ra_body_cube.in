# oracle: create_atoms of a rounded/polyhedron body molecule (the cube of w152body_pour_cube): with native's zero quat_external the vertices sit at the body centers and the overlapping cubes have no contact energy; setup only (run 0)
# oracle-inputs: w152body_pour_cube.mol
# oracle-compare: thermo=all rel=1e-12 abs=1e-14
units           lj
dimension       3
boundary        p p p
atom_style      body rounded/polyhedron 1 8
region          reg block 0 20 0 20 0 20 units box
create_box      1 reg
molecule        obj w152body_pour_cube.mol
create_atoms    0 single 5 5 5 mol obj 4567
create_atoms    0 single 7.2 5.3 5.1 mol obj 1234 rotate 30 1 0 0
create_atoms    0 random 2 777 NULL mol obj 999 overlap 4.0
pair_style      body/rounded/polyhedron 20 5 0 1 0.5
pair_coeff      * * 100 1
comm_modify     vel yes
neighbor        0.5 bin
fix             1 all nve/body
velocity        all create 1.0 8848
compute         bl all body/local id 1 2 3
compute         bls all reduce sum c_bl[2] c_bl[3] c_bl[4] inputs local
thermo_style    custom step atoms ke pe etotal press c_bls[1] c_bls[2] c_bls[3]
thermo_modify   format float %.15g
run             0
