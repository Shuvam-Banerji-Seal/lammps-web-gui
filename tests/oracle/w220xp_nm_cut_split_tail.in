# oracle: pair nm/cut/split 2.5 (r0 1.3, explicit e0 r0 n m), pair_modify tail yes, 216 atoms NVE 200 steps
# oracle-compare: thermo=all atoms=all rel=1e-12 abs=1e-13
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 1.6e-13, atoms 6.7e-14.
units        lj
boundary     p p p
atom_style   atomic
lattice      sc 0.5
region       box block 0 6 0 6 0 6
create_box   2 box
create_atoms 1 box
set          group all type/fraction 2 0.5 4321
mass         * 1.0
velocity     all create 1.0 4242
timestep     0.002
fix          1 all nve
pair_style   nm/cut/split 2.5
pair_coeff   1 1 1.0 1.3 8 4
pair_coeff   1 2 0.7 1.3 8 6
pair_coeff   2 2 0.8 1.3 9 6
pair_modify  tail yes
thermo_style custom step pe evdwl ecoul elong ke press pxx pyy pzz pxy pxz pyz
thermo_modify format float %.15g
thermo       20
run          200
