# oracle: fix bond/react with prob v_p1 (an equal-style variable, native v_prob), tiny nylon as in w114cf_nylon_stab_long.
# oracle: The probability is 0.6 for the first run (80 steps) and 0.2 for the second run after the variable is redefined;
# oracle: native evaluates it at each run's init (src/REACTION/fix_bond_react.cpp, init: rxn.fraction = compute_equal(v_prob)).
# oracle-inputs: w94react_nylon.data w94react_nylon_stp1.map w94react_nylon_stp1_unreacted.mol w94react_nylon_stp1_reacted.mol w94react_nylon_stp2.map w94react_nylon_stp2_unreacted.mol w94react_nylon_stp2_reacted.mol
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-5
units real
boundary p p p
atom_style full
kspace_style pppm 1.0e-4
pair_style lj/class2/coul/long 8.5
angle_style class2
bond_style class2
dihedral_style class2
improper_style class2
special_bonds lj/coul 0 0 1
pair_modify tail yes mix sixthpower
read_data w94react_nylon.data extra/bond/per/atom 5 extra/angle/per/atom 15 extra/dihedral/per/atom 15 extra/improper/per/atom 25 extra/special/per/atom 25
velocity all create 300.0 4928459 dist gaussian
molecule mol1 w94react_nylon_stp1_unreacted.mol
molecule mol2 w94react_nylon_stp1_reacted.mol
molecule mol3 w94react_nylon_stp2_unreacted.mol
molecule mol4 w94react_nylon_stp2_reacted.mol
variable p1 equal 0.6
thermo 10
fix myrxns all bond/react stabilization yes statted_grp .03 react rxn1 all 1 0.0 2.9 mol1 mol2 w94react_nylon_stp1.map prob v_p1 1234 react rxn2 all 1 0.0 5.0 mol3 mol4 w94react_nylon_stp2.map rescale_charges yes
fix 1 statted_grp_REACT nvt temp 300 300 100
fix 4 bond_react_MASTER_group temp/rescale 1 300 300 10 1
thermo_style custom step temp press density f_myrxns[1] f_myrxns[2]
thermo_modify colname auto format float %.15g
run 80
variable p1 equal 0.2
run 80
