# oracle: region2vmd writes VMD Tcl scripts for block (open faces), sphere, cylinder (open faces, move), ellipsoid and prism regions
# oracle-files: r2v_blocks.tcl r2v_round.tcl r2v_prism.tcl
units           lj
atom_style      atomic
region          box block 0 4 0 4 0 4
create_box      1 box
variable        mx equal 0.25
variable        my equal -0.5
variable        mz equal 1.0e-3
region          rinf block -5 2.5 0.25 4 0 2.0 open 2 open 5
region          rmov block 0.1 1.7 0 1.3 -0.2 2.4 move v_mx v_my v_mz
region          rsph sphere 1.3 2.2 1.1 0.9 move v_mx v_my v_mz
region          rcyl cylinder x 1.5 1.25 0.8 0.0 3.5 open 1
region          rcylz cylinder z 2.0 1.5 0.33333333333 -1.0 2.75 move v_mx v_my v_mz
region          rcylo cylinder y 2.0 1.0 0.5 0.25 1.75 open 3
region          rell ellipsoid 1.0 1.5 1.2 0.6 0.4 0.3
region          rpr prism 0 2.0 0 1.5 -1.0 1.0 0.5 0.25 0.1 open 1 open 6
region2vmd      r2v_blocks.tcl color red material Glossy region rinf region rmov
region2vmd      r2v_round.tcl region rsph color green material Opaque region rcyl command "display projection Orthographic" region rcylz region rcylo color blue region rell
region2vmd      r2v_prism.tcl region rpr material Diffuse
