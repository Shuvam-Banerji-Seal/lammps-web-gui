# oracle: run_style respa 2 levels with hybrid/overlay — lj/cut on level 1, morse on level 2, harmonic bonds level 1, fix nve
# oracle-inputs: mol_chains.data
# oracle-compare: thermo=all atoms=all rel=1e-8
units           lj
atom_style      molecular
bond_style      harmonic
angle_style     none
dihedral_style  none
improper_style  none
pair_style      hybrid/overlay lj/cut 2.5 morse 3.0
read_data       mol_chains.data
pair_coeff      * * lj/cut 0.5 0.9
pair_coeff      1 3 lj/cut 0.8 1.0
pair_coeff      * * morse 0.2 1.6 1.1 3.0
bond_coeff      1 120.0 1.05
bond_coeff      2 90.0 1.1
special_bonds   lj 0.0 0.5 0.8
timestep        0.002
run_style       respa 2 3 hybrid 1 2
fix             1 all nve
thermo_style    custom step temp pe evdwl ebond etotal press
thermo_modify   format float %.15g
thermo          10
run             60
