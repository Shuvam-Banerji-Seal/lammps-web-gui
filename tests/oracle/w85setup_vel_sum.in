# oracle: velocity set/ramp/scale/zero with the sum keyword; components a style does not write keep their values; scale and zero ignore sum (native measured)
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 1.0
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
compute         r all reduce sum vx vy vz
thermo_style    custom step temp c_r[1] c_r[2] c_r[3]
thermo_modify   format float %.15g
velocity        all create 1.0 4928 loop geom
run             0
velocity        all set 0.3 0.5 0.2 units box
run             0
velocity        all set 1.0 NULL NULL units box sum yes
run             0
velocity        all ramp vz -1 1 z 1 3 units box sum yes
run             0
velocity        all scale 2.0 sum yes
run             0
velocity        all zero linear sum yes
run             0
