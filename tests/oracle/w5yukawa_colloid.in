# oracle: pair_style yukawa/colloid on spheres of two radii (atom_style sphere)
units           lj
atom_style      sphere
lattice         fcc 0.3
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
group           odd id 1:108:2
set             group odd type 2
set             type 1 diameter 1.0
set             type 2 diameter 1.4
variable        dx atom 0.08*sin(1.3*x+0.7*y)
variable        dy atom 0.08*cos(0.9*y-1.1*z)
variable        dz atom 0.08*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.6*sin(0.9*x+0.4*z)
variable        vy atom 0.6*cos(0.6*y+0.8*x)
variable        vz atom 0.6*sin(0.7*z-0.3*y)
velocity        all set v_vx v_vy v_vz units box
velocity        all zero linear
pair_style      yukawa/colloid 2.0 3.5
pair_coeff      1 1 100.0
pair_coeff      2 2 140.0 3.0
pair_coeff      1 2 120.0 3.2
timestep        0.002
fix             1 all nve
thermo_style    custom step temp pe etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          10
run             50
