# oracle: eFF H2 under fix nph/eff x 0 0 1 y 0 0 1 z 0 0 1 couple xy with pchain 1 and mtk no: coupled x and y with the electron radial terms, 10 steps
# oracle-inputs: w63eff_h2.data
# oracle-compare: thermo=all atoms=all
units           electron
newton          on
boundary        p p p
atom_style      electron
read_data       w63eff_h2.data
pair_style      eff/cut 6.447968 pressure/evirials
pair_coeff      * *
comm_modify     vel yes
thermo          2
velocity        all create 300.0 4928459 dist gaussian rot yes mom yes
timestep        0.0005
fix             1 all nph/eff x 0.0 0.0 1.0 y 0.0 0.0 1.0 z 0.0 0.0 1.0 couple xy pchain 1 mtk no
thermo_style    custom step pe ke temp press vol lx ly lz xy xz yz f_1
thermo_modify   format float %.15g
run             10
