# oracle: fix tgnpt/drude x y z with couple xy, pchain 1 and mtk no on DRUDE butane: coupled x and y, z free of them, 40 steps
# oracle-inputs: w72drude_data.butane10
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-10

units real
boundary p p p

atom_style full
bond_style harmonic
angle_style harmonic
dihedral_style opls
special_bonds lj/coul 0.0 0.0 0.5

pair_style hybrid/overlay lj/cut/coul/cut 8.0 8.0 thole 2.089 8.0
pair_modify mix geometric tail yes

read_data w72drude_data.butane10

comm_modify vel yes

group gBUTANE molecule 1:10
group gCORES type 1 2 3
group gDRUDES type 4 5

pair_coeff    1    1 lj/cut/coul/cut 0.065997 3.500000 # C3H C3H
pair_coeff    1    2 lj/cut/coul/cut 0.065997 3.500000 # C3H C2H
pair_coeff    1    3 lj/cut/coul/cut 0.044496 2.958040 # C3H H
pair_coeff    2    2 lj/cut/coul/cut 0.065997 3.500000 # C2H C2H
pair_coeff    2    3 lj/cut/coul/cut 0.044496 2.958040 # C2H H
pair_coeff    3    3 lj/cut/coul/cut 0.029999 2.500000 # H H
pair_coeff    *  4*5 lj/cut/coul/cut 0.000000 0.000000 # No lj for drudes
pair_coeff    1    * thole 1.368000
pair_coeff    2    * thole 1.368000
pair_coeff    4    * thole 1.368000
pair_coeff    5    * thole 1.368000

neighbor 2.0 bin

variable vTEMP   equal 260.0
variable vTEMP_D equal 1.0
variable vPRESS  equal 1.0

velocity gCORES  create ${vTEMP} 12345
velocity gDRUDES create ${vTEMP_D} 12345

fix fDRUDE all drude C C N D D


fix fNPT all tgnpt/drude temp ${vTEMP} ${vTEMP} 100.0 ${vTEMP_D} 20.0 x 1.0 1.0 500.0 y 1.0 1.0 500.0 z 200.0 200.0 500.0 couple xy pchain 1 mtk no

compute cTEMP all temp/drude

thermo_style custom step etotal ke temp pe press vol lx ly lz xy f_fNPT f_fNPT[1] f_fNPT[2] f_fNPT[3]
thermo_modify   format float %.15g
thermo 10

timestep 0.5
run 40

