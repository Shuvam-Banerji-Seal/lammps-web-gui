# oracle: compute pod/global (Ta_param + Ta_coeff, 31 descriptors per element, one element) on the randomly displaced bcc Ta 2x1x1 cell (4 atoms, 4 x 2 x 2 A box, rcut 5 so the neighbours are periodic images): the global array of 1 + 3*4 = 13 rows by 31 columns, all 403 entries printed as thermo columns
# engine vs native fixture: thermo max relative error 1.8e-12 over the 403 array entries (target 1e-8); engine time 0.04 s (warm; 0.25 s cold)
# native: installed lmp (b332f28, ML-POD)
# oracle-inputs: w128pod_Ta_param.pod w128pod_Ta_coeff.pod
# oracle-compare: thermo=all atoms=none rel=1e-8 abs=1e-10
units           metal
atom_style      atomic
boundary        p p p
lattice         bcc 2.0
region          box block 0 2 0 1 0 1
create_box      1 box
create_atoms    1 box
mass            1 180.88
displace_atoms  all random 0.1 0.1 0.1 123456 units box
pair_style      pod
pair_coeff      * * w128pod_Ta_param.pod w128pod_Ta_coeff.pod Ta
compute         gd all pod/global w128pod_Ta_param.pod w128pod_Ta_coeff.pod Ta
thermo_style    custom step pe c_gd[1][1] c_gd[1][2] c_gd[1][3] c_gd[1][4] c_gd[1][5] c_gd[1][6] c_gd[1][7] c_gd[1][8] c_gd[1][9] c_gd[1][10] c_gd[1][11] c_gd[1][12] c_gd[1][13] c_gd[1][14] c_gd[1][15] c_gd[1][16] c_gd[1][17] c_gd[1][18] c_gd[1][19] c_gd[1][20] c_gd[1][21] c_gd[1][22] c_gd[1][23] c_gd[1][24] c_gd[1][25] c_gd[1][26] c_gd[1][27] c_gd[1][28] c_gd[1][29] c_gd[1][30] c_gd[1][31] c_gd[2][1] c_gd[2][2] c_gd[2][3] c_gd[2][4] c_gd[2][5] c_gd[2][6] c_gd[2][7] c_gd[2][8] c_gd[2][9] c_gd[2][10] c_gd[2][11] c_gd[2][12] c_gd[2][13] c_gd[2][14] c_gd[2][15] c_gd[2][16] c_gd[2][17] c_gd[2][18] c_gd[2][19] c_gd[2][20] c_gd[2][21] c_gd[2][22] c_gd[2][23] c_gd[2][24] c_gd[2][25] c_gd[2][26] c_gd[2][27] c_gd[2][28] c_gd[2][29] c_gd[2][30] c_gd[2][31] c_gd[3][1] c_gd[3][2] c_gd[3][3] c_gd[3][4] c_gd[3][5] c_gd[3][6] c_gd[3][7] c_gd[3][8] c_gd[3][9] c_gd[3][10] c_gd[3][11] c_gd[3][12] c_gd[3][13] c_gd[3][14] c_gd[3][15] c_gd[3][16] c_gd[3][17] c_gd[3][18] c_gd[3][19] c_gd[3][20] c_gd[3][21] c_gd[3][22] c_gd[3][23] c_gd[3][24] c_gd[3][25] c_gd[3][26] c_gd[3][27] c_gd[3][28] c_gd[3][29] c_gd[3][30] c_gd[3][31] c_gd[4][1] c_gd[4][2] c_gd[4][3] c_gd[4][4] c_gd[4][5] c_gd[4][6] c_gd[4][7] c_gd[4][8] c_gd[4][9] c_gd[4][10] c_gd[4][11] c_gd[4][12] c_gd[4][13] c_gd[4][14] c_gd[4][15] c_gd[4][16] c_gd[4][17] c_gd[4][18] c_gd[4][19] c_gd[4][20] c_gd[4][21] c_gd[4][22] c_gd[4][23] c_gd[4][24] c_gd[4][25] c_gd[4][26] c_gd[4][27] c_gd[4][28] c_gd[4][29] c_gd[4][30] c_gd[4][31] c_gd[5][1] c_gd[5][2] c_gd[5][3] c_gd[5][4] c_gd[5][5] c_gd[5][6] c_gd[5][7] c_gd[5][8] c_gd[5][9] c_gd[5][10] c_gd[5][11] c_gd[5][12] c_gd[5][13] c_gd[5][14] c_gd[5][15] c_gd[5][16] c_gd[5][17] c_gd[5][18] c_gd[5][19] c_gd[5][20] c_gd[5][21] c_gd[5][22] c_gd[5][23] c_gd[5][24] c_gd[5][25] c_gd[5][26] c_gd[5][27] c_gd[5][28] c_gd[5][29] c_gd[5][30] c_gd[5][31] c_gd[6][1] c_gd[6][2] c_gd[6][3] c_gd[6][4] c_gd[6][5] c_gd[6][6] c_gd[6][7] c_gd[6][8] c_gd[6][9] c_gd[6][10] c_gd[6][11] c_gd[6][12] c_gd[6][13] c_gd[6]