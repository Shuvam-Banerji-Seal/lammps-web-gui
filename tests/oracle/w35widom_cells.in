# oracle: fix widom atom insertions through the probe-energy cell list (box of 8 sigma, five or more cells of half the cutoff per side), lj/cut with shift, two types, 216 atoms on a displaced sc lattice moving under fix nve, 300 insertions every 5 steps
# oracle-compare: thermo=all atoms=none rel=1e-8
units           lj
atom_style      atomic
boundary        p p p
lattice         sc 0.42
region          box block 0 6 0 6 0 6
create_box      2 box
create_atoms    1 box
set             atom 1*108 type 2
variable        dx atom 0.15*sin(1.1*x+0.4*y)
variable        dy atom 0.15*sin(0.7*y+1.3*z)
variable        dz atom 0.15*sin(0.9*z+0.6*x)
displace_atoms  all move v_dx v_dy v_dz units box
mass            * 1.0
pair_style      lj/cut 2.5
pair_modify     shift yes
pair_coeff      1 1 1.0 1.0 2.5
pair_coeff      1 2 1.5 0.8 2.0
pair_coeff      2 2 0.5 0.88 2.2
variable        vx atom 0.5*sin(1.7*y-0.6*z)
variable        vy atom 0.5*cos(1.2*z+0.9*x)
variable        vz atom 0.5*sin(2.1*x-0.8*y)
velocity        all set v_vx v_vy v_vz units box
fix             w all widom 5 300 2 8123 0.75
fix             2 all nve
timestep        0.002
thermo_style    custom step pe f_w[1] f_w[2] f_w[3]
thermo_modify   format float %.15g
thermo          5
run             20
