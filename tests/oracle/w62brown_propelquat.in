# oracle: fix propel/self quat 4.0 with qvector 0 1 0 on brownian/asphere (2d, ellipsoids), pressure with the propel virial
# oracle-compare: thermo=all atoms=all
dimension       2
units           lj
atom_style      ellipsoid
boundary        p p p
lattice         sq 0.4
region          box block 0 6 0 6 -0.2 0.2
create_box      1 box
create_atoms    1 box
set             type * shape 3.0 1.0 1.0
set             type * quat/random 31
velocity        all create 1.0 1 loop geom
pair_style      none
fix             1 all brownian/asphere 1.0 31 rng uniform gamma_r_eigen inf inf 0.5 gamma_t_eigen 2.0 2.0 inf
fix             2 all propel/self quat 4.0 qvector 0 1 0
compute         press all pressure NULL virial
thermo_style    custom step ke pe c_press
thermo_modify   format float %.15g
timestep        0.00001
thermo          50
run             200
