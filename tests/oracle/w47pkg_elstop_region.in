# oracle: fix electron/stopping with region and minneigh 0 (cut down from examples/PACKAGES/electron_stopping/in.elstop.only): 200 steps, dt/reset
# oracle-inputs: w47pkg_elstop_cu.table
# oracle-potentials: AlCu.eam.alloy
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units metal
atom_style atomic
boundary p p p
lattice fcc 3.615
region box block 0 4 0 4 0 4
region rsmall block 0 2 0 2 0 2
create_box 1 box
create_atoms 1 box
mass 1 63.546
pair_style eam/alloy
pair_coeff * * AlCu.eam.alloy Cu
velocity all create 300 42534 mom yes rot yes
group pka id 1
velocity pka set 200 100 50 units box
fix fdt all dt/reset 1 NULL 0.0005 0.02 emax 20.0 units box
fix fel all electron/stopping 10.0 w47pkg_elstop_cu.table region rsmall minneigh 0
fix fnve all nve
timestep 0.0001
thermo 20
thermo_style custom step dt time pe ke f_fel
thermo_modify format float %.15g
run 200
