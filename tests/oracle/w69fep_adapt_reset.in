# oracle: fix adapt/fep pair lambda with after yes and reset yes, then a second run from the restored hot start (quicktests style, cut down)
# oracle-compare: thermo=all (was a 1e-6 relative bound: run 2 starts from overlapping pairs: evdwl is a cancellation of ~1e10 terms, so its last digits differed at 1e-10 and grew to 3e-8 by step 130; now measured thermo 3.5e-12, see below)
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 3.5e-12, atoms 1.2e-13.
units           real
boundary        p p p
atom_style      charge
pair_style      lj/cut/coul/long/soft 1 0.5 0.5 8.0 8.0
lattice         bcc 5.0
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box basis 1 1 basis 2 2
mass            1 12.011
mass            2 12.011
pair_coeff      1 1 0.1 3.0 1.0
pair_coeff      1 2 0.1 3.0 1.0
pair_coeff      2 2 0.1 3.0 1.0
set             type 1 charge 0.1
set             type 2 charge -0.1
kspace_style    pppm 1.0e-5
timestep        2.0
velocity        all create 300.0 12345
fix             INTEG all nve
variable        lam equal ramp(1.0,0.0)
variable        lam2 equal 0.5+0.5*v_lam
fix             ADAPT all adapt/fep 10 pair lj/cut/coul/long/soft lambda 1*2 1*2 v_lam after yes reset yes
thermo_style    custom step etotal ke pe epair evdwl ecoul elong temp press v_lam
thermo_modify   format float %.15g
thermo          25
run             100
unfix           ADAPT
thermo          10
run             40
