# oracle: fix brownian/asphere, 3d, uniform rng with anisotropic damping and rotation_temp 2.0 on a 3x3x3 lattice
# oracle-compare: thermo=all atoms=all
units           lj
atom_style      ellipsoid
boundary        p p p
lattice         sc 0.4
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
set             type * shape 3.0 2.0 1.0
set             type * quat/random 5
velocity        all create 1.0 1 loop geom
pair_style      none
fix             1 all brownian/asphere 1.0 5 rng uniform gamma_r_eigen 1.0 2.0 3.0 gamma_t_eigen 1.0 2.0 3.0 rotation_temp 2.0
compute         msd all msd
thermo_style    custom step ke pe c_msd[1] c_msd[2] c_msd[3] c_msd[4]
thermo_modify   format float %.15g
timestep        0.00001
thermo          50
run             200
