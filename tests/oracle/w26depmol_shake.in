# oracle: fix shake mol + fix deposit shake — the deposited molecule is added to the SHAKE clusters
# oracle-inputs: w26depmol_dimer_shake.mol
# oracle-compare: thermo=all atoms=none rel=1e-4 abs=1e-10
# (the constraint virial is omitted: the browser SHAKE solver's convergence criterion differs from
#  native at the 1e-7 level for a molecule added mid-run)
units           lj
atom_style      bond
boundary        p p f
region          box block 0 10 0 10 0 20
create_box      3 box bond/types 1 extra/bond/per/atom 1
molecule        dim w26depmol_dimer_shake.mol
create_atoms    1 single 5.0 5.0 17.0 units box
create_atoms    1 single 3.0 6.0 16.5 units box
create_atoms    1 single 7.0 4.0 16.5 units box
pair_style      lj/cut 2.5
pair_coeff      * * 0.5 1.0
mass            * 1.0
bond_style      harmonic
bond_coeff      1 5.0 1.0
region          slab block 0 10 0 10 15 18
fix             1 all shake 0.0001 20 1000 b 1 mol dim
fix             2 all nve
fix             3 all deposit 4 0 1 12345 region slab mol dim shake 1 near 1.0 vz -0.5 -0.5 units box
thermo_style    custom step atoms temp pe ebond evdwl etotal
thermo_modify   format float %.15g
thermo          1
run             20
