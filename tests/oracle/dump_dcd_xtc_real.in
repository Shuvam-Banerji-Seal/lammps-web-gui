# oracle: dump dcd and xtc in real units (xtc in nm and ps) of a triclinic box: dump_modify pbc yes, first yes, then write_dump
# oracle-files: t.dcd t.xtc p.xtc w.dcd w.xtc
units           real
atom_style      atomic
lattice         fcc 4.0
region          box prism 0 3 0 3 0 3 0.37 0.21 0.13
create_box      2 box
create_atoms    1 box
set             type 1 type/fraction 2 0.3 4321
mass            1 39.948
mass            2 83.798
velocity        all create 600.0 5512 loop geom
pair_style      lj/cut 8.5
pair_coeff      1 1 0.238 3.405
pair_coeff      2 2 0.317 3.6
pair_coeff      1 2 0.275 3.5
fix             1 all nve
dump            1 all dcd 10 t.dcd
dump            2 all xtc 10 t.xtc
dump            3 all xtc 15 p.xtc
dump_modify     3 pbc yes first yes
thermo_style    custom step temp pe etotal press
thermo_modify   format float %.15g
thermo          10
run             30
write_dump      all dcd w.dcd modify unwrap yes
write_dump      all xtc w.xtc modify precision 10000
