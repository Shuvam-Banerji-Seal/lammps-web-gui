# oracle: compute ti with two atom types (pair lj/cut for type 1 and for type 2, each with its own lambda scale and derivative) on a displaced two-type fcc lj crystal; the derivative dU/dlambda is in thermo after 5 steps of nve
# oracle: native: b332f28 (installed lmp; compute ti is in the EXTRA-COMPUTE package of that binary)
# oracle-compare: thermo=all atoms=none rel=1e-8 abs=1e-10
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 1.5e-15, atoms n/a (atoms=none; no per-atom output).
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
mass            * 1.0
region          left block INF 3.0 INF INF INF INF units lattice
group           gleft region left
set             group gleft type 2
variable        dx atom 0.08*sin(2.3*x+1.1*y+0.4*z)
variable        dy atom 0.08*cos(1.9*y-0.7*x+0.3*z)
variable        dz atom 0.08*sin(1.3*z+0.8*x-0.5*y)
displace_atoms  all move v_dx v_dy v_dz units box
velocity        all create 1.0 87287 loop geom
variable        lam equal 0.4
variable        fa equal 0.2+0.8*v_lam
variable        dfa equal 0.8
variable        fb equal 1.0-0.5*v_lam
variable        dfb equal -0.5
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0 2.5
compute         ti all ti lj/cut 1 v_fa v_dfa lj/cut 2*2 v_fb v_dfb
fix             1 all nve
thermo_style    custom step pe c_ti
thermo_modify   format float %.15g
thermo          5
run             5
