# oracle: pair_modify pair lj/cut compute/tally yes; the native group/group sum keeps the lj/cut energy (measured: the same with compute/tally no)
# oracle-inputs: w88pair_chain.data
units           real
atom_style      full
read_data       w88pair_chain.data
bond_style      harmonic
bond_coeff      1 100.0 1.0
angle_style     harmonic
angle_coeff     1 10.0 110.0
dihedral_style  harmonic
dihedral_coeff  1 1.0 1 0
pair_style      hybrid lj/cut 10.0 morse 10.0
pair_coeff      1 1 lj/cut 0.2 1.1
pair_coeff      1 2 lj/cut 0.2 1.1
pair_coeff      2 2 morse 0.1 1.5 1.2
pair_modify     pair lj/cut compute/tally yes
compute         cgg all group/group all pair yes
thermo_style    custom step pe evdwl c_cgg
thermo_modify   format float %.15g
run 0
