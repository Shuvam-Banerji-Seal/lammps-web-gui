# oracle: PPPM triclinic box with kspace_modify gewald and mesh set (box 10x11x13 tilted, order 4)
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           real
atom_style      charge
lattice         sc 3.2
region          box prism 0 10 0 11 0 13 -1.5 2 0.5 units box
create_box      2 box
create_atoms    1 box
group           odd id 1:1000:2
set             group odd type 2
mass            1 15.0
mass            2 20.0
set             type 1 charge 0.42
set             type 2 charge -0.38
variable        dx atom 0.15*sin(0.43*x+0.27*y)
variable        dy atom 0.15*cos(0.31*y-0.23*z)
variable        dz atom 0.15*sin(0.37*z+0.19*x)
displace_atoms  all move v_dx v_dy v_dz units box
pair_style      lj/cut/coul/long 8.0
pair_coeff      * * 0.0 1.0
pair_modify     table 0
kspace_style    pppm 1.0e-5
kspace_modify   gewald 0.33 mesh 12 12 16 order 4
thermo_style    custom step pe evdwl ecoul elong press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
run             0
