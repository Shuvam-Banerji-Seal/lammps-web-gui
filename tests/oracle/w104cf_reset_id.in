# oracle: reset_atoms id renumbers bonded atoms in native storage (file) order; bond energies and forces follow the atoms
# oracle-inputs: w104cf_reset_id.data
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=1e-12
units           lj
atom_style      bond
read_data       w104cf_reset_id.data
pair_style      lj/cut 2.0
pair_coeff      * * 0.2 1.0
bond_style      harmonic
bond_coeff      1 40.0 1.2
reset_atoms     id
thermo_style    custom step pe epair ebond press
thermo_modify   format float %.15g norm no
thermo          10
run             20
