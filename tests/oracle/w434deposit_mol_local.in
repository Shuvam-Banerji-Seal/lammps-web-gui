# oracle: fix deposit of dimer molecules with local and global: the molecule centre goes lo..hi above the highest (nearby) atom in z, then the molecule is rotated about it
# oracle-inputs: w148rg_dimer.mol
# oracle-compare: thermo=all atoms=all
units           lj
atom_style      bond
atom_modify     map array
boundary        p p f
lattice         fcc 0.8
region          box block 0 4 0 4 0 16
create_box      3 box bond/types 1 extra/bond/per/atom 1 extra/special/per/atom 1
region          bed block 0 4 0 4 0 1.5
create_atoms    1 region bed
mass            * 1.0
molecule        dimer w148rg_dimer.mol
region          top block 0 4 0 4 5 6
bond_style      harmonic
bond_coeff      1 50.0 1.0
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0
timestep        0.005
fix             1 all nve
fix             w all wall/reflect zlo EDGE zhi EDGE
fix             3 all deposit 4 0 4 1729 region top mol dimer local 0.8 1.6 1.2 vz -0.3 -0.3 near 0.9
fix             4 all deposit 4 0 4 2468 region top mol dimer global 2.0 2.5 vz -0.3 -0.3 near 0.9
thermo_style    custom step atoms pe ke
thermo_modify   format float %.15g
thermo          4
run             24
