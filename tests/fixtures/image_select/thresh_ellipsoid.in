# image_select fixture: native b332f28 (/home/roy/.local/bin/lmp), dump image PPM, run 0.
units lj
atom_style ellipsoid
region box block 0 6 0 6 0 6
create_box 2 box
create_atoms 1 single 1.5 1.5 1.5
create_atoms 2 single 3.0 3.0 3.0
create_atoms 1 single 4.5 4.5 4.5
create_atoms 2 single 4.5 1.5 3.0
set type 1 shape 1.0 0.5 0.5
set type 2 shape 0.6 0.6 1.2
set atom 2 quat 1 1 0 40
set group all density 1.0
pair_style lj/cut 2.5
pair_coeff * * 1.0 1.0
dump d all image 1 img.*.ppm type type size 96 96 view 60 30 box no 0.02 ellipsoid type 1 2 0.1
dump_modify d pad 0 thresh x < 4.0
run 0
