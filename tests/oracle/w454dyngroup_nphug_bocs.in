# oracle: fixes nphug and bocs (cgiso with an analytic correction) on a dynamic group (the atoms whose scaled |vx| has
# a fractional part above 0.5, re-evaluated every 2 steps) after fix nve on the other atoms' dynamic group, lj/cut fcc
# liquid; two runs
# oracle-compare: thermo=all atoms=all
units           lj
atom_style      atomic
boundary        p p p
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 0.8 4928 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
variable        up atom (abs(vx)*1e2-floor(abs(vx)*1e2))>0.5
variable        down atom !v_up
group           dyn dynamic all var up every 2
group           dyn2 dynamic all var down every 2
variable        ndyn equal count(dyn)
timestep        0.002
fix             1 dyn2 nve
fix             2 dyn nphug temp 1.0 1.0 10.0 iso 1.5 1.5 20.0 tchain 1 pchain 0
thermo_style    custom step temp ke pe press vol f_2 v_ndyn
thermo_modify   format float %.15g
thermo          10
run             60
unfix           2
fix             2 dyn bocs temp 1.0 1.1 0.5 cgiso 0.5 0.5 2.0 analytic 128.0 108 2 0.1 0.01
run             60
