# oracle: pair_style hybrid/overlay rebo kolmogorov/crespi/z 14.0 - graphene bilayer (256 atoms, the example's data file), 20 NVE steps
# measured (engine vs native, black box; rel over |value| >= 1e-6; per-atom scale max(1,|value|)): thermo max abs 5.6e-11, max rel 3.5e-12; per-atom max scaled 6.7e-13
# oracle-inputs: w102il_bilayer.data
# oracle-potentials: CH.rebo CC.KC
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           metal
boundary        p p p
atom_style      atomic
read_data       w102il_bilayer.data
mass            * 12.0107
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
pair_style      hybrid/overlay rebo kolmogorov/crespi/z 14.0
pair_coeff      * * rebo CH.rebo C C
pair_coeff      1 2 kolmogorov/crespi/z CC.KC C C
timestep        0.0005
thermo_style    custom step temp pe etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          10
run             0
velocity        all create 300.0 12345
fix             1 all nve
run             20
