# oracle: lj/cut/coul/long with the default Coulomb table (pair_modify table 12) in metal units on a displaced rock-salt crystal; kspace pppm with a fixed g_ewald and mesh
# oracle-compare: thermo=all atoms=all
units           metal
atom_style      charge
lattice         custom 5.64 a1 1 0 0 a2 0 1 0 a3 0 0 1 &
                basis 0 0 0 basis 0.5 0.5 0 basis 0.5 0 0.5 basis 0 0.5 0.5 &
                basis 0.5 0 0 basis 0 0.5 0 basis 0 0 0.5 basis 0.5 0.5 0.5
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box basis 5 2 basis 6 2 basis 7 2 basis 8 2
mass            1 22.99
mass            2 35.45
set             type 1 charge 1.0
set             type 2 charge -1.0
variable        dx atom 0.05*sin(1.3*x+0.7*y)
variable        dy atom 0.05*cos(0.9*y-0.4*z)
variable        dz atom 0.05*sin(1.1*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
pair_style      lj/cut/coul/long 7.0
pair_coeff      * * 0.01 2.8
kspace_style    pppm 1.0e-5
kspace_modify   gewald 0.32 mesh 20 20 20 order 5
thermo_style    custom step pe ecoul elong press pxx pxy
thermo_modify   format float %.15g
fix             1 all nve
timestep        0.001
thermo          10
run             30
