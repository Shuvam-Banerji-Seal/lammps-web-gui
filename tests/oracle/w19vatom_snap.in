# oracle: pair_style snap, per-atom virial (compute stress/atom) on 2 types, triclinic prism, 8 atoms, 10 NVE steps; synthetic SNAP files
# oracle-inputs: w19vatom_snap.snapcoeff w19vatom_snap.snapparam
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           lj
atom_style      atomic
region          box prism 0 6 0 6 0 6 0.5 0.3 0.2
create_box      2 box
create_atoms    1 single 1.0 1.2 0.9 units box
create_atoms    2 single 2.1 1.5 1.1 units box
create_atoms    1 single 0.4 2.6 3.3 units box
create_atoms    2 single 3.3 0.6 2.2 units box
create_atoms    1 single 4.6 4.1 0.8 units box
create_atoms    2 single 5.2 2.9 4.4 units box
create_atoms    1 single 2.7 5.0 5.1 units box
create_atoms    2 single 0.9 3.8 1.9 units box
mass            * 1.0
variable        w1 atom c_s[1]*(1+0.1*id)
variable        w2 atom c_s[2]*(1+0.1*id)
variable        w3 atom c_s[3]*(1+0.1*id)
variable        w4 atom c_s[4]*(1+0.1*id)
variable        w5 atom c_s[5]*(1+0.1*id)
variable        w6 atom c_s[6]*(1+0.1*id)
compute         s all stress/atom NULL
compute         cr all reduce sum v_w1 v_w2 v_w3 v_w4 v_w5 v_w6
compute         sr all reduce sum c_s[1] c_s[2] c_s[3] c_s[4] c_s[5] c_s[6]
fix             1 all nve
thermo_style    custom step pe press vol c_sr[1] c_sr[2] c_sr[3] c_sr[4] c_sr[5] c_sr[6] c_cr[1] c_cr[2] c_cr[3] c_cr[4] c_cr[5] c_cr[6]
thermo_modify   format float %.15g norm no
timestep        0.001
pair_style      snap
pair_coeff      * * w19vatom_snap.snapcoeff w19vatom_snap.snapparam A B
run             10
