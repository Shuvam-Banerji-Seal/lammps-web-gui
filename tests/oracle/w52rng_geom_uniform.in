# oracle: velocity create loop geom (uniform) on a 256-atom fcc LJ lattice, run 0 (native per-atom RanPark streams)
# oracle-compare: thermo=all atoms=all
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 1.44 87287 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
neighbor        0.3 bin
neigh_modify    every 20 delay 0 check no
thermo_style    custom step temp pe ke etotal press
thermo_modify   format float %.15g
thermo          1
run             0
