# oracle: pouring spheres into a closed box of triangles made by fix surface/global, turned about z, then about (1 1 1) (in.tribox.gran.global cut down: 30 spheres poured, 800 + 300 + 100 + 200 steps; 3d, molecule tris, closed box)
# oracle-note: stopped at step 1400 (cut-down length); the spheres reach the box floor from about step 600 on. Four runs; the native and engine pour agree across the run boundaries here.
# oracle-inputs: w127gsg_surf.tribox
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# oracle-measured: max relative error (native fixture vs engine, scale max(1,|LAMMPS|)): thermo 5.1e-12, per-atom 9.9e-10 (measured with tests/fixtures/oracle, 2026-10-13)
units           lj
atom_style      sphere
boundary        f f f
dimension       3
comm_modify     vel yes

region          box block -10 10 -10 10 -10 10 units box
create_box      2 box

pair_style      granular
pair_coeff      * * hooke 4000.0 100.0 &
                    tangential linear_history 1000.0 1.0 0.5 &
                    damping mass_velocity

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

molecule        tris w127gsg_surf.tribox

fix             20 all surface/global input mol tris &
                model * * granular hooke 4000.0 100.0 &
                    tangential linear_history 1000.0 1.0 0.5 &
                    damping mass_velocity

fix             2 all nve/sphere
fix             3 all gravity 1.0 vector 0 0 -1

region          slab block -2 2 -2 2 -2 2 units box
fix             ins all pour 30 1 4767548 vol 0.4 10 &
                diam one 1.0 region slab ignore

timestep        0.005

compute         1 all temp
compute_modify  1 dynamic/dof yes

compute         2 all temp/sphere
compute_modify  2 dynamic/dof yes

thermo_style    custom step atoms temp c_1 c_2 press
thermo_modify   format float %.15g lost ignore
compute_modify  thermo_temp dynamic/dof yes
thermo          100

run             800

fix_modify      20 move * rotate 0 0 0 0 0 1 25
run             300

fix_modify      20 move * none
run             100

fix_modify      20 move * rotate 0 0 0 1 1 1 25
run             200
