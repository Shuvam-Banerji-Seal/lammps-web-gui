# oracle: pair rheo/solid on five solid RHEO particles, 40 velocity-Verlet steps (fix nve): atom_style rheo, pair_style rheo/solid with k, cutoff and gamma per type pair, set rheo/status, pairs within the cutoff act
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-13
# Measured with native LAMMPS (black box): engine vs native passes at rel=1e-15 (abs 1e-13) on all 5 thermo rows (ke, press) and all 5 atoms (positions, velocities, forces).
units        lj
atom_style   rheo
dimension    2
boundary     p p p
comm_modify  vel yes
newton       off
region       box block 0 6 0 6 -0.01 0.01
create_box   1 box
create_atoms 1 single 1.0 1.0 0
create_atoms 1 single 1.7 1.2 0
create_atoms 1 single 2.9 1.1 0
create_atoms 1 single 1.5 2.4 0
create_atoms 1 single 4.6 4.5 0
mass         * 1.0
set          group all rheo/status 1
velocity     all set 0.2 -0.1 0.0 units box
timestep     0.01
pair_style   rheo/solid
pair_coeff   * * 1.0 1.3 0.5
fix          4 all enforce2d
fix          5 all nve
thermo       10
thermo_style custom step ke press
thermo_modify format float %.15g
run          40
