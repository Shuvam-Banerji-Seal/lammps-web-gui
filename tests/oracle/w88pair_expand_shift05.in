# oracle: pair_style lj/expand with pair_modify shift yes, delta 0.5 (cutoff 3.0, shift point 3.0)
units lj
atom_style atomic
lattice fcc 0.8442
region box block 0 5 0 5 0 5
create_box 2 box
create_atoms 1 box
mass * 1.0
set group all type/fraction 2 0.3 1234
pair_style lj/expand 2.5
pair_coeff * * 1.0 1.0 0.5
pair_modify shift yes
thermo_style custom step pe evdwl etail press
thermo_modify format float %.15g
run 0
