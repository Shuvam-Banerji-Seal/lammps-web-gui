# oracle: improper_style umbrella, improper 2 apex on the flipped side (w0 = 30 and 20); B-01
# oracle-inputs: w87bond_chain3d.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# Measured with native LAMMPS (black box): engine thermo agrees to a max relative error of 4.0e-15 (forces to the 1e-8 test tolerance)
units real
atom_style full
boundary f f f
read_data w87bond_chain3d.data
pair_style zero 5.0
pair_coeff * *
bond_style harmonic
bond_coeff * 0 1.5
angle_style harmonic
angle_coeff * 0 110
dihedral_style harmonic
dihedral_coeff * 0 1 1
improper_style umbrella
improper_coeff 1 8 20
improper_coeff 2 15 30
thermo_style custom step ebond eangle edihed eimp pe
thermo_modify format float %.15g
run 0
