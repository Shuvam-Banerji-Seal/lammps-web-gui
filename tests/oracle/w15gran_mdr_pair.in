# oracle: pair_style granular mdr — three equal spheres in a row pressed and sliding (elastic, Y large), damping mdr 1, tangential linear_history, fix nve/sphere
units           lj
atom_style      sphere 1
atom_modify     map array
comm_modify     vel yes
newton          off
boundary        f f f
region          b block -10 10 -10 10 -10 10
create_box      1 b
create_atoms    1 single 0.0 0.0 0.0
create_atoms    1 single 0.9 0.0 0.0
create_atoms    1 single 1.8 0.0 0.0
set type 1 diameter 1.0 density 1.0
group           one id 1
group           three id 3
velocity        one set 0.1 0.05 0.0 units box
velocity        three set -0.1 -0.03 0.0 units box
pair_style granular
pair_coeff * * mdr 1.0 0.3 1000.0 0.0 0.0 0.2 damping mdr 1 tangential linear_history 300.0 0.5 0.4
timestep 0.001
fix 1 all nve/sphere
thermo_style custom step ke
thermo_modify format float %.15g
thermo 50
run 400
