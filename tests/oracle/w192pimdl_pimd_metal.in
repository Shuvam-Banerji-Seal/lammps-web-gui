# oracle: w192pimdl_pimd_metal — fix pimd/langevin method pimd (cartesian ring), obabo, PILE_L, nvt, taup and fixcom no, metal units, 4 beads (3 atoms, 30 steps)
# oracle-partitions: 4
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# Measured with native LAMMPS: max relative error over the 4 partitions 9.4e-14 on thermo, 2.8e-14 per atom.
variable ibead world 0 1 2 3
units metal
atom_style atomic
atom_modify map yes
boundary p p p
region box block -10 10 -10 10 -10 10
create_box 1 box
create_atoms 1 single -3.0 1.0 0.5
create_atoms 1 single 2.5 -2.0 1.5
create_atoms 1 single 0.5 3.5 -2.5
mass 1 39.948
pair_style lj/cut 9.5251
pair_coeff * * 0.00965188 3.4
pair_modify shift yes
timestep 0.001
velocity all create 113.15 4321${ibead} mom yes rot no dist gaussian
fix 1 all pimd/langevin method pimd ensemble nvt integrator obabo thermostat PILE_L 1234 tau 1.0 temp 113.15 taup 1.0 fixcom no
thermo_style custom step temp f_1[1] f_1[2] f_1[3] f_1[4] f_1[5] f_1[6] f_1[7] f_1[8] f_1[9] f_1[10] pe vol press
thermo_modify format float %.15g norm no
thermo 5
run 30
