# oracle: compute voronoi/atom neighbors yes (local array) in the 144-atom MEAM NiCr box of the KMC cut-down (non-cubic periodic box 11.286 x 15.048 x 11.286, two types): row order at the start
# Measured (ORACLE_MEASURE=1): thermo 3.3e-15; the 144-atom local rows of the non-cubic box agree at 1e-12 (filerel); engine ~1.5 s warm (MEAM setup). native: lmp b332f28, sort off.
# oracle-potentials: library_2nn.meam MoCoNiVFeAlCr_2nn.meam
# oracle-files: w199vo_meam_rows.loc
# oracle-compare: thermo=all atoms=none rel=1e-8 abs=1e-10 filerel=1e-12
units           metal
dimension       3
boundary        p p p
atom_style      atomic
atom_modify     map array sort 0 0.0
lattice         fcc 3.762
region          whole block 0 1 0 1 0 1
create_box      2 whole
create_atoms    1 region whole
replicate       3 4 3
region          puck block INF INF 1 3 INF INF
set             region puck type 2
pair_style      meam
pair_coeff      * * library_2nn.meam Mo Co Ni V Fe Al Cr MoCoNiVFeAlCr_2nn.meam Ni Cr
thermo_modify   format float %.15g
compute         voroN all voronoi/atom neighbors yes
dump            d all local 1 w199vo_meam_rows.loc c_voroN[1] c_voroN[2] c_voroN[3]
dump_modify     d format float %.15g
run             0
undump          d
