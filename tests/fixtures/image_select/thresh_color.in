# image_select fixture: native b332f28 (/home/roy/.local/bin/lmp), dump image PPM, run 0.
units lj
atom_style atomic
lattice sc 1.0
region box block 0 5 0 5 0 5
create_box 1 box
create_atoms 1 box
mass * 1.0
pair_style lj/cut 2.5
pair_coeff * * 1.0 1.0
dump d all image 1 img.*.ppm x type size 96 96 view 60 30 box no 0.02
dump_modify d pad 0 thresh x > 1.5 thresh y <= 3.0
run 0
