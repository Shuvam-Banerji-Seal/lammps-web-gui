# oracle: pair_modify neigh/trim yes on hybrid/overlay (neighbour lists only: results unchanged)
units lj
atom_style atomic
lattice fcc 0.8442
region box block 0 5 0 5 0 5
create_box 2 box
create_atoms 1 box
mass * 1.0
set group all type/fraction 2 0.3 1234
pair_style hybrid/overlay lj/cut 2.5 lj/cut 3.0
pair_coeff * * lj/cut 1 1.0 1.0
pair_coeff * * lj/cut 2 0.5 0.9
pair_modify neigh/trim yes
thermo_style custom step pe evdwl etail press
thermo_modify format float %.15g
run 0
