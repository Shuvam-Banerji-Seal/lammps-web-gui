# oracle: pair_style tersoff/zbl - compressed cell, short distances, ZBL switching
# oracle-inputs: w14tersoff_zbl.tersoff.zbl
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           metal
atom_style      atomic
lattice         diamond 4.9
region          box block 0 2 0 2 0 2
create_box      2 box
create_atoms    1 box
group           odd id 1:1000:2
set             group odd type 2
mass            * 28.0855
variable        dx atom 0.15*sin(0.9*x+0.4*y)
variable        dy atom 0.15*cos(0.7*y-0.5*z)
variable        dz atom 0.15*sin(1.1*z+0.3*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 2.0*sin(0.5*x+0.2*z)
variable        vy atom 2.0*cos(0.4*y+0.6*x)
variable        vz atom 2.0*sin(0.3*z-0.5*y)
velocity        all set v_vx v_vy v_vz units box
velocity        all zero linear
pair_style      tersoff/zbl
pair_coeff      * * w14tersoff_zbl.tersoff.zbl A B
timestep        0.001
fix             1 all nve
thermo_style    custom step temp pe etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          10
run             50
