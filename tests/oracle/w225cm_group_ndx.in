# oracle: group2ndx then ndx2group round trip (GROMACS index file, all groups and a selected group)
# oracle-files: w225cm_groups.ndx w225cm_groups_sel.ndx w225cm_groups2.ndx
# oracle-compare: thermo=all atoms=none
units           lj
atom_style      atomic
atom_modify     map array
lattice         fcc 0.8442
region          box block 0 2 0 2 0 2
create_box      2 box
create_atoms    1 box
set             atom 3 type 2
mass            * 1.0
group           left region box
group           odd id 1 3 5 7 9 11
group           hot type 2
group           empty id 1000
group           none subtract left left
region          sph sphere 1 1 1 0.9
group           inside region sph
thermo_style    custom step pe
thermo_modify   format float %.15g
run             0
group2ndx       w225cm_groups.ndx
group2ndx       w225cm_groups_sel.ndx hot odd inside
group           odd clear
group           hot delete
ndx2group       w225cm_groups.ndx
group2ndx       w225cm_groups2.ndx
