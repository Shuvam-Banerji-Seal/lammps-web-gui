# oracle: replicate 3 3 1 bond/periodic of a chain bonded diagonally across the x and y boundaries (examples/replicate in.replicate.bond.xy), 300-step nve
# oracle-inputs: w70repbp_data.bond.xy
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
dimension       2
atom_style      molecular
read_data       w70repbp_data.bond.xy
replicate       3 3 1 bond/periodic
mass            1 1.0
velocity        all create 0.02 87287 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.5
bond_style      harmonic
bond_coeff      1 50.0 1.414
special_bonds   fene
fix             1 all nve
thermo          50
thermo_modify   format float %.15g
run             300
