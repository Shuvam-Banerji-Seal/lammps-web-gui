# oracle: bpm/spring bonds break on impact (cut down from examples/bpm/impact/in.bpm.impact.spring). As native fix
# update/special/bonds does, a broken bond's pair loses its special bits in the current neighbor lists and the
# special lists change at the next re-neighboring, so breaks force no extra list build (thermo nbuild).
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
dimension       3
boundary        f f f
atom_style      bond
special_bonds   lj 0.0 1.0 1.0 coul 0.0 1.0 1.0
newton          on off
comm_modify     vel yes cutoff 2.6
lattice         fcc 1.0
region          box block -12 8 -9 9 -9 9
create_box      1 box bond/types 2 extra/bond/per/atom 20
region          disk cylinder x 0.0 0.0 7.0 -0.5 0.5
create_atoms    1 region disk
group           plate region disk
region          ball sphere 4.0 0.0 0.0 2.5
create_atoms    1 region ball
group           projectile region ball
displace_atoms  all random 0.1 0.1 0.1 134598738
mass            1 1.0
neighbor        1.0 bin
pair_style      bpm/spring
pair_coeff      1 1 1.0 1.0 1.0
fix             1 all nve
create_bonds    many plate plate 1 0.0 1.5
create_bonds    many projectile projectile 2 0.0 1.5
neighbor        0.3 bin
special_bonds   lj 0.0 1.0 1.0 coul 1.0 1.0 1.0
bond_style      bpm/spring
bond_coeff      1 1.0 0.04 1.0
bond_coeff      2 1.0 0.20 1.0
velocity        projectile set -0.2 0.0 0.0
compute         nbond all nbond/atom
compute         tbond all reduce sum c_nbond
timestep        0.1
thermo_style    custom step ke pe pxx c_tbond nbuild
thermo_modify   format float %.15g lost ignore lost/bond ignore
thermo          25
run             400
