# oracle: compute pe/atom and stress/atom (kspace terms) with pppm/dielectric and kspace_modify slab 3.0 (the per-atom slab term of slabcorr), the w226cs_diel system with a shrink-wrapped z, per-atom values dumped
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 8.1e-10, atoms 3.6e-9 (the per-atom kspace energy and virial; the pppm/dielectric FFT summation order).
# oracle-inputs: w226cs_diel.data
# oracle-files: w268pd_diel_slab_peratom.dump
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-12 filerel=1e-8
units           real
atom_style      dielectric
boundary        p p f
read_data       w226cs_diel.data
pair_style      coul/long/dielectric 8.0
pair_coeff      * *
bond_style      harmonic
bond_coeff      1 100.0 1.5
special_bonds   lj/coul 0.0 0.5 1.0
kspace_style    pppm/dielectric 1.0e-5
kspace_modify   slab 3.0
compute         pa all pe/atom kspace
compute         sa all stress/atom NULL kspace
thermo_style    custom step pe ecoul elong evdwl press
thermo_modify   format float %.15g
dump            d all custom 1 w268pd_diel_slab_peratom.dump id c_pa c_sa[1] c_sa[2] c_sa[3] c_sa[4] c_sa[5] c_sa[6]
dump_modify     d sort id format float %.15g
run             0
