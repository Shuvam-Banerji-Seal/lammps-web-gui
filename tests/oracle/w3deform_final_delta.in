# oracle: fix deform: fix             2 all deform 2 x final 0.0 7.0 y delta -0.2 0.3 z scale 1.05 units box
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
mass            1 1.0
variable        dx atom 0.04*sin(1.3*x+0.7*y)
variable        dy atom 0.04*cos(0.9*y-1.1*z)
variable        dz atom 0.04*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.8*sin(0.9*x+0.4*z)
variable        vy atom 0.8*cos(0.6*y+0.8*x)
variable        vz atom 0.8*sin(0.7*z-0.3*y)
velocity        all set v_vx v_vy v_vz units box
velocity        all zero linear
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
timestep        0.002
fix             1 all nve
fix             2 all deform 2 x final 0.0 7.0 y delta -0.2 0.3 z scale 1.05 units box
thermo_style    custom step temp pe etotal press pxx pyy pzz pxy pxz pyz lx ly lz xy xz yz vol 
thermo_modify   format float %.15g
thermo          10
run             60
