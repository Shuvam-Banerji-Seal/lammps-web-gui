# oracle: compute sna/grid on a triclinic (prism) box, 2x3x2 grid, two types, through thermo
# oracle-compare: thermo=first atoms=all rel=1e-8 abs=1e-9
units           metal
atom_modify     map hash
lattice         bcc 2.0
region          box prism 0 4 0 2 0 2 1 0.5 0.3
create_box      2 box
create_atoms    1 box
group           odd id 1:4:2
set             group odd type 2
mass            * 180.88
variable        dx atom 0.05*sin(1.3*x+0.7*y)
variable        dy atom 0.05*cos(0.9*y-1.1*z)
variable        dz atom 0.05*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
pair_style      zbl 4 4.8
pair_coeff      * * 73 73
compute mygrid all sna/grid grid 2 3 2 1.0 0.99363 2 2.3 2.0 1.0 0.96 rmin0 0 switchflag 1 bzeroflag 1
thermo_style    custom step pe c_mygrid[1][1] c_mygrid[1][2] c_mygrid[1][3] c_mygrid[1][4] c_mygrid[1][5] c_mygrid[1][6] c_mygrid[1][7] c_mygrid[1][8] c_mygrid[2][1] c_mygrid[2][2] c_mygrid[2][3] c_mygrid[2][4] c_mygrid[2][5] c_mygrid[2][6] c_mygrid[2][7] c_mygrid[2][8] c_mygrid[3][1] c_mygrid[3][2] c_mygrid[3][3] c_mygrid[3][4] c_mygrid[3][5] c_mygrid[3][6] c_mygrid[3][7] c_mygrid[3][8] c_mygrid[4][1] c_mygrid[4][2] c_mygrid[4][3] c_mygrid[4][4] c_mygrid[4][5] c_mygrid[4][6] c_mygrid[4][7] c_mygrid[4][8] c_mygrid[5][1] c_mygrid[5][2] c_mygrid[5][3] c_mygrid[5][4] c_mygrid[5][5] c_mygrid[5][6] c_mygrid[5][7] c_mygrid[5][8] c_mygrid[6][1] c_mygrid[6][2] c_mygrid[6][3] c_mygrid[6][4] c_mygrid[6][5] c_mygrid[6][6] c_mygrid[6][7] c_mygrid[6][8] c_mygrid[7][1] c_mygrid[7][2] c_mygrid[7][3] c_mygrid[7][4] c_mygrid[7][5] c_mygrid[7][6] c_mygrid[7][7] c_mygrid[7][8] c_mygrid[8][1] c_mygrid[8][2] c_mygrid[8][3] c_mygrid[8][4] c_mygrid[8][5] c_mygrid[8][6] c_mygrid[8][7] c_mygrid[8][8] c_mygrid[9][1] c_mygrid[9][2] c_mygrid[9][3] c_mygrid[9][4] c_mygrid[9][5] c_mygrid[9][6] c_mygrid[9][7] c_mygrid[9][8] c_mygrid[10][1] c_mygrid[10][2] c_mygrid[10][3] c_mygrid[10][4] c_mygrid[10][5] c_mygrid[10][6] c_mygrid[10][7] c_mygrid[10][8] c_mygrid[11][1] c_mygrid[11][2] c_mygrid[11][3] c_mygrid[11][4] c_mygrid[11][5] c_mygrid[11][6] c_mygrid[11][7] c_mygrid[11][8] c_mygrid[12][1] c_mygrid[12][2] c_mygrid[12][3] c_mygrid[12][4] c_mygrid[12][5] c_mygrid[12][6] c_mygrid[12][7] c_mygrid[12][8]
thermo_modify   format float %.15g
run             0
