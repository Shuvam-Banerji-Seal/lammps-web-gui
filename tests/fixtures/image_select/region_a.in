# image_select fixture: native b332f28 (/home/roy/.local/bin/lmp), dump image PPM, run 0.
units lj
atom_style atomic
lattice sc 1.0
region box block 0 5 0 5 0 5
create_box 2 box
create_atoms 1 box
group odd id 1:125:2
set group odd type 2
mass * 1.0
pair_style lj/cut 2.5
pair_coeff * * 1.0 1.0
region ball sphere 2.5 2.5 2.5 1.8 side in
dump d all image 1 img.*.ppm type type size 96 96 view 60 30 box yes 0.02
dump_modify d pad 0 region ball
run 0
