# oracle: fix shardlow with pair dpd/fdt/energy and fix eos/cv (isoenergetic, atom_style dpd, SSA) on the examples/PACKAGES/dpd-react/dpde-shardlow fluid (1000 atoms), 100 steps
# oracle-inputs: w95dreact_shardlow_dpde_1000.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# Measured with native LAMMPS (black box): the dpde-shardlow example (same data, cutoff, kappa and seed).
# Measured against the engine: max relative error 4e-15 (thermo), 8e-14 (atoms).

boundary        p p p

units           metal
atom_style      dpd
read_data       w95dreact_shardlow_dpde_1000.data

comm_modify     mode single vel yes
mass            1 100.0

pair_style      dpd/fdt/energy 10.0 245455
pair_coeff      1 1 0.075 0.022 3.2E-05 10.00

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check no once no

timestep        0.001

compute         dpdU all dpd
variable        totEnergy equal pe+ke+c_dpdU[1]+c_dpdU[2]

thermo          10
thermo_style    custom step temp pe ke v_totEnergy
thermo_modify   format float %.15g

fix             1 all shardlow
fix             2 all nve
fix             3 all eos/cv 0.0005

run             100
