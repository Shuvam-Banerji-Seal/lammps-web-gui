# oracle: pair bpm/spring with the anharmonic term and damping: two unbonded atoms collide head-on
# oracle-inputs: w51bpm_pair.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      bond
newton          on off
read_data       w51bpm_pair.data
pair_style      bpm/spring anharmonic yes
pair_coeff      1 1 1.0 1.0 0.5 2.0
neighbor        0.3 bin
comm_modify     vel yes cutoff 2.0
fix             1 all nve
thermo_style    custom step pe epair ke fmax
thermo_modify   format float %.15g norm no
set             atom 1 vx 0.5
set             atom 2 vx -0.5
timestep        0.01
thermo          4
run             24
