# oracle: fix gcmc deletions in units metal with a very negative mu (always accepted, insertions rejected); checks the native deletion-attempt stream and the metal Planck constant path
# oracle-compare: thermo=all atoms=none rel=1e-8
units metal
atom_style atomic
pair_style lj/cut 3.0
pair_modify tail no
region box block 0 5 0 5 0 5
create_box 1 box
pair_coeff * * 0.0 1.0
mass 1 1.0
create_atoms 1 single 0.5 0.5 0.5 units box
create_atoms 1 single 1.5 0.5 0.5 units box
create_atoms 1 single 2.5 0.5 0.5 units box
create_atoms 1 single 3.5 0.5 0.5 units box
create_atoms 1 single 4.5 0.5 0.5 units box
create_atoms 1 single 0.5 1.5 0.5 units box
create_atoms 1 single 1.5 1.5 0.5 units box
create_atoms 1 single 2.5 1.5 0.5 units box
create_atoms 1 single 3.5 1.5 0.5 units box
create_atoms 1 single 4.5 1.5 0.5 units box
create_atoms 1 single 0.5 2.5 0.5 units box
create_atoms 1 single 1.5 2.5 0.5 units box
group gcmcgroup type 1
fix mygcmc gcmcgroup gcmc 1 3 0 1 29494 300.0 -2.0 1.0
thermo_style custom step atoms pe f_mygcmc[3] f_mygcmc[4] f_mygcmc[5] f_mygcmc[6]
thermo 1
thermo_modify format float %.15g
run 20
