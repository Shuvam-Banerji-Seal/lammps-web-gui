# oracle: dihedral_style class2 from a data file: all five cross-term sections, three non-planar 4-atom chains
# oracle-inputs: w35c2dih.data
# oracle-compare: rel=1e-9 atoms=all
units lj
atom_style molecular
bond_style class2
angle_style harmonic
dihedral_style class2
pair_style lj/cut 2.5
read_data w35c2dih.data
pair_coeff * * 0.5 0.9
special_bonds lj 0.0 0.5 0.8
timestep 0.002
fix 1 all nve
thermo_style custom step temp pe ebond eangle edihed eimp evdwl etotal press pxx pyy pzz pxy pxz pyz
thermo_modify format float %.15g
thermo 10
run 0
run 50
