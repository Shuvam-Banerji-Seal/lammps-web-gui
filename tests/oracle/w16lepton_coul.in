# oracle: pair_style lepton/coul (qi, qj charges) with per-pair cutoffs, lj+coul intermediate, ecoul tally
units           lj
atom_style      charge
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      2 box
region          left block 0 2.25 0 4 0 4
region          right block 2.25 4 0 4 0 4
create_atoms    1 region left
create_atoms    2 region right
mass            * 1.0
set             type 1 charge 0.3
set             type 2 charge -0.2
variable        vx atom 0.5*sin(1.3*x+0.7*y)
variable        vy atom 0.5*cos(0.9*y-0.4*z)
variable        vz atom 0.5*sin(1.1*z+0.5*x)
velocity        all set v_vx v_vy v_vz
velocity        all zero linear
pair_style      lepton/coul 2.5
pair_coeff      1 1 "qi*qj/r + 4.0*((1.0/r)^12-(1.0/r)^6)" 2.0
pair_coeff      1 2 "lj+coul; lj=4.0*eps*((sig/r)^12 - (sig/r)^6); eps=1.0; sig=1.0; coul=qi*qj/r" 2.5
pair_coeff      2 2 "lj+coul; lj=4.0*eps*((sig/r)^6 - 1.0*(sig/r)^3); eps=0.5; sig=0.95; coul=0.5*qi*qj/r*exp(-r)"
fix             1 all nve
thermo_style    custom step temp pe ecoul evdwl press
thermo_modify   format float %.15g
thermo          10
run             30
