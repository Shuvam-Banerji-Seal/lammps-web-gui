# oracle: charged 12-atom SDS box in real units, coul/long 12.0 + pppm 1e-4 (automatic G-ewald, mesh 8 8 8), step 0
# oracle-inputs: w117cf_pppm_mesh8_real.data
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=1e-12
units real
atom_style full
boundary p p p
bond_style harmonic
angle_style harmonic
special_bonds lj/coul 0.0 0.0 1.0
read_data w117cf_pppm_mesh8_real.data
pair_style coul/long 12.0
pair_coeff * *
kspace_style pppm 1.0e-4
bond_coeff 1 300.0 3.0
angle_coeff 1 20.0 100.0
thermo_style custom step pe evdwl ecoul elong eangle press
thermo_modify format float %.15g norm no
run 0
