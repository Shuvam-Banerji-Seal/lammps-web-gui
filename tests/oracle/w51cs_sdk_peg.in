# oracle: cut-down of examples/PACKAGES/cgspica/peg-verlet/in.pegc12e8-angle (lj/sdk and angle sdk; 30 chains, 50 steps)
# oracle-inputs: w51cs_peg_cut.data
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           real
dimension       3
atom_style      angle
pair_style      lj/sdk 15.0
bond_style      harmonic
angle_style     sdk
special_bonds   lj/coul 0.0 0.0 1.0
read_data       w51cs_peg_cut.data

neighbor        3.0 bin
neigh_modify    delay 5
timestep        5.0
velocity        all create 303.0 46659 mom yes rot yes dist gaussian
fix             1 all nvt temp 303.0 303.0 100.0
thermo_style    custom step temp pe evdwl ebond eangle etotal press
thermo_modify   format float %.15g
thermo          10
run             50
