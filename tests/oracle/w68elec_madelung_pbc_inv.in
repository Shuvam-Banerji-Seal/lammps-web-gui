# oracle: ELECTRODE madelung in.madelung-ewald-ffield (without ffield): fully periodic ewald/electrode, fix electrode/conp mat_inv, symm on
# oracle-inputs: w68elec_au_elyt.data
# oracle-compare: thermo=all atoms=all
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 1.7e-15, atoms 1.8e-13.
# Measured with native LAMMPS (black box): step 0: pe=138.307198058 c_qbot=-0.287554670879 c_qtop=0.287554670879 f_conp=-6.63116857798
boundary        p p p
kspace_style    ewald/electrode 1.0e-8
units           real
atom_style      full
pair_style      lj/cut/coul/long 12
read_data       w68elec_au_elyt.data
group           bot type 1
group           top type 2
variable        q atom q
compute         qbot bot reduce sum v_q
compute         qtop top reduce sum v_q
fix             conp bot electrode/conp 0 2 couple top 1 symm on
thermo_style    custom step pe c_qbot c_qtop f_conp
thermo_modify   format float %.15g
run             0
