# oracle: fix deposit with attempt 1 and near 0.9: a failed insertion step leaves the next try M steps later
# oracle-compare: thermo=all atoms=all
units           lj
atom_style      atomic
atom_modify     map array
boundary        p p f
region          box block -10 10 -10 10 -10 10
create_box      1 box
mass            1 1.0
region          reg block 0 1 0 1 0 2 side in units box
pair_style      lj/cut 2.5
pair_coeff      * * 0.0 1.0
timestep        0.01
fix             1 all nve
fix             3 all deposit 4 1 3 999 region reg units box near 0.9 attempt 1 vx -0.1 0.1 units box
thermo_style    custom step atoms pe
thermo_modify   format float %.15g
thermo          3
run             15
