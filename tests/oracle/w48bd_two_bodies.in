# oracle: two interacting bodies (2 and 3 sub-particles, different types, non-trivial inertia tensors and initial angular momenta), fix nve/body on both, 200 steps; body/nparticle sub-particle LJ forces and torques; thermo pe, ke, temp, etotal, press and the final atom state
# oracle-inputs: w48bd_two_bodies.data
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           lj
dimension       3
atom_style      body nparticle 2 3
read_data       w48bd_two_bodies.data
set             atom 1 angmom 0.4 -0.3 0.7
set             atom 2 angmom -0.2 0.5 0.1
velocity        all set 0.05 -0.02 0.03
pair_style      body/nparticle 5.0
pair_coeff      * * 1.0 1.0
pair_coeff      2 2 0.7 0.9
fix             1 all nve/body
thermo_style    custom step pe ke temp etotal press
thermo_modify   format float %.15g
thermo          20
run             200
