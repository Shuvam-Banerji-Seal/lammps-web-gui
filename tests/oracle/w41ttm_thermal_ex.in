# Wave 41: cut-down of examples/ttm/in.ttm.thermal (bcc Fe, eam/fs, fix ttm/thermal with a properties file, set 1800):
# 4x4x4 bcc cells (128 atoms) and a 4x4x4 electron grid with uniform properties (the example's values), 100 steps.
# oracle-inputs: w41ttm_thermal_ex.props
# oracle-potentials: Fe_mm.eam.fs
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
# Note: the atoms are moved 0.5 A off the lattice planes (displace_atoms below): an atom on a cell face takes its cell
# from round-off (measured: the sign of a 1e-23 residual decides the cell), so the grid would not be reproduced.
units           metal
atom_style      atomic
boundary        p p p

variable        latc  equal 2.87
lattice         bcc ${latc}
variable        xmax equal   2.0
variable        xmin equal  -2.0
variable        ymax equal   2.0
variable        ymin equal  -2.0
variable        zmax equal   2.0
variable        zmin equal  -2.0

region          sim_box block ${xmin} ${xmax} ${ymin} ${ymax} ${zmin} ${zmax} &
                units lattice
create_box      1 sim_box
region          atom_box block ${xmin} ${xmax} ${ymin} ${ymax} ${zmin} ${zmax} &
                units lattice
create_atoms    1 region atom_box
displace_atoms all move 0.5 0.5 0.5 units box

mass            1 55.845

pair_style      eam/fs
pair_coeff      * * Fe_mm.eam.fs Fe

neighbor        2.0 bin
neigh_modify    every 5 delay 0 check yes

fix             1 all nve

fix             twotemp all ttm/thermal 11111 w41ttm_thermal_ex.props 4 4 4 set 1800.0

compute         pe all pe/atom
compute         ke all ke/atom

timestep        0.0001
thermo          10

thermo_style    custom step temp etotal f_twotemp[1] f_twotemp[2]
                thermo_modify format float "%20.16g"

run             100
