# oracle: fix atom_weight/apip with constant times and no_rescale (the deterministic form: the per-atom weight sums the fast time for atoms with the SIMPLE bit of lambda_required, the precise time for the COMPLEX bit and the group time for members of the lambda_input group) under hybrid/overlay eam/fs/apip + pace/apip with mixed switching parameters, on the 31-atom Cu cell of examples/PACKAGES/apip/in.validate: the weight sums and the global vector every 2 steps and a dump of the weights
# Native reference: LAMMPS b332f28 built with PKG_APIP and PKG_ML-PACE (/store/shuvam/software/lammps-build-apip/lmp)
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 4.4e-16, atoms 4.3e-16.
# oracle-examples: PACKAGES/apip/data.validate PACKAGES/apip/Cu-1.yace PACKAGES/apip/Cu_300K_Immel_2023.eam.fs
# oracle-files: w278ap_atom_weight.dump
# oracle-compare: thermo=all atoms=all
units           metal
atom_style      apip
timestep        0.001
read_data       data.validate
variable        lam atom 0.5+0.5*sin(1.3*x+0.7*y-0.4*z)
set             group all apip/lambda v_lam
group           pre id 1:9
group           fst id 20:31
group           grp id 5:14
set             group pre apip/lambda precise
set             group fst apip/lambda fast
pair_style      hybrid/overlay eam/fs/apip pace/apip
pair_coeff      * * eam/fs/apip Cu_300K_Immel_2023.eam.fs Cu
pair_coeff      * * pace/apip Cu-1.yace Cu
fix             1 all nve
fix             w all atom_weight/apip 2 1e-05 0.0004 3e-06 0 grp no_rescale
compute         wsum all reduce sum f_w
thermo_style    custom step pe c_wsum f_w[1] f_w[2] f_w[3] f_w[4]
thermo_modify   format float %.15g
thermo          2
dump            d all custom 2 w278ap_atom_weight.dump id f_w
dump_modify     d format float %.15g sort id
velocity        all create 300 4928459 loop geom
run             4
