# oracle: 2d fix rigid single on three finite-size spheres with spin (x and y spin components dropped, as native) and position-dependent in-plane forces, plus three free spheres; 2d temp/sphere counts 1 rotational dof per sphere and a body removes 2n - 3 + n
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           lj
atom_style      sphere
dimension       2
region          box block 0 20 0 20 -0.5 0.5
create_box      1 box
create_atoms    1 single 8 10 0
create_atoms    1 single 9 10 0
create_atoms    1 single 8.5 10.9 0
create_atoms    1 single 3 3 0
create_atoms    1 single 4 3 0
create_atoms    1 single 3.5 3.9 0
set             type 1 diameter 1.0 density 1.0
set             atom 2 diameter 0.6 density 2.0
set             atom 3 diameter 1.4 density 0.5
group           body id 1:3
group           free id 4:6
pair_style      zero 2.5
pair_coeff      * *
velocity        all set 0 0 0 units box
set             group body vx 0.1 vy 0.02 vz 0
set             group free vx -0.05 vy 0.03 vz 0
set             atom 1 omega 0.4 -0.3 0.3
set             atom 2 omega 0.1 0.2 0.7
set             atom 3 omega 0.2 0.1 -0.2
set             atom 4 omega 0.05 0.05 0.2
set             atom 5 omega 0 0 0.1
set             atom 6 omega 0.1 0 -0.1
variable        fx atom 0.2*sin(1.3*x)+0.05*y
variable        fy atom 0.1*cos(0.9*y)
fix             1 body rigid single
fix             2 all addforce v_fx v_fy 0
fix             3 all enforce2d
compute         ers all erotate/sphere
compute         tsp all temp/sphere
timestep        0.002
thermo_style    custom step temp ke pe c_ers f_1 f_1[1][1] f_1[1][2] f_1[1][3] f_1[1][4] f_1[1][5] f_1[1][6] f_1[1][7] f_1[1][8] f_1[1][9] f_1[1][10] f_1[1][11] f_1[1][12]
thermo_modify   format float %.15g temp tsp
thermo          5
run             100
