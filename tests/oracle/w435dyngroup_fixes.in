# oracle: fixes whose native dynamic_group_allow is 1 on a dynamic group (the atoms of the lower half, re-evaluated every 2 steps): wall/harmonic/outside, wall/harmonic/returned, wall/lepton, addtorque, spring/rg and oneway, with their energies and forces in thermo
# oracle-compare: thermo=all atoms=all
units           lj
boundary        p p f
lattice         fcc 0.7
region          box block 0 4 0 4 0 6
create_box      1 box
region          inner block INF INF INF INF 0.3 5.7
create_atoms    1 region inner
mass            1 1.0
velocity        all create 2.0 81163 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
region          lower block INF INF INF INF INF 3.0
region          left block INF 2.0 INF INF INF INF
group           dyn dynamic all region lower every 2
fix             1 all nve
fix             2 dyn wall/harmonic/outside zlo EDGE 2.0 1.0 1.5
fix             3 dyn wall/harmonic/returned zhi EDGE 2.0 1.0 1.5
fix             4 dyn wall/lepton zlo EDGE "k*(rc-r)^2;k=3.0;rc=1.2" 1.2
fix             5 dyn addtorque 0.05 -0.1 0.2
fix             6 dyn spring/rg 1.0 NULL
fix             7 dyn oneway 3 left -x
thermo_style    custom step temp pe f_2 f_3 f_4 f_5 f_6
thermo_modify   format float %.15g
thermo          10
run             60
