# oracle: fix store/state history with Nfreq = 20 (3 frames every 5 steps before each multiple of 20: steps 10, 15, 20, then 30, 35, 40) of x and an atom-style variable, read by compute property/atom history[*][2] and history[1][1], lj melt 40 steps in two runs; dumps on multiples of 20
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 2.5e-15, atoms 4.1e-14.
# oracle-files: w269ss_history_nfreq.dump
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=1e-12 filerel=1e-10
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 3.0 87287 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
neighbor        0.3 bin
variable        vv atom vx*vx+vy*vy
fix             1 all nve
fix             hist all store/state 0 x v_vv history 5 3 20
compute         h all property/atom history[*][2] history[1][1] history hist
thermo_style    custom step temp pe
thermo_modify   format float %.15g
thermo          10
dump            d all custom 20 w269ss_history_nfreq.dump id c_h[1] c_h[2] c_h[3] c_h[4]
dump_modify     d sort id format float %.15g
run             25
run             15
