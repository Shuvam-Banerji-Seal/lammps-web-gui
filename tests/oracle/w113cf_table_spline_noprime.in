# oracle: pair_style table spline 500 on a 150-point R table without FPRIME (end slopes by native's secant estimate), cutoff at the table's outer distance
# measured max error vs native (run 0): per-atom 1.1e-14 relative, thermo 2.2e-13 (the old derivative end slope agrees here, the LJ table is smooth; the benzene case is the discriminating one)
# oracle-inputs: w113cf_lj_noprime_R150.table
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
group           odd id 1:108:2
set             group odd type 2
mass            * 1.0
variable        dx atom 0.04*sin(1.3*x+0.7*y)
variable        dy atom 0.04*cos(0.9*y-1.1*z)
variable        dz atom 0.04*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.8*sin(0.9*x+0.4*z)
variable        vy atom 0.8*cos(0.6*y+0.8*x)
variable        vz atom 0.8*sin(0.7*z-0.3*y)
velocity        all set v_vx v_vy v_vz units box
pair_style      table spline 500
pair_coeff      1 1 w113cf_lj_noprime_R150.table LJ11
pair_coeff      2 2 w113cf_lj_noprime_R150.table LJ11 2.5
pair_coeff      1 2 w113cf_lj_noprime_R150.table LJ11 2.4
timestep        0.002
fix             1 all nve
thermo_style    custom step temp pe etotal press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g
thermo          10
run             0
