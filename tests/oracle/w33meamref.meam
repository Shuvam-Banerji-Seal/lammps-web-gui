# w33meamref: synthetic single-element parameter file (not a LAMMPS potential file) with Cmin below the
# default, so the second neighbour shell of the fcc reference (four screening atoms at C = 1) is partly screened.
rc = 4.0
delr = 0.1
Ec(1,1) = 3.5
re(1,1) = 2.5
alpha(1,1) = 5.0
Cmin(1,1,1) = 0.70
Cmax(1,1,1) = 2.40
zbl(1,1) = 0
augt1 = 1
