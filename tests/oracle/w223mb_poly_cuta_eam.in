# oracle: pair_style polymorphic with CuTa_eam.poly (eta 1, Cu Ta), fcc lattice, displaced, velocity create, 100 steps of nve
# oracle-potentials: CuTa_eam.poly
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 2.8e-12, atoms 1.1e-13.
units           metal
atom_style      atomic
lattice         fcc 3.6
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
group           odd id 1:256:2
set             group odd type 2
mass            1 63.55
mass            2 180.95
variable        dx atom 0.05*sin(1.3*x+0.7*y)
variable        dy atom 0.05*cos(0.9*y-0.4*z)
variable        dz atom 0.05*sin(1.1*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
velocity        all create 300.0 4928459
pair_style      polymorphic
pair_coeff      * * CuTa_eam.poly Cu Ta
timestep        0.001
fix             1 all nve
thermo_style    custom step pe ke press pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.15g norm no
thermo          20
run             100
