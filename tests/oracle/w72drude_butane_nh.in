# oracle: DRUDE butane (examples/PACKAGES/drude/butane in.butane.nh) cut down to 10 molecules (180 atoms), 40 steps:
# fix drude, drude/transform/direct and inverse around fix nvt on the cores and on the Drude particles, momentum, temp/drude
# oracle-inputs: w72drude_data.butane10
# oracle-compare: thermo=all atoms=all rel=2e-6 abs=1e-10
# Measured with native LAMMPS (black box): engine vs native, max relative error 7.5e-7 (thermo press, step 30) and 5e-7 per atom force; the tolerance is 2e-6 (the Langevin variant on the same system is 2e-8).
units           real
boundary        p p p
atom_style      full
bond_style      harmonic
angle_style     harmonic
dihedral_style  opls
special_bonds   lj/coul 0.0 0.0 0.5
pair_style      hybrid/overlay lj/cut/coul/long 8.0 8.0 thole 2.089 8.0
pair_modify     mix geometric tail yes
kspace_style    pppm 1.0e-4
read_data       w72drude_data.butane10
group           gBUTANE molecule 1:10
group           gCORES type 1 2 3
group           gDRUDES type 4 5
pair_coeff      1    1 lj/cut/coul/long 0.065997 3.500000
pair_coeff      1    2 lj/cut/coul/long 0.065997 3.500000
pair_coeff      1    3 lj/cut/coul/long 0.044496 2.958040
pair_coeff      2    2 lj/cut/coul/long 0.065997 3.500000
pair_coeff      2    3 lj/cut/coul/long 0.044496 2.958040
pair_coeff      3    3 lj/cut/coul/long 0.029999 2.500000
pair_coeff      *  4*5 lj/cut/coul/long 0.000000 0.000000
pair_coeff      1    * thole 1.368000
pair_coeff      2    * thole 1.368000
pair_coeff      4    * thole 1.368000
pair_coeff      5    * thole 1.368000
neighbor        2.0 bin
velocity        gCORES  create 260.0 12345
velocity        gDRUDES create 1.0 12345
fix             fDRUDE all drude C C N D D
fix             fSHAKE gCORES shake 0.0001 20 0 b 2 4
comm_modify     vel yes
compute         cTEMP_CORE gCORES temp/com
compute         cTEMP all temp/drude
fix             fDIRECT all drude/transform/direct
fix             fNVT1 gCORES nvt temp 260.0 260.0 100.0
fix             fNVT2 gDRUDES nvt temp 1.0 1.0 20.0
fix             fINVERSE all drude/transform/inverse
fix             fMOMENTUM all momentum 100 linear 1 1 1
thermo_style    custom step etotal ke temp pe ebond eangle edihed eimp evdwl ecoul elong press vol c_cTEMP[1] c_cTEMP[2]
thermo_modify   format float %.15g
thermo          10
timestep        0.5
run             40
