# oracle: DPD-REACT pair table/rx (lookup 400, fractional weighting, named sites rdx and h2) with fix rx (rk4, dense) + fix eos/table/rx: the w160rx mixed start (rdx 1, the other species 0.1), 10 + 10 steps in a 4x4x6 hcp box (pair table: the Morse table w162rx_table.table, cut 16)
# oracle-inputs: w160rx_kinetics.dpdrx w160rx_table.eos w160rx_thermo.dpdrx w162rx_table.table
# oracle-files: oracle_rx.dump
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-15 atomrel=1e-8 filerel=1e-8
# native: /home/roy/.local/bin/lmp (b332f28, DPD-REACT included)
# Measured with native LAMMPS: after 20 steps rdx is 0.994622 (from 1) and h2 is 0.1000000038 (from 0.1), so the fraction weights of rdx and h2 change over the run.
# Measured against the engine: max relative error 1.1e-13 over all 9082 thermo and per-atom values (absolute 2.9e-11 at most); engine time about 0.7 s (vitest test duration, one case)

boundary        p p p
units           metal
atom_style      dpd
atom_modify     map array
fix             4 all rx w160rx_kinetics.dpdrx none dense lammps_rk4 1

lattice         hcp 6.6520898 origin 0.0833333333333 0.25 0.25 orient z 1 0 0 orient x 0 1 0 orient y 0 0 1
region          box block 0 4.0 0 4.0 0.0 6.0 units lattice
create_box      2 box
region          atoms block 0 4.0 0 4.0 0.0 6.0 units lattice
create_atoms    1 region atoms

comm_modify     mode single vel yes
mass            * 222.12

# species concentrations (rdx 1; the other species start at 0.1 so their fractions change)
set             atom * d_rdx 1.00
set             atom * d_h2 0.1
set             atom * d_no2 0.1
set             atom * d_n2 0.1
set             atom * d_hcn 0.1
set             atom * d_no 0.1
set             atom * d_h2o 0.1
set             atom * d_co 0.1
set             atom * d_co2 0.1

velocity        all create 2065.0 875661 dist gaussian loop geom
set             atom * dpd/theta 2065.00

timestep        0.001

pair_style      hybrid/overlay dpd/fdt/energy 16.00 234324 table/rx lookup 400 fractional
pair_coeff      * * dpd/fdt/energy 0.0 0.05 10.0 16.00
pair_coeff      * * table/rx w162rx_table.table RXPAIR rdx h2 16.00

fix             2 all nve
fix             3 all eos/table/rx linear w160rx_table.eos 201 KEYWORD w160rx_thermo.dpdrx

compute         dpdU all dpd
compute         dpdUatom all dpd/atom

variable        totEnergy equal pe+c_dpdU[1]+c_dpdU[2]+c_dpdU[3]

thermo          1
thermo_style    custom step temp press vol pe ke c_dpdU[1] c_dpdU[2] c_dpdU[3] v_totEnergy c_dpdU[4]
thermo_modify   format float %.15g flush yes

fix_modify      4 rx_chemistry off
run             10
fix_modify      4 rx_chemistry on
run             10

write_dump      all custom oracle_rx.dump id d_rdx d_h2 d_no2 d_n2 d_hcn d_no d_h2o d_co d_co2 d_rdxOld d_h2Old d_no2Old d_n2Old d_hcnOld d_noOld d_h2oOld d_coOld d_co2Old c_dpdUatom[1] c_dpdUatom[2] c_dpdUatom[3] c_dpdUatom[4] modify format float %.17g sort id
