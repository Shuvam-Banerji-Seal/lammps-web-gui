# oracle: pair_style comb - charged Si diamond (+0.35/-0.35 by parity), displaced, fixed charges, 40 steps (in.comb.Si cut down; exercises the Coulomb and charge-field terms)
# oracle-potentials: ffield.comb
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units		metal
atom_style	charge
lattice  	diamond 5.43
region		box block 0 3 0 3 0 3
create_box	1 box
create_atoms	1 box
mass		1 28.0855
group		odd id 1:1000:2
group		even id 2:1000:2
set		group odd charge 0.35
set		group even charge -0.35
variable	dx atom 0.06*sin(0.9*x+0.4*y)
variable	dy atom 0.06*cos(0.7*y-0.5*z)
variable	dz atom 0.06*sin(1.1*z+0.3*x)
displace_atoms	all move v_dx v_dy v_dz units box
variable	vx atom 0.4*sin(0.5*x+0.2*z)
variable	vy atom 0.4*cos(0.4*y+0.6*x)
variable	vz atom 0.4*sin(0.3*z-0.5*y)
velocity	all set v_vx v_vy v_vz units box
pair_style	comb
pair_coeff	* * ffield.comb Si
timestep	0.0002
fix		1 all nve
thermo_style	custom step temp etotal pe evdwl ecoul press vol lx ly lz xz
thermo_modify	norm yes format float %.15g
thermo		10
run		40
