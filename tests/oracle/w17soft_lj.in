# oracle: lj/cut/soft with lambda 0.5 and 1.0 between two types (explicit cross term), NVE 50 steps
units           lj
atom_style      atomic
lattice         fcc 0.5
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
lattice         fcc 0.5 origin 0.5 0.0 0.0
create_atoms    2 box
mass            * 1.0
variable        vx atom 1.2*sin(1.7*x+2.3*y+0.7*z)
variable        vy atom 1.2*cos(2.1*x-1.1*y+0.3*z)
variable        vz atom 1.2*sin(0.5*x+1.9*z+1.3*y)
velocity        all set v_vx v_vy v_vz units box
velocity        all zero linear
pair_style      lj/cut/soft 2 0.5 2.5
pair_coeff      1 1 1.0 1.0 0.5
pair_coeff      2 2 0.8 1.1 1.0
pair_coeff      1 2 0.9 1.05 0.75
neighbor        0.3 bin
neigh_modify    every 1 delay 0 check yes
timestep        0.001
fix             1 all nve
thermo_style    custom step temp pe ke etotal press pxx pyy pzz pxy pxz pyz evdwl
thermo_modify   format float %.15g
thermo          10
run             50
