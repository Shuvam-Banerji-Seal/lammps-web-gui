# oracle: 3d atom_style sphere, lj/cut (zero torque) — fix nvt/sphere thermostats translation and rotation (compute temp/sphere made by the fix); spheres with set omega
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# oracle-files: w7nhs_omega.dump
units           lj
atom_style      sphere
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
group           odd id 1:108:2
set             group odd type 2
set             group odd diameter 1.2
set             type 1 density 1.3
variable        dx atom 0.04*sin(1.3*x+0.7*y)
variable        dy atom 0.04*cos(0.9*y-1.1*z)
variable        dz atom 0.04*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        wx atom 0.5*sin(0.3*id)
variable        wy atom 0.5*cos(0.7*id)
variable        wz atom 0.2*sin(1.1*id)
set             group all omega v_wx v_wy v_wz
velocity        all create 1.2 87287
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0
timestep        0.002
fix             1 all nvt/sphere temp 1.2 0.8 0.5
compute         ts all temp/sphere
compute         er all erotate/sphere
thermo_style    custom step temp pe etotal press c_ts c_er f_1 c_ts[1] c_ts[4]
thermo_modify   format float %.15g
thermo          20
run             200
write_dump      all custom w7nhs_omega.dump id omegax omegay omegaz modify format float %.17g sort id
