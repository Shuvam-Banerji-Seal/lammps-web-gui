# oracle: angmom/chunk, inertia/chunk and omega/chunk (chunk/atom type) of 12 ellipsoids (two types, a point particle among them) with angular momenta and orientations under fix nve/asphere, 50 steps
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-12
units           lj
atom_style      ellipsoid
lattice         sc 0.3
region          box block 0 3 0 2 0 2
create_box      2 box
create_atoms    1 box
set             atom 1 type 1
set             atom 1 shape 1.3 1.2 1.3
set             atom 1 quat 0.4 1 0.48 37
set             atom 1 angmom 0.336588 0.124844 0.25
set             atom 1 density 0.7
set             atom 2 type 1
set             atom 2 shape 1.6 0.8 1.4
set             atom 2 quat 0.5 1 0.46 54
set             atom 2 angmom 0.363719 0.196093 0.3
set             atom 2 density 0.8
set             atom 3 type 1
set             atom 3 shape 1 1 1.5
set             atom 3 quat 0.6 1 0.44 71
set             atom 3 angmom 0.056448 -0.288051 0.35
set             atom 3 density 0.6
set             atom 4 type 1
set             atom 4 shape 0 0 0
set             atom 4 density 0.7
set             atom 5 type 1
set             atom 5 shape 1.6 0.8 1.3
set             atom 5 quat 0.8 1 0.4 105
set             atom 5 angmom -0.38357 0.251721 0.45
set             atom 5 density 0.8
set             atom 6 type 1
set             atom 6 shape 1 1 1.4
set             atom 6 quat 0.9 1 0.38 122
set             atom 6 angmom -0.111766 -0.253156 0.5
set             atom 6 density 0.6
set             atom 7 type 2
set             atom 7 shape 1.3 1.2 1.5
set             atom 7 quat 1 1 0.36 139
set             atom 7 angmom 0.262795 -0.0410212 0.55
set             atom 7 density 0.7
set             atom 8 type 2
set             atom 8 shape 1.6 0.8 1.2
set             atom 8 quat 1.1 1 0.34 156
set             atom 8 angmom 0.395743 0.287298 0.6
set             atom 8 density 0.8
set             atom 9 type 2
set             atom 9 shape 0 0 0
set             atom 9 density 0.6
set             atom 10 type 2
set             atom 10 shape 1.3 1.2 1.4
set             atom 10 quat 1.3 1 0.3 190
set             atom 10 angmom -0.217608 -0.122425 0.7
set             atom 10 density 0.7
set             atom 11 type 2
set             atom 11 shape 1.6 0.8 1.5
set             atom 11 quat 1.4 1 0.28 207
set             atom 11 angmom -0.399996 0.299988 0.75
set             atom 11 density 0.8
set             atom 12 type 2
set             atom 12 shape 1 1 1.2
set             atom 12 quat 1.5 1 0.26 224
set             atom 12 angmom -0.214629 -0.127254 0.8
set             atom 12 density 0.6
velocity        all create 0.8 4928 mom yes rot no dist gaussian
pair_style      lj/cut 2.5
pair_coeff      * * 0.05 0.8
timestep        0.001
group           fin id 1 2 3 5 6 7 8 10 11 12
group           pts id 4 9
fix             1 fin nve/asphere
fix             2 pts nve
compute         cc all chunk/atom type
compute         L all angmom/chunk cc
compute         I all inertia/chunk cc
compute         W all omega/chunk cc
thermo_style    custom step c_L[1][1] c_L[1][2] c_L[1][3] c_L[2][1] c_L[2][2] c_L[2][3] c_I[1][1] c_I[1][2] c_I[1][3] c_I[1][4] c_I[1][5] c_I[1][6] c_I[2][1] c_I[2][2] c_I[2][3] c_I[2][4] c_I[2][5] c_I[2][6] c_W[1][1] c_W[1][2] c_W[1][3] c_W[2][1] c_W[2][2] c_W[2][3]
thermo_modify   format float %.15g norm no
thermo          10
run             50
