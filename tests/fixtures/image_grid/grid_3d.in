# image_grid fixture: native b332f28 (/home/roy/.local/bin/lmp), dump image PPM.
units lj
atom_style atomic
lattice sc 0.5
region box block 0 3 0 3 0 3
create_box 1 box
create_atoms 1 box
mass * 1.0
pair_style lj/cut 2.5
pair_coeff * * 1.0 1.0
compute pg all property/grid 3 3 3 z
dump d all image 1 img.*.ppm type type size 128 128 view 60 30 box yes 0.02 grid c_pg:grid:data
dump_modify d pad 0 adiam * 0.4 gmap min max cf 0.0 3 min blue 0.5 white max red gtrans 0.6
run 0
