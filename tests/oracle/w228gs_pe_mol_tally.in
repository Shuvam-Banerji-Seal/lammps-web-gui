# oracle: compute pe/mol/tally (intra- and inter-molecular pair energy between group half and all) with lj/cut on a 64-atom molecular fluid
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10 filerel=1e-8
# oracle-files: w228gs_pe_mol_tally.dump
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 1.7e-15, atoms 7.4e-15.
units           lj
atom_style      molecular
boundary        p p p
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
group           half id 1:32
set             group half type 2
mass            * 1.0
set             group all mol 1
set             atom 1*8 mol 2
set             atom 9*16 mol 3
displace_atoms  all random 0.1 0.1 0.1 4321 units box
velocity        all create 1.0 4242 loop geom
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0
compute         pm all pe/mol/tally half
thermo_style    custom step pe c_pm[1] c_pm[2] c_pm[3] c_pm[4]
thermo_modify   format float %.15g
dump            1 all custom 1 w228gs_pe_mol_tally.dump id x y z
dump_modify     1 sort id format float %.15g
run             0
