# oracle: fix adapt atom diameter scale yes reset yes (mass yes) every 2 steps, with the diameters changed by set after the fix is defined: native restores the radii the fix stored when it was defined (its STORE/ATOM fix), and scales from the run's own start (previous_diam_scale 1 at each init); two runs
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      sphere 1
lattice         sc 0.8
region          b block 0 4 0 4 0 4
create_box      2 b
create_atoms    1 box
group           odd id 1:64:2
set             group all diameter 1.0 density 1.0
set             group odd type 2
variable        dx atom 0.1*sin(1.3*x+0.7*y)
variable        dy atom 0.1*cos(0.9*y-1.1*z)
variable        dz atom 0.1*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.5*sin(1.7*x+2.3*y+0.7*z)
variable        vy atom 0.5*cos(2.1*x-1.1*y+0.3*z)
variable        vz atom 0.5*sin(0.5*x+1.9*z+1.3*y)
velocity        all set v_vx v_vy v_vz units box
timestep        0.002
pair_style      lj/cut 2.5
pair_coeff      * * 0.5 1.0
variable        ss equal 1.0+0.002*elapsed
fix             1 odd adapt 2 atom diameter v_ss scale yes reset yes
set             group odd diameter 1.2 density 1.4
fix             2 all nve/sphere
compute         rr all property/atom radius mass
compute         sr all reduce sum c_rr[1] c_rr[2]
thermo_style    custom step temp pe ke etotal press c_sr[1] c_sr[2]
thermo_modify   format float %.15g
thermo          10
run             40
run             20
