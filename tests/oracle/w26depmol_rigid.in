# oracle: fix rigid/small mol + fix deposit rigid — rigid bodies from deposited molecules
# oracle-inputs: w26depmol_dimer.mol
units           lj
atom_style      bond
boundary        p p f
region          box block 0 10 0 10 0 20
create_box      3 box bond/types 1 extra/bond/per/atom 1
molecule        dim w26depmol_dimer.mol
pair_style      lj/cut 2.5
pair_coeff      * * 0.0 1.0
mass            * 1.0
bond_style      harmonic
bond_coeff      1 20.0 0.5
region          slab block 0 10 0 10 16 18
group           addatoms empty
fix             1 addatoms rigid/small molecule mol dim
fix             2 addatoms deposit 4 0 1 12345 region slab mol dim rigid 1 vz -1.0 -1.0 units box
thermo_style    custom step atoms temp pe ebond evdwl etotal press
thermo_modify   format float %.15g
thermo          1
run             4
