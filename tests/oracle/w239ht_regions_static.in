# oracle: compute heat/flux/tally and heat/flux/virial/tally, lj/cut/coul/cut, groups lower/upper from a region, molecule groups m1/m2 (static, run 0)
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 3.9e-15, atoms 1.1e-14.
# oracle-compare: thermo=all atoms=all
units lj
atom_style full
boundary p p p
lattice fcc 0.8442
region box block 0 3 0 3 0 3
create_box 2 box
create_atoms 1 box
group odd id 1:108:2
set group odd type 2
mass 1 1.0
mass 2 1.5
set group odd charge 0.6
group even subtract all odd
set group even charge -0.6
region lowz block INF INF INF INF INF 2.5 units box
group lower region lowz
group upper subtract all lower
variable dx atom 0.04*sin(1.3*x+0.7*y)
variable dy atom 0.04*cos(0.9*y-1.1*z)
variable dz atom 0.04*sin(1.7*z+0.5*x)
displace_atoms all move v_dx v_dy v_dz units box
variable vx atom 0.8*sin(0.9*x+0.4*z)
variable vy atom 0.8*cos(0.6*y+0.8*x)
variable vz atom 0.8*sin(0.7*z-0.3*y)
velocity all set v_vx v_vy v_vz units box
timestep 0.002
pair_style      lj/cut/coul/cut 2.5
pair_coeff      * * 1.0 1.0
group           m1 id 1:108:3
group           m2 id 2:108:3
set group m1 mol 1
compute         hx lower heat/flux/tally upper
compute         hxv lower heat/flux/virial/tally upper
compute         hm m1 heat/flux/tally m2
compute         hmv m1 heat/flux/virial/tally m2
thermo_style    custom step pe c_hx[1] c_hx[2] c_hx[3] c_hx[4] c_hx[5] c_hx[6] c_hxv c_hm[1] c_hm[4] c_hmv
thermo_modify   format float %.15g norm no
thermo          1
run             0
