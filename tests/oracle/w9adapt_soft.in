# oracle: fix adapt pair soft a * * v_prefactor with ramp(10,30) over 100 steps, N=1, 2 types
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      atomic
lattice         sc 0.8
region          b block 0 4 0 4 0 4
create_box      2 b
create_atoms    1 box
mass            * 1.0
set             group all type 1
group           odd id 1:64:2
set             group odd type 2
variable        dx atom 0.1*sin(1.3*x+0.7*y)
variable        dy atom 0.1*cos(0.9*y-1.1*z)
variable        dz atom 0.1*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 0.5*sin(1.7*x+2.3*y+0.7*z)
variable        vy atom 0.5*cos(2.1*x-1.1*y+0.3*z)
variable        vz atom 0.5*sin(0.5*x+1.9*z+1.3*y)
velocity        all set v_vx v_vy v_vz units box
timestep        0.002
thermo_style    custom step temp pe ke etotal press pxx pyy pzz
thermo_modify   format float %.15g
thermo          10
pair_style      soft 2.5
pair_coeff      * * 10.0
variable        prefactor equal ramp(10,30)
fix             1 all adapt 1 pair soft a * * v_prefactor
fix             2 all nve
run             100
