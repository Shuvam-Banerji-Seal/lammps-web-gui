# oracle: fix srd with point SRD particles only, 2d (cut-down of examples/srd/in.srd.pure: 3x3 box, 200 steps)
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# Measured with native LAMMPS (black box): the engine agrees with the thermo rows and the per-atom state to a relative error below 1e-13 (no big particles; the SRD rotation and the RanMars uniform draws in bin order).
units		lj
atom_style	atomic
atom_modify	first empty
dimension	2

lattice		sq 0.4
region		box block 0 3 0 3 -0.5 0.5
create_box	1 box

lattice		sq 0.4
region		plane block 0 3 0 3 -0.001 0.001
lattice		sq 85.0
create_atoms	1 region plane

group		empty type 2

mass		1 0.01
velocity	all create 1.0 593849 loop geom

neighbor	0.3 bin
neigh_modify	delay 1 every 1 check no

comm_modify	group empty

timestep	0.02

fix		1 all srd 1 NULL 1.0 0.25 49894 collision slip
fix		2 all enforce2d

thermo_style	custom step temp f_1[7] etotal press f_1[3] f_1[4] f_1[6]
thermo_modify	format float %.15g
thermo		20

run		200
