# oracle: pouring spheres into a rotating box of line segments (in.line.gran.surf cut down: 30 spheres poured, 580 steps; 2d surf/granular, fix surface/local input mol lines)
# oracle-note: the run is stopped at step 580 because the engine and native LAMMPS first differ at step 588 (sphere 15, a contact with the rotating box; the 2 spheres' forces differ by ~2e-2). Measured: see oracle-measured.
# oracle-inputs: w106gs_surf.line
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
# oracle-measured: max relative error (native fixture vs engine, scale max(1,|LAMMPS|)): thermo 3.4e-15, per-atom 1.7e-15 (measured with tests/fixtures/oracle, 2026-10-13)
units           lj
atom_style      line
atom_modify     map array
boundary        f f p
dimension       2
comm_modify     vel yes cutoff 12.5

region          box block -15 15 -15 15 -0.5 0.5 units box
create_box      2 box

molecule        lines w106gs_surf.line
fix             20 all surface/local input mol lines

pair_style      hybrid granular surf/granular
pair_coeff      1 1 granular hooke 4000.0 100.0 &
                         tangential linear_history 1000.0 1.0 0.5 &
                         damping mass_velocity
pair_coeff      1 2 surf/granular hooke 4000.0 100.0 &
                         tangential linear_history 1000.0 1.0 0.5 &
                         damping mass_velocity
pair_coeff      2 2 none

group           sphere type 1
group           line type 2

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

fix             1 line move rotate 0 0 0 0 0 1 25

fix             2 sphere nve/sphere
fix             3 sphere gravity 1.0 vector 0 -1 0

region          slab block -3 3 -2 2 -0.5 0.5 units box
fix             ins sphere pour 30 1 4767548 vol 0.4 10 &
                diam one 1.0 region slab

fix             10 all enforce2d

timestep        0.005

compute         1 sphere temp
compute_modify  1 dynamic/dof yes

compute         2 sphere temp/sphere
compute_modify  2 dynamic/dof yes

thermo_style    custom step atoms temp c_1 c_2 press
thermo_modify   format float %.15g lost ignore
compute_modify  thermo_temp dynamic/dof yes
thermo          100

run             580
