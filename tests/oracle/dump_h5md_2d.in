# oracle: dump h5md in 2d (native: the b332f28 build with the H5MD package): sub-intervals of position (every 2) and velocity (every 3), image with position, force and species every dump, unwrapped positions
# oracle-files: b.h5
units           lj
dimension       2
atom_style      atomic
lattice         sq2 0.8442
region          box block 0 10 0 10 -0.5 0.5
create_box      2 box
create_atoms    1 box
mass            * 1.0
set             group all type/fraction 2 0.4 4321
velocity        all create 2.0 87287 loop geom
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0
fix             1 all nve
fix             2 all enforce2d
thermo_style    custom step temp pe etotal press
thermo_modify   format float %.15g
dump            1 all h5md 4 b.h5 position every 2 image velocity every 3 species force
dump_modify     1 unwrap yes
run             24
