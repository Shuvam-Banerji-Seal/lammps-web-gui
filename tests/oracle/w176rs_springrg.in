# oracle: fix spring/rg keeps its reference rg0 through write_restart/read_restart (fix_spring_rg.cpp write_restart "rg0"): the fix is re-specified with RG0 NULL after read_restart, so the value comes from the file; 20 + 20 steps. Native: built from b332f28 (installed lmp, EXTRA-FIX).
# oracle-compare: thermo=all atoms=all rel=1e-8
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 0.8 4321 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
timestep        0.004
fix             1 all nve
fix             sr all spring/rg 2.0 NULL
thermo_style    custom step temp pe etotal f_sr
thermo_modify   format float %.15g
thermo          5
run             20
write_restart   w176rs_springrg.restart
clear
read_restart    w176rs_springrg.restart
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
fix             1 all nve
fix             sr all spring/rg 2.0 NULL
thermo_style    custom step temp pe etotal f_sr
thermo_modify   format float %.15g
thermo          5
run             20
