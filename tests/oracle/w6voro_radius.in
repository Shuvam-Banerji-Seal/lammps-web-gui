# oracle: compute voronoi/atom radical tessellation (radius v_rad) with two atom types, written by a dump
# oracle-files: rad.dump
# oracle-compare: thermo=first-last
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 3 0 3 0 3
create_box      2 box
create_atoms    1 box
mass            * 1.0
region          left block INF 1.5 INF INF INF INF
group           small region left
set             group small type 2
variable        dx atom 0.06*sin(1.3*x+0.7*y)
variable        dy atom 0.06*cos(0.9*y-1.1*z)
variable        dz atom 0.06*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        rad atom (type==1)*0.3+(type==2)*0.2
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0
compute         v all voronoi/atom radius v_rad
thermo_style    custom step pe
thermo_modify   format float %.15g
dump            d all custom 1 rad.dump id type c_v[*]
dump_modify     d sort id format float %.12g
run             0
