# oracle: coul/long alone on the small sds system (precision reference for the overlay case)
# oracle-inputs: w104cf_sds_small.data
# oracle-compare: thermo=all atoms=all
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 5.6e-15, atoms 1.4e-15.
units real
atom_style full
boundary p p p
bond_style harmonic
angle_style harmonic
special_bonds lj/coul 0.0 0.0 1.0
read_data w104cf_sds_small.data
pair_style coul/long 26.5
pair_coeff * *
kspace_style ewald 1e-6
bond_coeff 1 300.0 3.0
angle_coeff 1 20.0 100.0
thermo_style custom step pe evdwl ecoul elong eangle press
thermo_modify format float %.15g norm no
run 0
