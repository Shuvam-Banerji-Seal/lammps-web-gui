# oracle: kspace_style ewald with kspace_modify kmax/ewald 4 0 4. Native uses the counts only when all three are
# positive (src/kspace.cpp kewaldflag), so a zero count leaves the automatic choice; mesh, order and diff are read
# and ignored by ewald.
# oracle-compare: thermo=all atoms=all rel=1e-9 abs=1e-10
units lj
atom_style full
lattice fcc 0.8442
region box block 0 3 0 3 0 3
create_box 2 box
create_atoms 1 box
mass * 1.0
set type 1 type/ratio 2 0.5 12345
set type 1 charge 1.0
set type 2 charge -1.0
velocity all create 1.0 87287 loop geom
pair_style lj/cut/coul/long 2.5
pair_coeff * * 1.0 1.0
kspace_style ewald 1e-4
kspace_modify kmax/ewald 4 0 4 mesh 8 8 8 order 3 diff ad
fix 1 all nve
thermo_style custom step temp pe ecoul elong press pxx pyz
thermo_modify format float %.15g
thermo 5
run 20
