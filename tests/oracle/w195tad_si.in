# oracle: tad (temperature accelerated dynamics) on 3 partitions: a vacancy in 2x2x2 diamond Si (sw), nvt at 1600 K
#   (the high temperature, tlo 1200), 200 steps, t_event 20, delta_conf 0.05, tmax 0.001 (the first event is confident at once); NEB with 20+20 iterations every 5 (quickmin)
# oracle-partitions: 3
# oracle-potentials: Si.sw
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10 atomrel=1e-8
# Measured with native LAMMPS: thermo max 1.9e-12, atoms max 2.8e-12 relative (ORACLE_MEASURE=1; table exact incl. the NEB barriers, engine run 0.5 s)
# native: b332f28 (/home/roy/.local/bin/lmp, mpirun -np 3 -partition 3x1)
units           metal
atom_style      atomic
atom_modify     map array
boundary        p p p
atom_modify     sort 0 0.0
variable a equal 5.431
lattice         custom $a a1 1.0 0.0 0.0 a2 0.0 1.0 0.0 a3 0.0 0.0 1.0 &
                basis 0.0 0.0 0.0 basis 0.0 0.5 0.5 basis 0.5 0.0 0.5 basis 0.5 0.5 0.0 &
                basis 0.25 0.25 0.25 basis 0.25 0.75 0.75 basis 0.75 0.25 0.75 basis 0.75 0.75 0.25
region          myreg block 0 2 0 2 0 2
create_box      1 myreg
create_atoms    1 region myreg
mass            1 28.06
group           Si type 1
velocity        all create 1600.0 5287286 mom yes rot yes dist gaussian
group           del id 30
delete_atoms    group del
pair_style      sw
pair_coeff      * * Si.sw Si
thermo          10
fix             1 all nve
timestep        1.0e-3
neighbor        1.0 bin
neigh_modify    every 1 delay 10 check yes
run             20
unfix           1
fix             1 all nvt temp 1600.0 1600.0 0.1
compute         event all event/displace 0.5
thermo_style    custom step temp pe
thermo_modify   format float %.15g
tad 200 20 1200.0 1600.0 0.05 0.001 event min 1.0e-5 1.0e-5 100 100 neb 0.0 0.01 20 20 5
