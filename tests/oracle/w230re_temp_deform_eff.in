# oracle: compute temp/deform/eff (streaming velocity of fix deform removed) on the eFF SiH4 system with fix nve/eff, 20 steps
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 6.1e-13, atoms 0.
# oracle-inputs: w110effecp_sih4.data
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=1e-12 atomrel=1e-10
units           electron
newton          on
boundary        f f f
atom_style      electron
read_data       w110effecp_sih4.data
pair_style      eff/cut 1000.0 ecp 1 Si
pair_coeff      * *
comm_modify     vel yes
velocity        all set 0.001 0.002 -0.001 units box
timestep        0.001
fix             1 all nve/eff
fix             2 all deform 1 x erate 0.001 y erate -0.0005 remap v
compute         tdef all temp/deform/eff
thermo_style    custom step temp pe ke etotal c_tdef c_tdef[1] c_tdef[4]
thermo_modify   temp tdef format float %.15g
thermo          5
run             20
