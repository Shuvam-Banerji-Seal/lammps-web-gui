# oracle: kspace_modify compute no with pppm; the kspace setup runs but no kspace force, energy or virial is computed
# oracle-compare: thermo=all atoms=all
units           lj
atom_style      charge
atom_modify     map array sort 0 0.0
lattice         sc 0.7
region          box block 0 2 0 3 0 3
create_box      1 box
create_atoms    1 box
group           neg id 1:17:2
group           pos id 2:18:2
set             group neg charge -1.0
set             group pos charge 1.0
mass            * 1.0
velocity        all create 0.5 4928 loop all
pair_style      lj/cut/coul/long 2.5
pair_coeff      * * 1.0 1.0
pair_modify     table 0
kspace_style    pppm 1e-4
kspace_modify   compute no
timestep        0.002
fix             1 all nve
thermo_style    custom step temp pe elong press
thermo_modify   format float %.15g
thermo          5
run             20
