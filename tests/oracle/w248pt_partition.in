# oracle: the partition command runs its command on the selected partitions only (input.cpp Input::partition): two partitions, partition yes 1 / no 1 / yes * with a region, velocities and a fix that differ between the partitions
# oracle-partitions: 2
# oracle-compare: thermo=all atoms=all
# Measured max relative error, engine vs native (thermo rows, final atoms): partition 0 thermo 1.4e-15, atoms 4.4e-14; partition 1 thermo 1.9e-15, atoms 1.2e-13.
units           lj
atom_style      atomic
lattice         fcc 0.8442
partition       yes 1 region box block 0 3 0 3 0 3
partition       no 1 region box block 0 4 0 3 0 3
partition       yes * create_box 1 box
create_atoms    1 box
mass            1 1.0
partition       yes 1 velocity all create 1.0 87287 loop geom
partition       no 1 velocity all create 2.0 4928 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
fix             1 all nve
partition       yes 2 fix 2 all langevin 1.5 1.5 0.5 1234
thermo_style    custom step atoms temp pe press
thermo_modify   format float %.15g
thermo          10
run             30
