# oracle: compute property/atom takes the atom style's own words (native avec->property_atom): atom_style sph rho drho esph desph cv, 0 outside the group
dimension          2
units              si
atom_style         sph
region             box block -0.05e-3 1.044e-3 -0.05e-3 1.044e-3 -1.0e-6 1.0e-6 units box
create_box         2 box
region             fluid block 0.0001e-3 0.999e-3 0.0001e-3 0.999e-3 EDGE EDGE side in units box
lattice            sq 0.05e-3
create_atoms       1 region fluid
region             walls block 0.0001e-3 0.999e-3 0.0001e-3 EDGE EDGE EDGE side out units box
create_atoms       2 region walls
group              fluid type 1
group              walls type 2
mass               * 4.0e-7
set                group all sph/rho 1000.0
set                group fluid sph/e 2.0e-9
set                group walls sph/cv 3.0
pair_style         sph/taitwater/morris
pair_coeff         * * 1000 0.1 1.0e-3 1.3e-4
variable           vx atom 0.01*sin(1.0e4*y)
velocity           fluid set v_vx 0.0 0.0 units box
fix                1 fluid sph
fix                2 walls sph/stationary
compute            p fluid property/atom rho drho esph desph cv
compute            r all reduce sum c_p[1] c_p[2] c_p[3] c_p[4] c_p[5]
compute            m all reduce max c_p[1] c_p[2] c_p[4]
thermo_style       custom step c_r[1] c_r[2] c_r[3] c_r[4] c_r[5] c_m[1] c_m[2] c_m[3]
thermo_modify      format float %.15g
neighbor           3.0e-6 bin
timestep           5.0e-5
thermo             10
run                30
