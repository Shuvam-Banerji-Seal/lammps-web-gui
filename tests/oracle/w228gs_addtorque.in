# oracle: fix addtorque/atom with constant and atom-style (v_name) torque components, every 2 steps, on finite-size spheres in contact (gran/hooke/history); the vector is the group torque before the change
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10 filerel=1e-8
# oracle-files: w228gs_addtorque.dump
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 1.1e-14, atoms 2.7e-15.
units           lj
atom_style      sphere
comm_modify     vel yes
boundary        p p p
lattice         sc 0.8
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
set             type 1 diameter 1.0
set             group all density 1.0
displace_atoms  all random 0.1 0.1 0.1 4321 units box
velocity        all create 0.3 4242 loop geom
set             group all omega 0.2 -0.1 0.3
variable        tz atom 0.05*x-0.02*y
pair_style      gran/hooke/history 2000.0 NULL 50.0 NULL 0.5 0
pair_coeff      * *
timestep        0.002
fix             1 all nve/sphere
fix             2 all addtorque/atom 0.1 -0.2 v_tz every 2
thermo_style    custom step pe ke f_2[1] f_2[2] f_2[3]
thermo_modify   format float %.15g
thermo          5
dump            1 all custom 20 w228gs_addtorque.dump id x y z vx vy vz tqx tqy tqz
dump_modify     1 sort id format float %.15g
run             20
