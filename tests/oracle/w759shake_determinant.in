# oracle: a SHAKE bond whose predicted separation cannot reach the bond length (relative velocity across the bond larger than the bond length per step): native warns Shake determinant < 0.0 and takes the multiplier of closest approach, -b / (2 a)
units           lj
atom_style      bond
atom_modify     map array
region          box block 0 12 0 12 0 12
create_box      1 box bond/types 1 extra/bond/per/atom 1
create_atoms    1 single 6.0 6.0 5.5 units box
create_atoms    1 single 6.0 6.0 6.5 units box
mass            1 1.0
pair_style      zero 2.0
pair_coeff      * *
bond_style      harmonic
bond_coeff      1 50.0 1.0
create_bonds    single/bond 1 1 2
velocity        all set 0.0 0.0 0.0
group           one id 1
velocity        one set 400.0 0.0 0.0
timestep        0.005
fix             1 all nve
fix             2 all shake 1e-10 50 0 b 1
thermo_style    custom step ke pe press pxx pzz
thermo_modify   format float %.15g
thermo          1
run             4
