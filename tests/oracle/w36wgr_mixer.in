# oracle: fix wall/gran/region on the granregion mixer region (intersect of a side-in cylinder with two moving side-out blocks), hertz/history, spheres under gravity
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-12
units           lj
atom_style      sphere
atom_modify     map array
comm_modify     vel yes
boundary        f f f
region          boxreg block 0 20 0 20 0 20 units box
create_box      1 boxreg
variable        sweep equal 0.5*sin(2*PI*step/10000.0)
region          cylreg cylinder z 10 10 10 0 20 side in units box
region          b1 block 2 18 9 11 0 4 side out move v_sweep NULL NULL units box
region          b2 block 9 11 2 18 0 3.99999 side out move NULL v_sweep NULL units box
region          mixer intersect 3 cylreg b1 b2 side in
create_atoms    1 single 4 4 4.5 units box
create_atoms    1 single 7 4 4.5 units box
create_atoms    1 single 10 4 4.5 units box
create_atoms    1 single 13 4 4.5 units box
create_atoms    1 single 16 4 4.5 units box
create_atoms    1 single 4 7 4.5 units box
create_atoms    1 single 7 7 4.5 units box
create_atoms    1 single 10 7 4.5 units box
create_atoms    1 single 13 7 4.5 units box
create_atoms    1 single 16 7 4.5 units box
create_atoms    1 single 4 10 4.5 units box
create_atoms    1 single 7 10 4.5 units box
create_atoms    1 single 10 10 4.5 units box
create_atoms    1 single 13 10 4.5 units box
create_atoms    1 single 16 10 4.5 units box
create_atoms    1 single 4 13 4.5 units box
create_atoms    1 single 7 13 4.5 units box
create_atoms    1 single 10 13 4.5 units box
create_atoms    1 single 13 13 4.5 units box
create_atoms    1 single 16 13 4.5 units box
create_atoms    1 single 4 16 4.5 units box
create_atoms    1 single 7 16 4.5 units box
create_atoms    1 single 10 16 4.5 units box
create_atoms    1 single 13 16 4.5 units box
create_atoms    1 single 16 16 4.5 units box
create_atoms    1 single 4 4 6.0 units box
create_atoms    1 single 4 16 6.0 units box
create_atoms    1 single 16 4 6.0 units box
create_atoms    1 single 16 16 6.0 units box
create_atoms    1 single 10 10 6.0 units box
set             type 1 diameter 1.0 density 1.0
velocity        all set 0.05 -0.05 -1.0 units box
pair_style      none
timestep        5.0e-5
fix             1 all nve/sphere
fix             2 all gravity 1.0 vector 0 0 -1
fix             3 all wall/gran/region hertz/history 20000.0 5000.0 50.0 25.0 0.5 1 region mixer
thermo_style    custom step ke pe etotal atoms
thermo_modify   format float %.15g
thermo          50
run             500
