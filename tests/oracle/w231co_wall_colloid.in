# oracle: fix wall/colloid (examples/COLLOID-style finite-size spheres, cut down): 10 spheres of diameter 1 in a 10 x 10 x 10 box, periodic in x and y, walls zlo (coord 0, epsilon 1, sigma 1, cutoff 2.5) and zhi (EDGE, epsilon 1, sigma 1, cutoff 2.5), nve, 40 steps of 0.005
# native: installed lmp (b332f28)
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 3.3e-15, atoms 0.0e+0.
# oracle-compare: thermo=all atoms=all rel=1e-8 abs=1e-10
units           lj
atom_style      sphere
boundary        p p f
region          box block 0 10 0 10 0 10
create_box      1 box
create_atoms    1 single 2 2 2 units box
create_atoms    1 single 5 5 2.5 units box
create_atoms    1 single 8 3 3 units box
create_atoms    1 single 3 7 4 units box
create_atoms    1 single 6 6 5 units box
create_atoms    1 single 8 8 6 units box
create_atoms    1 single 1.5 8.5 7 units box
create_atoms    1 single 4.5 1.5 7.5 units box
create_atoms    1 single 7.5 4.5 8 units box
create_atoms    1 single 2.5 4 9 units box
set             type 1 diameter 1.0 density 1.0
pair_style      zero 3.0
pair_coeff      * *
velocity        all create 1.0 4321 loop geom
fix             1 all nve
fix             2 all wall/colloid zlo 0.0 1.0 1.0 2.5 zhi EDGE 1.0 1.0 2.5
thermo          10
thermo_style    custom step pe ke etotal f_2 f_2[1] f_2[2]
thermo_modify   format float %.15g
timestep        0.005
run             40
