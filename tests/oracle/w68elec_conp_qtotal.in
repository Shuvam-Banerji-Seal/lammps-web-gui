# oracle: ELECTRODE conp with qtotal 0.1 (constant total electrode charge, mat_inv, symm off)
# oracle-inputs: w68elec_au_elyt.data
# oracle-compare: thermo=all atoms=all
# Measured max relative error, engine vs native (thermo rows, final atoms): thermo 9.2e-15, atoms 5.3e-13.
# Measured with native LAMMPS (black box): step 0: pe=117.004470009 c_qbot=-0.229214485147 c_qtop=0.329214485147
boundary        p p f
kspace_style    ewald/electrode 1.0e-8
kspace_modify   slab 8.0
units           real
atom_style      full
pair_style      lj/cut/coul/long 12
read_data       w68elec_au_elyt.data
group           bot type 1
group           top type 2
variable        q atom q
compute         qbot bot reduce sum v_q
compute         qtop top reduce sum v_q
thermo_style    custom step pe c_qbot c_qtop
thermo_modify   format float %.15g
fix             conp bot electrode/conp 0 2 couple top 1 qtotal 0.1
run             0
