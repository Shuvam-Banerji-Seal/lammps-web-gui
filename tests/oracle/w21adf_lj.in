# oracle: compute adf on a melted LJ fcc binary mixture with type ranges and the ordinate keyword
# oracle-compare: rel=1e-9
units           lj
atom_style      atomic
boundary        p p p
lattice         fcc 0.8442
region          box block 0 6 0 6 0 6
create_box      2 box
create_atoms    1 box
group           odd id 1:864:2
set             group odd type 2
mass            1 1.0
mass            2 1.5
region          lowz block INF INF INF INF INF 2.5 units box
group           lower region lowz
group           upper subtract all lower
variable        dx atom 0.05*sin(1.3*x+0.7*y)
variable        dy atom 0.05*cos(0.9*y-1.1*z)
variable        dz atom 0.05*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
variable        vx atom 1.1*sin(0.9*x+0.4*z)
variable        vy atom 1.1*cos(0.6*y+0.8*x)
variable        vz atom 1.1*sin(0.7*z-0.3*y)
velocity        all set v_vx v_vy v_vz units box
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
pair_coeff      1 2 0.9 1.1
pair_coeff      2 2 0.8 1.05
timestep        0.002
fix             1 all nve
compute         a all adf 8 1 1 1 0.0 2.0 0.0 2.0 1 2 2 0.0 2.5 0.0 2.5 ordinate cosine
compute         b all adf 6 2 1* 1* 0.0 2.0 0.0 2.0 ordinate radian
thermo_style    custom step temp pe etotal press c_a[1][2] c_a[3][3] c_a[8][4] c_a[4][5] c_a[8][1] c_b[3][2] c_b[6][3] c_b[1][1]
thermo_modify   format float %.15g
thermo          10
run             50
