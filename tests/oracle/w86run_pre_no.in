# oracle: run pre no keeps the forces and neighbor lists of the previous run (run.html "pre"); the setup row shows the old energy
# oracle-compare: thermo=all rel=1e-12 abs=1e-14
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
mass            1 1.0
variable        vx atom 1.4*sin(1.7*x+2.3*y+0.7*z)
variable        vy atom 1.4*cos(2.1*x-1.1*y+0.3*z)
variable        vz atom 1.4*sin(0.5*x+1.9*z+1.3*y)
velocity        all set v_vx v_vy v_vz units box
velocity        all zero linear
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
neighbor        0.3 bin
neigh_modify    every 1 delay 0 check yes
fix             1 all nve
group           sub id 1:64
thermo_style    custom step temp pe etotal press
thermo_modify   format float %.15g
thermo          1
run             10
displace_atoms  sub move 0.05 0.03 -0.02 units box
run             10 pre no
run             5 pre yes
