# oracle: fix adapt on lj/cubic sigma: init_one re-derives lj1..lj4, the inner cutoff and cutoff stay those pair_coeff set, and the cubic part takes r_min from the current sigma
# oracle-compare: thermo=all atoms=all rel=1e-10 abs=1e-10
units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
mass            * 1.0
set             group all type/fraction 2 0.5 4321
velocity        all create 1.0 87287 loop geom
pair_style      lj/cubic
pair_coeff      1 1 1.0 1.0
pair_coeff      2 2 0.8 1.05
variable        s equal 1.0+0.001*elapsed
fix             1 all nve
fix             2 all adapt 2 pair lj/cubic sigma 1 1 v_s
thermo_style    custom step temp pe press
thermo_modify   format float %.15g
thermo          10
run             40
