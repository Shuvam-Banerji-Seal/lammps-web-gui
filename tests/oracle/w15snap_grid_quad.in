# oracle: compute sna/grid with quadraticflag 1 and bnormflag 1 (quadratic grid terms)
# oracle-compare: thermo=first atoms=all rel=1e-8 abs=1e-9
units           metal
atom_modify     map hash
lattice         bcc 2.0
region          box block 0 2 0 1 0 1
create_box      2 box
create_atoms    1 box
group           odd id 1:4:2
set             group odd type 2
mass            * 180.88
variable        dx atom 0.05*sin(1.3*x+0.7*y)
variable        dy atom 0.05*cos(0.9*y-1.1*z)
variable        dz atom 0.05*sin(1.7*z+0.5*x)
displace_atoms  all move v_dx v_dy v_dz units box
pair_style      zbl 4 4.8
pair_coeff      * * 73 73
compute mygrid all sna/grid grid 2 2 2 1.0 0.99363 2 2.3 2.0 1.0 0.96 rmin0 0 quadraticflag 1 bnormflag 1 bzeroflag 0
thermo_style    custom step pe c_mygrid[1][1] c_mygrid[1][2] c_mygrid[1][3] c_mygrid[1][4] c_mygrid[1][5] c_mygrid[1][6] c_mygrid[1][7] c_mygrid[1][8] c_mygrid[1][9] c_mygrid[1][10] c_mygrid[1][11] c_mygrid[1][12] c_mygrid[1][13] c_mygrid[1][14] c_mygrid[1][15] c_mygrid[1][16] c_mygrid[1][17] c_mygrid[1][18] c_mygrid[1][19] c_mygrid[1][20] c_mygrid[1][21] c_mygrid[1][22] c_mygrid[1][23] c_mygrid[2][1] c_mygrid[2][2] c_mygrid[2][3] c_mygrid[2][4] c_mygrid[2][5] c_mygrid[2][6] c_mygrid[2][7] c_mygrid[2][8] c_mygrid[2][9] c_mygrid[2][10] c_mygrid[2][11] c_mygrid[2][12] c_mygrid[2][13] c_mygrid[2][14] c_mygrid[2][15] c_mygrid[2][16] c_mygrid[2][17] c_mygrid[2][18] c_mygrid[2][19] c_mygrid[2][20] c_mygrid[2][21] c_mygrid[2][22] c_mygrid[2][23] c_mygrid[3][1] c_mygrid[3][2] c_mygrid[3][3] c_mygrid[3][4] c_mygrid[3][5] c_mygrid[3][6] c_mygrid[3][7] c_mygrid[3][8] c_mygrid[3][9] c_mygrid[3][10] c_mygrid[3][11] c_mygrid[3][12] c_mygrid[3][13] c_mygrid[3][14] c_mygrid[3][15] c_mygrid[3][16] c_mygrid[3][17] c_mygrid[3][18] c_mygrid[3][19] c_mygrid[3][20] c_mygrid[3][21] c_mygrid[3][22] c_mygrid[3][23] c_mygrid[4][1] c_mygrid[4][2] c_mygrid[4][3] c_mygrid[4][4] c_mygrid[4][5] c_mygrid[4][6] c_mygrid[4][7] c_mygrid[4][8] c_mygrid[4][9] c_mygrid[4][10] c_mygrid[4][11] c_mygrid[4][12] c_mygrid[4][13] c_mygrid[4][14] c_mygrid[4][15] c_mygrid[4][16] c_mygrid[4][17] c_mygrid[4][18] c_mygrid[4][19] c_mygrid[4][20] c_mygrid[4][21] c_mygrid[4][22] c_mygrid[4][23] c_mygrid[5][1] c_mygrid[5][2] c_mygrid[5][3] c_mygrid[5][4] c_mygrid[5][5] c_mygrid[5][6] c_mygrid[5][7] c_mygrid[5][8] c_mygrid[5][9] c_mygrid[5][10] c_mygrid[5][11] c_mygrid[5][12] c_mygrid[5][13] c_mygrid[5][14] c_mygrid[5][15] c_mygrid[5][16] c_mygrid[5][17] c_mygrid[5][18] c_mygrid[5][19] c_mygrid[5][20] c_mygrid[5][21] c_mygrid[5][22] c_mygrid[5][23] c_mygrid[6][1] c_mygrid[6][2] c_mygrid[6][3] c_mygrid[6][4] c_mygrid[6][5] c_mygrid[6][6] c_mygrid[6][7] c_mygrid[6][8] c_mygrid[6][9] c_mygrid[6][10] c_mygrid[6][11] c_mygri